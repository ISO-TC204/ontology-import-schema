	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		BodyOfWater [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">BodyOfWater</TD></TR></TABLE>> URL="../BodyOfWater" margin=0]
	}
	SeaBodyOfWater [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">SeaBodyOfWater</TD></TR></TABLE>> URL="../SeaBodyOfWater" margin=0]
	{
