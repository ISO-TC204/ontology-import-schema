// Diagram for PaymentCard
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		FinancialProduct [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">FinancialProduct</TD></TR></TABLE>> URL="../FinancialProduct" margin=0]
		PaymentMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PaymentMethod</TD></TR></TABLE>> URL="../PaymentMethod" margin=0]
	}
	PaymentCard [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PaymentCard</TD></TR></TABLE>> URL="../PaymentCard" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	PaymentCard -> FinancialProduct [arrowhead=onormal style=solid]
	PaymentCard -> PaymentMethod [arrowhead=onormal style=solid]
}
