    rdfs:comment "A hospital." ;
    rdfs:subClassOf :CivicStructure,
        :EmergencyService,
        :MedicalOrganization ;
    skos:definition "A hospital." .

:InstantaneousEvent a owl:Class ;
    rdfs:label "InstantaneousEvent" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/4527> ;
    rdfs:comment "An event with no duration, like for instance a computer log entry." ;
    rdfs:subClassOf :StructuredValue ;
    owl:equivalentClass prov:InstantaneousEvent ;
    skos:definition "An event with no duration, like for instance a computer log entry." .

:InvestmentOrDeposit a owl:Class ;
    rdfs:label "InvestmentOrDeposit" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    rdfs:comment "A type of financial product that typically requires the client to transfer funds to a financial service in return for potential beneficial financial return." ;
    rdfs:subClassOf :FinancialProduct ;
    skos:definition "A type of financial product that typically requires the client to transfer funds to a financial service in return for potential beneficial financial return." .

:ItemListOrderType a owl:Class ;
    rdfs:label "ItemListOrderType" ;
    rdfs:comment "Enumerated for values for itemListOrder for indicating how an ordered ItemList is organized." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerated for values for itemListOrder for indicating how an ordered ItemList is organized." .

:Landform a owl:Class ;
    rdfs:label "Landform" ;
    rdfs:comment "A landform or physical feature.  Landform elements include mountains, plains, lakes, rivers, seascape and oceanic waterbody interface features such as bays, peninsulas, seas and so forth, including sub-aqueous terrain features such as submersed mountain ranges, volcanoes, and the great ocean basins." ;
    rdfs:subClassOf :Place ;
    skos:definition "A landform or physical feature.  Landform elements include mountains, plains, lakes, rivers, seascape and oceanic waterbody interface features such as bays, peninsulas, seas and so forth, including sub-aqueous terrain features such as submersed mountain ranges, volcanoes, and the great ocean basins." .

:LegalForceStatus a owl:Class ;
    rdfs:label "LegalForceStatus" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "A list of possible statuses for the legal force of a legislation." ;
    rdfs:subClassOf :StatusEnumeration ;
    skos:definition "A list of possible statuses for the legal force of a legislation." ;
    skos:exactMatch eli:InForce .

:LifestyleModification a owl:Class ;
    rdfs:label "LifestyleModification" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A process of care involving exercise, changes to diet, fitness routines, and other lifestyle changes aimed at improving a health condition." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "A process of care involving exercise, changes to diet, fitness routines, and other lifestyle changes aimed at improving a health condition." .

:LocationFeatureSpecification a owl:Class ;
    rdfs:label "LocationFeatureSpecification" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment "Specifies a location feature by providing a structured value representing a feature of an accommodation as a property-value pair of varying degrees of formality." ;
    rdfs:subClassOf :PropertyValue ;
    skos:definition "Specifies a location feature by providing a structured value representing a feature of an accommodation as a property-value pair of varying degrees of formality." .

:MedicalEvidenceLevel a owl:Class ;
    rdfs:label "MedicalEvidenceLevel" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Level of evidence for a medical guideline. Enumerated type." ;
    rdfs:subClassOf :MedicalEnumeration ;
    skos:definition "Level of evidence for a medical guideline. Enumerated type." .

:MedicalRiskEstimator a owl:Class ;
    rdfs:label "MedicalRiskEstimator" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Any rule set or interactive tool for estimating the risk of developing a complication or condition." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "Any rule set or interactive tool for estimating the risk of developing a complication or condition." .

:MedicalSign a owl:Class ;
    rdfs:label "MedicalSign" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Any physical manifestation of a person's medical condition discoverable by objective diagnostic tests or physical examination." ;
    rdfs:subClassOf :MedicalSignOrSymptom ;
    skos:definition "Any physical manifestation of a person's medical condition discoverable by objective diagnostic tests or physical examination." .

:Menu a owl:Class ;
    rdfs:label "Menu" ;
    rdfs:comment "A structured representation of food or drink items available from a FoodEstablishment." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A structured representation of food or drink items available from a FoodEstablishment." .

:MenuSection a owl:Class ;
    rdfs:label "MenuSection" ;
    rdfs:comment "A sub-grouping of food or drink items in a menu. E.g. courses (such as 'Dinner', 'Breakfast', etc.), specific type of dishes (such as 'Meat', 'Vegan', 'Drinks', etc.), or some other classification made by the menu provider." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A sub-grouping of food or drink items in a menu. E.g. courses (such as 'Dinner', 'Breakfast', etc.), specific type of dishes (such as 'Meat', 'Vegan', 'Drinks', etc.), or some other classification made by the menu provider." .

:MonetaryAmountDistribution a owl:Class ;
    rdfs:label "MonetaryAmountDistribution" ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "A statistical distribution of monetary amounts." ;
    rdfs:subClassOf :QuantitativeValueDistribution ;
    skos:definition "A statistical distribution of monetary amounts." .

:NonprofitType a owl:Class ;
    rdfs:label "NonprofitType" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2543> ;
    rdfs:comment "NonprofitType enumerates several kinds of official non-profit types of which a non-profit organization can be." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "NonprofitType enumerates several kinds of official non-profit types of which a non-profit organization can be." .

:OrganizeAction a owl:Class ;
    rdfs:label "OrganizeAction" ;
    rdfs:comment "The act of manipulating/administering/supervising/controlling one or more objects." ;
    rdfs:subClassOf :Action ;
    skos:definition "The act of manipulating/administering/supervising/controlling one or more objects." .

:OwnershipInfo a owl:Class ;
    rdfs:label "OwnershipInfo" ;
    :contributor <https://blog.schema.org/2012/11/08/good-relations-and-schema-org/> ;
    rdfs:comment "A structured value providing information about when a certain organization or person owned a certain product." ;
    rdfs:subClassOf :StructuredValue ;
    skos:definition "A structured value providing information about when a certain organization or person owned a certain product." .

:PerformingGroup a owl:Class ;
    rdfs:label "PerformingGroup" ;
    rdfs:comment "A performance group, such as a band, an orchestra, or a circus." ;
    rdfs:subClassOf :Organization ;
    skos:definition "A performance group, such as a band, an orchestra, or a circus." .

:PlanAction a owl:Class ;
    rdfs:label "PlanAction" ;
    rdfs:comment "The act of planning the execution of an event/task/action/reservation/plan to a future date." ;
    rdfs:subClassOf :OrganizeAction ;
    skos:definition "The act of planning the execution of an event/task/action/reservation/plan to a future date." .

:PlayAction a owl:Class ;
    rdfs:label "PlayAction" ;
    rdfs:comment "The act of playing/exercising/training/performing for enjoyment, leisure, recreation, competition or exercise.\\n\\nRelated actions:\\n\\n* [[ListenAction]]: Unlike ListenAction (which is under ConsumeAction), PlayAction refers to performing for an audience or at an event, rather than consuming music.\\n* [[WatchAction]]: Unlike WatchAction (which is under ConsumeAction), PlayAction refers to showing/displaying for an audience or at an event, rather than consuming visual content." ;
    rdfs:subClassOf :Action ;
    skos:definition "The act of playing/exercising/training/performing for enjoyment, leisure, recreation, competition or exercise.\\n\\nRelated actions:\\n\\n* [[ListenAction]]: Unlike ListenAction (which is under ConsumeAction), PlayAction refers to performing for an audience or at an event, rather than consuming music.\\n* [[WatchAction]]: Unlike WatchAction (which is under ConsumeAction), PlayAction refers to showing/displaying for an audience or at an event, rather than consuming visual content." .

:ProductGroup a owl:Class ;
    rdfs:label "ProductGroup" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1797> ;
    rdfs:comment """A ProductGroup represents a group of [[Product]]s that vary only in certain well-described ways, such as by [[size]], [[color]], [[material]] etc.

While a ProductGroup itself is not directly offered for sale, the various varying products that it represents can be. The ProductGroup serves as a prototype or template, standing in for all of the products who have an [[isVariantOf]] relationship to it. As such, properties (including additional types) can be applied to the ProductGroup to represent characteristics shared by each of the (possibly very many) variants. Properties that reference a ProductGroup are not included in this mechanism; neither are the following specific properties [[variesBy]], [[hasVariant]], [[url]]. """ ;
    rdfs:subClassOf :Product,
        cmns-cls:Classifier,
        cmns-coll:Collection ;
    skos:definition """A ProductGroup represents a group of [[Product]]s that vary only in certain well-described ways, such as by [[size]], [[color]], [[material]] etc.

While a ProductGroup itself is not directly offered for sale, the various varying products that it represents can be. The ProductGroup serves as a prototype or template, standing in for all of the products who have an [[isVariantOf]] relationship to it. As such, properties (including additional types) can be applied to the ProductGroup to represent characteristics shared by each of the (possibly very many) variants. Properties that reference a ProductGroup are not included in this mechanism; neither are the following specific properties [[variesBy]], [[hasVariant]], [[url]]. """ .

