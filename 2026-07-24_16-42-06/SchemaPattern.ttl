    skos:definition "Password, PIN, or access code needed for delivery (e.g. from a locker)." .

:accessMode a owl:DatatypeProperty ;
    rdfs:label "accessMode" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1100> ;
    rdfs:comment "The human sensory perceptual system or cognitive faculty through which a person may process or perceive information. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessMode-vocabulary)." ;
    skos:definition "The human sensory perceptual system or cognitive faculty through which a person may process or perceive information. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessMode-vocabulary)." .

:accessModeSufficient a owl:ObjectProperty ;
    rdfs:label "accessModeSufficient" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :ItemList ;
    :source <https://github.com/schemaorg/schemaorg/issues/1100> ;
    rdfs:comment "A list of single or combined accessModes that are sufficient to understand all the intellectual content of a resource. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessModeSufficient-vocabulary)." ;
    skos:definition "A list of single or combined accessModes that are sufficient to understand all the intellectual content of a resource. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessModeSufficient-vocabulary)." .

:accessibilityAPI a owl:DatatypeProperty ;
    rdfs:label "accessibilityAPI" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "Indicates that the resource is compatible with the referenced accessibility API. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityAPI-vocabulary)." ;
    skos:definition "Indicates that the resource is compatible with the referenced accessibility API. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityAPI-vocabulary)." .

:accessibilityControl a owl:DatatypeProperty ;
    rdfs:label "accessibilityControl" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "Identifies input methods that are sufficient to fully control the described resource. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityControl-vocabulary)." ;
    skos:definition "Identifies input methods that are sufficient to fully control the described resource. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityControl-vocabulary)." .

:accessibilityFeature a owl:DatatypeProperty ;
    rdfs:label "accessibilityFeature" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "Content features of the resource, such as accessible media, alternatives and supported enhancements for accessibility. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityFeature-vocabulary)." ;
    skos:definition "Content features of the resource, such as accessible media, alternatives and supported enhancements for accessibility. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityFeature-vocabulary)." .

:accessibilityHazard a owl:DatatypeProperty ;
    rdfs:label "accessibilityHazard" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "A characteristic of the described resource that is physiologically dangerous to some users. Related to WCAG 2.0 guideline 2.3. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityHazard-vocabulary)." ;
    skos:definition "A characteristic of the described resource that is physiologically dangerous to some users. Related to WCAG 2.0 guideline 2.3. Values should be drawn from the [approved vocabulary](https://www.w3.org/2021/a11y-discov-vocab/latest/#accessibilityHazard-vocabulary)." .

:accessibilitySummary a owl:DatatypeProperty ;
    rdfs:label "accessibilitySummary" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1100> ;
    rdfs:comment "A human-readable summary of specific accessibility features or deficiencies, consistent with the other accessibility metadata but expressing subtleties such as \"short descriptions are present but long descriptions will be needed for non-visual users\" or \"short descriptions are present and no long descriptions are needed\"." ;
    skos:definition "A human-readable summary of specific accessibility features or deficiencies, consistent with the other accessibility metadata but expressing subtleties such as \"short descriptions are present but long descriptions will be needed for non-visual users\" or \"short descriptions are present and no long descriptions are needed\"." .

:accommodationCategory a owl:DatatypeProperty ;
    rdfs:label "accommodationCategory" ;
    :domainIncludes :Accommodation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Category of an [[Accommodation]], following real estate conventions, e.g. RESO (see [PropertySubType](https://ddwiki.reso.org/display/DDW17/PropertySubType+Field), and [PropertyType](https://ddwiki.reso.org/display/DDW17/PropertyType+Field) fields  for suggested values)." ;
    rdfs:subPropertyOf :category ;
    skos:definition "Category of an [[Accommodation]], following real estate conventions, e.g. RESO (see [PropertySubType](https://ddwiki.reso.org/display/DDW17/PropertySubType+Field), and [PropertyType](https://ddwiki.reso.org/display/DDW17/PropertyType+Field) fields  for suggested values)." .

:accommodationFloorPlan a owl:ObjectProperty ;
    rdfs:label "accommodationFloorPlan" ;
    :domainIncludes :Accommodation,
        :Residence ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :FloorPlan ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "A floorplan of some [[Accommodation]]." ;
    skos:definition "A floorplan of some [[Accommodation]]." .

:accountId a owl:DatatypeProperty ;
    rdfs:label "accountId" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :Text ;
    rdfs:comment "The identifier for the account the payment will be applied to." ;
    rdfs:subPropertyOf :identifier ;
    skos:definition "The identifier for the account the payment will be applied to." .

:accountMinimumInflow a owl:ObjectProperty ;
    rdfs:label "accountMinimumInflow" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :BankAccount ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A minimum amount that has to be paid in every month." ;
    skos:definition "A minimum amount that has to be paid in every month." .

:accountOverdraftLimit a owl:ObjectProperty ;
    rdfs:label "accountOverdraftLimit" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :BankAccount ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "An overdraft is an extension of credit from a lending institution when an account reaches zero. An overdraft allows the individual to continue withdrawing money even if the account has no funds in it. Basically the bank allows people to borrow a set amount of money." ;
    skos:definition "An overdraft is an extension of credit from a lending institution when an account reaches zero. An overdraft allows the individual to continue withdrawing money even if the account has no funds in it. Basically the bank allows people to borrow a set amount of money." .

:accountablePerson a owl:ObjectProperty ;
    rdfs:label "accountablePerson" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Person ;
    rdfs:comment "Specifies the Person that is legally accountable for the CreativeWork." ;
    skos:definition "Specifies the Person that is legally accountable for the CreativeWork." .

:acquireLicensePage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "acquireLicensePage" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2454> ;
    rdfs:comment "Indicates a page documenting how licenses can be purchased or otherwise acquired, for the current item." ;
    rdfs:subPropertyOf :usageInfo ;
    skos:definition "Indicates a page documenting how licenses can be purchased or otherwise acquired, for the current item." .

:acquiredFrom a owl:ObjectProperty ;
    rdfs:label "acquiredFrom" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OwnershipInfo ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The organization or person from which the product was acquired." ;
    skos:definition "The organization or person from which the product was acquired." .

:acrissCode a owl:DatatypeProperty ;
    rdfs:label "acrissCode" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :BusOrCoach,
        :Car ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The ACRISS Car Classification Code is a code used by many car rental companies, for classifying vehicles. ACRISS stands for Association of Car Rental Industry Systems and Standards." ;
    skos:definition "The ACRISS Car Classification Code is a code used by many car rental companies, for classifying vehicles. ACRISS stands for Association of Car Rental Industry Systems and Standards." .

:actionAccessibilityRequirement a owl:ObjectProperty ;
    rdfs:label "actionAccessibilityRequirement" ;
    :domainIncludes :ConsumeAction ;
    :rangeIncludes :ActionAccessSpecification ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "A set of requirements that must be fulfilled in order to perform an Action. If more than one value is specified, fulfilling one set of requirements will allow the Action to be performed." ;
    skos:definition "A set of requirements that must be fulfilled in order to perform an Action. If more than one value is specified, fulfilling one set of requirements will allow the Action to be performed." .

:actionPlatform a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "actionPlatform" ;
    :domainIncludes :EntryPoint ;
    :rangeIncludes :DigitalPlatformEnumeration,
        :Text,
        :URL ;
    rdfs:comment "The high level platform(s) where the Action can be performed for the given URL. To specify a specific application or operating system instance, use actionApplication." ;
    skos:definition "The high level platform(s) where the Action can be performed for the given URL. To specify a specific application or operating system instance, use actionApplication." .

:actionProcess a owl:ObjectProperty ;
    rdfs:label "actionProcess" ;
    :domainIncludes :Action ;
    :rangeIncludes :HowTo ;
    rdfs:comment "Description of the process by which the action was performed." ;
    skos:definition "Description of the process by which the action was performed." .

:actionStatus a owl:ObjectProperty ;
    rdfs:label "actionStatus" ;
    :domainIncludes :Action ;
    :rangeIncludes :ActionStatusType ;
    rdfs:comment "Indicates the current disposition of the Action." ;
    skos:definition "Indicates the current disposition of the Action." .

:actionableFeedbackPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "actionableFeedbackPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For a [[NewsMediaOrganization]] or other news-related [[Organization]], a statement about public engagement activities (for news media, the newsroom’s), including involving the public - digitally or otherwise -- in coverage decisions, reporting and activities after publication." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For a [[NewsMediaOrganization]] or other news-related [[Organization]], a statement about public engagement activities (for news media, the newsroom’s), including involving the public - digitally or otherwise -- in coverage decisions, reporting and activities after publication." .

:activeIngredient a owl:DatatypeProperty ;
    rdfs:label "activeIngredient" ;
    :domainIncludes :DietarySupplement,
        :Drug,
        :DrugStrength,
        :Substance ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "An active ingredient, typically chemical compounds and/or biologic substances." ;
    skos:definition "An active ingredient, typically chemical compounds and/or biologic substances." .

:activityDuration a owl:ObjectProperty ;
    rdfs:label "activityDuration" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Duration,
        :QuantitativeValue ;
    rdfs:comment "Length of time to engage in the activity." ;
    skos:definition "Length of time to engage in the activity." .

:activityFrequency a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "activityFrequency" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    rdfs:comment "How often one should engage in the activity." ;
    skos:definition "How often one should engage in the activity." .

:actors a owl:ObjectProperty ;
    rdfs:label "actors" ;
    :domainIncludes :Clip,
        :Episode,
        :Movie,
        :MovieSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGame,
        :VideoGameSeries,
        :VideoObject ;
    :rangeIncludes :Person ;
    :supersededBy :actor ;
    rdfs:comment "An actor, e.g. in TV, radio, movie, video games etc. Actors can be associated with individual items or with a series, episode, clip." ;
    skos:definition "An actor, e.g. in TV, radio, movie, video games etc. Actors can be associated with individual items or with a series, episode, clip." .

:addOn a owl:ObjectProperty ;
    rdfs:label "addOn" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Offer ;
    :rangeIncludes :Offer ;
    rdfs:comment "An additional offer that can only be obtained in combination with the first base offer (e.g. supplements and extensions that are available for a surcharge)." ;
    skos:definition "An additional offer that can only be obtained in combination with the first base offer (e.g. supplements and extensions that are available for a surcharge)." .

:additionalName a owl:DatatypeProperty ;
    rdfs:label "additionalName" ;
    :domainIncludes :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "An additional name for a Person, can be used for a middle name." ;
    rdfs:subPropertyOf :alternateName ;
    skos:definition "An additional name for a Person, can be used for a middle name." .

:additionalNumberOfGuests a owl:DatatypeProperty ;
    rdfs:label "additionalNumberOfGuests" ;
    :domainIncludes :RsvpAction ;
    :rangeIncludes :Number ;
    rdfs:comment "If responding yes, the number of guests who will attend in addition to the invitee." ;
    skos:definition "If responding yes, the number of guests who will attend in addition to the invitee." .

:additionalProperty a owl:ObjectProperty ;
    rdfs:label "additionalProperty" ;
    :domainIncludes :MerchantReturnPolicy,
        :Offer,
        :Place,
        :Product,
        :QualitativeValue,
        :QuantitativeValue ;
    :rangeIncludes :PropertyValue ;
    rdfs:comment """A property-value pair representing an additional characteristic of the entity, e.g. a product feature or another characteristic for which there is no matching property in schema.org.\\n\\nNote: Publishers should be aware that applications designed to use specific schema.org properties (e.g. http://schema.org/width, http://schema.org/color, http://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism.
""" ;
    skos:definition """A property-value pair representing an additional characteristic of the entity, e.g. a product feature or another characteristic for which there is no matching property in schema.org.\\n\\nNote: Publishers should be aware that applications designed to use specific schema.org properties (e.g. http://schema.org/width, http://schema.org/color, http://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism.
""" .

:additionalType a owl:DatatypeProperty ;
    rdfs:label "additionalType" ;
    :domainIncludes :Thing ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment """An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. Typically the value is a URI-identified RDF class, and in this case corresponds to the
    use of rdf:type in RDF. Text values can be used sparingly, for cases where useful information can be added without their being an appropriate schema to reference. In the case of text values, the class label should follow the schema.org <a href="http://schema.org/docs/styleguide.html">style guide</a>.""" ;
    rdfs:subPropertyOf rdf:type ;
    skos:definition """An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. Typically the value is a URI-identified RDF class, and in this case corresponds to the
    use of rdf:type in RDF. Text values can be used sparingly, for cases where useful information can be added without their being an appropriate schema to reference. In the case of text values, the class label should follow the schema.org <a href="http://schema.org/docs/styleguide.html">style guide</a>.""" .

:additionalVariable a owl:DatatypeProperty ;
    rdfs:label "additionalVariable" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any additional component of the exercise prescription that may need to be articulated to the patient. This may include the order of exercises, the number of repetitions of movement, quantitative distance, progressions over time, etc." ;
    skos:definition "Any additional component of the exercise prescription that may need to be articulated to the patient. This may include the order of exercises, the number of repetitions of movement, quantitative distance, progressions over time, etc." .

:address a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "address" ;
    :domainIncludes :GeoCoordinates,
        :GeoShape,
        :Organization,
        :Person,
        :Place ;
    :rangeIncludes :PostalAddress,
        :Text ;
    rdfs:comment "Physical address of the item." ;
    skos:definition "Physical address of the item." .

:addressCountry a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "addressCountry" ;
    :domainIncludes :DefinedRegion,
        :GeoCoordinates,
        :GeoShape,
        :PostalAddress ;
    :rangeIncludes :Country,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "The country. Recommended to be in 2-letter [ISO 3166-1 alpha-2](http://en.wikipedia.org/wiki/ISO_3166-1) format, for example \"US\". For backward compatibility, a 3-letter [ISO 3166-1 alpha-3](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3) country code such as \"SGP\" or a full country name such as \"Singapore\" can also be used." ;
    skos:definition "The country. Recommended to be in 2-letter [ISO 3166-1 alpha-2](http://en.wikipedia.org/wiki/ISO_3166-1) format, for example \"US\". For backward compatibility, a 3-letter [ISO 3166-1 alpha-3](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3) country code such as \"SGP\" or a full country name such as \"Singapore\" can also be used." .

:addressLocality a owl:DatatypeProperty ;
    rdfs:label "addressLocality" ;
    :domainIncludes :PostalAddress ;
    :rangeIncludes :Text ;
    rdfs:comment "The locality in which the street address is, and which is in the region. For example, Mountain View." ;
    owl:equivalentProperty gs1:addressLocality,
        fibo-fnd-plc:hasMunicipality ;
    skos:definition "The locality in which the street address is, and which is in the region. For example, Mountain View." .

:addressRegion a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "addressRegion" ;
    :domainIncludes :DefinedRegion,
        :PostalAddress ;
    :rangeIncludes :AdministrativeArea,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level [Administrative division](https://en.wikipedia.org/wiki/List_of_administrative_divisions_by_country)." ;
    owl:equivalentProperty fibo-fnd-plc:hasCountrySubdivision ;
    skos:definition "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level [Administrative division](https://en.wikipedia.org/wiki/List_of_administrative_divisions_by_country)." .

:administrationRoute a owl:DatatypeProperty ;
    rdfs:label "administrationRoute" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "A route by which this drug may be administered, e.g. 'oral'." ;
    skos:definition "A route by which this drug may be administered, e.g. 'oral'." .

:advanceBookingRequirement a owl:ObjectProperty ;
    rdfs:label "advanceBookingRequirement" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The amount of time that is required between accepting the offer and the actual usage of the resource or service." ;
    skos:definition "The amount of time that is required between accepting the offer and the actual usage of the resource or service." .

:adverseOutcome a owl:ObjectProperty ;
    rdfs:label "adverseOutcome" ;
    :domainIncludes :MedicalDevice,
        :TherapeuticProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity ;
    rdfs:comment "A possible complication and/or side effect of this therapy. If it is known that an adverse outcome is serious (resulting in death, disability, or permanent damage; requiring hospitalization; or otherwise life-threatening or requiring immediate medical attention), tag it as a seriousAdverseOutcome instead." ;
    skos:definition "A possible complication and/or side effect of this therapy. If it is known that an adverse outcome is serious (resulting in death, disability, or permanent damage; requiring hospitalization; or otherwise life-threatening or requiring immediate medical attention), tag it as a seriousAdverseOutcome instead." .

:affectedBy a owl:ObjectProperty ;
    rdfs:label "affectedBy" ;
    :domainIncludes :MedicalTest ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Drug ;
    rdfs:comment "Drugs that affect the test's results." ;
    skos:definition "Drugs that affect the test's results." .

:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation" ;
    :domainIncludes :Person ;
    :rangeIncludes :Organization ;
    rdfs:comment "An organization that this person is affiliated with. For example, a school/university, a club, or a team." ;
    rdfs:subPropertyOf :memberOf ;
    skos:definition "An organization that this person is affiliated with. For example, a school/university, a club, or a team." .

:afterMedia a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "afterMedia" ;
    :domainIncludes :HowToDirection ;
    :rangeIncludes :MediaObject,
        :URL ;
    rdfs:comment "A media object representing the circumstances after performing this direction." ;
    skos:definition "A media object representing the circumstances after performing this direction." .

:agent a owl:ObjectProperty ;
    rdfs:label "agent" ;
    :domainIncludes :Action ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The direct performer or driver of the action (animate or inanimate). E.g. *John* wrote a book." ;
    skos:definition "The direct performer or driver of the action (animate or inanimate). E.g. *John* wrote a book." .

:agentInteractionStatistic a owl:ObjectProperty ;
    rdfs:label "agentInteractionStatistic" ;
    :domainIncludes :Organization,
        :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :InteractionCounter ;
    :source <https://github.com/schemaorg/schemaorg/issues/2858> ;
    rdfs:comment "The number of completed interactions for this entity, in a particular role (the 'agent'), in a particular action (indicated in the statistic), and in a particular context (i.e. interactionService)." ;
    skos:definition "The number of completed interactions for this entity, in a particular role (the 'agent'), in a particular action (indicated in the statistic), and in a particular context (i.e. interactionService)." .

:aggregateElement a owl:ObjectProperty ;
    rdfs:label "aggregateElement" ;
    :domainIncludes :ItemList ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Thing ;
    :source <https://github.com/schemaorg/schemaorg/issues/4321> ;
    rdfs:comment "Indicates a prototype of the elements in the list that is used to hold aggregate information (ratings, offers, etc.)." ;
    skos:definition "Indicates a prototype of the elements in the list that is used to hold aggregate information (ratings, offers, etc.)." .

:aggregateRating a owl:ObjectProperty ;
    rdfs:label "aggregateRating" ;
    :domainIncludes :Brand,
        :CreativeWork,
        :Event,
        :Offer,
        :Organization,
        :Place,
        :Product,
        :Service ;
    :rangeIncludes :AggregateRating ;
    rdfs:comment "The overall rating, based on a collection of reviews or ratings, of the item." ;
    skos:definition "The overall rating, based on a collection of reviews or ratings, of the item." .

:aircraft a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "aircraft" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text,
        :Vehicle ;
    rdfs:comment "The kind of aircraft (e.g., \"Boeing 747\")." ;
    skos:definition "The kind of aircraft (e.g., \"Boeing 747\")." .

:albumProductionType a owl:ObjectProperty ;
    rdfs:label "albumProductionType" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicAlbum ;
    :rangeIncludes :MusicAlbumProductionType ;
    rdfs:comment "Classification of the album by its type of content: soundtrack, live album, studio album, etc." ;
    skos:definition "Classification of the album by its type of content: soundtrack, live album, studio album, etc." .

:albumReleaseType a owl:ObjectProperty ;
    rdfs:label "albumReleaseType" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicAlbum ;
    :rangeIncludes :MusicAlbumReleaseType ;
    rdfs:comment "The kind of release which this album is: single, EP or album." ;
    skos:definition "The kind of release which this album is: single, EP or album." .

:albums a owl:ObjectProperty ;
    rdfs:label "albums" ;
    :domainIncludes :MusicGroup ;
    :rangeIncludes :MusicAlbum ;
    :supersededBy :album ;
    rdfs:comment "A collection of music albums." ;
    skos:definition "A collection of music albums." .

:alcoholWarning a owl:DatatypeProperty ;
    rdfs:label "alcoholWarning" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any precaution, guidance, contraindication, etc. related to consumption of alcohol while taking this drug." ;
    skos:definition "Any precaution, guidance, contraindication, etc. related to consumption of alcohol while taking this drug." .

:algorithm a owl:DatatypeProperty ;
    rdfs:label "algorithm" ;
    :domainIncludes :MedicalRiskScore ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The algorithm or rules to follow to compute the score." ;
    skos:definition "The algorithm or rules to follow to compute the score." .

:alignmentType a owl:DatatypeProperty ;
    rdfs:label "alignmentType" ;
    :domainIncludes :AlignmentObject ;
    :rangeIncludes :Text ;
    rdfs:comment "A category of alignment between the learning resource and the framework node. Recommended values include: 'requires', 'textComplexity', 'readingLevel', and 'educationalSubject'." ;
    skos:definition "A category of alignment between the learning resource and the framework node. Recommended values include: 'requires', 'textComplexity', 'readingLevel', and 'educationalSubject'." .

:alternativeHeadline a owl:DatatypeProperty ;
    rdfs:label "alternativeHeadline" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "A secondary title of the CreativeWork." ;
    skos:definition "A secondary title of the CreativeWork." .

:alternativeOf a owl:ObjectProperty ;
    rdfs:label "alternativeOf" ;
    :domainIncludes :Gene ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Gene ;
    :source <http://www.bioschemas.org/Gene> ;
    rdfs:comment "Another gene which is a variation of this one." ;
    skos:definition "Another gene which is a variation of this one." .

:amenityFeature a owl:ObjectProperty ;
    rdfs:label "amenityFeature" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation,
        :FloorPlan,
        :LodgingBusiness,
        :Place ;
    :rangeIncludes :LocationFeatureSpecification ;
    rdfs:comment "An amenity feature (e.g. a characteristic or service) of the Accommodation. This generic property does not make a statement about whether the feature is included in an offer for the main accommodation or available at extra costs." ;
    skos:definition "An amenity feature (e.g. a characteristic or service) of the Accommodation. This generic property does not make a statement about whether the feature is included in an offer for the main accommodation or available at extra costs." .

:amount a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "amount" ;
    :domainIncludes :DatedMoneySpecification,
        :InvestmentOrDeposit,
        :LoanOrCredit,
        :MonetaryGrant,
        :MoneyTransfer ;
    :rangeIncludes :MonetaryAmount,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253>,
        <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "The amount of money." ;
    skos:definition "The amount of money." .

:amountOfThisGood a owl:DatatypeProperty ;
    rdfs:label "amountOfThisGood" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :TypeAndQuantityNode ;
    :rangeIncludes :Number ;
    rdfs:comment "The quantity of the goods included in the offer." ;
    skos:definition "The quantity of the goods included in the offer." .

:announcementLocation a owl:ObjectProperty ;
    rdfs:label "announcementLocation" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CivicStructure,
        :LocalBusiness ;
    :source <https://github.com/schemaorg/schemaorg/issues/2514> ;
    rdfs:comment "Indicates a specific [[CivicStructure]] or [[LocalBusiness]] associated with the SpecialAnnouncement. For example, a specific testing facility or business with special opening hours. For a larger geographic region like a quarantine of an entire region, use [[spatialCoverage]]." ;
    rdfs:subPropertyOf :spatialCoverage ;
    skos:definition "Indicates a specific [[CivicStructure]] or [[LocalBusiness]] associated with the SpecialAnnouncement. For example, a specific testing facility or business with special opening hours. For a larger geographic region like a quarantine of an entire region, use [[spatialCoverage]]." .

:annualPercentageRate a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "annualPercentageRate" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :FinancialProduct ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The annual rate that is charged for borrowing (or made by investing), expressed as a single percentage number that represents the actual yearly cost of funds over the term of a loan. This includes any fees or additional costs associated with the transaction." ;
    skos:definition "The annual rate that is charged for borrowing (or made by investing), expressed as a single percentage number that represents the actual yearly cost of funds over the term of a loan. This includes any fees or additional costs associated with the transaction." .

:answerCount a owl:DatatypeProperty ;
    rdfs:label "answerCount" ;
    :domainIncludes :Question ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of answers this question has received." ;
    skos:definition "The number of answers this question has received." .

:answerExplanation a owl:ObjectProperty ;
    rdfs:label "answerExplanation" ;
    :domainIncludes :Answer ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Comment,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2636> ;
    rdfs:comment "A step-by-step or full explanation about Answer. Can outline how this Answer was achieved or contain more broad clarification or statement about it. " ;
    skos:definition "A step-by-step or full explanation about Answer. Can outline how this Answer was achieved or contain more broad clarification or statement about it. " .

:antagonist a owl:ObjectProperty ;
    rdfs:label "antagonist" ;
    :domainIncludes :Muscle ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Muscle ;
    rdfs:comment "The muscle whose action counteracts the specified muscle." ;
    skos:definition "The muscle whose action counteracts the specified muscle." .

:appearance a owl:ObjectProperty ;
    rdfs:label "appearance" ;
    :domainIncludes :Claim ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork ;
    :source <https://github.com/schemaorg/schemaorg/issues/1828> ;
    rdfs:comment "Indicates an occurrence of a [[Claim]] in some [[CreativeWork]]." ;
    rdfs:subPropertyOf :workExample ;
    skos:definition "Indicates an occurrence of a [[Claim]] in some [[CreativeWork]]." .

:applicableCountry a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "applicableCountry" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Country,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3001> ;
    rdfs:comment "A country where a particular merchant return policy applies to, for example the two-letter ISO 3166-1 alpha-2 country code." ;
    skos:definition "A country where a particular merchant return policy applies to, for example the two-letter ISO 3166-1 alpha-2 country code." .

:applicableLocation a owl:ObjectProperty ;
    rdfs:label "applicableLocation" ;
    :domainIncludes :DrugCost,
        :DrugLegalStatus ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AdministrativeArea ;
    rdfs:comment "The location in which the status applies." ;
    skos:definition "The location in which the status applies." .

:applicantLocationRequirements a owl:ObjectProperty ;
    rdfs:label "applicantLocationRequirements" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AdministrativeArea ;
    :source <https://github.com/schemaorg/schemaorg/issues/2083> ;
    rdfs:comment "The location(s) applicants can apply from. This is usually used for telecommuting jobs where the applicant does not need to be in a physical office. Note: This should not be used for citizenship or work visa requirements." ;
    skos:definition "The location(s) applicants can apply from. This is usually used for telecommuting jobs where the applicant does not need to be in a physical office. Note: This should not be used for citizenship or work visa requirements." .

:application a owl:ObjectProperty ;
    rdfs:label "application" ;
    :domainIncludes :EntryPoint ;
    :rangeIncludes :SoftwareApplication ;
    :supersededBy :actionApplication ;
    rdfs:comment "An application that can complete the request." ;
    skos:definition "An application that can complete the request." .

:applicationCategory a owl:DatatypeProperty ;
    rdfs:label "applicationCategory" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Type of software application, e.g. 'Game, Multimedia'." ;
    skos:definition "Type of software application, e.g. 'Game, Multimedia'." .

:applicationContact a owl:ObjectProperty ;
    rdfs:label "applicationContact" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ContactPoint ;
    :source <https://github.com/schemaorg/schemaorg/issues/2396> ;
    rdfs:comment "Contact details for further information relevant to this job posting." ;
    skos:definition "Contact details for further information relevant to this job posting." .

:applicationDeadline a owl:DatatypeProperty ;
    rdfs:label "applicationDeadline" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The date on which the program stops collecting applications for the next enrollment cycle. Flexible application deadlines (for example, a program with rolling admissions) can be described in a textual string, rather than as a DateTime." ;
    skos:definition "The date on which the program stops collecting applications for the next enrollment cycle. Flexible application deadlines (for example, a program with rolling admissions) can be described in a textual string, rather than as a DateTime." .

:applicationStartDate a owl:DatatypeProperty ;
    rdfs:label "applicationStartDate" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The date at which the program begins collecting applications for the next enrollment cycle." ;
    skos:definition "The date at which the program begins collecting applications for the next enrollment cycle." .

:applicationSubCategory a owl:DatatypeProperty ;
    rdfs:label "applicationSubCategory" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Subcategory of the application, e.g. 'Arcade Game'." ;
    skos:definition "Subcategory of the application, e.g. 'Arcade Game'." .

:applicationSuite a owl:DatatypeProperty ;
    rdfs:label "applicationSuite" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "The name of the application suite to which the application belongs (e.g. Excel belongs to Office)." ;
    skos:definition "The name of the application suite to which the application belongs (e.g. Excel belongs to Office)." .

:appliesToDeliveryMethod a owl:ObjectProperty ;
    rdfs:label "appliesToDeliveryMethod" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :DeliveryChargeSpecification,
        :PaymentChargeSpecification ;
    :rangeIncludes :DeliveryMethod ;
    rdfs:comment "The delivery method(s) to which the delivery charge or payment charge specification applies." ;
    skos:definition "The delivery method(s) to which the delivery charge or payment charge specification applies." .

:appliesToPaymentMethod a owl:ObjectProperty ;
    rdfs:label "appliesToPaymentMethod" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :PaymentChargeSpecification ;
    :rangeIncludes :PaymentMethod ;
    rdfs:comment "The payment method(s) to which the payment charge specification applies." ;
    skos:definition "The payment method(s) to which the payment charge specification applies." .

:archivedAt a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "archivedAt" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebPage ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "Indicates a page or other link involved in archival of a [[CreativeWork]]. In the case of [[MediaReview]], the items in a [[MediaReviewItem]] may often become inaccessible, but be archived by archival, journalistic, activist, or law enforcement organizations. In such cases, the referenced page may not directly publish the content." ;
    skos:definition "Indicates a page or other link involved in archival of a [[CreativeWork]]. In the case of [[MediaReview]], the items in a [[MediaReviewItem]] may often become inaccessible, but be archived by archival, journalistic, activist, or law enforcement organizations. In such cases, the referenced page may not directly publish the content." .

:area a owl:ObjectProperty ;
    rdfs:label "area" ;
    :domainIncludes :BroadcastService ;
    :rangeIncludes :Place ;
    :supersededBy :serviceArea ;
    rdfs:comment "The area within which users can expect to reach the broadcast service." ;
    skos:definition "The area within which users can expect to reach the broadcast service." .

:arrivalAirport a owl:ObjectProperty ;
    rdfs:label "arrivalAirport" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Airport ;
    rdfs:comment "The airport where the flight terminates." ;
    skos:definition "The airport where the flight terminates." .

:arrivalBoatTerminal a owl:ObjectProperty ;
    rdfs:label "arrivalBoatTerminal" ;
    :domainIncludes :BoatTrip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BoatTerminal ;
    :source <https://github.com/schemaorg/schemaorg/issues/1755> ;
    rdfs:comment "The terminal or port from which the boat arrives." ;
    skos:definition "The terminal or port from which the boat arrives." .

:arrivalBusStop a owl:ObjectProperty ;
    rdfs:label "arrivalBusStop" ;
    :domainIncludes :BusTrip ;
    :rangeIncludes :BusStation,
        :BusStop ;
    rdfs:comment "The stop or station from which the bus arrives." ;
    skos:definition "The stop or station from which the bus arrives." .

:arrivalGate a owl:DatatypeProperty ;
    rdfs:label "arrivalGate" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text ;
    rdfs:comment "Identifier of the flight's arrival gate." ;
    skos:definition "Identifier of the flight's arrival gate." .

:arrivalPlatform a owl:DatatypeProperty ;
    rdfs:label "arrivalPlatform" ;
    :domainIncludes :TrainTrip ;
    :rangeIncludes :Text ;
    rdfs:comment "The platform where the train arrives." ;
    skos:definition "The platform where the train arrives." .

:arrivalStation a owl:ObjectProperty ;
    rdfs:label "arrivalStation" ;
    :domainIncludes :TrainTrip ;
    :rangeIncludes :TrainStation ;
    rdfs:comment "The station where the train trip ends." ;
    skos:definition "The station where the train trip ends." .

:arrivalTerminal a owl:DatatypeProperty ;
    rdfs:label "arrivalTerminal" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text ;
    rdfs:comment "Identifier of the flight's arrival terminal." ;
    skos:definition "Identifier of the flight's arrival terminal." .

:arrivalTime a owl:DatatypeProperty ;
    rdfs:label "arrivalTime" ;
    :domainIncludes :Trip ;
    :rangeIncludes :DateTime,
        :Time ;
    rdfs:comment "The expected arrival time." ;
    skos:definition "The expected arrival time." .

:artEdition a owl:DatatypeProperty ;
    rdfs:label "artEdition" ;
    :domainIncludes :VisualArtwork ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "The number of copies when multiple copies of a piece of artwork are produced - e.g. for a limited edition of 20 prints, 'artEdition' refers to the total number of copies (in this example \"20\")." ;
    skos:definition "The number of copies when multiple copies of a piece of artwork are produced - e.g. for a limited edition of 20 prints, 'artEdition' refers to the total number of copies (in this example \"20\")." .

:artMedium a owl:DatatypeProperty ;
    rdfs:label "artMedium" ;
    :domainIncludes :VisualArtwork ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "The material used. (E.g. Oil, Watercolour, Acrylic, Linoprint, Marble, Cyanotype, Digital, Lithograph, DryPoint, Intaglio, Pastel, Woodcut, Pencil, Mixed Media, etc.)" ;
    rdfs:subPropertyOf :material ;
    skos:definition "The material used. (E.g. Oil, Watercolour, Acrylic, Linoprint, Marble, Cyanotype, Digital, Lithograph, DryPoint, Intaglio, Pastel, Woodcut, Pencil, Mixed Media, etc.)" .

:artform a owl:DatatypeProperty ;
    rdfs:label "artform" ;
    :domainIncludes :VisualArtwork ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "e.g. Painting, Drawing, Sculpture, Print, Photograph, Assemblage, Collage, etc." ;
    skos:definition "e.g. Painting, Drawing, Sculpture, Print, Photograph, Assemblage, Collage, etc." .

:articleBody a owl:DatatypeProperty ;
    rdfs:label "articleBody" ;
    :domainIncludes :Article ;
    :rangeIncludes :Text ;
    rdfs:comment "The actual body of the article." ;
    skos:definition "The actual body of the article." .

:articleSection a owl:DatatypeProperty ;
    rdfs:label "articleSection" ;
    :domainIncludes :Article ;
    :rangeIncludes :Text ;
    rdfs:comment "Articles may belong to one or more 'sections' in a magazine or newspaper, such as Sports, Lifestyle, etc." ;
    skos:definition "Articles may belong to one or more 'sections' in a magazine or newspaper, such as Sports, Lifestyle, etc." .

:artist a owl:ObjectProperty ;
    rdfs:label "artist" ;
    :domainIncludes :ComicIssue,
        :ComicStory,
        :VisualArtwork ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Person ;
    rdfs:comment """The primary artist for a work
    	in a medium other than pencils or digital line art--for example, if the
    	primary artwork is done in watercolors or digital paints.""" ;
    skos:definition """The primary artist for a work
    	in a medium other than pencils or digital line art--for example, if the
    	primary artwork is done in watercolors or digital paints.""" .

:asin a owl:DatatypeProperty ;
    rdfs:label "asin" ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2288> ;
    rdfs:comment """An Amazon Standard Identification Number (ASIN) is a 10-character alphanumeric unique identifier assigned by Amazon.com and its partners for product identification within the Amazon organization (summary from [Wikipedia](https://en.wikipedia.org/wiki/Amazon_Standard_Identification_Number)'s article).

Note also that this is a definition for how to include ASINs in Schema.org data, and not a definition of ASINs in general - see documentation from Amazon for authoritative details.
ASINs are most commonly encoded as text strings, but the [asin] property supports URL/URI as potential values too.""" ;
    rdfs:subPropertyOf :identifier ;
    skos:definition """An Amazon Standard Identification Number (ASIN) is a 10-character alphanumeric unique identifier assigned by Amazon.com and its partners for product identification within the Amazon organization (summary from [Wikipedia](https://en.wikipedia.org/wiki/Amazon_Standard_Identification_Number)'s article).

Note also that this is a definition for how to include ASINs in Schema.org data, and not a definition of ASINs in general - see documentation from Amazon for authoritative details.
ASINs are most commonly encoded as text strings, but the [asin] property supports URL/URI as potential values too.""" .

:aspect a owl:DatatypeProperty ;
    rdfs:label "aspect" ;
    :domainIncludes :MedicalWebPage ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    :supersededBy :mainContentOfPage ;
    rdfs:comment "An aspect of medical practice that is considered on the page, such as 'diagnosis', 'treatment', 'causes', 'prognosis', 'etiology', 'epidemiology', etc." ;
    skos:definition "An aspect of medical practice that is considered on the page, such as 'diagnosis', 'treatment', 'causes', 'prognosis', 'etiology', 'epidemiology', etc." .

:assembly a owl:DatatypeProperty ;
    rdfs:label "assembly" ;
    :domainIncludes :APIReference ;
    :rangeIncludes :Text ;
    :supersededBy :executableLibraryName ;
    rdfs:comment "Library file name, e.g., mscorlib.dll, system.web.dll." ;
    skos:definition "Library file name, e.g., mscorlib.dll, system.web.dll." .

:assemblyVersion a owl:DatatypeProperty ;
    rdfs:label "assemblyVersion" ;
    :domainIncludes :APIReference ;
    :rangeIncludes :Text ;
    rdfs:comment "Associated product/technology version. E.g., .NET Framework 4.5." ;
    skos:definition "Associated product/technology version. E.g., .NET Framework 4.5." .

:assesses a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "assesses" ;
    :domainIncludes :CreativeWork,
        :EducationEvent,
        :LearningResource ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2427> ;
    rdfs:comment "The item being described is intended to assess the competency or learning outcome defined by the referenced term." ;
    skos:definition "The item being described is intended to assess the competency or learning outcome defined by the referenced term." .

:associatedAnatomy a owl:ObjectProperty ;
    rdfs:label "associatedAnatomy" ;
    :domainIncludes :MedicalCondition,
        :PhysicalActivity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure,
        :AnatomicalSystem,
        :SuperficialAnatomy ;
    rdfs:comment "The anatomy of the underlying organ system or structures associated with this entity." ;
    skos:definition "The anatomy of the underlying organ system or structures associated with this entity." .

:associatedArticle a owl:ObjectProperty ;
    rdfs:label "associatedArticle" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :NewsArticle ;
    rdfs:comment "A NewsArticle associated with the Media Object." ;
    skos:definition "A NewsArticle associated with the Media Object." .

:associatedClaimReview a owl:ObjectProperty ;
    rdfs:label "associatedClaimReview" ;
    :domainIncludes :Review ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Review ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "An associated [[ClaimReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." ;
    rdfs:subPropertyOf :associatedReview ;
    skos:definition "An associated [[ClaimReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." .

:associatedDisease a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "associatedDisease" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MedicalCondition,
        :PropertyValue,
        :URL ;
    :source <http://www.bioschemas.org/BioChemEntity> ;
    rdfs:comment "Disease associated to this BioChemEntity. Such disease can be a MedicalCondition or a URL. If you want to add an evidence supporting the association, please use PropertyValue." ;
    skos:definition "Disease associated to this BioChemEntity. Such disease can be a MedicalCondition or a URL. If you want to add an evidence supporting the association, please use PropertyValue." .

:associatedMedia a owl:ObjectProperty ;
    rdfs:label "associatedMedia" ;
    :domainIncludes :CreativeWork,
        :HyperToc,
        :HyperTocEntry ;
    :rangeIncludes :MediaObject ;
    rdfs:comment "A media object that encodes this CreativeWork. This property is a synonym for encoding." ;
    skos:definition "A media object that encodes this CreativeWork. This property is a synonym for encoding." .

:associatedMediaReview a owl:ObjectProperty ;
    rdfs:label "associatedMediaReview" ;
    :domainIncludes :Review ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Review ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "An associated [[MediaReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." ;
    rdfs:subPropertyOf :associatedReview ;
    skos:definition "An associated [[MediaReview]], related by specific common content, topic or claim. The expectation is that this property would be most typically used in cases where a single activity is conducting both claim reviews and media reviews, in which case [[relatedMediaReview]] would commonly be used on a [[ClaimReview]], while [[relatedClaimReview]] would be used on [[MediaReview]]." .

:associatedPathophysiology a owl:DatatypeProperty ;
    rdfs:label "associatedPathophysiology" ;
    :domainIncludes :AnatomicalStructure,
        :AnatomicalSystem,
        :SuperficialAnatomy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "If applicable, a description of the pathophysiology associated with the anatomical system, including potential abnormal changes in the mechanical, physical, and biochemical functions of the system." ;
    skos:definition "If applicable, a description of the pathophysiology associated with the anatomical system, including potential abnormal changes in the mechanical, physical, and biochemical functions of the system." .

:athlete a owl:ObjectProperty ;
    rdfs:label "athlete" ;
    :domainIncludes :SportsTeam ;
    :rangeIncludes :Person ;
    rdfs:comment "A person that acts as performing member of a sports team; a player as opposed to a coach." ;
    skos:definition "A person that acts as performing member of a sports team; a player as opposed to a coach." .

:attendees a owl:ObjectProperty ;
    rdfs:label "attendees" ;
    :domainIncludes :Event ;
    :rangeIncludes :Organization,
        :Person ;
    :supersededBy :attendee ;
    rdfs:comment "A person attending the event." ;
    skos:definition "A person attending the event." .

:audienceType a owl:DatatypeProperty ;
    rdfs:label "audienceType" ;
    :domainIncludes :Audience ;
    :rangeIncludes :Text ;
    rdfs:comment "The target group associated with a given audience (e.g. veterans, car owners, musicians, etc.)." ;
    skos:definition "The target group associated with a given audience (e.g. veterans, car owners, musicians, etc.)." .

:audio a owl:ObjectProperty ;
    rdfs:label "audio" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :AudioObject,
        :Clip,
        :MusicRecording ;
    :source <https://github.com/schemaorg/schemaorg/issues/2420> ;
    rdfs:comment "An embedded audio object." ;
    skos:definition "An embedded audio object." .

:auditDate a owl:DatatypeProperty ;
    rdfs:label "auditDate" ;
    :domainIncludes :Certification ;
    :rangeIncludes :Date,
        :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/3230> ;
    rdfs:comment "Date when a certification was last audited. See also  [gs1:certificationAuditDate](https://www.gs1.org/voc/certificationAuditDate)." ;
    owl:equivalentProperty unece:InspectionDateTime ;
    skos:definition "Date when a certification was last audited. See also  [gs1:certificationAuditDate](https://www.gs1.org/voc/certificationAuditDate)." .

:authenticator a owl:ObjectProperty ;
    rdfs:label "authenticator" ;
    :domainIncludes :MediaSubscription ;
    :rangeIncludes :Organization ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "The Organization responsible for authenticating the user's subscription. For example, many media apps require a cable/satellite provider to authenticate your subscription before playing media." ;
    skos:definition "The Organization responsible for authenticating the user's subscription. For example, many media apps require a cable/satellite provider to authenticate your subscription before playing media." .

:author a owl:ObjectProperty ;
    rdfs:label "author" ;
    :domainIncludes :CreativeWork,
        :Rating ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The author of this content or rating. Please note that author is special in that HTML 5 provides a special mechanism for indicating authorship via the rel tag. That is equivalent to this and may be used interchangeably." ;
    skos:definition "The author of this content or rating. Please note that author is special in that HTML 5 provides a special mechanism for indicating authorship via the rel tag. That is equivalent to this and may be used interchangeably." .

:availability a owl:ObjectProperty ;
    rdfs:label "availability" ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :ItemAvailability ;
    rdfs:comment "The availability of this item&#x2014;for example In stock, Out of stock, Pre-order, etc." ;
    skos:definition "The availability of this item&#x2014;for example In stock, Out of stock, Pre-order, etc." .

:availabilityEnds a owl:DatatypeProperty ;
    rdfs:label "availabilityEnds" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :ActionAccessSpecification,
        :Demand,
        :Offer ;
    :rangeIncludes :Date,
        :DateTime,
        :Time ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "The end of the availability of the product or service included in the offer." ;
    skos:definition "The end of the availability of the product or service included in the offer." .

:availabilityStarts a owl:DatatypeProperty ;
    rdfs:label "availabilityStarts" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :ActionAccessSpecification,
        :Demand,
        :Offer ;
    :rangeIncludes :Date,
        :DateTime,
        :Time ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "The beginning of the availability of the product or service included in the offer." ;
    skos:definition "The beginning of the availability of the product or service included in the offer." .

:availableAtOrFrom a owl:ObjectProperty ;
    rdfs:label "availableAtOrFrom" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :Place ;
    rdfs:comment "The place(s) from which the offer can be obtained (e.g. store locations)." ;
    rdfs:subPropertyOf :areaServed ;
    skos:definition "The place(s) from which the offer can be obtained (e.g. store locations)." .

:availableChannel a owl:ObjectProperty ;
    rdfs:label "availableChannel" ;
    :domainIncludes :Service ;
    :rangeIncludes :ServiceChannel ;
    rdfs:comment "A means of accessing the service (e.g. a phone bank, a web site, a location, etc.)." ;
    skos:definition "A means of accessing the service (e.g. a phone bank, a web site, a location, etc.)." .

:availableDeliveryMethod a owl:ObjectProperty ;
    rdfs:label "availableDeliveryMethod" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :DeliveryMethod ;
    rdfs:comment "The delivery method(s) available for this offer." ;
    skos:definition "The delivery method(s) available for this offer." .

:availableFrom a owl:DatatypeProperty ;
    rdfs:label "availableFrom" ;
    :domainIncludes :DeliveryEvent ;
    :rangeIncludes :DateTime ;
    rdfs:comment "When the item is available for pickup from the store, locker, etc." ;
    skos:definition "When the item is available for pickup from the store, locker, etc." .

:availableIn a owl:ObjectProperty ;
    rdfs:label "availableIn" ;
    :domainIncludes :DrugStrength ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AdministrativeArea ;
    rdfs:comment "The location in which the strength is available." ;
    skos:definition "The location in which the strength is available." .

:availableLanguage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "availableLanguage" ;
    :domainIncludes :ContactPoint,
        :Course,
        :LodgingBusiness,
        :ServiceChannel,
        :TouristAttraction ;
    :rangeIncludes :Language,
        :Text ;
    rdfs:comment "A language someone may use with or at the item, service or place. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[inLanguage]]." ;
    owl:equivalentProperty gs1:availableLanguage ;
    skos:definition "A language someone may use with or at the item, service or place. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[inLanguage]]." .

:availableService a owl:ObjectProperty ;
    rdfs:label "availableService" ;
    :domainIncludes :Hospital,
        :MedicalClinic,
        :Physician ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalProcedure,
        :MedicalTest,
        :MedicalTherapy ;
    rdfs:comment "A medical service available from this provider." ;
    skos:definition "A medical service available from this provider." .

:availableStrength a owl:ObjectProperty ;
    rdfs:label "availableStrength" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DrugStrength ;
    rdfs:comment "An available dosage strength for the drug." ;
    skos:definition "An available dosage strength for the drug." .

:availableTest a owl:ObjectProperty ;
    rdfs:label "availableTest" ;
    :domainIncludes :DiagnosticLab ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalTest ;
    rdfs:comment "A diagnostic test or procedure offered by this lab." ;
    skos:definition "A diagnostic test or procedure offered by this lab." .

:availableThrough a owl:DatatypeProperty ;
    rdfs:label "availableThrough" ;
    :domainIncludes :DeliveryEvent ;
    :rangeIncludes :DateTime ;
    rdfs:comment "After this date, the item will no longer be available for pickup." ;
    skos:definition "After this date, the item will no longer be available for pickup." .

:awards a owl:DatatypeProperty ;
    rdfs:label "awards" ;
    :domainIncludes :CreativeWork,
        :Organization,
        :Person,
        :Product ;
    :rangeIncludes :Text ;
    :supersededBy :award ;
    rdfs:comment "Awards won by or for this item." ;
    skos:definition "Awards won by or for this item." .

:awayTeam a owl:ObjectProperty ;
    rdfs:label "awayTeam" ;
    :domainIncludes :SportsEvent ;
    :rangeIncludes :Person,
        :SportsTeam ;
    rdfs:comment "The away team in a sports event." ;
    rdfs:subPropertyOf :competitor ;
    skos:definition "The away team in a sports event." .

:backstory a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "backstory" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :Article ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1688> ;
    rdfs:comment "For an [[Article]], typically a [[NewsArticle]], the backstory property provides a textual summary giving a brief explanation of why and how an article was created. In a journalistic setting this could include information about reporting process, methods, interviews, data sources, etc." ;
    skos:definition "For an [[Article]], typically a [[NewsArticle]], the backstory property provides a textual summary giving a brief explanation of why and how an article was created. In a journalistic setting this could include information about reporting process, methods, interviews, data sources, etc." .

:bankAccountType a owl:DatatypeProperty ;
    rdfs:label "bankAccountType" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :BankAccount ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The type of a bank account." ;
    skos:definition "The type of a bank account." .

:baseSalary a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "baseSalary" ;
    :domainIncludes :EmployeeRole,
        :JobPosting ;
    :rangeIncludes :MonetaryAmount,
        :Number,
        :PriceSpecification ;
    rdfs:comment "The base salary of the job or of an employee in an EmployeeRole." ;
    skos:definition "The base salary of the job or of an employee in an EmployeeRole." .

:bccRecipient a owl:ObjectProperty ;
    rdfs:label "bccRecipient" ;
    :domainIncludes :Message ;
    :rangeIncludes :ContactPoint,
        :Organization,
        :Person ;
    rdfs:comment "A sub property of recipient. The recipient blind copied on a message." ;
    rdfs:subPropertyOf :recipient ;
    skos:definition "A sub property of recipient. The recipient blind copied on a message." .

:bed a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "bed" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation,
        :HotelRoom,
        :Suite ;
    :rangeIncludes :BedDetails,
        :BedType,
        :Text ;
    rdfs:comment """The type of bed or beds included in the accommodation. For the single case of just one bed of a certain type, you use bed directly with a text.
      If you want to indicate the quantity of a certain kind of bed, use an instance of BedDetails. For more detailed information, use the amenityFeature property.""" ;
    skos:definition """The type of bed or beds included in the accommodation. For the single case of just one bed of a certain type, you use bed directly with a text.
      If you want to indicate the quantity of a certain kind of bed, use an instance of BedDetails. For more detailed information, use the amenityFeature property.""" .

:beforeMedia a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "beforeMedia" ;
    :domainIncludes :HowToDirection ;
    :rangeIncludes :MediaObject,
        :URL ;
    rdfs:comment "A media object representing the circumstances before performing this direction." ;
    skos:definition "A media object representing the circumstances before performing this direction." .

:beneficiaryBank a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "beneficiaryBank" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :MoneyTransfer ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BankOrCreditUnion,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A bank or bank’s branch, financial institution or international financial institution operating the beneficiary’s bank account or releasing funds for the beneficiary." ;
    skos:definition "A bank or bank’s branch, financial institution or international financial institution operating the beneficiary’s bank account or releasing funds for the beneficiary." .

:benefits a owl:DatatypeProperty ;
    rdfs:label "benefits" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    :supersededBy :jobBenefits ;
    rdfs:comment "Description of benefits associated with the job." ;
    skos:definition "Description of benefits associated with the job." .

:benefitsSummaryUrl a owl:DatatypeProperty ;
    rdfs:label "benefitsSummaryUrl" ;
    :domainIncludes :HealthInsurancePlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1062> ;
    rdfs:comment "The URL that goes directly to the summary of benefits and coverage for the specific standard plan or plan variation." ;
    skos:definition "The URL that goes directly to the summary of benefits and coverage for the specific standard plan or plan variation." .

:bestRating a owl:DatatypeProperty ;
    rdfs:label "bestRating" ;
    :domainIncludes :Rating ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The highest value allowed in this rating system." ;
    skos:definition "The highest value allowed in this rating system." .

:billingAddress a owl:ObjectProperty ;
    rdfs:label "billingAddress" ;
    :domainIncludes :Order ;
    :rangeIncludes :PostalAddress ;
    rdfs:comment "The billing address for the order." ;
    owl:equivalentProperty unece:BillingAddress ;
    skos:definition "The billing address for the order." .

:billingDuration a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "billingDuration" ;
    :domainIncludes :UnitPriceSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Duration,
        :Number,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2689> ;
    rdfs:comment "Specifies for how long this price (or price component) will be billed. Can be used, for example, to model the contractual duration of a subscription or payment plan. Type can be either a Duration or a Number (in which case the unit of measurement, for example month, is specified by the unitCode property)." ;
    skos:definition "Specifies for how long this price (or price component) will be billed. Can be used, for example, to model the contractual duration of a subscription or payment plan. Type can be either a Duration or a Number (in which case the unit of measurement, for example month, is specified by the unitCode property)." .

:billingIncrement a owl:DatatypeProperty ;
    rdfs:label "billingIncrement" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :UnitPriceSpecification ;
    :rangeIncludes :Number ;
    rdfs:comment "This property specifies the minimal quantity and rounding increment that will be the basis for the billing. The unit of measurement is specified by the unitCode property." ;
    skos:definition "This property specifies the minimal quantity and rounding increment that will be the basis for the billing. The unit of measurement is specified by the unitCode property." .

:billingPeriod a owl:ObjectProperty ;
    rdfs:label "billingPeriod" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :Duration ;
    rdfs:comment "The time interval used to compute the invoice." ;
    owl:equivalentProperty unece:billingPeriod ;
    skos:definition "The time interval used to compute the invoice." .

:billingStart a owl:DatatypeProperty ;
    rdfs:label "billingStart" ;
    :domainIncludes :UnitPriceSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2689> ;
    rdfs:comment "Specifies after how much time this price (or price component) becomes valid and billing starts. Can be used, for example, to model a price increase after the first year of a subscription. The unit of measurement is specified by the unitCode property." ;
    skos:definition "Specifies after how much time this price (or price component) becomes valid and billing starts. Can be used, for example, to model a price increase after the first year of a subscription. The unit of measurement is specified by the unitCode property." .

:bioChemInteraction a owl:ObjectProperty ;
    rdfs:label "bioChemInteraction" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BioChemEntity ;
    :source <http://www.bioschemas.org> ;
    rdfs:comment "A BioChemEntity that is known to interact with this item." ;
    skos:definition "A BioChemEntity that is known to interact with this item." .

:bioChemSimilarity a owl:ObjectProperty ;
    rdfs:label "bioChemSimilarity" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BioChemEntity ;
    :source <http://www.bioschemas.org> ;
    rdfs:comment "A similar BioChemEntity, e.g., obtained by fingerprint similarity algorithms." ;
    skos:definition "A similar BioChemEntity, e.g., obtained by fingerprint similarity algorithms." .

:biologicalRole a owl:ObjectProperty ;
    rdfs:label "biologicalRole" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm ;
    :source <http://www.bioschemas.org> ;
    rdfs:comment "A role played by the BioChemEntity within a biological context." ;
    skos:definition "A role played by the BioChemEntity within a biological context." .

:biomechnicalClass a owl:DatatypeProperty ;
    rdfs:label "biomechnicalClass" ;
    :domainIncludes :Joint ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The biomechanical properties of the bone." ;
    skos:definition "The biomechanical properties of the bone." .

:birthDate a owl:DatatypeProperty ;
    rdfs:label "birthDate" ;
    :domainIncludes :Person ;
    :rangeIncludes :Date ;
    rdfs:comment "Date of birth." ;
    skos:definition "Date of birth." .

:birthPlace a owl:ObjectProperty ;
    rdfs:label "birthPlace" ;
    :domainIncludes :Person ;
    :rangeIncludes :Place ;
    rdfs:comment "The place where the person was born." ;
    skos:definition "The place where the person was born." .

:bitrate a owl:DatatypeProperty ;
    rdfs:label "bitrate" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :Text ;
    rdfs:comment "The bitrate of the media object." ;
    skos:definition "The bitrate of the media object." .

:blogPosts a owl:ObjectProperty ;
    rdfs:label "blogPosts" ;
    :domainIncludes :Blog ;
    :rangeIncludes :BlogPosting ;
    :supersededBy :blogPost ;
    rdfs:comment "Indicates a post that is part of a [[Blog]]. Note that historically, what we term a \"Blog\" was once known as a \"weblog\", and that what we term a \"BlogPosting\" is now often colloquially referred to as a \"blog\"." ;
    skos:definition "Indicates a post that is part of a [[Blog]]. Note that historically, what we term a \"Blog\" was once known as a \"weblog\", and that what we term a \"BlogPosting\" is now often colloquially referred to as a \"blog\"." .

:bloodSupply a owl:ObjectProperty ;
    rdfs:label "bloodSupply" ;
    :domainIncludes :Muscle ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Vessel ;
    rdfs:comment "The blood vessel that carries blood from the heart to the muscle." ;
    skos:definition "The blood vessel that carries blood from the heart to the muscle." .

:boardingGroup a owl:DatatypeProperty ;
    rdfs:label "boardingGroup" ;
    :domainIncludes :FlightReservation ;
    :rangeIncludes :Text ;
    rdfs:comment "The airline-specific indicator of boarding order / preference." ;
    skos:definition "The airline-specific indicator of boarding order / preference." .

:boardingPolicy a owl:ObjectProperty ;
    rdfs:label "boardingPolicy" ;
    :domainIncludes :Airline,
        :Flight ;
    :rangeIncludes :BoardingPolicyType ;
    rdfs:comment "The type of boarding policy used by the airline (e.g. zone-based or group-based)." ;
    skos:definition "The type of boarding policy used by the airline (e.g. zone-based or group-based)." .

:bodyLocation a owl:DatatypeProperty ;
    rdfs:label "bodyLocation" ;
    :domainIncludes :AnatomicalStructure,
        :MedicalProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Location in the body of the anatomical structure." ;
    skos:definition "Location in the body of the anatomical structure." .

:bodyType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "bodyType" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QualitativeValue,
        :Text,
        :URL ;
    rdfs:comment "Indicates the design and body style of the vehicle (e.g. station wagon, hatchback, etc.)." ;
    skos:definition "Indicates the design and body style of the vehicle (e.g. station wagon, hatchback, etc.)." .

:bookEdition a owl:DatatypeProperty ;
    rdfs:label "bookEdition" ;
    :domainIncludes :Book ;
    :rangeIncludes :Text ;
    rdfs:comment "The edition of the book." ;
    skos:definition "The edition of the book." .

:bookFormat a owl:ObjectProperty ;
    rdfs:label "bookFormat" ;
    :domainIncludes :Book ;
    :rangeIncludes :BookFormatType ;
    rdfs:comment "The format of the book." ;
    skos:definition "The format of the book." .

:bookingAgent a owl:ObjectProperty ;
    rdfs:label "bookingAgent" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :Organization,
        :Person ;
    :supersededBy :broker ;
    rdfs:comment "'bookingAgent' is an out-dated term indicating a 'broker' that serves as a booking agent." ;
    skos:definition "'bookingAgent' is an out-dated term indicating a 'broker' that serves as a booking agent." .

:bookingTime a owl:DatatypeProperty ;
    rdfs:label "bookingTime" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The date and time the reservation was booked." ;
    skos:definition "The date and time the reservation was booked." .

:borrower a owl:ObjectProperty ;
    rdfs:label "borrower" ;
    :domainIncludes :LendAction ;
    :rangeIncludes :Person ;
    rdfs:comment "A sub property of participant. The person that borrows the object being lent." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The person that borrows the object being lent." .

:box a owl:DatatypeProperty ;
    rdfs:label "box" ;
    :domainIncludes :GeoShape ;
    :rangeIncludes :Text ;
    rdfs:comment "A box is the area enclosed by the rectangle formed by two points. The first point is the lower corner, the second point is the upper corner. A box is expressed as two points separated by a space character." ;
    skos:definition "A box is the area enclosed by the rectangle formed by two points. The first point is the lower corner, the second point is the upper corner. A box is expressed as two points separated by a space character." .

:branch a owl:ObjectProperty ;
    rdfs:label "branch" ;
    :domainIncludes :Nerve ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure ;
    :supersededBy :arterialBranch ;
    rdfs:comment "The branches that delineate from the nerve bundle. Not to be confused with [[branchOf]]." ;
    skos:definition "The branches that delineate from the nerve bundle. Not to be confused with [[branchOf]]." .

:branchCode a owl:DatatypeProperty ;
    rdfs:label "branchCode" ;
    :domainIncludes :Place ;
    :rangeIncludes :Text ;
    rdfs:comment """A short textual code (also called "store code") that uniquely identifies a place of business. The code is typically assigned by the parentOrganization and used in structured URLs.\\n\\nFor example, in the URL http://www.starbucks.co.uk/store-locator/etc/detail/3047 the code "3047" is a branchCode for a particular branch.
      """ ;
    skos:definition """A short textual code (also called "store code") that uniquely identifies a place of business. The code is typically assigned by the parentOrganization and used in structured URLs.\\n\\nFor example, in the URL http://www.starbucks.co.uk/store-locator/etc/detail/3047 the code "3047" is a branchCode for a particular branch.
      """ .

:branchOf a owl:ObjectProperty ;
    rdfs:label "branchOf" ;
    :domainIncludes :LocalBusiness ;
    :rangeIncludes :Organization ;
    :supersededBy :parentOrganization ;
    rdfs:comment "The larger organization that this local business is a branch of, if any. Not to be confused with (anatomical) [[branch]]." ;
    skos:definition "The larger organization that this local business is a branch of, if any. Not to be confused with (anatomical) [[branch]]." .

:brand a owl:ObjectProperty ;
    rdfs:label "brand" ;
    :domainIncludes :Organization,
        :Person,
        :Product,
        :Service ;
    :rangeIncludes :Brand,
        :Organization ;
    rdfs:comment "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person." ;
    rdfs:subPropertyOf fibo-fnd-rel:hasDesignation ;
    owl:equivalentProperty unece:brandName ;
    skos:definition "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person." .

:breadcrumb a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "breadcrumb" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :BreadcrumbList,
        :Text ;
    rdfs:comment "A set of links that can help a user understand and navigate a website hierarchy." ;
    skos:definition "A set of links that can help a user understand and navigate a website hierarchy." .

:breastfeedingWarning a owl:DatatypeProperty ;
    rdfs:label "breastfeedingWarning" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any precaution, guidance, contraindication, etc. related to this drug's use by breastfeeding mothers." ;
    skos:definition "Any precaution, guidance, contraindication, etc. related to this drug's use by breastfeeding mothers." .

:broadcastAffiliateOf a owl:ObjectProperty ;
    rdfs:label "broadcastAffiliateOf" ;
    :domainIncludes :BroadcastService ;
    :rangeIncludes :Organization ;
    rdfs:comment "The media network(s) whose content is broadcast on this station." ;
    skos:definition "The media network(s) whose content is broadcast on this station." .

:broadcastChannelId a owl:DatatypeProperty ;
    rdfs:label "broadcastChannelId" ;
    :domainIncludes :BroadcastChannel ;
    :rangeIncludes :Text ;
    rdfs:comment "The unique address by which the BroadcastService can be identified in a provider lineup. In US, this is typically a number." ;
    skos:definition "The unique address by which the BroadcastService can be identified in a provider lineup. In US, this is typically a number." .

:broadcastDisplayName a owl:DatatypeProperty ;
    rdfs:label "broadcastDisplayName" ;
    :domainIncludes :BroadcastService ;
    :rangeIncludes :Text ;
    rdfs:comment "The name displayed in the channel guide. For many US affiliates, it is the network name." ;
    skos:definition "The name displayed in the channel guide. For many US affiliates, it is the network name." .

:broadcastFrequency a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "broadcastFrequency" ;
    :domainIncludes :BroadcastChannel,
        :BroadcastService ;
    :rangeIncludes :BroadcastFrequencySpecification,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1004> ;
    rdfs:comment "The frequency used for over-the-air broadcasts. Numeric values or simple ranges, e.g. 87-99. In addition a shortcut idiom is supported for frequencies of AM and FM radio channels, e.g. \"87 FM\"." ;
    skos:definition "The frequency used for over-the-air broadcasts. Numeric values or simple ranges, e.g. 87-99. In addition a shortcut idiom is supported for frequencies of AM and FM radio channels, e.g. \"87 FM\"." .

:broadcastFrequencyValue a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "broadcastFrequencyValue" ;
    :domainIncludes :BroadcastFrequencySpecification ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/1004> ;
    rdfs:comment "The frequency in MHz for a particular broadcast." ;
    skos:definition "The frequency in MHz for a particular broadcast." .

:broadcastOfEvent a owl:ObjectProperty ;
    rdfs:label "broadcastOfEvent" ;
    :domainIncludes :BroadcastEvent ;
    :rangeIncludes :Event ;
    rdfs:comment "The event being broadcast such as a sporting event or awards ceremony." ;
    skos:definition "The event being broadcast such as a sporting event or awards ceremony." .

:broadcastServiceTier a owl:DatatypeProperty ;
    rdfs:label "broadcastServiceTier" ;
    :domainIncludes :BroadcastChannel ;
    :rangeIncludes :Text ;
    rdfs:comment "The type of service required to have access to the channel (e.g. Standard or Premium)." ;
    skos:definition "The type of service required to have access to the channel (e.g. Standard or Premium)." .

:broadcastSignalModulation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "broadcastSignalModulation" ;
    :domainIncludes :BroadcastFrequencySpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QualitativeValue,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2111> ;
    rdfs:comment "The modulation (e.g. FM, AM, etc) used by a particular broadcast service." ;
    skos:definition "The modulation (e.g. FM, AM, etc) used by a particular broadcast service." .

:broadcastSubChannel a owl:DatatypeProperty ;
    rdfs:label "broadcastSubChannel" ;
    :domainIncludes :BroadcastFrequencySpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2111> ;
    rdfs:comment "The subchannel used for the broadcast." ;
    skos:definition "The subchannel used for the broadcast." .

:broadcastTimezone a owl:DatatypeProperty ;
    rdfs:label "broadcastTimezone" ;
    :domainIncludes :BroadcastService ;
    :rangeIncludes :Text ;
    rdfs:comment "The timezone in [ISO 8601 format](http://en.wikipedia.org/wiki/ISO_8601) for which the service bases its broadcasts." ;
    skos:definition "The timezone in [ISO 8601 format](http://en.wikipedia.org/wiki/ISO_8601) for which the service bases its broadcasts." .

:broadcaster a owl:ObjectProperty ;
    rdfs:label "broadcaster" ;
    :domainIncludes :BroadcastService ;
    :rangeIncludes :Organization ;
    rdfs:comment "The organization owning or operating the broadcast service." ;
    skos:definition "The organization owning or operating the broadcast service." .

:browserRequirements a owl:DatatypeProperty ;
    rdfs:label "browserRequirements" ;
    :domainIncludes :WebApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Specifies browser requirements in human-readable text. For example, 'requires HTML5 support'." ;
    skos:definition "Specifies browser requirements in human-readable text. For example, 'requires HTML5 support'." .

:busName a owl:DatatypeProperty ;
    rdfs:label "busName" ;
    :domainIncludes :BusTrip ;
    :rangeIncludes :Text ;
    rdfs:comment "The name of the bus (e.g. Bolt Express)." ;
    skos:definition "The name of the bus (e.g. Bolt Express)." .

:busNumber a owl:DatatypeProperty ;
    rdfs:label "busNumber" ;
    :domainIncludes :BusTrip ;
    :rangeIncludes :Text ;
    rdfs:comment "The unique identifier for the bus." ;
    skos:definition "The unique identifier for the bus." .

:businessDays a owl:ObjectProperty ;
    rdfs:label "businessDays" ;
    :domainIncludes :ServicePeriod,
        :ShippingDeliveryTime ;
    :rangeIncludes :DayOfWeek,
        :OpeningHoursSpecification ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Days of the week when the merchant typically operates, indicated via opening hours markup." ;
    skos:definition "Days of the week when the merchant typically operates, indicated via opening hours markup." .

:businessFunction a owl:ObjectProperty ;
    rdfs:label "businessFunction" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :TypeAndQuantityNode ;
    :rangeIncludes :BusinessFunction ;
    rdfs:comment "The business function (e.g. sell, lease, repair, dispose) of the offer or component of a bundle (TypeAndQuantityNode). The default is http://purl.org/goodrelations/v1#Sell." ;
    skos:definition "The business function (e.g. sell, lease, repair, dispose) of the offer or component of a bundle (TypeAndQuantityNode). The default is http://purl.org/goodrelations/v1#Sell." .

:buyer a owl:ObjectProperty ;
    rdfs:label "buyer" ;
    :domainIncludes :SellAction ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A sub property of participant. The participant/person/organization that bought the object." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The participant/person/organization that bought the object." .

:byArtist a owl:ObjectProperty ;
    rdfs:label "byArtist" ;
    :domainIncludes :MusicAlbum,
        :MusicRecording ;
    :rangeIncludes :MusicGroup,
        :Person ;
    rdfs:comment "The artist that performed this album or recording." ;
    skos:definition "The artist that performed this album or recording." .

:byDay a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "byDay" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DayOfWeek,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment "Defines the day(s) of the week on which a recurring [[Event]] takes place. May be specified using either [[DayOfWeek]], or alternatively [[Text]] conforming to iCal's syntax for byDay recurrence rules." ;
    skos:definition "Defines the day(s) of the week on which a recurring [[Event]] takes place. May be specified using either [[DayOfWeek]], or alternatively [[Text]] conforming to iCal's syntax for byDay recurrence rules." .

:byMonth a owl:DatatypeProperty ;
    rdfs:label "byMonth" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment "Defines the month(s) of the year on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-12. January is 1." ;
    skos:definition "Defines the month(s) of the year on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-12. January is 1." .

:byMonthDay a owl:DatatypeProperty ;
    rdfs:label "byMonthDay" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment "Defines the day(s) of the month on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-31." ;
    skos:definition "Defines the day(s) of the month on which a recurring [[Event]] takes place. Specified as an [[Integer]] between 1-31." .

:byMonthWeek a owl:DatatypeProperty ;
    rdfs:label "byMonthWeek" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/2599> ;
    rdfs:comment "Defines the week(s) of the month on which a recurring Event takes place. Specified as an Integer between 1-5. For clarity, byMonthWeek is best used in conjunction with byDay to indicate concepts like the first and third Mondays of a month." ;
    skos:definition "Defines the week(s) of the month on which a recurring Event takes place. Specified as an Integer between 1-5. For clarity, byMonthWeek is best used in conjunction with byDay to indicate concepts like the first and third Mondays of a month." .

:callSign a owl:DatatypeProperty ;
    rdfs:label "callSign" ;
    :domainIncludes :BroadcastService,
        :Person,
        :Vehicle ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2109> ;
    rdfs:comment "A [callsign](https://en.wikipedia.org/wiki/Call_sign), as used in broadcasting and radio communications to identify people, radio and TV stations, or vehicles." ;
    rdfs:subPropertyOf :identifier ;
    skos:definition "A [callsign](https://en.wikipedia.org/wiki/Call_sign), as used in broadcasting and radio communications to identify people, radio and TV stations, or vehicles." .

:calories a owl:ObjectProperty ;
    rdfs:label "calories" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Energy ;
    rdfs:comment "The number of calories." ;
    skos:definition "The number of calories." .

:candidate a owl:ObjectProperty ;
    rdfs:label "candidate" ;
    :domainIncludes :VoteAction ;
    :rangeIncludes :Person ;
    rdfs:comment "A sub property of object. The candidate subject of this action." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The candidate subject of this action." .

:carbohydrateContent a owl:ObjectProperty ;
    rdfs:label "carbohydrateContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of carbohydrates." ;
    skos:definition "The number of grams of carbohydrates." .

:cargoVolume a owl:ObjectProperty ;
    rdfs:label "cargoVolume" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The available volume for cargo or luggage. For automobiles, this is usually the trunk volume.\\n\\nTypical unit code(s): LTR for liters, FTQ for cubic foot/feet\\n\\nNote: You can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The available volume for cargo or luggage. For automobiles, this is usually the trunk volume.\\n\\nTypical unit code(s): LTR for liters, FTQ for cubic foot/feet\\n\\nNote: You can use [[minValue]] and [[maxValue]] to indicate ranges." .

:carrier a owl:ObjectProperty ;
    rdfs:label "carrier" ;
    :domainIncludes :Flight,
        :ParcelDelivery ;
    :rangeIncludes :Organization ;
    :supersededBy :provider ;
    rdfs:comment "'carrier' is an out-dated term indicating the 'provider' for parcel delivery and flights." ;
    skos:definition "'carrier' is an out-dated term indicating the 'provider' for parcel delivery and flights." .

:carrierRequirements a owl:DatatypeProperty ;
    rdfs:label "carrierRequirements" ;
    :domainIncludes :MobileApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Specifies specific carrier(s) requirements for the application (e.g. an application may only work on a specific carrier network)." ;
    skos:definition "Specifies specific carrier(s) requirements for the application (e.g. an application may only work on a specific carrier network)." .

:cashBack a owl:DatatypeProperty ;
    rdfs:label "cashBack" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :PaymentCard ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A cardholder benefit that pays the cardholder a small percentage of their net expenditures." ;
    skos:definition "A cardholder benefit that pays the cardholder a small percentage of their net expenditures." .

:catalog a owl:ObjectProperty ;
    rdfs:label "catalog" ;
    :domainIncludes :Dataset ;
    :rangeIncludes :DataCatalog ;
    :supersededBy :includedInDataCatalog ;
    rdfs:comment "A data catalog which contains this dataset." ;
    skos:definition "A data catalog which contains this dataset." .

:catalogNumber a owl:DatatypeProperty ;
    rdfs:label "catalogNumber" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRelease ;
    :rangeIncludes :Text ;
    rdfs:comment "The catalog number for the release." ;
    skos:definition "The catalog number for the release." .

:ccRecipient a owl:ObjectProperty ;
    rdfs:label "ccRecipient" ;
    :domainIncludes :Message ;
    :rangeIncludes :ContactPoint,
        :Organization,
        :Person ;
    rdfs:comment "A sub property of recipient. The recipient copied on a message." ;
    rdfs:subPropertyOf :recipient ;
    skos:definition "A sub property of recipient. The recipient copied on a message." .

:certificationIdentification a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "certificationIdentification" ;
    :domainIncludes :Certification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3230> ;
    rdfs:comment "Identifier of a certification instance (as registered with an independent certification body). Typically this identifier can be used to consult and verify the certification instance. See also [gs1:certificationIdentification](https://www.gs1.org/voc/certificationIdentification)." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Registration/hasRegistrationIdentifier> ;
    owl:equivalentProperty unece:CertificateIdentifier ;
    skos:definition "Identifier of a certification instance (as registered with an independent certification body). Typically this identifier can be used to consult and verify the certification instance. See also [gs1:certificationIdentification](https://www.gs1.org/voc/certificationIdentification)." .

:certificationRating a owl:ObjectProperty ;
    rdfs:label "certificationRating" ;
    :domainIncludes :Certification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Rating ;
    :source <https://github.com/schemaorg/schemaorg/issues/3230> ;
    rdfs:comment "Rating of a certification instance (as defined by an independent certification body). Typically this rating can be used to rate the level to which the requirements of the certification instance are fulfilled. See also [gs1:certificationValue](https://www.gs1.org/voc/certificationValue)." ;
    skos:definition "Rating of a certification instance (as defined by an independent certification body). Typically this rating can be used to rate the level to which the requirements of the certification instance are fulfilled. See also [gs1:certificationValue](https://www.gs1.org/voc/certificationValue)." .

:certificationStatus a owl:ObjectProperty ;
    rdfs:label "certificationStatus" ;
    :domainIncludes :Certification ;
    :rangeIncludes :CertificationStatusEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/3230> ;
    rdfs:comment "Indicates the current status of a certification: active or inactive. See also  [gs1:certificationStatus](https://www.gs1.org/voc/certificationStatus)." ;
    skos:definition "Indicates the current status of a certification: active or inactive. See also  [gs1:certificationStatus](https://www.gs1.org/voc/certificationStatus)." .

:character a owl:ObjectProperty ;
    rdfs:label "character" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Person ;
    rdfs:comment "Fictional person connected with a creative work." ;
    skos:definition "Fictional person connected with a creative work." .

:characterAttribute a owl:ObjectProperty ;
    rdfs:label "characterAttribute" ;
    :domainIncludes :Game,
        :VideoGameSeries ;
    :rangeIncludes :Thing ;
    rdfs:comment "A piece of data that represents a particular aspect of a fictional character (skill, power, character points, advantage, disadvantage)." ;
    skos:definition "A piece of data that represents a particular aspect of a fictional character (skill, power, character points, advantage, disadvantage)." .

:characterName a owl:DatatypeProperty ;
    rdfs:label "characterName" ;
    :domainIncludes :PerformanceRole ;
    :rangeIncludes :Text ;
    rdfs:comment "The name of a character played in some acting or performing role, i.e. in a PerformanceRole." ;
    skos:definition "The name of a character played in some acting or performing role, i.e. in a PerformanceRole." .

:cheatCode a owl:ObjectProperty ;
    rdfs:label "cheatCode" ;
    :domainIncludes :VideoGame,
        :VideoGameSeries ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "Cheat codes to the game." ;
    skos:definition "Cheat codes to the game." .

:checkinTime a owl:DatatypeProperty ;
    rdfs:label "checkinTime" ;
    :domainIncludes :LodgingBusiness,
        :LodgingReservation ;
    :rangeIncludes :DateTime,
        :Time ;
    rdfs:comment "The earliest someone may check into a lodging establishment." ;
    skos:definition "The earliest someone may check into a lodging establishment." .

:checkoutPageURLTemplate a owl:DatatypeProperty ;
    rdfs:label "checkoutPageURLTemplate" ;
    :domainIncludes :Offer ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3135> ;
    rdfs:comment "A URL template (RFC 6570) for a checkout page for an offer. This approach allows merchants to specify a URL for online checkout of the offered product, by interpolating parameters such as the logged in user ID, product ID, quantity, discount code etc. Parameter naming and standardization are not specified here." ;
    skos:definition "A URL template (RFC 6570) for a checkout page for an offer. This approach allows merchants to specify a URL for online checkout of the offered product, by interpolating parameters such as the logged in user ID, product ID, quantity, discount code etc. Parameter naming and standardization are not specified here." .

:checkoutTime a owl:DatatypeProperty ;
    rdfs:label "checkoutTime" ;
    :domainIncludes :LodgingBusiness,
        :LodgingReservation ;
    :rangeIncludes :DateTime,
        :Time ;
    rdfs:comment "The latest someone may check out of a lodging establishment." ;
    skos:definition "The latest someone may check out of a lodging establishment." .

:chemicalComposition a owl:DatatypeProperty ;
    rdfs:label "chemicalComposition" ;
    :domainIncludes :ChemicalSubstance ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <http://www.bioschemas.org/ChemicalSubstance> ;
    rdfs:comment "The chemical composition describes the identity and relative ratio of the chemical elements that make up the substance." ;
    skos:definition "The chemical composition describes the identity and relative ratio of the chemical elements that make up the substance." .

:chemicalRole a owl:ObjectProperty ;
    rdfs:label "chemicalRole" ;
    :domainIncludes :ChemicalSubstance,
        :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm ;
    :source <http://www.bioschemas.org/ChemicalSubstance> ;
    rdfs:comment "A role played by the BioChemEntity within a chemical context." ;
    skos:definition "A role played by the BioChemEntity within a chemical context." .

:childMaxAge a owl:DatatypeProperty ;
    rdfs:label "childMaxAge" ;
    :domainIncludes :ParentAudience ;
    :rangeIncludes :Number ;
    rdfs:comment "Maximal age of the child." ;
    skos:definition "Maximal age of the child." .

:childMinAge a owl:DatatypeProperty ;
    rdfs:label "childMinAge" ;
    :domainIncludes :ParentAudience ;
    :rangeIncludes :Number ;
    rdfs:comment "Minimal age of the child." ;
    skos:definition "Minimal age of the child." .

:children a owl:ObjectProperty ;
    rdfs:label "children" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "A child of the person." ;
    skos:definition "A child of the person." .

:cholesterolContent a owl:ObjectProperty ;
    rdfs:label "cholesterolContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of milligrams of cholesterol." ;
    skos:definition "The number of milligrams of cholesterol." .

:circle a owl:DatatypeProperty ;
    rdfs:label "circle" ;
    :domainIncludes :GeoShape ;
    :rangeIncludes :Text ;
    rdfs:comment "A circle is the circular region of a specified radius centered at a specified latitude and longitude. A circle is expressed as a pair followed by a radius in meters." ;
    skos:definition "A circle is the circular region of a specified radius centered at a specified latitude and longitude. A circle is expressed as a pair followed by a radius in meters." .

:citation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "citation" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :CreativeWork,
        :Text ;
    rdfs:comment "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc." ;
    skos:definition "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc." .

:claimInterpreter a owl:ObjectProperty ;
    rdfs:label "claimInterpreter" ;
    :domainIncludes :Claim ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "For a [[Claim]] interpreted from [[MediaObject]] content, the [[interpretedAsClaim]] property can be used to indicate a claim contained, implied or refined from the content of a [[MediaObject]]." ;
    skos:definition "For a [[Claim]] interpreted from [[MediaObject]] content, the [[interpretedAsClaim]] property can be used to indicate a claim contained, implied or refined from the content of a [[MediaObject]]." .

:claimReviewed a owl:DatatypeProperty ;
    rdfs:label "claimReviewed" ;
    :domainIncludes :ClaimReview ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1061> ;
    rdfs:comment "A short summary of the specific claims reviewed in a ClaimReview." ;
    skos:definition "A short summary of the specific claims reviewed in a ClaimReview." .

:clincalPharmacology a owl:DatatypeProperty ;
    rdfs:label "clincalPharmacology" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    :supersededBy :clinicalPharmacology ;
    rdfs:comment "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." ;
    skos:definition "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." .

:clipNumber a owl:DatatypeProperty ;
    rdfs:label "clipNumber" ;
    :domainIncludes :Clip ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "Position of the clip within an ordered group of clips." ;
    rdfs:subPropertyOf :position ;
    skos:definition "Position of the clip within an ordered group of clips." .

:closes a owl:DatatypeProperty ;
    rdfs:label "closes" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OpeningHoursSpecification ;
    :rangeIncludes :Time ;
    rdfs:comment "The closing hour of the place or service on the given day(s) of the week." ;
    skos:definition "The closing hour of the place or service on the given day(s) of the week." .

:coach a owl:ObjectProperty ;
    rdfs:label "coach" ;
    :domainIncludes :SportsTeam ;
    :rangeIncludes :Person ;
    rdfs:comment "A person that acts in a coaching role for a sports team." ;
    skos:definition "A person that acts in a coaching role for a sports team." .

:code a owl:ObjectProperty ;
    rdfs:label "code" ;
    :domainIncludes :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalCode ;
    rdfs:comment "A medical code for the entity, taken from a controlled vocabulary or ontology such as ICD-9, DiseasesDB, MeSH, SNOMED-CT, RxNorm, etc." ;
    skos:definition "A medical code for the entity, taken from a controlled vocabulary or ontology such as ICD-9, DiseasesDB, MeSH, SNOMED-CT, RxNorm, etc." .

:codeRepository a owl:DatatypeProperty ;
    rdfs:label "codeRepository" ;
    :domainIncludes :SoftwareSourceCode ;
    :rangeIncludes :URL ;
    rdfs:comment "Link to the repository where the un-compiled, human readable code and related code is located (SVN, GitHub, CodePlex)." ;
    skos:definition "Link to the repository where the un-compiled, human readable code and related code is located (SVN, GitHub, CodePlex)." .

:codeValue a owl:DatatypeProperty ;
    rdfs:label "codeValue" ;
    :domainIncludes :CategoryCode,
        :MedicalCode ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A short textual code that uniquely identifies the value." ;
    rdfs:subPropertyOf :termCode ;
    skos:definition "A short textual code that uniquely identifies the value." .

:codingSystem a owl:DatatypeProperty ;
    rdfs:label "codingSystem" ;
    :domainIncludes :MedicalCode ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The coding system, e.g. 'ICD-10'." ;
    skos:definition "The coding system, e.g. 'ICD-10'." .

:colleagues a owl:ObjectProperty ;
    rdfs:label "colleagues" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    :supersededBy :colleague ;
    rdfs:comment "A colleague of the person." ;
    skos:definition "A colleague of the person." .

:collection a owl:ObjectProperty ;
    rdfs:label "collection" ;
    :domainIncludes :UpdateAction ;
    :rangeIncludes :Thing ;
    :supersededBy :targetCollection ;
    rdfs:comment "A sub property of object. The collection target of the action." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The collection target of the action." .

:collectionSize a owl:DatatypeProperty ;
    rdfs:label "collectionSize"@en ;
    :domainIncludes :Collection ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1759> ;
    rdfs:comment "The number of items in the [[Collection]]."@en ;
    skos:definition "The number of items in the [[Collection]]."@en .

:color a owl:DatatypeProperty ;
    rdfs:label "color" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The color of the product." ;
    owl:equivalentProperty unece:colourDescription ;
    skos:definition "The color of the product." .

:colorSwatch a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "colorSwatch" ;
    :domainIncludes :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ImageObject,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/3423> ;
    rdfs:comment "A color swatch image, visualizing the color of a [[Product]]. Should match the textual description specified in the [[color]] property. This can be a URL or a fully described ImageObject." ;
    rdfs:subPropertyOf :image ;
    skos:definition "A color swatch image, visualizing the color of a [[Product]]. Should match the textual description specified in the [[color]] property. This can be a URL or a fully described ImageObject." .

:colorist a owl:ObjectProperty ;
    rdfs:label "colorist" ;
    :domainIncludes :ComicIssue,
        :ComicStory,
        :VisualArtwork ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Person ;
    rdfs:comment "The individual who adds color to inked drawings." ;
    skos:definition "The individual who adds color to inked drawings." .

:comment a owl:ObjectProperty ;
    rdfs:label "comment" ;
    :domainIncludes :CreativeWork,
        :RsvpAction ;
    :rangeIncludes :Comment ;
    rdfs:comment "Comments, typically from users." ;
    skos:definition "Comments, typically from users." .

:commentCount a owl:DatatypeProperty ;
    rdfs:label "commentCount" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of comments this CreativeWork (e.g. Article, Question or Answer) has received. This is most applicable to works published in Web sites with commenting system; additional comments may exist elsewhere." ;
    skos:definition "The number of comments this CreativeWork (e.g. Article, Question or Answer) has received. This is most applicable to works published in Web sites with commenting system; additional comments may exist elsewhere." .

:commentText a owl:DatatypeProperty ;
    rdfs:label "commentText" ;
    :domainIncludes :UserComments ;
    :rangeIncludes :Text ;
    rdfs:comment "The text of the UserComment." ;
    skos:definition "The text of the UserComment." .

:commentTime a owl:DatatypeProperty ;
    rdfs:label "commentTime" ;
    :domainIncludes :UserComments ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The time at which the UserComment was made." ;
    skos:definition "The time at which the UserComment was made." .

:companyRegistration a owl:ObjectProperty ;
    rdfs:label "companyRegistration" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Certification ;
    rdfs:comment "The official registration number of a business including the organization that issued it such as Company House or Chamber of Commerce." ;
    skos:definition "The official registration number of a business including the organization that issued it such as Company House or Chamber of Commerce." .

:competencyRequired a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "competencyRequired" ;
    :domainIncludes :EducationalOccupationalCredential,
        :LearningResource ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "Knowledge, skill, ability or personal attribute that must be demonstrated by a person or other entity in order to do something such as earn an Educational Occupational Credential or understand a LearningResource." ;
    skos:definition "Knowledge, skill, ability or personal attribute that must be demonstrated by a person or other entity in order to do something such as earn an Educational Occupational Credential or understand a LearningResource." .

:composer a owl:ObjectProperty ;
    rdfs:label "composer" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :Event,
        :MusicComposition ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The person or organization who wrote a composition, or who is the composer of a work performed at some event." ;
    skos:definition "The person or organization who wrote a composition, or who is the composer of a work performed at some event." .

:comprisedOf a owl:ObjectProperty ;
    rdfs:label "comprisedOf" ;
    :domainIncludes :AnatomicalSystem ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure,
        :AnatomicalSystem ;
    rdfs:comment "Specifying something physically contained by something else. Typically used here for the underlying anatomical structures, such as organs, that comprise the anatomical system." ;
    skos:definition "Specifying something physically contained by something else. Typically used here for the underlying anatomical structures, such as organs, that comprise the anatomical system." .

:conditionsOfAccess a owl:DatatypeProperty ;
    rdfs:label "conditionsOfAccess" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2173> ;
    rdfs:comment "Conditions that affect the availability of, or method(s) of access to, an item. Typically used for real world items such as an [[ArchiveComponent]] held by an [[ArchiveOrganization]]. This property is not suitable for use as a general Web access control mechanism. It is expressed only in natural language.\\n\\nFor example \"Available by appointment from the Reading Room\" or \"Accessible only from logged-in accounts \". " ;
    skos:definition "Conditions that affect the availability of, or method(s) of access to, an item. Typically used for real world items such as an [[ArchiveComponent]] held by an [[ArchiveOrganization]]. This property is not suitable for use as a general Web access control mechanism. It is expressed only in natural language.\\n\\nFor example \"Available by appointment from the Reading Room\" or \"Accessible only from logged-in accounts \". " .

:confirmationNumber a owl:DatatypeProperty ;
    rdfs:label "confirmationNumber" ;
    :domainIncludes :Invoice,
        :Order ;
    :rangeIncludes :Text ;
    rdfs:comment "A number that confirms the given order or payment has been received." ;
    rdfs:subPropertyOf :identifier ;
    skos:definition "A number that confirms the given order or payment has been received." .

:connectedTo a owl:ObjectProperty ;
    rdfs:label "connectedTo" ;
    :domainIncludes :AnatomicalStructure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure ;
    rdfs:comment "Other anatomical structures to which this structure is connected." ;
    skos:definition "Other anatomical structures to which this structure is connected." .

:constraintProperty a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "constraintProperty" ;
    :domainIncludes :ConstraintNode ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Property,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2291> ;
    rdfs:comment "Indicates a property used as a constraint. For example, in the definition of a [[StatisticalVariable]]. The value is a property, either from within Schema.org or from other compatible (e.g. RDF) systems such as DataCommons.org or Wikidata.org. " ;
    skos:definition "Indicates a property used as a constraint. For example, in the definition of a [[StatisticalVariable]]. The value is a property, either from within Schema.org or from other compatible (e.g. RDF) systems such as DataCommons.org or Wikidata.org. " .

:contactOption a owl:ObjectProperty ;
    rdfs:label "contactOption" ;
    :domainIncludes :ContactPoint ;
    :rangeIncludes :ContactPointOption ;
    rdfs:comment "An option available on this contact point (e.g. a toll-free number or support for hearing-impaired callers)." ;
    skos:definition "An option available on this contact point (e.g. a toll-free number or support for hearing-impaired callers)." .

:contactPoints a owl:ObjectProperty ;
    rdfs:label "contactPoints" ;
    :domainIncludes :Organization,
        :Person ;
    :rangeIncludes :ContactPoint ;
    :supersededBy :contactPoint ;
    rdfs:comment "A contact point for a person or organization." ;
    owl:equivalentProperty fibo-fnd-org:hasContactPoint ;
    skos:definition "A contact point for a person or organization." .

:contactType a owl:DatatypeProperty ;
    rdfs:label "contactType" ;
    :domainIncludes :ContactPoint ;
    :rangeIncludes :Text ;
    rdfs:comment "A person or organization can have different contact points, for different purposes. For example, a sales contact point, a PR contact point and so on. This property is used to specify the kind of contact point." ;
    owl:equivalentProperty gs1:contactType ;
    skos:definition "A person or organization can have different contact points, for different purposes. For example, a sales contact point, a PR contact point and so on. This property is used to specify the kind of contact point." .

:contactlessPayment a owl:DatatypeProperty ;
    rdfs:label "contactlessPayment" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :PaymentCard ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A secure method for consumers to purchase products or services via debit, credit or smartcards by using RFID or NFC technology." ;
    skos:definition "A secure method for consumers to purchase products or services via debit, credit or smartcards by using RFID or NFC technology." .

:containedIn a owl:ObjectProperty ;
    rdfs:label "containedIn" ;
    :domainIncludes :Place ;
    :rangeIncludes :Place ;
    :supersededBy :containedInPlace ;
    rdfs:comment "The basic containment relation between a place and one that contains it." ;
    skos:definition "The basic containment relation between a place and one that contains it." .

:contentRating a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "contentRating" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Rating,
        :Text ;
    rdfs:comment "Official rating of a piece of content&#x2014;for example, 'MPAA PG-13'." ;
    skos:definition "Official rating of a piece of content&#x2014;for example, 'MPAA PG-13'." .

:contentReferenceTime a owl:DatatypeProperty ;
    rdfs:label "contentReferenceTime" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/1050> ;
    rdfs:comment "The specific time described by a creative work, for works (e.g. articles, video objects etc.) that emphasise a particular moment within an Event." ;
    skos:definition "The specific time described by a creative work, for works (e.g. articles, video objects etc.) that emphasise a particular moment within an Event." .

:contentSize a owl:DatatypeProperty ;
    rdfs:label "contentSize" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :Text ;
    rdfs:comment "File size in (mega/kilo)bytes." ;
    skos:definition "File size in (mega/kilo)bytes." .

:contentType a owl:DatatypeProperty ;
    rdfs:label "contentType" ;
    :domainIncludes :EntryPoint ;
    :rangeIncludes :Text ;
    rdfs:comment "The supported content type(s) for an EntryPoint response." ;
    skos:definition "The supported content type(s) for an EntryPoint response." .

:contentUrl a owl:DatatypeProperty ;
    rdfs:label "contentUrl" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :URL ;
    rdfs:comment "Actual bytes of the media object, for example the image file or video file." ;
    skos:definition "Actual bytes of the media object, for example the image file or video file." .

:contraindication a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "contraindication" ;
    :domainIncludes :MedicalDevice,
        :MedicalTherapy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalContraindication,
        :Text ;
    rdfs:comment "A contraindication for this therapy." ;
    skos:definition "A contraindication for this therapy." .

:contributor a owl:ObjectProperty ;
    rdfs:label "contributor" ;
    :domainIncludes :CreativeWork,
        :Event ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A secondary contributor to the CreativeWork or Event." ;
    skos:definition "A secondary contributor to the CreativeWork or Event." .

:cookTime a owl:ObjectProperty ;
    rdfs:label "cookTime" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :Duration ;
    rdfs:comment "The time it takes to actually cook the dish, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    rdfs:subPropertyOf :performTime ;
    skos:definition "The time it takes to actually cook the dish, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

:cookingMethod a owl:DatatypeProperty ;
    rdfs:label "cookingMethod" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :Text ;
    rdfs:comment "The method of cooking, such as Frying, Steaming, ..." ;
    skos:definition "The method of cooking, such as Frying, Steaming, ..." .

:copyrightHolder a owl:ObjectProperty ;
    rdfs:label "copyrightHolder" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The party holding the legal copyright to the CreativeWork." ;
    skos:definition "The party holding the legal copyright to the CreativeWork." .

:copyrightNotice a owl:DatatypeProperty ;
    rdfs:label "copyrightNotice" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2659> ;
    rdfs:comment "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work." ;
    skos:definition "Text of a notice appropriate for describing the copyright aspects of this Creative Work, ideally indicating the owner of the copyright for the Work." .

:copyrightYear a owl:DatatypeProperty ;
    rdfs:label "copyrightYear" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Number ;
    rdfs:comment "The year during which the claimed copyright for the CreativeWork was first asserted." ;
    skos:definition "The year during which the claimed copyright for the CreativeWork was first asserted." .

:correction a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "correction" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CorrectionComment,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1950> ;
    rdfs:comment "Indicates a correction to a [[CreativeWork]], either via a [[CorrectionComment]], textually or in another document." ;
    skos:definition "Indicates a correction to a [[CreativeWork]], either via a [[CorrectionComment]], textually or in another document." .

:correctionsPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "correctionsPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For an [[Organization]] (e.g. [[NewsMediaOrganization]]), a statement describing (in news media, the newsroom’s) disclosure and correction policy for errors." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For an [[Organization]] (e.g. [[NewsMediaOrganization]]), a statement describing (in news media, the newsroom’s) disclosure and correction policy for errors." .

:costCategory a owl:ObjectProperty ;
    rdfs:label "costCategory" ;
    :domainIncludes :DrugCost ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DrugCostCategory ;
    rdfs:comment "The category of cost, such as wholesale, retail, reimbursement cap, etc." ;
    skos:definition "The category of cost, such as wholesale, retail, reimbursement cap, etc." .

:costCurrency a owl:DatatypeProperty ;
    rdfs:label "costCurrency" ;
    :domainIncludes :DrugCost ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The currency (in 3-letter) of the drug cost. See: http://en.wikipedia.org/wiki/ISO_4217. " ;
    skos:definition "The currency (in 3-letter) of the drug cost. See: http://en.wikipedia.org/wiki/ISO_4217. " .

:costOrigin a owl:DatatypeProperty ;
    rdfs:label "costOrigin" ;
    :domainIncludes :DrugCost ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Additional details to capture the origin of the cost data. For example, 'Medicare Part B'." ;
    skos:definition "Additional details to capture the origin of the cost data. For example, 'Medicare Part B'." .

:costPerUnit a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "costPerUnit" ;
    :domainIncludes :DrugCost ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Number,
        :QualitativeValue,
        :Text ;
    rdfs:comment "The cost per unit of the drug." ;
    skos:definition "The cost per unit of the drug." .

:countriesNotSupported a owl:DatatypeProperty ;
    rdfs:label "countriesNotSupported" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Countries for which the application is not supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." ;
    skos:definition "Countries for which the application is not supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." .

:countriesSupported a owl:DatatypeProperty ;
    rdfs:label "countriesSupported" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Countries for which the application is supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." ;
    skos:definition "Countries for which the application is supported. You can also provide the two-letter ISO 3166-1 alpha-2 country code." .

:countryOfAssembly a owl:DatatypeProperty ;
    rdfs:label "countryOfAssembly" ;
    :domainIncludes :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/991> ;
    rdfs:comment "The place where the product was assembled." ;
    owl:equivalentProperty unece:finalAssemblyCountry ;
    skos:definition "The place where the product was assembled." .

:countryOfLastProcessing a owl:DatatypeProperty ;
    rdfs:label "countryOfLastProcessing" ;
    :domainIncludes :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/991> ;
    rdfs:comment "The place where the item (typically [[Product]]) was last processed and tested before importation." ;
    owl:equivalentProperty unece:ProcessingCountry ;
    skos:definition "The place where the item (typically [[Product]]) was last processed and tested before importation." .

:countryOfOrigin a owl:ObjectProperty ;
    rdfs:label "countryOfOrigin" ;
    :domainIncludes :CreativeWork,
        :Movie,
        :Product,
        :TVEpisode,
        :TVSeason,
        :TVSeries ;
    :rangeIncludes :Country ;
    rdfs:comment """The country of origin of something, including products as well as creative  works such as movie and TV content.

In the case of TV and movie, this would be the country of the principle offices of the production company or individual responsible for the movie. For other kinds of [[CreativeWork]] it is difficult to provide fully general guidance, and properties such as [[contentLocation]] and [[locationCreated]] may be more applicable.

In the case of products, the country of origin of the product. The exact interpretation of this may vary by context and product type, and cannot be fully enumerated here.""" ;
    owl:equivalentProperty unece:originCountry ;
    skos:definition """The country of origin of something, including products as well as creative  works such as movie and TV content.

In the case of TV and movie, this would be the country of the principle offices of the production company or individual responsible for the movie. For other kinds of [[CreativeWork]] it is difficult to provide fully general guidance, and properties such as [[contentLocation]] and [[locationCreated]] may be more applicable.

In the case of products, the country of origin of the product. The exact interpretation of this may vary by context and product type, and cannot be fully enumerated here.""" .

:course a owl:ObjectProperty ;
    rdfs:label "course" ;
    :domainIncludes :ExerciseAction ;
    :rangeIncludes :Place ;
    :supersededBy :exerciseCourse ;
    rdfs:comment "A sub property of location. The course where this action was taken." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The course where this action was taken." .

:courseCode a owl:DatatypeProperty ;
    rdfs:label "courseCode" ;
    :domainIncludes :Course ;
    :rangeIncludes :Text ;
    rdfs:comment "The identifier for the [[Course]] used by the course [[provider]] (e.g. CS101 or 6.001)." ;
    skos:definition "The identifier for the [[Course]] used by the course [[provider]] (e.g. CS101 or 6.001)." .

:courseMode a owl:DatatypeProperty ;
    rdfs:label "courseMode" ;
    :domainIncludes :CourseInstance ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "The medium or means of delivery of the course instance or the mode of study, either as a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or as a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous)." ;
    skos:definition "The medium or means of delivery of the course instance or the mode of study, either as a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or as a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous)." .

:coursePrerequisites a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "coursePrerequisites" ;
    :domainIncludes :Course ;
    :rangeIncludes :AlignmentObject,
        :Course,
        :Text ;
    rdfs:comment "Requirements for taking the Course. May be completion of another [[Course]] or a textual description like \"permission of instructor\". Requirements may be a pre-requisite competency, referenced using [[AlignmentObject]]." ;
    skos:definition "Requirements for taking the Course. May be completion of another [[Course]] or a textual description like \"permission of instructor\". Requirements may be a pre-requisite competency, referenced using [[AlignmentObject]]." .

:courseSchedule a owl:ObjectProperty ;
    rdfs:label "courseSchedule" ;
    :domainIncludes :CourseInstance ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Schedule ;
    :source <https://github.com/schemaorg/schemaorg/issues/3281> ;
    rdfs:comment "Represents the length and pace of a course, expressed as a [[Schedule]]." ;
    skos:definition "Represents the length and pace of a course, expressed as a [[Schedule]]." .

:courseWorkload a owl:DatatypeProperty ;
    rdfs:label "courseWorkload" ;
    :domainIncludes :CourseInstance ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1909> ;
    rdfs:comment "The amount of work expected of students taking the course, often provided as a figure per week or per month, and may be broken down by type. For example, \"2 hours of lectures, 1 hour of lab work and 3 hours of independent study per week\"." ;
    skos:definition "The amount of work expected of students taking the course, often provided as a figure per week or per month, and may be broken down by type. For example, \"2 hours of lectures, 1 hour of lab work and 3 hours of independent study per week\"." .

:coverageEndTime a owl:DatatypeProperty ;
    rdfs:label "coverageEndTime" ;
    :domainIncludes :LiveBlogPosting ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The time when the live blog will stop covering the Event. Note that coverage may continue after the Event concludes." ;
    skos:definition "The time when the live blog will stop covering the Event. Note that coverage may continue after the Event concludes." .

:coverageStartTime a owl:DatatypeProperty ;
    rdfs:label "coverageStartTime" ;
    :domainIncludes :LiveBlogPosting ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The time when the live blog will begin covering the Event. Note that coverage may begin before the Event's start time. The LiveBlogPosting may also be created before coverage begins." ;
    skos:definition "The time when the live blog will begin covering the Event. Note that coverage may begin before the Event's start time. The LiveBlogPosting may also be created before coverage begins." .

:creativeWorkStatus a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "creativeWorkStatus" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/987> ;
    rdfs:comment "The status of a creative work in terms of its stage in a lifecycle. Example terms include Incomplete, Draft, Published, Obsolete. Some organizations define a set of terms for the stages of their publication lifecycle." ;
    skos:definition "The status of a creative work in terms of its stage in a lifecycle. Example terms include Incomplete, Draft, Published, Obsolete. Some organizations define a set of terms for the stages of their publication lifecycle." .

:credentialCategory a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "credentialCategory" ;
    :domainIncludes :EducationalOccupationalCredential ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "The category or type of credential being described, for example \"degree”, “certificate”, “badge”, or more specific term." ;
    skos:definition "The category or type of credential being described, for example \"degree”, “certificate”, “badge”, or more specific term." .

:creditText a owl:DatatypeProperty ;
    rdfs:label "creditText" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2659> ;
    rdfs:comment "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work." ;
    skos:definition "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work." .

:creditedTo a owl:ObjectProperty ;
    rdfs:label "creditedTo" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRelease ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The group the release is credited to if different than the byArtist. For example, Red and Blue is credited to \"Stefani Germanotta Band\", but by Lady Gaga." ;
    skos:definition "The group the release is credited to if different than the byArtist. For example, Red and Blue is credited to \"Stefani Germanotta Band\", but by Lady Gaga." .

:cssSelector a owl:DatatypeProperty ;
    rdfs:label "cssSelector" ;
    :domainIncludes :SpeakableSpecification,
        :WebPageElement ;
    :rangeIncludes :CssSelectorType ;
    :source <https://github.com/schemaorg/schemaorg/issues/1389> ;
    rdfs:comment "A CSS selector, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." ;
    skos:definition "A CSS selector, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." .

:currenciesAccepted a owl:DatatypeProperty ;
    rdfs:label "currenciesAccepted" ;
    :domainIncludes :LocalBusiness ;
    :rangeIncludes :Text ;
    rdfs:comment "The currency accepted.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." ;
    skos:definition "The currency accepted.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." .

:currency a owl:DatatypeProperty ;
    rdfs:label "currency" ;
    :domainIncludes :DatedMoneySpecification,
        :ExchangeRateSpecification,
        :LoanOrCredit,
        :MonetaryAmount,
        :MonetaryAmountDistribution ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The currency in which the monetary amount is expressed.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." ;
    owl:equivalentProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> ;
    skos:definition "The currency in which the monetary amount is expressed.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." .

