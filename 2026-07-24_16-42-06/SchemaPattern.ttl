:Airline a owl:Class ;
    rdfs:label "Airline" ;
    rdfs:comment "An organization that provides flights for passengers." ;
    rdfs:subClassOf :Organization ;
    skos:definition "An organization that provides flights for passengers." .

:Apartment a owl:Class ;
    rdfs:label "Apartment" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment "An apartment (in American English) or flat (in British English) is a self-contained housing unit (a type of residential real estate) that occupies only part of a building (source: Wikipedia, the free encyclopedia, see <a href=\"http://en.wikipedia.org/wiki/Apartment\">http://en.wikipedia.org/wiki/Apartment</a>)." ;
    rdfs:subClassOf :Accommodation ;
    skos:definition "An apartment (in American English) or flat (in British English) is a self-contained housing unit (a type of residential real estate) that occupies only part of a building (source: Wikipedia, the free encyclopedia, see <a href=\"http://en.wikipedia.org/wiki/Apartment\">http://en.wikipedia.org/wiki/Apartment</a>)." .

:ArchiveOrganization a owl:Class ;
    rdfs:label "ArchiveOrganization"@en ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1758> ;
    rdfs:comment "An organization with archival holdings. An organization which keeps and preserves archival material and typically makes it accessible to the public."@en ;
    rdfs:subClassOf :LocalBusiness ;
    skos:definition "An organization with archival holdings. An organization which keeps and preserves archival material and typically makes it accessible to the public."@en .

:Artery a owl:Class ;
    rdfs:label "Artery" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A type of blood vessel that specifically carries blood away from the heart." ;
    rdfs:subClassOf :Vessel ;
    owl:equivalentClass snomed:51114001 ;
    skos:definition "A type of blood vessel that specifically carries blood away from the heart." .

:Audiobook a owl:Class ;
    rdfs:label "Audiobook" ;
    :isPartOf <http://bib.schema.org> ;
    rdfs:comment "An audiobook." ;
    rdfs:subClassOf :AudioObject,
        :Book ;
    skos:definition "An audiobook." .

:BedType a owl:Class ;
    rdfs:label "BedType" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1262> ;
    rdfs:comment "A type of bed. This is used for indicating the bed or beds available in an accommodation." ;
    rdfs:subClassOf :QualitativeValue ;
    skos:definition "A type of bed. This is used for indicating the bed or beds available in an accommodation." .

:BoatTerminal a owl:Class ;
    rdfs:label "BoatTerminal" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1755> ;
    rdfs:comment "A terminal for boats, ships, and other water vessels." ;
    rdfs:subClassOf :CivicStructure ;
    skos:definition "A terminal for boats, ships, and other water vessels." .

:BoatTrip a owl:Class ;
    rdfs:label "BoatTrip" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1755> ;
    rdfs:comment "A trip on a commercial ferry line." ;
    rdfs:subClassOf :Trip ;
    skos:definition "A trip on a commercial ferry line." .

:BusOrCoach a owl:Class ;
    rdfs:label "BusOrCoach" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :isPartOf <http://auto.schema.org> ;
    rdfs:comment "A bus (also omnibus or autobus) is a road vehicle designed to carry passengers. Coaches are luxury buses, usually in service for long distance travel." ;
    rdfs:subClassOf :Vehicle ;
    skos:definition "A bus (also omnibus or autobus) is a road vehicle designed to carry passengers. Coaches are luxury buses, usually in service for long distance travel." .

:BusStation a owl:Class ;
    rdfs:label "BusStation" ;
    rdfs:comment "A bus station." ;
    rdfs:subClassOf :CivicStructure ;
    skos:definition "A bus station." .

:BusStop a owl:Class ;
    rdfs:label "BusStop" ;
    rdfs:comment "A bus stop." ;
    rdfs:subClassOf :CivicStructure ;
    skos:definition "A bus stop." .

:Car a owl:Class ;
    rdfs:label "Car" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    rdfs:comment "A car is a wheeled, self-powered motor vehicle used for transportation." ;
    rdfs:subClassOf :Vehicle ;
    skos:definition "A car is a wheeled, self-powered motor vehicle used for transportation." .

:CategoryCodeSet a owl:Class ;
    rdfs:label "CategoryCodeSet" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A set of Category Code values." ;
    rdfs:subClassOf :DefinedTermSet ;
    skos:definition "A set of Category Code values." .

:Collection a owl:Class ;
    rdfs:label "Collection" ;
    :isPartOf <http://bib.schema.org> ;
    rdfs:comment "A collection of items, e.g. creative works or products." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A collection of items, e.g. creative works or products." .

:CompoundPriceSpecification a owl:Class ;
    rdfs:label "CompoundPriceSpecification" ;
    :contributor <https://blog.schema.org/2012/11/08/good-relations-and-schema-org/> ;
    rdfs:comment "A compound price specification is one that bundles multiple prices that all apply in combination for different dimensions of consumption. Use the name property of the attached unit price specification for indicating the dimension of a price component (e.g. \"electricity\" or \"final cleaning\")." ;
    rdfs:subClassOf :PriceSpecification ;
    skos:definition "A compound price specification is one that bundles multiple prices that all apply in combination for different dimensions of consumption. Use the name property of the attached unit price specification for indicating the dimension of a price component (e.g. \"electricity\" or \"final cleaning\")." .

:DrugLegalStatus a owl:Class ;
    rdfs:label "DrugLegalStatus" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "The legal availability status of a medical drug." ;
    rdfs:subClassOf :MedicalIntangible ;
    skos:definition "The legal availability status of a medical drug." .

:EmployeeRole a owl:Class ;
    rdfs:label "EmployeeRole" ;
    rdfs:comment "A subclass of OrganizationRole used to describe employee relationships." ;
    rdfs:subClassOf :OrganizationRole ;
    skos:definition "A subclass of OrganizationRole used to describe employee relationships." .

:Energy a owl:Class ;
    rdfs:label "Energy" ;
    rdfs:comment "Properties that take Energy as values are of the form '&lt;Number&gt; &lt;Energy unit of measure&gt;'." ;
    rdfs:subClassOf :Quantity ;
    skos:definition "Properties that take Energy as values are of the form '&lt;Number&gt; &lt;Energy unit of measure&gt;'." .

:GeoCircle a owl:Class ;
    rdfs:label "GeoCircle" ;
    rdfs:comment """A GeoCircle is a GeoShape representing a circular geographic area. As it is a GeoShape
          it provides the simple textual property 'circle', but also allows the combination of postalCode alongside geoRadius.
          The center of the circle can be indicated via the 'geoMidpoint' property, or more approximately using 'address', 'postalCode'.
       """ ;
    rdfs:subClassOf :GeoShape ;
    skos:definition """A GeoCircle is a GeoShape representing a circular geographic area. As it is a GeoShape
          it provides the simple textual property 'circle', but also allows the combination of postalCode alongside geoRadius.
          The center of the circle can be indicated via the 'geoMidpoint' property, or more approximately using 'address', 'postalCode'.
       """ .

:Guide a owl:Class ;
    rdfs:label "Guide" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2405> ;
    rdfs:comment "[[Guide]] is a page or article that recommends specific products or services, or aspects of a thing for a user to consider. A [[Guide]] may represent a Buying Guide and detail aspects of products or services for a user to consider. A [[Guide]] may represent a Product Guide and recommend specific products or services. A [[Guide]] may represent a Ranked List and recommend specific products or services with ranking." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "[[Guide]] is a page or article that recommends specific products or services, or aspects of a thing for a user to consider. A [[Guide]] may represent a Buying Guide and detail aspects of products or services for a user to consider. A [[Guide]] may represent a Product Guide and recommend specific products or services. A [[Guide]] may represent a Ranked List and recommend specific products or services with ranking." .

:HotelRoom a owl:Class ;
    rdfs:label "HotelRoom" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment """A hotel room is a single room in a hotel.
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" ;
    rdfs:subClassOf :Room ;
    skos:definition """A hotel room is a single room in a hotel.
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" .

:House a owl:Class ;
    rdfs:label "House" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment "A house is a building or structure that has the ability to be occupied for habitation by humans or other creatures (source: Wikipedia, the free encyclopedia, see <a href=\"http://en.wikipedia.org/wiki/House\">http://en.wikipedia.org/wiki/House</a>)." ;
    rdfs:subClassOf :Accommodation ;
    skos:definition "A house is a building or structure that has the ability to be occupied for habitation by humans or other creatures (source: Wikipedia, the free encyclopedia, see <a href=\"http://en.wikipedia.org/wiki/House\">http://en.wikipedia.org/wiki/House</a>)." .

:HowToSection a owl:Class ;
    rdfs:label "HowToSection" ;
    rdfs:comment "A sub-grouping of steps in the instructions for how to achieve a result (e.g. steps for making a pie crust within a pie recipe)." ;
    rdfs:subClassOf :CreativeWork,
        :ItemList,
        :ListItem ;
    skos:definition "A sub-grouping of steps in the instructions for how to achieve a result (e.g. steps for making a pie crust within a pie recipe)." .

:HowToSupply a owl:Class ;
    rdfs:label "HowToSupply" ;
    rdfs:comment "A supply consumed when performing the instructions for how to achieve a result." ;
    rdfs:subClassOf :HowToItem ;
    skos:definition "A supply consumed when performing the instructions for how to achieve a result." .

:HyperToc a owl:Class ;
    rdfs:label "HyperToc" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2766> ;
    rdfs:comment "A HyperToc represents a hypertext table of contents for complex media objects, such as [[VideoObject]], [[AudioObject]]. Items in the table of contents are indicated using the [[tocEntry]] property, and typed [[HyperTocEntry]]. For cases where the same larger work is split into multiple files, [[associatedMedia]] can be used on individual [[HyperTocEntry]] items." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A HyperToc represents a hypertext table of contents for complex media objects, such as [[VideoObject]], [[AudioObject]]. Items in the table of contents are indicated using the [[tocEntry]] property, and typed [[HyperTocEntry]]. For cases where the same larger work is split into multiple files, [[associatedMedia]] can be used on individual [[HyperTocEntry]] items." .

:LegalService a owl:Class ;
    rdfs:label "LegalService" ;
    rdfs:comment "A LegalService is a business that provides legally-oriented services, advice and representation, e.g. law firms.\\n\\nAs a [[LocalBusiness]] it can be described as a [[provider]] of one or more [[Service]]\\(s)." ;
    rdfs:subClassOf :LocalBusiness ;
    skos:definition "A LegalService is a business that provides legally-oriented services, advice and representation, e.g. law firms.\\n\\nAs a [[LocalBusiness]] it can be described as a [[provider]] of one or more [[Service]]\\(s)." .

:LinkRole a owl:Class ;
    rdfs:label "LinkRole" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1045> ;
    rdfs:comment "A Role that represents a Web link, e.g. as expressed via the 'url' property. Its linkRelationship property can indicate URL-based and plain textual link types, e.g. those in IANA link registry or others such as 'amphtml'. This structure provides a placeholder where details from HTML's link element can be represented outside of HTML, e.g. in JSON-LD feeds." ;
    rdfs:subClassOf :Role ;
    skos:definition "A Role that represents a Web link, e.g. as expressed via the 'url' property. Its linkRelationship property can indicate URL-based and plain textual link types, e.g. those in IANA link registry or others such as 'amphtml'. This structure provides a placeholder where details from HTML's link element can be represented outside of HTML, e.g. in JSON-LD feeds." .

:Map a owl:Class ;
    rdfs:label "Map" ;
    rdfs:comment "A map." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A map." .

:MediaGallery a owl:Class ;
    rdfs:label "MediaGallery" ;
    rdfs:comment "Web page type: Media gallery page. A mixed-media page that can contain media such as images, videos, and other multimedia." ;
    rdfs:subClassOf :CollectionPage ;
    skos:definition "Web page type: Media gallery page. A mixed-media page that can contain media such as images, videos, and other multimedia." .

:MedicalAudience a owl:Class ;
    rdfs:label "MedicalAudience" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Target audiences for medical web pages." ;
    rdfs:subClassOf :Audience,
        :PeopleAudience ;
    skos:definition "Target audiences for medical web pages." .

:MedicalCause a owl:Class ;
    rdfs:label "MedicalCause" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "The causative agent(s) that are responsible for the pathophysiologic process that eventually results in a medical condition, symptom or sign. In this schema, unless otherwise specified this is meant to be the proximate cause of the medical condition, symptom or sign. The proximate cause is defined as the causative agent that most directly results in the medical condition, symptom or sign. For example, the HIV virus could be considered a cause of AIDS. Or in a diagnostic context, if a patient fell and sustained a hip fracture and two days later sustained a pulmonary embolism which eventuated in a cardiac arrest, the cause of the cardiac arrest (the proximate cause) would be the pulmonary embolism and not the fall. Medical causes can include cardiovascular, chemical, dermatologic, endocrine, environmental, gastroenterologic, genetic, hematologic, gynecologic, iatrogenic, infectious, musculoskeletal, neurologic, nutritional, obstetric, oncologic, otolaryngologic, pharmacologic, psychiatric, pulmonary, renal, rheumatologic, toxic, traumatic, or urologic causes; medical conditions can be causes as well." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "The causative agent(s) that are responsible for the pathophysiologic process that eventually results in a medical condition, symptom or sign. In this schema, unless otherwise specified this is meant to be the proximate cause of the medical condition, symptom or sign. The proximate cause is defined as the causative agent that most directly results in the medical condition, symptom or sign. For example, the HIV virus could be considered a cause of AIDS. Or in a diagnostic context, if a patient fell and sustained a hip fracture and two days later sustained a pulmonary embolism which eventuated in a cardiac arrest, the cause of the cardiac arrest (the proximate cause) would be the pulmonary embolism and not the fall. Medical causes can include cardiovascular, chemical, dermatologic, endocrine, environmental, gastroenterologic, genetic, hematologic, gynecologic, iatrogenic, infectious, musculoskeletal, neurologic, nutritional, obstetric, oncologic, otolaryngologic, pharmacologic, psychiatric, pulmonary, renal, rheumatologic, toxic, traumatic, or urologic causes; medical conditions can be causes as well." .

:MedicalDevicePurpose a owl:Class ;
    rdfs:label "MedicalDevicePurpose" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Categories of medical devices, organized by the purpose or intended use of the device." ;
    rdfs:subClassOf :MedicalEnumeration ;
    skos:definition "Categories of medical devices, organized by the purpose or intended use of the device." .

:MedicalWebPage a owl:Class ;
    rdfs:label "MedicalWebPage" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A web page that provides medical information." ;
    rdfs:subClassOf :WebPage ;
    skos:definition "A web page that provides medical information." .

:MonetaryGrant a owl:Class ;
    rdfs:label "MonetaryGrant" ;
    :isPartOf <http://pending.schema.org> ;
    :source <http://schema.org/docs/collab/FundInfoCollab>,
        <https://github.com/schemaorg/schemaorg/issues/383> ;
    rdfs:comment "A monetary grant." ;
    rdfs:subClassOf :Grant ;
    skos:definition "A monetary grant." .

:MoneyTransfer a owl:Class ;
    rdfs:label "MoneyTransfer" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The act of transferring money from one place to another place. This may occur electronically or physically." ;
    rdfs:subClassOf :TransferAction ;
    skos:definition "The act of transferring money from one place to another place. This may occur electronically or physically." .

:MortgageLoan a owl:Class ;
    rdfs:label "MortgageLoan" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A loan in which property or real estate is used as collateral. (A loan securitized against some real estate.)" ;
    rdfs:subClassOf :LoanOrCredit ;
    skos:definition "A loan in which property or real estate is used as collateral. (A loan securitized against some real estate.)" .

:NLNonprofitType a owl:Class ;
    rdfs:label "NLNonprofitType" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2543> ;
    rdfs:comment "NLNonprofitType: Non-profit organization type originating from the Netherlands." ;
    rdfs:subClassOf :NonprofitType ;
    skos:definition "NLNonprofitType: Non-profit organization type originating from the Netherlands." .

:OccupationalExperienceRequirements a owl:Class ;
    rdfs:label "OccupationalExperienceRequirements" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2681> ;
    rdfs:comment "Indicates employment-related experience requirements, e.g. [[monthsOfExperience]]." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "Indicates employment-related experience requirements, e.g. [[monthsOfExperience]]." .

:OnlineMarketplace a owl:Class ;
    rdfs:label "OnlineMarketplace" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/4470> ;
    rdfs:comment "An eCommerce marketplace." ;
    rdfs:subClassOf :OnlineStore ;
    skos:definition "An eCommerce marketplace." .

:OrganizationRole a owl:Class ;
    rdfs:label "OrganizationRole" ;
    rdfs:comment "A subclass of Role used to describe roles within organizations." ;
    rdfs:subClassOf :Role ;
    skos:definition "A subclass of Role used to describe roles within organizations." .

:ParentAudience a owl:Class ;
    rdfs:label "ParentAudience" ;
    rdfs:comment "A set of characteristics describing parents, who can be interested in viewing some content." ;
    rdfs:subClassOf :PeopleAudience ;
    skos:definition "A set of characteristics describing parents, who can be interested in viewing some content." .

:PaymentChargeSpecification a owl:Class ;
    rdfs:label "PaymentChargeSpecification" ;
    :contributor <https://blog.schema.org/2012/11/08/good-relations-and-schema-org/> ;
    rdfs:comment "The costs of settling the payment using a particular payment method." ;
    rdfs:subClassOf :PriceSpecification ;
    skos:definition "The costs of settling the payment using a particular payment method." .

:Periodical a owl:Class ;
    rdfs:label "Periodical" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    rdfs:comment "A publication in any medium issued in successive parts bearing numerical or chronological designations and intended to continue indefinitely, such as a magazine, scholarly journal, or newspaper.\\n\\nSee also [blog post](https://blog.schema.org/2014/09/02/schema-org-support-for-bibliographic-relationships-and-periodicals/)." ;
    rdfs:subClassOf :CreativeWorkSeries ;
    owl:equivalentClass bibo:Periodical ;
    skos:definition "A publication in any medium issued in successive parts bearing numerical or chronological designations and intended to continue indefinitely, such as a magazine, scholarly journal, or newspaper.\\n\\nSee also [blog post](https://blog.schema.org/2014/09/02/schema-org-support-for-bibliographic-relationships-and-periodicals/)." .

:Photograph a owl:Class ;
    rdfs:label "Photograph" ;
    rdfs:comment "A photograph." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A photograph." .

:PodcastSeries a owl:Class ;
    rdfs:label "PodcastSeries" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/373> ;
    rdfs:comment "A podcast is an episodic series of digital audio or video files which a user can download and listen to." ;
    rdfs:subClassOf :CreativeWorkSeries ;
    skos:definition "A podcast is an episodic series of digital audio or video files which a user can download and listen to." .

:Project a owl:Class ;
    rdfs:label "Project" ;
    :isPartOf <http://pending.schema.org> ;
    :source <http://schema.org/docs/collab/FundInfoCollab>,
        <https://github.com/schemaorg/schemaorg/issues/383> ;
    rdfs:comment """An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.
Use properties from [[Organization]], [[subOrganization]]/[[parentOrganization]] to indicate project sub-structures. 
   """ ;
    rdfs:subClassOf :Organization ;
    skos:definition """An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.
Use properties from [[Organization]], [[subOrganization]]/[[parentOrganization]] to indicate project sub-structures. 
   """ .

:RadioChannel a owl:Class ;
    rdfs:label "RadioChannel" ;
    rdfs:comment "A unique instance of a radio BroadcastService on a CableOrSatelliteService lineup." ;
    rdfs:subClassOf :BroadcastChannel ;
    skos:definition "A unique instance of a radio BroadcastService on a CableOrSatelliteService lineup." .

:RealEstateListing a owl:Class ;
    rdfs:label "RealEstateListing" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2348> ;
    rdfs:comment """A [[RealEstateListing]] is a listing that describes one or more real-estate [[Offer]]s (whose [[businessFunction]] is typically to lease out, or to sell).
  The [[RealEstateListing]] type itself represents the overall listing, as manifested in some [[WebPage]].
  """ ;
    rdfs:subClassOf :WebPage ;
    skos:definition """A [[RealEstateListing]] is a listing that describes one or more real-estate [[Offer]]s (whose [[businessFunction]] is typically to lease out, or to sell).
  The [[RealEstateListing]] type itself represents the overall listing, as manifested in some [[WebPage]].
  """ .

:ReceiveAction a owl:Class ;
    rdfs:label "ReceiveAction" ;
    rdfs:comment "The act of physically/electronically taking delivery of an object that has been transferred from an origin to a destination. Reciprocal of SendAction.\\n\\nRelated actions:\\n\\n* [[SendAction]]: The reciprocal of ReceiveAction.\\n* [[TakeAction]]: Unlike TakeAction, ReceiveAction does not imply that the ownership has been transferred (e.g. I can receive a package, but it does not mean the package is now mine)." ;
    rdfs:subClassOf :TransferAction ;
    skos:definition "The act of physically/electronically taking delivery of an object that has been transferred from an origin to a destination. Reciprocal of SendAction.\\n\\nRelated actions:\\n\\n* [[SendAction]]: The reciprocal of ReceiveAction.\\n* [[TakeAction]]: Unlike TakeAction, ReceiveAction does not imply that the ownership has been transferred (e.g. I can receive a package, but it does not mean the package is now mine)." .

:RentAction a owl:Class ;
    rdfs:label "RentAction" ;
    rdfs:comment "The act of giving money in return for temporary use, but not ownership, of an object such as a vehicle or property. For example, an agent rents a property from a landlord in exchange for a periodic payment." ;
    rdfs:subClassOf :TradeAction ;
    skos:definition "The act of giving money in return for temporary use, but not ownership, of an object such as a vehicle or property. For example, an agent rents a property from a landlord in exchange for a periodic payment." .

:ReplaceAction a owl:Class ;
    rdfs:label "ReplaceAction" ;
    rdfs:comment "The act of editing a recipient by replacing an old object with a new object." ;
    rdfs:subClassOf :UpdateAction ;
    skos:definition "The act of editing a recipient by replacing an old object with a new object." .

:Room a owl:Class ;
    rdfs:label "Room" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment """A room is a distinguishable space within a structure, usually separated from other spaces by interior walls (source: Wikipedia, the free encyclopedia, see <a href="http://en.wikipedia.org/wiki/Room">http://en.wikipedia.org/wiki/Room</a>).
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" ;
    rdfs:subClassOf :Accommodation ;
    skos:definition """A room is a distinguishable space within a structure, usually separated from other spaces by interior walls (source: Wikipedia, the free encyclopedia, see <a href="http://en.wikipedia.org/wiki/Room">http://en.wikipedia.org/wiki/Room</a>).
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" .

:SellAction a owl:Class ;
    rdfs:label "SellAction" ;
    rdfs:comment "The act of taking money from a buyer in exchange for goods or services rendered. An agent sells an object, product, or service to a buyer for a price. Reciprocal of BuyAction." ;
    rdfs:subClassOf :TradeAction ;
    skos:definition "The act of taking money from a buyer in exchange for goods or services rendered. An agent sells an object, product, or service to a buyer for a price. Reciprocal of BuyAction." .

:SendAction a owl:Class ;
    rdfs:label "SendAction" ;
    rdfs:comment "The act of physically/electronically dispatching an object for transfer from an origin to a destination. Related actions:\\n\\n* [[ReceiveAction]]: The reciprocal of SendAction.\\n* [[GiveAction]]: Unlike GiveAction, SendAction does not imply the transfer of ownership (e.g. I can send you my laptop, but I'm not necessarily giving it to you)." ;
    rdfs:subClassOf :TransferAction ;
    skos:definition "The act of physically/electronically dispatching an object for transfer from an origin to a destination. Related actions:\\n\\n* [[ReceiveAction]]: The reciprocal of SendAction.\\n* [[GiveAction]]: Unlike GiveAction, SendAction does not imply the transfer of ownership (e.g. I can send you my laptop, but I'm not necessarily giving it to you)." .

:Series a owl:Class ;
    rdfs:label "Series" ;
    rdfs:comment "A Series in schema.org is a group of related items, typically but not necessarily of the same kind. See also [[CreativeWorkSeries]], [[EventSeries]]." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "A Series in schema.org is a group of related items, typically but not necessarily of the same kind. See also [[CreativeWorkSeries]], [[EventSeries]]." .

:SingleFamilyResidence a owl:Class ;
    rdfs:label "SingleFamilyResidence" ;
    rdfs:comment "Residence type: Single-family home." ;
    rdfs:subClassOf :House ;
    skos:definition "Residence type: Single-family home." .

:SizeGroupEnumeration a owl:Class ;
    rdfs:label "SizeGroupEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "Enumerates common size groups for various product categories." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerates common size groups for various product categories." .

:SolveMathAction a owl:Class ;
    rdfs:label "SolveMathAction" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2740> ;
    rdfs:comment "The action that takes in a math expression and directs users to a page potentially capable of solving/simplifying that expression." ;
    rdfs:subClassOf :Action ;
    skos:definition "The action that takes in a math expression and directs users to a page potentially capable of solving/simplifying that expression." .

:Specialty a owl:Class ;
    rdfs:label "Specialty" ;
    rdfs:comment "Any branch of a field in which people typically develop specific expertise, usually after significant study, time, and effort." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Any branch of a field in which people typically develop specific expertise, usually after significant study, time, and effort." .

:SportsOrganization a owl:Class ;
    rdfs:label "SportsOrganization" ;
    rdfs:comment "Represents the collection of all sports organizations, including sports teams, governing bodies, and sports associations." ;
    rdfs:subClassOf :Organization ;
    skos:definition "Represents the collection of all sports organizations, including sports teams, governing bodies, and sports associations." .

:TouristDestination a owl:Class ;
    rdfs:label "TouristDestination" ;
    :contributor <http://schema.org/docs/collab/IIT-CNR.it>,
        <http://schema.org/docs/collab/Tourism> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1810> ;
    rdfs:comment """A tourist destination. In principle any [[Place]] can be a [[TouristDestination]] from a [[City]], Region or [[Country]] to an [[AmusementPark]] or [[Hotel]]. This Type can be used on its own to describe a general [[TouristDestination]], or be used as an [[additionalType]] to add tourist relevant properties to any other [[Place]].  A [[TouristDestination]] is defined as a [[Place]] that contains, or is colocated with, one or more [[TouristAttraction]]s, often linked by a similar theme or interest to a particular [[touristType]]. The [UNWTO](http://www2.unwto.org/) defines Destination (main destination of a tourism trip) as the place visited that is central to the decision to take the trip.
  (See examples below.)""" ;
    rdfs:subClassOf :Place ;
    skos:definition """A tourist destination. In principle any [[Place]] can be a [[TouristDestination]] from a [[City]], Region or [[Country]] to an [[AmusementPark]] or [[Hotel]]. This Type can be used on its own to describe a general [[TouristDestination]], or be used as an [[additionalType]] to add tourist relevant properties to any other [[Place]].  A [[TouristDestination]] is defined as a [[Place]] that contains, or is colocated with, one or more [[TouristAttraction]]s, often linked by a similar theme or interest to a particular [[touristType]]. The [UNWTO](http://www2.unwto.org/) defines Destination (main destination of a tourism trip) as the place visited that is central to the decision to take the trip.
  (See examples below.)""" .

:TrainStation a owl:Class ;
    rdfs:label "TrainStation" ;
    rdfs:comment "A train station." ;
    rdfs:subClassOf :CivicStructure ;
    skos:definition "A train station." .

:WebSite a owl:Class ;
    rdfs:label "WebSite" ;
    rdfs:comment "A WebSite is a set of related web pages and other items typically served from a single web domain and accessible via URLs." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A WebSite is a set of related web pages and other items typically served from a single web domain and accessible via URLs." .

:WorkBasedProgram a owl:Class ;
    rdfs:label "WorkBasedProgram" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "A program with both an educational and employment component. Typically based at a workplace and structured around work-based learning, with the aim of instilling competencies related to an occupation. WorkBasedProgram is used to distinguish programs such as apprenticeships from school, college or other classroom based educational programs." ;
    rdfs:subClassOf :EducationalOccupationalProgram ;
    skos:definition "A program with both an educational and employment component. Typically based at a workplace and structured around work-based learning, with the aim of instilling competencies related to an occupation. WorkBasedProgram is used to distinguish programs such as apprenticeships from school, college or other classroom based educational programs." .

:WriteAction a owl:Class ;
    rdfs:label "WriteAction" ;
    rdfs:comment "The act of authoring written creative content." ;
    rdfs:subClassOf :CreateAction ;
    skos:definition "The act of authoring written creative content." .

:about a owl:ObjectProperty ;
    rdfs:label "about" ;
    :domainIncludes :Certification,
        :CommunicateAction,
        :CreativeWork,
        :DefinedTerm,
        :DefinedTermSet,
        :Event ;
    :inverseOf :subjectOf ;
    :rangeIncludes :Thing ;
    :source <https://github.com/schemaorg/schemaorg/issues/1670>,
        <https://github.com/schemaorg/schemaorg/issues/4588> ;
    rdfs:comment "The subject matter of an object." ;
    skos:definition "The subject matter of an object." .

:actor a owl:ObjectProperty ;
    rdfs:label "actor" ;
    :domainIncludes :Clip,
        :CreativeWorkSeason,
        :Episode,
        :Event,
        :Movie,
        :MovieSeries,
        :PodcastSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGame,
        :VideoGameSeries,
        :VideoObject ;
    :rangeIncludes :PerformingGroup,
        :Person ;
    rdfs:comment "An actor (individual or a group), e.g. in TV, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip." ;
    skos:definition "An actor (individual or a group), e.g. in TV, radio, movie, video games etc., or in an event. Actors can be associated with individual items or with a series, episode, clip." .

:associatedReview a owl:ObjectProperty ;
    rdfs:label "associatedReview" ;
    :domainIncludes :Review ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Review ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "An associated [[Review]]." ;
    skos:definition "An associated [[Review]]." .

:competitor a owl:ObjectProperty ;
    rdfs:label "competitor" ;
    :domainIncludes :SportsEvent ;
    :rangeIncludes :Person,
        :SportsTeam ;
    rdfs:comment "A competitor in a sports event." ;
    skos:definition "A competitor in a sports event." .

:containedInPlace a owl:ObjectProperty ;
    rdfs:label "containedInPlace" ;
    :domainIncludes :Place ;
    :inverseOf :containsPlace ;
    :rangeIncludes :Place ;
    rdfs:comment "The basic containment relation between a place and one that contains it." ;
    skos:definition "The basic containment relation between a place and one that contains it." .

:encoding a owl:ObjectProperty ;
    rdfs:label "encoding" ;
    :domainIncludes :CreativeWork ;
    :inverseOf :encodesCreativeWork ;
    :rangeIncludes :MediaObject ;
    rdfs:comment "A media object that encodes this CreativeWork. This property is a synonym for associatedMedia." ;
    skos:definition "A media object that encodes this CreativeWork. This property is a synonym for associatedMedia." .

:hasMap a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "hasMap" ;
    :domainIncludes :Place ;
    :rangeIncludes :Map,
        :URL ;
    rdfs:comment "A URL to a map of the place." ;
    skos:definition "A URL to a map of the place." .

:legislationApplies a owl:ObjectProperty ;
    rdfs:label "legislationApplies" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Indicates that this legislation (or part of a legislation) somehow transfers another legislation in a different legislative context. This is an informative link, and it has no legal value. For legally-binding links of transposition, use the <a href=\"/legislationTransposes\">legislationTransposes</a> property. For example an informative consolidated law of a European Union's member state \"applies\" the consolidated version of the European Directive implemented in it." ;
    owl:equivalentProperty eli:implements ;
    skos:definition "Indicates that this legislation (or part of a legislation) somehow transfers another legislation in a different legislative context. This is an informative link, and it has no legal value. For legally-binding links of transposition, use the <a href=\"/legislationTransposes\">legislationTransposes</a> property. For example an informative consolidated law of a European Union's member state \"applies\" the consolidated version of the European Directive implemented in it." ;
    skos:exactMatch eli:implements .

:material a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "material" ;
    :domainIncludes :CreativeWork,
        :Product ;
    :rangeIncludes :Product,
        :Text,
        :URL ;
    rdfs:comment "A material that something is made from, e.g. leather, wool, cotton, paper." ;
    skos:definition "A material that something is made from, e.g. leather, wool, cotton, paper." .

:memberOf a owl:ObjectProperty ;
    rdfs:label "memberOf" ;
    :domainIncludes :Organization,
        :Person ;
    :inverseOf :member ;
    :rangeIncludes :MemberProgramTier,
        :Organization,
        :ProgramMembership ;
    rdfs:comment "An Organization (or ProgramMembership) to which this Person or Organization belongs." ;
    skos:definition "An Organization (or ProgramMembership) to which this Person or Organization belongs." .

:parentOrganization a owl:ObjectProperty ;
    rdfs:label "parentOrganization" ;
    :domainIncludes :Organization ;
    :inverseOf :subOrganization ;
    :rangeIncludes :Organization ;
    rdfs:comment "The larger organization that this organization is a [[subOrganization]] of, if any." ;
    owl:equivalentProperty gs1:parentOrganization ;
    skos:definition "The larger organization that this organization is a [[subOrganization]] of, if any." .

:result a owl:ObjectProperty ;
    rdfs:label "result" ;
    :domainIncludes :Action ;
    :rangeIncludes :Thing ;
    rdfs:comment "The result produced in the action. E.g. John wrote *a book*." ;
    skos:definition "The result produced in the action. E.g. John wrote *a book*." .

:seller a owl:ObjectProperty ;
    rdfs:label "seller" ;
    :domainIncludes :BuyAction,
        :Demand,
        :Flight,
        :Offer,
        :Order ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "An entity which offers (sells / leases / lends / loans) the services / goods.  A seller may also be a provider." ;
    rdfs:subPropertyOf :participant,
        fibo-fnd-pas:hasSupplier ;
    owl:equivalentProperty unece:Seller ;
    skos:definition "An entity which offers (sells / leases / lends / loans) the services / goods.  A seller may also be a provider." .

:spatialCoverage a owl:ObjectProperty ;
    rdfs:label "spatialCoverage" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Place ;
    rdfs:comment """The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content. It is a subproperty of
      contentLocation intended primarily for more technical and detailed materials. For example with a Dataset, it indicates
      areas that the dataset describes: a dataset of New York weather would have spatialCoverage which was the place: the state of New York.""" ;
    rdfs:subPropertyOf :contentLocation ;
    owl:equivalentProperty dcterms:spatial ;
    skos:definition """The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content. It is a subproperty of
      contentLocation intended primarily for more technical and detailed materials. For example with a Dataset, it indicates
      areas that the dataset describes: a dataset of New York weather would have spatialCoverage which was the place: the state of New York.""" .

:step a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "step" ;
    :domainIncludes :HowTo ;
    :rangeIncludes :CreativeWork,
        :HowToSection,
        :HowToStep,
        :Text ;
    rdfs:comment "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection." ;
    skos:definition "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection." .

:subEvent a owl:ObjectProperty ;
    rdfs:label "subEvent" ;
    :domainIncludes :Event ;
    :inverseOf :superEvent ;
    :rangeIncludes :Event ;
    rdfs:comment "An Event that is part of this event. For example, a conference event includes many presentations, each of which is a subEvent of the conference." ;
    skos:definition "An Event that is part of this event. For example, a conference event includes many presentations, each of which is a subEvent of the conference." .

:supply a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "supply" ;
    :domainIncludes :HowTo,
        :HowToDirection ;
    :rangeIncludes :HowToSupply,
        :Text ;
    rdfs:comment "A sub-property of instrument. A supply consumed when performing instructions or a direction." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub-property of instrument. A supply consumed when performing instructions or a direction." .

:workFeatured a owl:ObjectProperty ;
    rdfs:label "workFeatured" ;
    :domainIncludes :Event ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment """A work featured in some event, e.g. exhibited in an ExhibitionEvent.
       Specific subproperties are available for workPerformed (e.g. a play), or a workPresented (a Movie at a ScreeningEvent).""" ;
    skos:definition """A work featured in some event, e.g. exhibited in an ExhibitionEvent.
       Specific subproperties are available for workPerformed (e.g. a play), or a workPresented (a Movie at a ScreeningEvent).""" .

unece:PaymentDueDate a owl:ObjectProperty .

rdfs:Class a owl:Class .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> a owl:ObjectProperty .

fibo-fnd-doc:LegalDocument a owl:Class .

fibo-fnd-doc:isReferencedIn a owl:ObjectProperty .

fibo-fnd-pas:hasProduct a owl:ObjectProperty .

cmns-cls:Classifier a owl:Class .

