    rdfs:subClassOf :BlogPosting ;
    skos:definition "A [[LiveBlogPosting]] is a [[BlogPosting]] intended to provide a rolling textual coverage of an ongoing event through continuous updates." .

:LymphaticVessel a owl:Class ;
    rdfs:label "LymphaticVessel" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A type of blood vessel that specifically carries lymph fluid unidirectionally toward the heart." ;
    rdfs:subClassOf :Vessel ;
    skos:definition "A type of blood vessel that specifically carries lymph fluid unidirectionally toward the heart." .

:MeasurementMethodEnum a owl:Class ;
    rdfs:label "MeasurementMethodEnum" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2564> ;
    rdfs:comment "Enumeration(s) for use with [[measurementMethod]]." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumeration(s) for use with [[measurementMethod]]." .

:MeasurementTypeEnumeration a owl:Class ;
    rdfs:label "MeasurementTypeEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "Enumeration of common measurement types (or dimensions), for example \"chest\" for a person, \"inseam\" for pants, \"gauge\" for screws, or \"wheel\" for bicycles." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumeration of common measurement types (or dimensions), for example \"chest\" for a person, \"inseam\" for pants, \"gauge\" for screws, or \"wheel\" for bicycles." .

:MediaReview a owl:Class ;
    rdfs:label "MediaReview" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment """A [[MediaReview]] is a more specialized form of Review dedicated to the evaluation of media content online, typically in the context of fact-checking and misinformation.
    For more general reviews of media in the broader sense, use [[UserReview]], [[CriticReview]] or other [[Review]] types. This definition is
    a work in progress. While the [[MediaManipulationRatingEnumeration]] list reflects significant community review amongst fact-checkers and others working
    to combat misinformation, the specific structures for representing media objects, their versions and publication context, are still evolving. Similarly, best practices for the relationship between [[MediaReview]] and [[ClaimReview]] markup have not yet been finalized.""" ;
    rdfs:subClassOf :Review ;
    skos:definition """A [[MediaReview]] is a more specialized form of Review dedicated to the evaluation of media content online, typically in the context of fact-checking and misinformation.
    For more general reviews of media in the broader sense, use [[UserReview]], [[CriticReview]] or other [[Review]] types. This definition is
    a work in progress. While the [[MediaManipulationRatingEnumeration]] list reflects significant community review amongst fact-checkers and others working
    to combat misinformation, the specific structures for representing media objects, their versions and publication context, are still evolving. Similarly, best practices for the relationship between [[MediaReview]] and [[ClaimReview]] markup have not yet been finalized.""" .

:MediaSubscription a owl:Class ;
    rdfs:label "MediaSubscription" ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "A subscription which allows a user to access media including audio, video, books, etc." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "A subscription which allows a user to access media including audio, video, books, etc." .

:MedicalAudienceType a owl:Class ;
    rdfs:label "MedicalAudienceType" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Target audiences types for medical web pages. Enumerated type." ;
    rdfs:subClassOf :MedicalEnumeration ;
    skos:definition "Target audiences types for medical web pages. Enumerated type." .

:MedicalClinic a owl:Class ;
    rdfs:label "MedicalClinic" ;
    :isPartOf <http://health-lifesci.schema.org> ;
