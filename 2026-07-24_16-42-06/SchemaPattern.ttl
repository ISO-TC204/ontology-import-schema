    skos:definition "The quantity of the given bed type available in the HotelRoom, Suite, House, or Apartment." .

:numberOfCredits a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "numberOfCredits" ;
    :domainIncludes :Course,
        :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
