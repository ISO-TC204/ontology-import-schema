    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The options subject to this action." .

:album a owl:ObjectProperty ;
    rdfs:label "album" ;
    :domainIncludes :MusicGroup ;
    :rangeIncludes :MusicAlbum ;
    rdfs:comment "A music album." ;
    skos:definition "A music album." .

:albumRelease a owl:ObjectProperty ;
    rdfs:label "albumRelease" ;
    :domainIncludes :MusicAlbum ;
    :inverseOf :releaseOf ;
    :rangeIncludes :MusicRelease ;
    rdfs:comment "A release of this album." ;
    skos:definition "A release of this album." .

:alternateName a owl:DatatypeProperty ;
    rdfs:label "alternateName" ;
    :domainIncludes :Thing ;
    :rangeIncludes :Text ;
    rdfs:comment "An alias for the item." ;
    skos:definition "An alias for the item." .

:alumni a owl:ObjectProperty ;
