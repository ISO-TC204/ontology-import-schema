    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    rdfs:comment "A value indicating a steering position." ;
    rdfs:subClassOf :QualitativeValue ;
    skos:definition "A value indicating a steering position." .

:Suite a owl:Class ;
    rdfs:label "Suite" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment """A suite in a hotel or other public accommodation, denotes a class of luxury accommodations, the key feature of which is multiple rooms (source: Wikipedia, the free encyclopedia, see <a href="http://en.wikipedia.org/wiki/Suite_(hotel)">http://en.wikipedia.org/wiki/Suite_(hotel)</a>).
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" ;
    rdfs:subClassOf :Accommodation ;
    skos:definition """A suite in a hotel or other public accommodation, denotes a class of luxury accommodations, the key feature of which is multiple rooms (source: Wikipedia, the free encyclopedia, see <a href="http://en.wikipedia.org/wiki/Suite_(hotel)">http://en.wikipedia.org/wiki/Suite_(hotel)</a>).
<br /><br />
See also the <a href="/docs/hotels.html">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.
""" .

:TVSeason a owl:Class ;
    rdfs:label "TVSeason" ;
    rdfs:comment "Season dedicated to TV broadcast and associated online delivery." ;
    rdfs:subClassOf :CreativeWork,
        :CreativeWorkSeason ;
    skos:definition "Season dedicated to TV broadcast and associated online delivery." .

:TaxiReservation a owl:Class ;
    rdfs:label "TaxiReservation" ;
    rdfs:comment "A reservation for a taxi.\\n\\nNote: This type is for information about actual reservations, e.g. in confirmation emails or HTML pages with individual confirmations of reservations. For offers of tickets, use [[Offer]]." ;
    rdfs:subClassOf :Reservation ;
    skos:definition "A reservation for a taxi.\\n\\nNote: This type is for information about actual reservations, e.g. in confirmation emails or HTML pages with individual confirmations of reservations. For offers of tickets, use [[Offer]]." .

:TechArticle a owl:Class ;
    rdfs:label "TechArticle" ;
    rdfs:comment "A technical article - Example: How-to (task) topics, step-by-step, procedural troubleshooting, specifications, etc." ;
    rdfs:subClassOf :Article ;
    skos:definition "A technical article - Example: How-to (task) topics, step-by-step, procedural troubleshooting, specifications, etc." .

:TouristAttraction a owl:Class ;
    rdfs:label "TouristAttraction" ;
    :contributor <http://schema.org/docs/collab/IIT-CNR.it>,
        <http://schema.org/docs/collab/Tourism> ;
    rdfs:comment "A tourist attraction.  In principle any Thing can be a [[TouristAttraction]], from a [[Mountain]] and [[LandmarksOrHistoricalBuildings]] to a [[LocalBusiness]].  This Type can be used on its own to describe a general [[TouristAttraction]], or be used as an [[additionalType]] to add tourist attraction properties to any other type.  (See examples below)" ;
    rdfs:subClassOf :Place ;
    skos:definition "A tourist attraction.  In principle any Thing can be a [[TouristAttraction]], from a [[Mountain]] and [[LandmarksOrHistoricalBuildings]] to a [[LocalBusiness]].  This Type can be used on its own to describe a general [[TouristAttraction]], or be used as an [[additionalType]] to add tourist attraction properties to any other type.  (See examples below)" .

:Vein a owl:Class ;
    rdfs:label "Vein" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A type of blood vessel that specifically carries blood to the heart." ;
    rdfs:subClassOf :Vessel ;
    skos:definition "A type of blood vessel that specifically carries blood to the heart." .

:areaServed a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "areaServed" ;
    :domainIncludes :ContactPoint,
        :DeliveryChargeSpecification,
        :Demand,
        :FinancialIncentive,
        :Offer,
        :Organization,
        :Service ;
    :rangeIncludes :AdministrativeArea,
        :GeoShape,
        :Place,
        :Text ;
    rdfs:comment "The geographic area where a service or offered item is provided." ;
    owl:equivalentProperty fibo-fnd-pas:hasServiceArea ;
    skos:definition "The geographic area where a service or offered item is provided." .

:duration a owl:ObjectProperty ;
    rdfs:label "duration" ;
    :domainIncludes :Audiobook,
        :Episode,
        :Event,
        :MediaObject,
        :Movie,
        :MusicRecording,
        :MusicRelease,
        :QuantitativeValueDistribution,
        :Schedule,
        :ServicePeriod ;
    :rangeIncludes :Duration,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457>,
        <https://github.com/schemaorg/schemaorg/issues/1698>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The duration of the item (movie, audio recording, event, etc.) in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    skos:definition "The duration of the item (movie, audio recording, event, etc.) in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

:includedInDataCatalog a owl:ObjectProperty ;
    rdfs:label "includedInDataCatalog" ;
    :domainIncludes :Dataset ;
    :inverseOf :dataset ;
    :rangeIncludes :DataCatalog ;
    rdfs:comment "A data catalog which contains this dataset." ;
    skos:definition "A data catalog which contains this dataset." .

:legislationChanges a owl:ObjectProperty ;
    rdfs:label "legislationChanges" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Another legislation that this legislation changes. This encompasses the notions of amendment, replacement, correction, repeal, or other types of change. This may be a direct change (textual or non-textual amendment) or a consequential or indirect change. The property is to be used to express the existence of a change relationship between two acts rather than the existence of a consolidated version of the text that shows the result of the change. For consolidation relationships, use the <a href=\"/legislationConsolidates\">legislationConsolidates</a> property." ;
    owl:equivalentProperty eli:changes ;
    skos:definition "Another legislation that this legislation changes. This encompasses the notions of amendment, replacement, correction, repeal, or other types of change. This may be a direct change (textual or non-textual amendment) or a consequential or indirect change. The property is to be used to express the existence of a change relationship between two acts rather than the existence of a consolidated version of the text that shows the result of the change. For consolidation relationships, use the <a href=\"/legislationConsolidates\">legislationConsolidates</a> property." ;
    skos:exactMatch eli:changes .

:member a owl:ObjectProperty ;
    rdfs:label "member" ;
    :domainIncludes :Organization,
        :ProgramMembership ;
    :inverseOf :memberOf ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals." ;
    owl:equivalentProperty fibo-fnd-org:hasMember ;
    skos:definition "A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals." .

:recipient a owl:ObjectProperty ;
    rdfs:label "recipient" ;
    :domainIncludes :AuthorizeAction,
        :CommunicateAction,
        :DonateAction,
        :GiveAction,
        :Message,
        :PayAction,
        :ReturnAction,
        :SendAction,
        :TipAction ;
    :rangeIncludes :Audience,
        :ContactPoint,
        :Organization,
        :Person ;
    rdfs:comment "A sub property of participant. The participant who is at the receiving end of the action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The participant who is at the receiving end of the action." .

:workExample a owl:ObjectProperty ;
    rdfs:label "workExample" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :CreativeWork ;
    :inverseOf :exampleOfWork ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "Example/instance/realization/derivation of the concept of this creative work. E.g. the paperback edition, first edition, or e-book." ;
    skos:definition "Example/instance/realization/derivation of the concept of this creative work. E.g. the paperback edition, first edition, or e-book." .

:Airport a owl:Class ;
    rdfs:label "Airport" ;
    rdfs:comment "An airport." ;
    rdfs:subClassOf :CivicStructure ;
    skos:definition "An airport." .

:AllocateAction a owl:Class ;
    rdfs:label "AllocateAction" ;
    rdfs:comment "The act of organizing tasks/objects/events by associating resources to it." ;
    rdfs:subClassOf :OrganizeAction ;
    skos:definition "The act of organizing tasks/objects/events by associating resources to it." .

:Answer a owl:Class ;
    rdfs:label "Answer" ;
    :contributor <http://schema.org/docs/collab/QAStackExchange> ;
    rdfs:comment "An answer offered to a question; perhaps correct, perhaps opinionated or wrong." ;
    rdfs:subClassOf :Comment ;
    skos:definition "An answer offered to a question; perhaps correct, perhaps opinionated or wrong." .

:AssessAction a owl:Class ;
    rdfs:label "AssessAction" ;
    rdfs:comment "The act of forming one's opinion, reaction or sentiment." ;
    rdfs:subClassOf :Action ;
    skos:definition "The act of forming one's opinion, reaction or sentiment." .

:BankAccount a owl:Class ;
    rdfs:label "BankAccount" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    rdfs:comment "A product or service offered by a bank whereby one may deposit, withdraw or transfer money and in some cases be paid interest." ;
    rdfs:subClassOf :FinancialProduct ;
    owl:equivalentClass fibo-fbc:BankAccount ;
    skos:definition "A product or service offered by a bank whereby one may deposit, withdraw or transfer money and in some cases be paid interest." .

:BlogPosting a owl:Class ;
    rdfs:label "BlogPosting" ;
    rdfs:comment "A blog post." ;
    rdfs:subClassOf :SocialMediaPosting ;
    skos:definition "A blog post." .

:BroadcastEvent a owl:Class ;
    rdfs:label "BroadcastEvent" ;
    rdfs:comment "An over the air or online broadcast event." ;
    rdfs:subClassOf :PublicationEvent ;
    skos:definition "An over the air or online broadcast event." .

:BroadcastFrequencySpecification a owl:Class ;
    rdfs:label "BroadcastFrequencySpecification" ;
    :source <https://github.com/schemaorg/schemaorg/issues/1004> ;
    rdfs:comment "The frequency in MHz and the modulation used for a particular BroadcastService." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "The frequency in MHz and the modulation used for a particular BroadcastService." .

:BusTrip a owl:Class ;
    rdfs:label "BusTrip" ;
    rdfs:comment "A trip on a commercial bus line." ;
    rdfs:subClassOf :Trip ;
    skos:definition "A trip on a commercial bus line." .

:CarUsageType a owl:Class ;
    rdfs:label "CarUsageType" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :isPartOf <http://auto.schema.org> ;
    rdfs:comment "A value indicating a special usage of a car, e.g. commercial rental, driving school, or as a taxi." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "A value indicating a special usage of a car, e.g. commercial rental, driving school, or as a taxi." .

:Claim a owl:Class ;
    rdfs:label "Claim" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1828> ;
    rdfs:comment """A [[Claim]] in Schema.org represents a specific, factually-oriented claim that could be the [[itemReviewed]] in a [[ClaimReview]]. The content of a claim can be summarized with the [[text]] property. Variations on well known claims can have their common identity indicated via [[sameAs]] links, and summarized with a [[name]]. Ideally, a [[Claim]] description includes enough contextual information to minimize the risk of ambiguity or inclarity. In practice, many claims are better understood in the context in which they appear or the interpretations provided by claim reviews.

  Beyond [[ClaimReview]], the Claim type can be associated with related creative works - for example a [[ScholarlyArticle]] or [[Question]] might be [[about]] some [[Claim]].

  At this time, Schema.org does not define any types of relationship between claims. This is a natural area for future exploration.
  """ ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition """A [[Claim]] in Schema.org represents a specific, factually-oriented claim that could be the [[itemReviewed]] in a [[ClaimReview]]. The content of a claim can be summarized with the [[text]] property. Variations on well known claims can have their common identity indicated via [[sameAs]] links, and summarized with a [[name]]. Ideally, a [[Claim]] description includes enough contextual information to minimize the risk of ambiguity or inclarity. In practice, many claims are better understood in the context in which they appear or the interpretations provided by claim reviews.

  Beyond [[ClaimReview]], the Claim type can be associated with related creative works - for example a [[ScholarlyArticle]] or [[Question]] might be [[about]] some [[Claim]].

  At this time, Schema.org does not define any types of relationship between claims. This is a natural area for future exploration.
  """ .

:DataFeed a owl:Class ;
    rdfs:label "DataFeed" ;
    rdfs:comment "A single feed providing structured information about one or more entities or topics." ;
    rdfs:subClassOf :Dataset ;
    skos:definition "A single feed providing structured information about one or more entities or topics." .

:DatedMoneySpecification a owl:Class ;
    rdfs:label "DatedMoneySpecification" ;
    :supersededBy :MonetaryAmount ;
    rdfs:comment "A DatedMoneySpecification represents monetary values with optional start and end dates. For example, this could represent an employee's salary over a specific period of time. __Note:__ This type has been superseded by [[MonetaryAmount]], use of that type is recommended." ;
    rdfs:subClassOf :StructuredValue ;
    skos:definition "A DatedMoneySpecification represents monetary values with optional start and end dates. For example, this could represent an employee's salary over a specific period of time. __Note:__ This type has been superseded by [[MonetaryAmount]], use of that type is recommended." .

:DefinedTermSet a owl:Class ;
    rdfs:label "DefinedTermSet" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A set of defined terms, for example a set of categories or a classification scheme, a glossary, dictionary or enumeration. Use the about property to specify what the term set is about." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A set of defined terms, for example a set of categories or a classification scheme, a glossary, dictionary or enumeration. Use the about property to specify what the term set is about." .

:DigitalDocumentPermissionType a owl:Class ;
    rdfs:label "DigitalDocumentPermissionType" ;
    rdfs:comment "A type of permission which can be granted for accessing a digital document." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "A type of permission which can be granted for accessing a digital document." .

:DonateAction a owl:Class ;
