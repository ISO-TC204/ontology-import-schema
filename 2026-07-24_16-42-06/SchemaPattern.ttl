    skos:definition "A person or organization attending the event." .

:audience a owl:ObjectProperty ;
    rdfs:label "audience" ;
    :domainIncludes :CreativeWork,
        :Event,
        :LodgingBusiness,
        :PlayAction,
        :Product,
        :Service ;
    :rangeIncludes :Audience ;
    rdfs:comment "An intended audience, i.e. a group for whom something was created." ;
    skos:definition "An intended audience, i.e. a group for whom something was created." .

:availableOnDevice a owl:DatatypeProperty ;
    rdfs:label "availableOnDevice" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Device required to run the application. Used in cases where a specific make/model is required to run the application." ;
    skos:definition "Device required to run the application. Used in cases where a specific make/model is required to run the application." .

:award a owl:DatatypeProperty ;
    rdfs:label "award" ;
    :domainIncludes :CreativeWork,
        :Organization,
        :Person,
        :Product,
        :Service ;
    :rangeIncludes :Text ;
    rdfs:comment "An award won by or for this item." ;
    skos:definition "An award won by or for this item." .

:blogPost a owl:ObjectProperty ;
    rdfs:label "blogPost" ;
    :domainIncludes :Blog ;
    :rangeIncludes :BlogPosting ;
    rdfs:comment "A posting that is part of this blog." ;
    skos:definition "A posting that is part of this blog." .

:broker a owl:ObjectProperty ;
    rdfs:label "broker" ;
    :domainIncludes :Invoice,
        :Order,
        :Reservation,
        :Service ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "An entity that arranges for an exchange between a buyer and a seller.  In most cases a broker never acquires or releases ownership of a product or service involved in an exchange.  If it is not clear whether an entity is a broker, seller, or buyer, the latter two terms are preferred." ;
    skos:definition "An entity that arranges for an exchange between a buyer and a seller.  In most cases a broker never acquires or releases ownership of a product or service involved in an exchange.  If it is not clear whether an entity is a broker, seller, or buyer, the latter two terms are preferred." .

:caption a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "caption" ;
    :domainIncludes :AudioObject,
        :ImageObject,
        :VideoObject ;
    :rangeIncludes :MediaObject,
        :Text ;
    rdfs:comment "The caption for this object. For downloadable machine formats (closed caption, subtitles etc.) use MediaObject and indicate the [[encodingFormat]]." ;
    skos:definition "The caption for this object. For downloadable machine formats (closed caption, subtitles etc.) use MediaObject and indicate the [[encodingFormat]]." .

:category a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "category" ;
    :domainIncludes :ActionAccessSpecification,
        :Guide,
        :Invoice,
        :Offer,
        :PhysicalActivity,
        :Product,
        :Recommendation,
        :Service,
        :SpecialAnnouncement ;
    :rangeIncludes :CategoryCode,
        :PhysicalActivityCategory,
        :Text,
        :Thing,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741>,
        <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "A category for the item. Greater signs or slashes can be used to informally indicate a category hierarchy." ;
    skos:definition "A category for the item. Greater signs or slashes can be used to informally indicate a category hierarchy." .

:cause a owl:ObjectProperty ;
    rdfs:label "cause" ;
    :domainIncludes :MedicalCondition ;
    :inverseOf :causeOf ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalCause ;
    rdfs:comment "The cause of a medical condition." ;
    skos:definition "The cause of a medical condition." .

:causeOf a owl:ObjectProperty ;
    rdfs:label "causeOf" ;
    :domainIncludes :MedicalCause ;
    :inverseOf :cause ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity ;
    rdfs:comment "The condition, complication, symptom, sign, etc. caused." ;
    skos:definition "The condition, complication, symptom, sign, etc. caused." .

:childTaxon a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "childTaxon" ;
    :domainIncludes :Taxon ;
    :inverseOf :parentTaxon ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Taxon,
        :Text,
        :URL ;
    :source <http://www.bioschemas.org/Taxon> ;
    rdfs:comment "Closest child taxa of the taxon in question." ;
    skos:definition "Closest child taxa of the taxon in question." .

:clinicalPharmacology a owl:DatatypeProperty ;
    rdfs:label "clinicalPharmacology" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." ;
    skos:definition "Description of the absorption and elimination of drugs, including their concentration (pharmacokinetics, pK) and biological effects (pharmacodynamics, pD)." .

:codeSampleType a owl:DatatypeProperty ;
    rdfs:label "codeSampleType" ;
    :domainIncludes :SoftwareSourceCode ;
    :rangeIncludes :Text ;
    rdfs:comment "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." ;
    skos:definition "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." .

:colleague a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "colleague" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person,
        :URL ;
    rdfs:comment "A colleague of the person." ;
    skos:definition "A colleague of the person." .

:contactPoint a owl:ObjectProperty ;
    rdfs:label "contactPoint" ;
    :domainIncludes :HealthInsurancePlan,
        :Organization,
        :Person ;
    :rangeIncludes :ContactPoint ;
    rdfs:comment "A contact point for a person or organization." ;
    skos:definition "A contact point for a person or organization." .

:containsPlace a owl:ObjectProperty ;
    rdfs:label "containsPlace" ;
    :domainIncludes :Place ;
    :inverseOf :containedInPlace ;
    :rangeIncludes :Place ;
    rdfs:comment "The basic containment relation between a place and another that it contains." ;
    skos:definition "The basic containment relation between a place and another that it contains." .

:containsSeason a owl:ObjectProperty ;
    rdfs:label "containsSeason" ;
    :domainIncludes :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :CreativeWorkSeason ;
    rdfs:comment "A season that is part of the media series." ;
    rdfs:subPropertyOf :hasPart ;
    skos:definition "A season that is part of the media series." .

:contentLocation a owl:ObjectProperty ;
    rdfs:label "contentLocation" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Place ;
    rdfs:comment "The location depicted or described in the content. For example, the location in a photograph or painting." ;
    skos:definition "The location depicted or described in the content. For example, the location in a photograph or painting." .

:creator a owl:ObjectProperty ;
    rdfs:label "creator" ;
    :domainIncludes :CreativeWork,
        :UserComments ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork." ;
    skos:definition "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork." .

:dataset a owl:ObjectProperty ;
    rdfs:label "dataset" ;
    :domainIncludes :DataCatalog ;
    :inverseOf :includedInDataCatalog ;
    :rangeIncludes :Dataset ;
    rdfs:comment "A dataset contained in this catalog." ;
    skos:definition "A dataset contained in this catalog." .

:dateCreated a owl:DatatypeProperty ;
    rdfs:label "dateCreated" ;
    :domainIncludes :CreativeWork,
        :DataFeedItem ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed." ;
    skos:definition "The date on which the CreativeWork was created or the item was added to a DataFeed." .

:director a owl:ObjectProperty ;
    rdfs:label "director" ;
    :domainIncludes :Clip,
        :CreativeWorkSeason,
        :Episode,
        :Event,
        :Movie,
        :MovieSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGame,
        :VideoGameSeries,
        :VideoObject ;
    :rangeIncludes :Person ;
    rdfs:comment "A director of e.g. TV, radio, movie, video gaming etc. content, or of an event. Directors can be associated with individual items or with a series, episode, clip." ;
    skos:definition "A director of e.g. TV, radio, movie, video gaming etc. content, or of an event. Directors can be associated with individual items or with a series, episode, clip." .

:employee a owl:ObjectProperty ;
    rdfs:label "employee" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Person ;
    rdfs:comment "Someone working for this organization." ;
    skos:definition "Someone working for this organization." .

:encodesBioChemEntity a owl:ObjectProperty ;
    rdfs:label "encodesBioChemEntity" ;
    :domainIncludes :Gene ;
    :inverseOf :isEncodedByBioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BioChemEntity ;
    :source <http://www.bioschemas.org/Gene> ;
    rdfs:comment "Another BioChemEntity encoded by this one. " ;
    skos:definition "Another BioChemEntity encoded by this one. " .

:encodesCreativeWork a owl:ObjectProperty ;
    rdfs:label "encodesCreativeWork" ;
    :domainIncludes :MediaObject ;
    :inverseOf :encoding ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "The CreativeWork encoded by this media object." ;
    skos:definition "The CreativeWork encoded by this media object." .

:encodingFormat a owl:DatatypeProperty ;
    rdfs:label "encodingFormat" ;
    :domainIncludes :CreativeWork,
        :MediaObject ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment """Media type typically expressed using a MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml) and [MDN reference](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types)), e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.

In cases where a [[CreativeWork]] has several media type representations, [[encoding]] can be used to indicate each [[MediaObject]] alongside particular [[encodingFormat]] information.

Unregistered or niche encoding and file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia/Wikidata entry.""" ;
    skos:definition """Media type typically expressed using a MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml) and [MDN reference](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types)), e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.

In cases where a [[CreativeWork]] has several media type representations, [[encoding]] can be used to indicate each [[MediaObject]] alongside particular [[encodingFormat]] information.

Unregistered or niche encoding and file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia/Wikidata entry.""" .

:endDate a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    :domainIncludes :CreativeWorkSeason,
        :CreativeWorkSeries,
        :DatedMoneySpecification,
        :EducationalOccupationalProgram,
        :Event,
        :MerchantReturnPolicySeasonalOverride,
        :Role,
        :Schedule ;
    :rangeIncludes :Date,
        :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/2486> ;
    rdfs:comment "The end date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." ;
    owl:equivalentProperty cmns-dt:hasEndDate ;
    skos:definition "The end date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." .

:episode a owl:ObjectProperty ;
    rdfs:label "episode" ;
    :domainIncludes :CreativeWorkSeason,
        :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :Episode ;
    rdfs:comment "An episode of a TV, radio or game media within a series or season." ;
    rdfs:subPropertyOf :hasPart ;
    skos:definition "An episode of a TV, radio or game media within a series or season." .

:event a owl:ObjectProperty ;
    rdfs:label "event" ;
    :domainIncludes :InformAction,
        :InviteAction,
        :JoinAction,
        :LeaveAction,
        :Organization,
        :Place,
        :PlayAction ;
    :rangeIncludes :Event ;
    rdfs:comment "Upcoming or past event associated with this place, organization, or action." ;
    skos:definition "Upcoming or past event associated with this place, organization, or action." .

:exampleOfWork a owl:ObjectProperty ;
    rdfs:label "exampleOfWork" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :CreativeWork ;
    :inverseOf :workExample ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "A creative work that this work is an example/instance/realization/derivation of." ;
    skos:definition "A creative work that this work is an example/instance/realization/derivation of." .

:executableLibraryName a owl:DatatypeProperty ;
    rdfs:label "executableLibraryName" ;
    :domainIncludes :APIReference ;
    :rangeIncludes :Text ;
    rdfs:comment "Library file name, e.g., mscorlib.dll, system.web.dll." ;
    skos:definition "Library file name, e.g., mscorlib.dll, system.web.dll." .

:exerciseCourse a owl:ObjectProperty ;
    rdfs:label "exerciseCourse" ;
    :domainIncludes :ExerciseAction ;
    :rangeIncludes :Place ;
    rdfs:comment "A sub property of location. The course where this action was taken." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The course where this action was taken." .

:founder a owl:ObjectProperty ;
    rdfs:label "founder" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A person or organization who founded this organization." ;
    skos:definition "A person or organization who founded this organization." .

:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    :domainIncludes :DoseSchedule ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "How often the dose is taken, e.g. 'daily'." ;
    skos:definition "How often the dose is taken, e.g. 'daily'." .

:fundedItem a owl:ObjectProperty ;
    rdfs:label "fundedItem" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :Grant ;
    :inverseOf :funding ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BioChemEntity,
        :CreativeWork,
        :Event,
        :MedicalEntity,
        :Organization,
        :Person,
        :Product ;
    :source <https://github.com/schemaorg/schemaorg/issues/1950>,
        <https://github.com/schemaorg/schemaorg/issues/383> ;
    rdfs:comment "Indicates something directly or indirectly funded or sponsored through a [[Grant]]. See also [[ownershipFundingInfo]]." ;
    skos:definition "Indicates something directly or indirectly funded or sponsored through a [[Grant]]. See also [[ownershipFundingInfo]]." .

:funding a owl:ObjectProperty ;
    rdfs:label "funding" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :BioChemEntity,
        :CreativeWork,
        :Event,
        :MedicalEntity,
        :Organization,
        :Person,
        :Product ;
    :inverseOf :fundedItem ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Grant ;
    :source <https://github.com/schemaorg/schemaorg/issues/383> ;
    rdfs:comment "A [[Grant]] that directly or indirectly provide funding or sponsorship for this item. See also [[ownershipFundingInfo]]." ;
    skos:definition "A [[Grant]] that directly or indirectly provide funding or sponsorship for this item. See also [[ownershipFundingInfo]]." .

:game a owl:ObjectProperty ;
    rdfs:label "game" ;
    :domainIncludes :GameServer ;
    :inverseOf :gameServer ;
    :rangeIncludes :VideoGame ;
    rdfs:comment "Video game which is played on this server." ;
    skos:definition "Video game which is played on this server." .

:gameServer a owl:ObjectProperty ;
    rdfs:label "gameServer" ;
    :domainIncludes :VideoGame ;
    :inverseOf :game ;
    :rangeIncludes :GameServer ;
    rdfs:comment "The server on which  it is possible to play the game." ;
    skos:definition "The server on which  it is possible to play the game." .

:genre a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "genre" ;
    :domainIncludes :BroadcastChannel,
        :CreativeWork,
        :MusicGroup ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    rdfs:comment "Genre of the creative work, broadcast channel or group." ;
    skos:definition "Genre of the creative work, broadcast channel or group." .

:hasBioChemEntityPart a owl:ObjectProperty ;
    rdfs:label "hasBioChemEntityPart" ;
    :domainIncludes :BioChemEntity ;
    :inverseOf :isPartOfBioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BioChemEntity ;
    :source <http://www.bioschemas.org> ;
    rdfs:comment "Indicates a BioChemEntity that (in some sense) has this BioChemEntity as a part. " ;
    skos:definition "Indicates a BioChemEntity that (in some sense) has this BioChemEntity as a part. " .

:hasBroadcastChannel a owl:ObjectProperty ;
    rdfs:label "hasBroadcastChannel" ;
    :domainIncludes :BroadcastService ;
    :inverseOf :providesBroadcastService ;
    :rangeIncludes :BroadcastChannel ;
    :source <https://github.com/schemaorg/schemaorg/issues/1004> ;
    rdfs:comment "A broadcast channel of a broadcast service." ;
    skos:definition "A broadcast channel of a broadcast service." .

:hasDefinedTerm a owl:ObjectProperty ;
    rdfs:label "hasDefinedTerm" ;
    :domainIncludes :DefinedTermSet,
        :Taxon ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A Defined Term contained in this term set." ;
    skos:definition "A Defined Term contained in this term set." .

:hasMenu a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "hasMenu" ;
    :domainIncludes :FoodEstablishment ;
    :rangeIncludes :Menu,
        :Text,
        :URL ;
    rdfs:comment "Either the actual menu as a structured representation, as text, or a URL of the menu." ;
    skos:definition "Either the actual menu as a structured representation, as text, or a URL of the menu." .

:hasTiers a owl:ObjectProperty ;
    rdfs:label "hasTiers" ;
    :domainIncludes :MemberProgram ;
    :inverseOf :isTierOf ;
    :rangeIncludes :MemberProgramTier ;
    :source <https://github.com/schemaorg/schemaorg/issues/3563> ;
    rdfs:comment "The tiers of a member program." ;
    skos:definition "The tiers of a member program." .

:hasVariant a owl:ObjectProperty ;
    rdfs:label "hasVariant" ;
    :domainIncludes :ProductGroup ;
    :inverseOf :isVariantOf ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Product ;
    :source <https://github.com/schemaorg/schemaorg/issues/1797> ;
    rdfs:comment "Indicates a [[Product]] that is a member of this [[ProductGroup]] (or [[ProductModel]])." ;
    skos:definition "Indicates a [[Product]] that is a member of this [[ProductGroup]] (or [[ProductModel]])." .

:holdingArchive a owl:ObjectProperty ;
    rdfs:label "holdingArchive"@en ;
    :domainIncludes :ArchiveComponent ;
    :inverseOf :archiveHeld ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ArchiveOrganization ;
    :source <https://github.com/schemaorg/schemaorg/issues/1758> ;
    rdfs:comment "[[ArchiveOrganization]] that holds, keeps or maintains the [[ArchiveComponent]]."@en ;
    skos:definition "[[ArchiveOrganization]] that holds, keeps or maintains the [[ArchiveComponent]]."@en .

:inDefinedTermSet a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "inDefinedTermSet" ;
    :domainIncludes :DefinedTerm ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTermSet,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A [[DefinedTermSet]] that contains this term." ;
    rdfs:subPropertyOf :isPartOf ;
    skos:definition "A [[DefinedTermSet]] that contains this term." .

:inLanguage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "inLanguage" ;
    :domainIncludes :BroadcastService,
        :CommunicateAction,
        :CreativeWork,
        :Event,
        :LinkRole,
        :PronounceableText,
        :WriteAction ;
    :rangeIncludes :Language,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2382> ;
    rdfs:comment "The language of the content or performance or used in an action. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[availableLanguage]]." ;
    skos:definition "The language of the content or performance or used in an action. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[availableLanguage]]." .

:incentiveCompensation a owl:DatatypeProperty ;
    rdfs:label "incentiveCompensation" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "Description of bonus and commission compensation aspects of the job." ;
    skos:definition "Description of bonus and commission compensation aspects of the job." .

:interactionStatistic a owl:ObjectProperty ;
    rdfs:label "interactionStatistic" ;
    :domainIncludes :CreativeWork,
        :Organization,
        :Person ;
    :rangeIncludes :InteractionCounter ;
    :source <https://github.com/schemaorg/schemaorg/issues/2421> ;
    rdfs:comment "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication. The most specific child type of InteractionCounter should be used." ;
    skos:definition "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication. The most specific child type of InteractionCounter should be used." .

:isAccessibleForFree a owl:DatatypeProperty ;
    rdfs:label "isAccessibleForFree" ;
    :domainIncludes :CreativeWork,
        :Event,
        :Place ;
    :rangeIncludes :Boolean ;
    rdfs:comment "A flag to signal that the item, event, or place is accessible for free." ;
    skos:definition "A flag to signal that the item, event, or place is accessible for free." .

:isBasedOn a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "isBasedOn" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :CreativeWork,
        :Product,
        :URL ;
    rdfs:comment "A resource from which this work is derived or from which it is a modification or adaptation." ;
    skos:definition "A resource from which this work is derived or from which it is a modification or adaptation." .

:isEncodedByBioChemEntity a owl:ObjectProperty ;
    rdfs:label "isEncodedByBioChemEntity" ;
    :domainIncludes :BioChemEntity ;
    :inverseOf :encodesBioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Gene ;
    :source <http://www.bioschemas.org/Gene> ;
    rdfs:comment "Another BioChemEntity encoding by this one." ;
    skos:definition "Another BioChemEntity encoding by this one." .

:isPartOfBioChemEntity a owl:ObjectProperty ;
    rdfs:label "isPartOfBioChemEntity" ;
    :domainIncludes :BioChemEntity ;
    :inverseOf :hasBioChemEntityPart ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BioChemEntity ;
    :source <http://www.bioschemas.org> ;
    rdfs:comment "Indicates a BioChemEntity that is (in some sense) a part of this BioChemEntity. " ;
    skos:definition "Indicates a BioChemEntity that is (in some sense) a part of this BioChemEntity. " .

:isTierOf a owl:ObjectProperty ;
    rdfs:label "isTierOf" ;
    :domainIncludes :MemberProgramTier ;
    :inverseOf :hasTiers ;
    :rangeIncludes :MemberProgram ;
    :source <https://github.com/schemaorg/schemaorg/issues/3563> ;
    rdfs:comment "The member program this tier is a part of." ;
    skos:definition "The member program this tier is a part of." .

:isVariantOf a owl:ObjectProperty ;
    rdfs:label "isVariantOf" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product,
        :ProductModel ;
    :inverseOf :hasVariant ;
    :rangeIncludes :ProductGroup,
        :ProductModel ;
    rdfs:comment "Indicates the kind of product that this is a variant of. In the case of [[ProductModel]], this is a pointer (from a ProductModel) to a base product from which this product is a variant. It is safe to infer that the variant inherits all product features from the base model, unless defined locally. This is not transitive. In the case of a [[ProductGroup]], the group description also serves as a template, representing a set of Products that vary on explicitly defined, specific dimensions only (so it defines both a set of variants, as well as which values distinguish amongst those variants). When used with [[ProductGroup]], this property can apply to any [[Product]] included in the group." ;
    rdfs:subPropertyOf skos:broader,
        cmns-cls:exemplifies ;
    skos:definition "Indicates the kind of product that this is a variant of. In the case of [[ProductModel]], this is a pointer (from a ProductModel) to a base product from which this product is a variant. It is safe to infer that the variant inherits all product features from the base model, unless defined locally. This is not transitive. In the case of a [[ProductGroup]], the group description also serves as a template, representing a set of Products that vary on explicitly defined, specific dimensions only (so it defines both a set of variants, as well as which values distinguish amongst those variants). When used with [[ProductGroup]], this property can apply to any [[Product]] included in the group." .

:itemOffered a owl:ObjectProperty ;
    rdfs:label "itemOffered" ;
    :domainIncludes :Demand,
        :Offer ;
    :inverseOf :offers ;
    :rangeIncludes :AggregateOffer,
        :CreativeWork,
        :Event,
        :MenuItem,
        :Product,
        :Service,
        :Trip ;
    rdfs:comment "An item being offered (or demanded). The transactional nature of the offer or demand is documented using [[businessFunction]], e.g. sell, lease etc. While several common expected types are listed explicitly in this definition, others can be used. Using a second type, such as Product or a subtype of Product, can clarify the nature of the offer." ;
    skos:definition "An item being offered (or demanded). The transactional nature of the offer or demand is documented using [[businessFunction]], e.g. sell, lease etc. While several common expected types are listed explicitly in this definition, others can be used. Using a second type, such as Product or a subtype of Product, can clarify the nature of the offer." .

:jobBenefits a owl:DatatypeProperty ;
    rdfs:label "jobBenefits" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "Description of benefits associated with the job." ;
    skos:definition "Description of benefits associated with the job." .

:jurisdiction a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "jurisdiction" ;
    :domainIncludes :GovernmentService,
        :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AdministrativeArea,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2534> ;
    rdfs:comment "Indicates a legal jurisdiction, e.g. of some legislation, or where some government service is based." ;
    skos:definition "Indicates a legal jurisdiction, e.g. of some legislation, or where some government service is based." .

:mainContentOfPage a owl:ObjectProperty ;
    rdfs:label "mainContentOfPage" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :WebPageElement ;
    rdfs:comment "Indicates if this web page element is the main subject of the page." ;
    skos:definition "Indicates if this web page element is the main subject of the page." .

:mainEntity a owl:ObjectProperty ;
    rdfs:label "mainEntity" ;
    :domainIncludes :CreativeWork ;
    :inverseOf :mainEntityOfPage ;
    :rangeIncludes :Thing ;
    rdfs:comment "Indicates the primary entity described in some page or other CreativeWork." ;
    rdfs:subPropertyOf :about ;
    skos:definition "Indicates the primary entity described in some page or other CreativeWork." .

:mainEntityOfPage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "mainEntityOfPage" ;
    :domainIncludes :Thing ;
    :inverseOf :mainEntity ;
    :rangeIncludes :CreativeWork,
        :URL ;
    rdfs:comment "Indicates a page (or other CreativeWork) for which this thing is the main entity being described. See [background notes](/docs/datamodel.html#mainEntityBackground) for details." ;
    skos:definition "Indicates a page (or other CreativeWork) for which this thing is the main entity being described. See [background notes](/docs/datamodel.html#mainEntityBackground) for details." .

:makesOffer a owl:ObjectProperty ;
    rdfs:label "makesOffer" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :inverseOf :offeredBy ;
    :rangeIncludes :Offer ;
    rdfs:comment "A pointer to products or services offered by the organization or person." ;
    owl:equivalentProperty fibo-fnd-pas:offers ;
    skos:definition "A pointer to products or services offered by the organization or person." .

:measurementTechnique a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "measurementTechnique" ;
    :domainIncludes :DataCatalog,
        :DataDownload,
        :Dataset,
        :Observation,
        :PropertyValue,
        :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :MeasurementMethodEnum,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1425> ;
    rdfs:comment """A technique, method or technology used in an [[Observation]], [[StatisticalVariable]] or [[Dataset]] (or [[DataDownload]], [[DataCatalog]]), corresponding to the method used for measuring the corresponding variable(s) (for datasets, described using [[variableMeasured]]; for [[Observation]], a [[StatisticalVariable]]). Often but not necessarily each [[variableMeasured]] will have an explicit representation as (or mapping to) an property such as those defined in Schema.org, or other RDF vocabularies and "knowledge graphs". In that case the subproperty of [[variableMeasured]] called [[measuredProperty]] is applicable.
    
The [[measurementTechnique]] property helps when extra clarification is needed about how a [[measuredProperty]] was measured. This is oriented towards scientific and scholarly dataset publication but may have broader applicability; it is not intended as a full representation of measurement, but can often serve as a high level summary for dataset discovery. 

For example, if [[variableMeasured]] is: molecule concentration, [[measurementTechnique]] could be: "mass spectrometry" or "nmr spectroscopy" or "colorimetry" or "immunofluorescence". If the [[variableMeasured]] is "depression rating", the [[measurementTechnique]] could be "Zung Scale" or "HAM-D" or "Beck Depression Inventory". 

If there are several [[variableMeasured]] properties recorded for some given data object, use a [[PropertyValue]] for each [[variableMeasured]] and attach the corresponding [[measurementTechnique]]. The value can also be from an enumeration, organized as a [[MeasurementMetholdEnumeration]].""" ;
    skos:definition """A technique, method or technology used in an [[Observation]], [[StatisticalVariable]] or [[Dataset]] (or [[DataDownload]], [[DataCatalog]]), corresponding to the method used for measuring the corresponding variable(s) (for datasets, described using [[variableMeasured]]; for [[Observation]], a [[StatisticalVariable]]). Often but not necessarily each [[variableMeasured]] will have an explicit representation as (or mapping to) an property such as those defined in Schema.org, or other RDF vocabularies and "knowledge graphs". In that case the subproperty of [[variableMeasured]] called [[measuredProperty]] is applicable.
    
The [[measurementTechnique]] property helps when extra clarification is needed about how a [[measuredProperty]] was measured. This is oriented towards scientific and scholarly dataset publication but may have broader applicability; it is not intended as a full representation of measurement, but can often serve as a high level summary for dataset discovery. 

For example, if [[variableMeasured]] is: molecule concentration, [[measurementTechnique]] could be: "mass spectrometry" or "nmr spectroscopy" or "colorimetry" or "immunofluorescence". If the [[variableMeasured]] is "depression rating", the [[measurementTechnique]] could be "Zung Scale" or "HAM-D" or "Beck Depression Inventory". 

If there are several [[variableMeasured]] properties recorded for some given data object, use a [[PropertyValue]] for each [[variableMeasured]] and attach the corresponding [[measurementTechnique]]. The value can also be from an enumeration, organized as a [[MeasurementMetholdEnumeration]].""" .

:offeredBy a owl:ObjectProperty ;
    rdfs:label "offeredBy" ;
    :domainIncludes :Offer ;
    :inverseOf :makesOffer ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A pointer to the organization or person making the offer." ;
    owl:equivalentProperty fibo-fnd-pas:isOfferedBy ;
    skos:definition "A pointer to the organization or person making the offer." .

:offers a owl:ObjectProperty ;
    rdfs:label "offers" ;
    :domainIncludes :AggregateOffer,
        :CreativeWork,
        :EducationalOccupationalProgram,
        :Event,
        :MenuItem,
        :Product,
        :Service,
        :Trip ;
    :inverseOf :itemOffered ;
    :rangeIncludes :Demand,
        :Offer ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment """An offer to provide this item&#x2014;for example, an offer to sell a product, rent the DVD of a movie, perform a service, or give away tickets to an event. Use [[businessFunction]] to indicate the kind of transaction offered, i.e. sell, lease, etc. This property can also be used to describe a [[Demand]]. While this property is listed as expected on a number of common types, it can be used in others. In that case, using a second type, such as Product or a subtype of Product, can clarify the nature of the offer.
      """ ;
    owl:equivalentProperty fibo-fnd-pas:isProductOf ;
    skos:definition """An offer to provide this item&#x2014;for example, an offer to sell a product, rent the DVD of a movie, perform a service, or give away tickets to an event. Use [[businessFunction]] to indicate the kind of transaction offered, i.e. sell, lease, etc. This property can also be used to describe a [[Demand]]. While this property is listed as expected on a number of common types, it can be used in others. In that case, using a second type, such as Product or a subtype of Product, can clarify the nature of the offer.
      """ .

:owner a owl:ObjectProperty ;
    rdfs:label "owner" ;
    :domainIncludes :Thing ;
    :inverseOf :owns ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/4603> ;
    rdfs:comment "A person or organization who owns this Thing." ;
    skos:definition "A person or organization who owns this Thing." .

:owns a owl:ObjectProperty ;
    rdfs:label "owns" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :inverseOf :owner ;
    :rangeIncludes :Thing ;
    :source <https://github.com/schemaorg/schemaorg/issues/4603> ;
    rdfs:comment "Things owned by the organization or person." ;
    owl:equivalentProperty gs1:owns ;
    skos:definition "Things owned by the organization or person." .

:parent a owl:ObjectProperty ;
    rdfs:label "parent" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "A parent of this person." ;
    skos:definition "A parent of this person." .

:parentTaxon a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "parentTaxon" ;
    :domainIncludes :Taxon ;
    :inverseOf :childTaxon ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Taxon,
        :Text,
        :URL ;
    :source <http://www.bioschemas.org/Taxon> ;
    rdfs:comment "Closest parent taxon of the taxon in question." ;
    skos:definition "Closest parent taxon of the taxon in question." .

:partOfSeries a owl:ObjectProperty ;
    rdfs:label "partOfSeries" ;
    :domainIncludes :Clip,
        :CreativeWorkSeason,
        :Episode ;
    :rangeIncludes :CreativeWorkSeries ;
    rdfs:comment "The series to which this episode or season belongs." ;
    rdfs:subPropertyOf :isPartOf ;
    skos:definition "The series to which this episode or season belongs." .

:partOfTrip a owl:ObjectProperty ;
    rdfs:label "partOfTrip" ;
    :contributor <http://schema.org/docs/collab/Tourism> ;
    :domainIncludes :Trip ;
    :inverseOf :subTrip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Trip ;
    :source <https://github.com/schemaorg/schemaorg/issues/1810> ;
    rdfs:comment "Identifies that this [[Trip]] is a subTrip of another Trip.  For example Day 1, Day 2, etc. of a multi-day trip." ;
    skos:definition "Identifies that this [[Trip]] is a subTrip of another Trip.  For example Day 1, Day 2, etc. of a multi-day trip." .

:paymentDueDate a owl:DatatypeProperty ;
    rdfs:label "paymentDueDate" ;
    :domainIncludes :Invoice,
        :Order ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date that payment is due." ;
    owl:equivalentProperty unece:PaymentDueDate ;
    skos:definition "The date that payment is due." .

:performTime a owl:ObjectProperty ;
    rdfs:label "performTime" ;
    :domainIncludes :HowTo,
        :HowToDirection ;
    :rangeIncludes :Duration ;
    rdfs:comment "The length of time it takes to perform instructions or a direction (not including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    skos:definition "The length of time it takes to perform instructions or a direction (not including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

:performer a owl:ObjectProperty ;
    rdfs:label "performer" ;
    :domainIncludes :Event ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A performer at the event&#x2014;for example, a presenter, musician, musical group or actor." ;
    skos:definition "A performer at the event&#x2014;for example, a presenter, musician, musical group or actor." .

:photo a owl:ObjectProperty ;
    rdfs:label "photo" ;
    :domainIncludes :Place ;
    :rangeIncludes :ImageObject,
        :Photograph ;
    rdfs:comment "A photograph of this place." ;
    rdfs:subPropertyOf :image ;
    skos:definition "A photograph of this place." .

:provider a owl:ObjectProperty ;
    rdfs:label "provider" ;
    :domainIncludes :Action,
        :CreativeWork,
        :EducationalOccupationalProgram,
        :FinancialIncentive,
        :Invoice,
        :ParcelDelivery,
        :Reservation,
        :Service,
        :Trip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289>,
        <https://github.com/schemaorg/schemaorg/issues/2927> ;
    rdfs:comment "The service provider, service operator, or service performer; the goods producer. Another party (a seller) may offer those services or goods on behalf of the provider. A provider may also serve as the seller." ;
    owl:equivalentProperty unece:ServiceProvider ;
    skos:definition "The service provider, service operator, or service performer; the goods producer. Another party (a seller) may offer those services or goods on behalf of the provider. A provider may also serve as the seller." .

:providesBroadcastService a owl:ObjectProperty ;
    rdfs:label "providesBroadcastService" ;
    :domainIncludes :BroadcastChannel ;
    :inverseOf :hasBroadcastChannel ;
    :rangeIncludes :BroadcastService ;
    rdfs:comment "The BroadcastService offered on this channel." ;
    skos:definition "The BroadcastService offered on this channel." .

:recipeIngredient a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "recipeIngredient" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :ItemList,
        :PropertyValue,
        :Text ;
    rdfs:comment "An ingredient or ordered list of ingredients and potentially quantities used in the recipe, e.g. 1 cup of sugar, flour or garlic.  The ingredients can be represented as free text or more structured values." ;
    rdfs:subPropertyOf :supply ;
    skos:definition "An ingredient or ordered list of ingredients and potentially quantities used in the recipe, e.g. 1 cup of sugar, flour or garlic.  The ingredients can be represented as free text or more structured values." .

:recordedAs a owl:ObjectProperty ;
    rdfs:label "recordedAs" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :inverseOf :recordingOf ;
    :rangeIncludes :MusicRecording ;
    rdfs:comment "An audio recording of the work." ;
    skos:definition "An audio recording of the work." .

:recordedAt a owl:ObjectProperty ;
    rdfs:label "recordedAt" ;
    :domainIncludes :CreativeWork ;
    :inverseOf :recordedIn ;
    :rangeIncludes :Event ;
    rdfs:comment "The Event where the CreativeWork was recorded. The CreativeWork may capture all or part of the event." ;
    skos:definition "The Event where the CreativeWork was recorded. The CreativeWork may capture all or part of the event." .

:recordedIn a owl:ObjectProperty ;
    rdfs:label "recordedIn" ;
    :domainIncludes :Event ;
    :inverseOf :recordedAt ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "The CreativeWork that captured all or part of this Event." ;
    skos:definition "The CreativeWork that captured all or part of this Event." .

:recordingOf a owl:ObjectProperty ;
    rdfs:label "recordingOf" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRecording ;
    :inverseOf :recordedAs ;
    :rangeIncludes :MusicComposition ;
    rdfs:comment "The composition this track is a recording of." ;
    skos:definition "The composition this track is a recording of." .

:releaseOf a owl:ObjectProperty ;
    rdfs:label "releaseOf" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRelease ;
    :inverseOf :albumRelease ;
    :rangeIncludes :MusicAlbum ;
    rdfs:comment "The album this is a release of." ;
    skos:definition "The album this is a release of." .

:review a owl:ObjectProperty ;
    rdfs:label "review" ;
    :domainIncludes :Brand,
        :CreativeWork,
        :Event,
        :Offer,
        :Organization,
        :Place,
        :Product,
        :Service ;
    :rangeIncludes :Review ;
    rdfs:comment "A review of the item." ;
    skos:definition "A review of the item." .

:roleName a owl:DatatypeProperty ;
    rdfs:label "roleName" ;
    :domainIncludes :Role ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "A role played, performed or filled by a person or organization. For example, the team of creators for a comic book might fill the roles named 'inker', 'penciller', and 'letterer'; or an athlete in a SportsTeam might play in the position named 'Quarterback'." ;
    skos:definition "A role played, performed or filled by a person or organization. For example, the team of creators for a comic book might fill the roles named 'inker', 'penciller', and 'letterer'; or an athlete in a SportsTeam might play in the position named 'Quarterback'." .

:runtimePlatform a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "runtimePlatform" ;
    :domainIncludes :SoftwareApplication,
        :SoftwareSourceCode ;
    :rangeIncludes :RuntimePlatform,
        :Text ;
    rdfs:comment "Runtime platform or script interpreter dependencies (example: Java v1, Python 2.3, .NET Framework 3.0)." ;
    skos:definition "Runtime platform or script interpreter dependencies (example: Java v1, Python 2.3, .NET Framework 3.0)." .

:season a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "season" ;
    :domainIncludes :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :CreativeWorkSeason,
        :URL ;
    :supersededBy :containsSeason ;
    rdfs:comment "A season in a media series." ;
    rdfs:subPropertyOf :hasPart ;
    skos:definition "A season in a media series." .

:serialNumber a owl:DatatypeProperty ;
    rdfs:label "serialNumber" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :IndividualProduct,
        :Offer ;
    :rangeIncludes :Text ;
    rdfs:comment "The serial number or any alphanumeric identifier of a particular product. When attached to an offer, it is a shortcut for the serial number of the product included in the offer." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty unece:SerialId ;
    skos:definition "The serial number or any alphanumeric identifier of a particular product. When attached to an offer, it is a shortcut for the serial number of the product included in the offer." .

:serviceArea a owl:ObjectProperty ;
    rdfs:label "serviceArea" ;
    :domainIncludes :ContactPoint,
        :Organization,
        :Service ;
    :rangeIncludes :AdministrativeArea,
        :GeoShape,
        :Place ;
    :supersededBy :areaServed ;
    rdfs:comment "The geographic area where the service is provided." ;
    skos:definition "The geographic area where the service is provided." .

:serviceOutput a owl:ObjectProperty ;
    rdfs:label "serviceOutput" ;
    :domainIncludes :Service ;
    :rangeIncludes :Thing ;
    rdfs:comment "The tangible thing generated by the service, e.g. a passport, permit, etc." ;
    skos:definition "The tangible thing generated by the service, e.g. a passport, permit, etc." .

:sibling a owl:ObjectProperty ;
    rdfs:label "sibling" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "A sibling of the person." ;
    skos:definition "A sibling of the person." .

:significantLink a owl:DatatypeProperty ;
    rdfs:label "significantLink" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :URL ;
    rdfs:comment "One of the more significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." ;
    skos:definition "One of the more significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." .

:softwareRequirements a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "softwareRequirements" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :SoftwareApplication,
        :Text,
        :URL ;
    rdfs:comment "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime)." ;
    skos:definition "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime)." .

:sponsor a owl:ObjectProperty ;
    rdfs:label "sponsor" ;
    :domainIncludes :CreativeWork,
        :Event,
        :Grant,
        :MedicalStudy,
        :Organization,
        :Person ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A person or organization that supports a thing through a pledge, promise, or financial contribution. E.g. a sponsor of a Medical Study or a corporate sponsor of an event." ;
    skos:definition "A person or organization that supports a thing through a pledge, promise, or financial contribution. E.g. a sponsor of a Medical Study or a corporate sponsor of an event." .

:subOrganization a owl:ObjectProperty ;
    rdfs:label "subOrganization" ;
    :domainIncludes :Organization ;
    :inverseOf :parentOrganization ;
    :rangeIncludes :Organization ;
    rdfs:comment "A relationship between two organizations where the first includes the second, e.g., as a subsidiary. See also: the more specific 'department' property." ;
    owl:equivalentProperty gs1:subOrganization,
        fibo-be-oac:hasSubsidiary ;
    skos:definition "A relationship between two organizations where the first includes the second, e.g., as a subsidiary. See also: the more specific 'department' property." .

:subTrip a owl:ObjectProperty ;
    rdfs:label "subTrip" ;
    :contributor <http://schema.org/docs/collab/Tourism> ;
    :domainIncludes :Trip ;
    :inverseOf :partOfTrip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Trip ;
    :source <https://github.com/schemaorg/schemaorg/issues/1810> ;
    rdfs:comment "Identifies a [[Trip]] that is a subTrip of this Trip.  For example Day 1, Day 2, etc. of a multi-day trip." ;
    skos:definition "Identifies a [[Trip]] that is a subTrip of this Trip.  For example Day 1, Day 2, etc. of a multi-day trip." .

:subjectOf a owl:ObjectProperty ;
    rdfs:label "subjectOf" ;
    :domainIncludes :Thing ;
    :inverseOf :about ;
    :rangeIncludes :CreativeWork,
        :Event ;
    :source <https://github.com/schemaorg/schemaorg/issues/1670> ;
    rdfs:comment "A CreativeWork or Event about this Thing." ;
    skos:definition "A CreativeWork or Event about this Thing." .

:suggestedAnswer a owl:ObjectProperty ;
    rdfs:label "suggestedAnswer" ;
    :domainIncludes :Question ;
    :rangeIncludes :Answer,
        :ItemList ;
    rdfs:comment "An answer (possibly one of several, possibly incorrect) to a Question, e.g. on a Question/Answer site." ;
    skos:definition "An answer (possibly one of several, possibly incorrect) to a Question, e.g. on a Question/Answer site." .

:superEvent a owl:ObjectProperty ;
    rdfs:label "superEvent" ;
    :domainIncludes :Event ;
    :inverseOf :subEvent ;
    :rangeIncludes :Event ;
    rdfs:comment "An event that this event is a part of. For example, a collection of individual music performances might each have a music festival as their superEvent." ;
    skos:definition "An event that this event is a part of. For example, a collection of individual music performances might each have a music festival as their superEvent." .

:targetCollection a owl:ObjectProperty ;
    rdfs:label "targetCollection" ;
    :domainIncludes :UpdateAction ;
    :rangeIncludes :Thing ;
    rdfs:comment "A sub property of object. The collection target of the action." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The collection target of the action." .

:temporalCoverage a owl:DatatypeProperty ;
    rdfs:label "temporalCoverage" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :DateTime,
        :Text,
        :URL ;
    rdfs:comment """The temporalCoverage of a CreativeWork indicates the period that the content applies to, i.e. that it describes, either as a DateTime or as a textual string indicating a time period in [ISO 8601 time interval format](https://en.wikipedia.org/wiki/ISO_8601#Time_intervals). In
      the case of a Dataset it will typically indicate the relevant time period in a precise notation (e.g. for a 2011 census dataset, the year 2011 would be written "2011/2012"). Other forms of content, e.g. ScholarlyArticle, Book, TVSeries or TVEpisode, may indicate their temporalCoverage in broader terms - textually or via well-known URL.
      Written works such as books may sometimes have precise temporal coverage too, e.g. a work set in 1939 - 1945 can be indicated in ISO 8601 interval format format via "1939/1945".

Open-ended date ranges can be written with ".." in place of the end date. For example, "2015-11/.." indicates a range beginning in November 2015 and with no specified final date. This is tentative and might be updated in future when ISO 8601 is officially updated.""" ;
    owl:equivalentProperty dcterms:temporal ;
    skos:definition """The temporalCoverage of a CreativeWork indicates the period that the content applies to, i.e. that it describes, either as a DateTime or as a textual string indicating a time period in [ISO 8601 time interval format](https://en.wikipedia.org/wiki/ISO_8601#Time_intervals). In
      the case of a Dataset it will typically indicate the relevant time period in a precise notation (e.g. for a 2011 census dataset, the year 2011 would be written "2011/2012"). Other forms of content, e.g. ScholarlyArticle, Book, TVSeries or TVEpisode, may indicate their temporalCoverage in broader terms - textually or via well-known URL.
      Written works such as books may sometimes have precise temporal coverage too, e.g. a work set in 1939 - 1945 can be indicated in ISO 8601 interval format format via "1939/1945".

Open-ended date ranges can be written with ".." in place of the end date. For example, "2015-11/.." indicates a range beginning in November 2015 and with no specified final date. This is tentative and might be updated in future when ISO 8601 is officially updated.""" .

:termCode a owl:DatatypeProperty ;
    rdfs:label "termCode" ;
    :domainIncludes :DefinedTerm ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A code that identifies this [[DefinedTerm]] within a [[DefinedTermSet]]." ;
    skos:definition "A code that identifies this [[DefinedTerm]] within a [[DefinedTermSet]]." .

:track a owl:ObjectProperty ;
    rdfs:label "track" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicGroup,
        :MusicPlaylist ;
    :rangeIncludes :ItemList,
        :MusicRecording ;
    rdfs:comment "A music recording (track)&#x2014;usually a single song. If an ItemList is given, the list should contain items of type MusicRecording." ;
    skos:definition "A music recording (track)&#x2014;usually a single song. If an ItemList is given, the list should contain items of type MusicRecording." .

:translationOfWork a owl:ObjectProperty ;
    rdfs:label "translationOfWork" ;
    :domainIncludes :CreativeWork ;
    :inverseOf :workTranslation ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "The work that this work has been translated from. E.g. 物种起源 is a translationOf “On the Origin of Species”." ;
    skos:definition "The work that this work has been translated from. E.g. 物种起源 is a translationOf “On the Origin of Species”." .

:usageInfo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "usageInfo" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2454> ;
    rdfs:comment """The schema.org [[usageInfo]] property indicates further information about a [[CreativeWork]]. This property is applicable both to works that are freely available and to those that require payment or other transactions. It can reference additional information, e.g. community expectations on preferred linking and citation conventions, as well as purchasing details. For something that can be commercially licensed, usageInfo can provide detailed, resource-specific information about licensing options.

This property can be used alongside the license property which indicates license(s) applicable to some piece of content. The usageInfo property can provide information about other licensing options, e.g. acquiring commercial usage rights for an image that is also available under non-commercial creative commons licenses.""" ;
    skos:definition """The schema.org [[usageInfo]] property indicates further information about a [[CreativeWork]]. This property is applicable both to works that are freely available and to those that require payment or other transactions. It can reference additional information, e.g. community expectations on preferred linking and citation conventions, as well as purchasing details. For something that can be commercially licensed, usageInfo can provide detailed, resource-specific information about licensing options.

This property can be used alongside the license property which indicates license(s) applicable to some piece of content. The usageInfo property can provide information about other licensing options, e.g. acquiring commercial usage rights for an image that is also available under non-commercial creative commons licenses.""" .

