    rdfs:subClassOf :TransferAction ;
    skos:definition "The act of providing goods, services, or money without compensation, often for philanthropic reasons." .

:DrugClass a owl:Class ;
    rdfs:label "DrugClass" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A class of medical drugs, e.g., statins. Classes can represent general pharmacological class, common mechanisms of action, common physiological effects, etc." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "A class of medical drugs, e.g., statins. Classes can represent general pharmacological class, common mechanisms of action, common physiological effects, etc." .

:DrugCostCategory a owl:Class ;
