        :Organization ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The number of employees in an organization, e.g. business." ;
    skos:definition "The number of employees in an organization, e.g. business." .

:numberOfEpisodes a owl:DatatypeProperty ;
