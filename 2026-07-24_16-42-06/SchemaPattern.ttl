    rdfs:comment "An abstract is a short description that summarizes a [[CreativeWork]]." ;
    skos:definition "An abstract is a short description that summarizes a [[CreativeWork]]." .

:accelerationTime a owl:ObjectProperty ;
    rdfs:label "accelerationTime" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The time needed to accelerate the vehicle from a given start velocity to a given target velocity.\\n\\nTypical unit code(s): SEC for seconds\\n\\n* Note: There are unfortunately no standard unit codes for seconds/0..100 km/h or seconds/0..60 mph. Simply use \"SEC\" for seconds and indicate the velocities in the [[name]] of the [[QuantitativeValue]], or use [[valueReference]] with a [[QuantitativeValue]] of 0..60 mph or 0..100 km/h to specify the reference speeds." ;
    skos:definition "The time needed to accelerate the vehicle from a given start velocity to a given target velocity.\\n\\nTypical unit code(s): SEC for seconds\\n\\n* Note: There are unfortunately no standard unit codes for seconds/0..100 km/h or seconds/0..60 mph. Simply use \"SEC\" for seconds and indicate the velocities in the [[name]] of the [[QuantitativeValue]], or use [[valueReference]] with a [[QuantitativeValue]] of 0..60 mph or 0..100 km/h to specify the reference speeds." .

:acceptedAnswer a owl:ObjectProperty ;
    rdfs:label "acceptedAnswer" ;
    :domainIncludes :Question ;
    :rangeIncludes :Answer,
        :ItemList ;
    rdfs:comment "The answer(s) that has been accepted as best, typically on a Question/Answer site. Sites vary in their selection mechanisms, e.g. drawing on community opinion and/or the view of the Question author." ;
    rdfs:subPropertyOf :suggestedAnswer ;
    skos:definition "The answer(s) that has been accepted as best, typically on a Question/Answer site. Sites vary in their selection mechanisms, e.g. drawing on community opinion and/or the view of the Question author." .

:acceptedOffer a owl:ObjectProperty ;
    rdfs:label "acceptedOffer" ;
    :domainIncludes :Order ;
    :rangeIncludes :Offer ;
    rdfs:comment "The offer(s) -- e.g., product, quantity and price combinations -- included in the order." ;
    skos:definition "The offer(s) -- e.g., product, quantity and price combinations -- included in the order." .

:acceptedPaymentMethod a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "acceptedPaymentMethod" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :Organization ;
    :rangeIncludes :LoanOrCredit,
        :PaymentMethod,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3537> ;
    rdfs:comment "The payment method(s) that are accepted in general by an organization, or for some specific demand or offer." ;
    skos:definition "The payment method(s) that are accepted in general by an organization, or for some specific demand or offer." .

:acceptsReservations a owl:DatatypeProperty ;
    rdfs:label "acceptsReservations" ;
    :domainIncludes :FoodEstablishment ;
    :rangeIncludes :Boolean,
        :Text,
        :URL ;
    rdfs:comment "Indicates whether a FoodEstablishment accepts reservations. Values can be Boolean, an URL at which reservations can be made or (for backwards compatibility) the strings ```Yes``` or ```No```." ;
    skos:definition "Indicates whether a FoodEstablishment accepts reservations. Values can be Boolean, an URL at which reservations can be made or (for backwards compatibility) the strings ```Yes``` or ```No```." .

:accessCode a owl:DatatypeProperty ;
    rdfs:label "accessCode" ;
    :domainIncludes :DeliveryEvent ;
    :rangeIncludes :Text ;
