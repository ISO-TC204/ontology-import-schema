    skos:definition "The street address. For example, 1600 Amphitheatre Pkwy." .

:strengthUnit a owl:DatatypeProperty ;
    rdfs:label "strengthUnit" ;
    :domainIncludes :DrugStrength ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The units of an active ingredient's strength, e.g. mg." ;
    skos:definition "The units of an active ingredient's strength, e.g. mg." .

:strengthValue a owl:DatatypeProperty ;
    rdfs:label "strengthValue" ;
    :domainIncludes :DrugStrength ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Number ;
    rdfs:comment "The value of an active ingredient's strength, e.g. 325." ;
    skos:definition "The value of an active ingredient's strength, e.g. 325." .

:structuralClass a owl:DatatypeProperty ;
    rdfs:label "structuralClass" ;
    :domainIncludes :Joint ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The name given to how bone physically connects to each other." ;
    skos:definition "The name given to how bone physically connects to each other." .

:study a owl:ObjectProperty ;
    rdfs:label "study" ;
    :domainIncludes :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalStudy ;
    rdfs:comment "A medical study or trial related to this entity." ;
    skos:definition "A medical study or trial related to this entity." .

:studyDesign a owl:ObjectProperty ;
    rdfs:label "studyDesign" ;
    :domainIncludes :MedicalObservationalStudy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalObservationalStudyDesign ;
    rdfs:comment "Specifics about the observational study design (enumerated)." ;
    skos:definition "Specifics about the observational study design (enumerated)." .

:studyLocation a owl:ObjectProperty ;
    rdfs:label "studyLocation" ;
    :domainIncludes :MedicalStudy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AdministrativeArea ;
    rdfs:comment "The location in which the study is taking/took place." ;
    skos:definition "The location in which the study is taking/took place." .

:studySubject a owl:ObjectProperty ;
    rdfs:label "studySubject" ;
    :domainIncludes :MedicalStudy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity ;
    rdfs:comment "A subject of the study, i.e. one of the medical conditions, therapies, devices, drugs, etc. investigated by the study." ;
    skos:definition "A subject of the study, i.e. one of the medical conditions, therapies, devices, drugs, etc. investigated by the study." .

:subEvents a owl:ObjectProperty ;
    rdfs:label "subEvents" ;
    :domainIncludes :Event ;
    :rangeIncludes :Event ;
    :supersededBy :subEvent ;
    rdfs:comment "Events that are a part of this event. For example, a conference event includes many presentations, each subEvents of the conference." ;
    skos:definition "Events that are a part of this event. For example, a conference event includes many presentations, each subEvents of the conference." .

:subReservation a owl:ObjectProperty ;
    rdfs:label "subReservation" ;
