    skos:definition "A single step item (as HowToStep, text, document, video, etc.) or a HowToSection (originally misnamed 'steps'; 'step' is preferred)." .

:storageRequirements a owl:DatatypeProperty ;
    rdfs:label "storageRequirements" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Storage requirements (free space required)." ;
