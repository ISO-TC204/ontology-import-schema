    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1672> ;
    rdfs:comment "Text representing an XPath (typically but not necessarily version 1.0)." ;
    rdfs:subClassOf :Text ;
    skos:definition "Text representing an XPath (typically but not necessarily version 1.0)." .

:actionApplication a owl:ObjectProperty ;
