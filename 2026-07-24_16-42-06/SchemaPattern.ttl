:inker a owl:ObjectProperty ;
    rdfs:label "inker" ;
    :domainIncludes :ComicIssue,
        :ComicStory,
        :VisualArtwork ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Person ;
    rdfs:comment "The individual who traces over the pencil drawings in ink after pencils are complete." ;
    skos:definition "The individual who traces over the pencil drawings in ink after pencils are complete." .

:insertion a owl:ObjectProperty ;
    rdfs:label "insertion" ;
    :domainIncludes :Muscle ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure ;
    rdfs:comment "The place of attachment of a muscle, or what the muscle moves." ;
    skos:definition "The place of attachment of a muscle, or what the muscle moves." .

:installUrl a owl:DatatypeProperty ;
    rdfs:label "installUrl" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :URL ;
    rdfs:comment "URL at which the app may be installed, if different from the URL of the item." ;
    skos:definition "URL at which the app may be installed, if different from the URL of the item." .

:instructor a owl:ObjectProperty ;
    rdfs:label "instructor" ;
    :domainIncludes :CourseInstance ;
    :rangeIncludes :Person ;
    rdfs:comment "A person assigned to instruct or provide instructional assistance for the [[CourseInstance]]." ;
    skos:definition "A person assigned to instruct or provide instructional assistance for the [[CourseInstance]]." .

:intensity a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "intensity" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    rdfs:comment "Quantitative measure gauging the degree of force involved in the exercise, for example, heartbeats per minute. May include the velocity of the movement." ;
    skos:definition "Quantitative measure gauging the degree of force involved in the exercise, for example, heartbeats per minute. May include the velocity of the movement." .

:interactingDrug a owl:ObjectProperty ;
    rdfs:label "interactingDrug" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Drug ;
    rdfs:comment "Another drug that is known to interact with this drug in a way that impacts the effect of this drug or causes a risk to the patient. Note: disease interactions are typically captured as contraindications." ;
    skos:definition "Another drug that is known to interact with this drug in a way that impacts the effect of this drug or causes a risk to the patient. Note: disease interactions are typically captured as contraindications." .

:interactionCount a owl:ObjectProperty ;
    rdfs:label "interactionCount" ;
    :supersededBy :interactionStatistic ;
    rdfs:comment "This property is deprecated, alongside the UserInteraction types on which it depended." ;
    skos:definition "This property is deprecated, alongside the UserInteraction types on which it depended." .

:interactionService a owl:ObjectProperty ;
    rdfs:label "interactionService" ;
    :domainIncludes :InteractionCounter ;
    :rangeIncludes :SoftwareApplication,
        :WebSite ;
    rdfs:comment "The WebSite or SoftwareApplication where the interactions took place." ;
    skos:definition "The WebSite or SoftwareApplication where the interactions took place." .

:interactionType a owl:ObjectProperty ;
    rdfs:label "interactionType" ;
    :domainIncludes :InteractionCounter ;
    :rangeIncludes :Action ;
    rdfs:comment "The Action representing the type of interaction. For up votes, +1s, etc. use [[LikeAction]]. For down votes use [[DislikeAction]]. Otherwise, use the most specific Action." ;
    skos:definition "The Action representing the type of interaction. For up votes, +1s, etc. use [[LikeAction]]. For down votes use [[DislikeAction]]. Otherwise, use the most specific Action." .

:interactivityType a owl:DatatypeProperty ;
    rdfs:label "interactivityType" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "The predominant mode of learning supported by the learning resource. Acceptable values are 'active', 'expositive', or 'mixed'." ;
    skos:definition "The predominant mode of learning supported by the learning resource. Acceptable values are 'active', 'expositive', or 'mixed'." .

:interestRate a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "interestRate" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :FinancialProduct ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The interest rate, charged or paid, applicable to the financial product. Note: This is different from the calculated annualPercentageRate." ;
    skos:definition "The interest rate, charged or paid, applicable to the financial product. Note: This is different from the calculated annualPercentageRate." .

:interpretedAsClaim a owl:ObjectProperty ;
    rdfs:label "interpretedAsClaim" ;
    :domainIncludes :CreativeWork,
        :MediaObject ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Claim ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "Used to indicate a specific claim contained, implied, translated or refined from the content of a [[MediaObject]] or other [[CreativeWork]]. The interpreting party can be indicated using [[claimInterpreter]]." ;
    rdfs:subPropertyOf :description ;
    skos:definition "Used to indicate a specific claim contained, implied, translated or refined from the content of a [[MediaObject]] or other [[CreativeWork]]. The interpreting party can be indicated using [[claimInterpreter]]." .

:inventoryLevel a owl:ObjectProperty ;
    rdfs:label "inventoryLevel" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :SomeProducts ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The current approximate inventory level for the item or items." ;
    skos:definition "The current approximate inventory level for the item or items." .

:inverseOf a owl:ObjectProperty ;
    rdfs:label "inverseOf" ;
    :domainIncludes :Property ;
    :isPartOf <http://meta.schema.org> ;
    :rangeIncludes :Property ;
    rdfs:comment "Relates a property to a property that is its inverse. Inverse properties relate the same pairs of items to each other, but in reversed direction. For example, the 'alumni' and 'alumniOf' properties are inverseOf each other. Some properties don't have explicit inverses; in these situations RDFa and JSON-LD syntax for reverse properties can be used." ;
    skos:definition "Relates a property to a property that is its inverse. Inverse properties relate the same pairs of items to each other, but in reversed direction. For example, the 'alumni' and 'alumniOf' properties are inverseOf each other. Some properties don't have explicit inverses; in these situations RDFa and JSON-LD syntax for reverse properties can be used." .

:isAcceptingNewPatients a owl:DatatypeProperty ;
    rdfs:label "isAcceptingNewPatients" ;
    :domainIncludes :MedicalOrganization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/1062> ;
    rdfs:comment "Whether the provider is accepting new patients." ;
    skos:definition "Whether the provider is accepting new patients." .

:isAccessoryOrSparePartFor a owl:ObjectProperty ;
    rdfs:label "isAccessoryOrSparePartFor" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product ;
    :rangeIncludes :Product ;
    rdfs:comment "A pointer to another product (or multiple products) for which this product is an accessory or spare part." ;
    skos:definition "A pointer to another product (or multiple products) for which this product is an accessory or spare part." .

:isAvailableGenerically a owl:DatatypeProperty ;
    rdfs:label "isAvailableGenerically" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Boolean ;
    rdfs:comment "True if the drug is available in a generic form (regardless of name)." ;
    skos:definition "True if the drug is available in a generic form (regardless of name)." .

:isBasedOnUrl a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "isBasedOnUrl" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :CreativeWork,
        :Product,
        :URL ;
    :supersededBy :isBasedOn ;
    rdfs:comment "A resource that was used in the creation of this resource. This term can be repeated for multiple sources. For example, http://example.com/great-multiplication-intro.html." ;
    skos:definition "A resource that was used in the creation of this resource. This term can be repeated for multiple sources. For example, http://example.com/great-multiplication-intro.html." .

:isConsumableFor a owl:ObjectProperty ;
    rdfs:label "isConsumableFor" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product ;
    :rangeIncludes :Product ;
    rdfs:comment "A pointer to another product (or multiple products) for which this product is a consumable." ;
    skos:definition "A pointer to another product (or multiple products) for which this product is a consumable." .

:isFamilyFriendly a owl:DatatypeProperty ;
    rdfs:label "isFamilyFriendly" ;
    :domainIncludes :CreativeWork,
        :Offer,
        :Product ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Indicates whether this content is family friendly." ;
    skos:definition "Indicates whether this content is family friendly." .

:isGift a owl:DatatypeProperty ;
    rdfs:label "isGift" ;
    :domainIncludes :Order ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Indicates whether the offer was accepted as a gift for someone other than the buyer." ;
    skos:definition "Indicates whether the offer was accepted as a gift for someone other than the buyer." .

:isInvolvedInBiologicalProcess a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "isInvolvedInBiologicalProcess" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :PropertyValue,
        :URL ;
    :source <http://www.bioschemas.org/BioChemEntity> ;
    rdfs:comment "Biological process this BioChemEntity is involved in; please use PropertyValue if you want to include any evidence." ;
    skos:definition "Biological process this BioChemEntity is involved in; please use PropertyValue if you want to include any evidence." .

:isLiveBroadcast a owl:DatatypeProperty ;
    rdfs:label "isLiveBroadcast" ;
    :domainIncludes :BroadcastEvent ;
    :rangeIncludes :Boolean ;
    rdfs:comment "True if the broadcast is of a live event." ;
    skos:definition "True if the broadcast is of a live event." .

:isLocatedInSubcellularLocation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "isLocatedInSubcellularLocation" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :PropertyValue,
        :URL ;
    :source <http://www.bioschemas.org/BioChemEntity> ;
    rdfs:comment "Subcellular location where this BioChemEntity is located; please use PropertyValue if you want to include any evidence." ;
    skos:definition "Subcellular location where this BioChemEntity is located; please use PropertyValue if you want to include any evidence." .

:isPlanForApartment a owl:ObjectProperty ;
    rdfs:label "isPlanForApartment" ;
    :domainIncludes :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Accommodation ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Indicates some accommodation that this floor plan describes." ;
    skos:definition "Indicates some accommodation that this floor plan describes." .

:isProprietary a owl:DatatypeProperty ;
    rdfs:label "isProprietary" ;
    :domainIncludes :DietarySupplement,
        :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Boolean ;
    rdfs:comment "True if this item's name is a proprietary/brand name (vs. generic name)." ;
    skos:definition "True if this item's name is a proprietary/brand name (vs. generic name)." .

:isRelatedTo a owl:ObjectProperty ;
    rdfs:label "isRelatedTo" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product,
        :Service ;
    :rangeIncludes :Product,
        :Service ;
    rdfs:comment "A pointer to another, somehow related product (or multiple products)." ;
    owl:equivalentProperty unece:RelatedProduct ;
    skos:definition "A pointer to another, somehow related product (or multiple products)." .

:isResizable a owl:DatatypeProperty ;
    rdfs:label "isResizable" ;
    :domainIncludes :3DModel ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2394> ;
    rdfs:comment "Whether the 3DModel allows resizing. For example, room layout applications often do not allow 3DModel elements to be resized to reflect reality." ;
    skos:definition "Whether the 3DModel allows resizing. For example, room layout applications often do not allow 3DModel elements to be resized to reflect reality." .

:isSimilarTo a owl:ObjectProperty ;
    rdfs:label "isSimilarTo" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product,
        :Service ;
    :rangeIncludes :Product,
        :Service ;
    rdfs:comment "A pointer to another, functionally similar product (or multiple products)." ;
    owl:equivalentProperty unece:SubstituteProduct ;
    skos:definition "A pointer to another, functionally similar product (or multiple products)." .

:isStoreOn a owl:ObjectProperty ;
    rdfs:label "isStoreOn" ;
    :domainIncludes :OnlineStore ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :OnlineMarketplace ;
    :source <https://github.com/schemaorg/schemaorg/issues/4470> ;
    rdfs:comment "The eCommerce marketplace this online store is on." ;
    skos:definition "The eCommerce marketplace this online store is on." .

:isUnlabelledFallback a owl:DatatypeProperty ;
    rdfs:label "isUnlabelledFallback" ;
    :domainIncludes :ShippingRateSettings ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "This can be marked 'true' to indicate that some published [[DeliveryTimeSettings]] or [[ShippingRateSettings]] are intended to apply to all [[OfferShippingDetails]] published by the same merchant, when referenced by a [[shippingSettingsLink]] in those settings. It is not meaningful to use a 'true' value for this property alongside a transitTimeLabel (for [[DeliveryTimeSettings]]) or shippingLabel (for [[ShippingRateSettings]]), since this property is for use with unlabelled settings." ;
    skos:definition "This can be marked 'true' to indicate that some published [[DeliveryTimeSettings]] or [[ShippingRateSettings]] are intended to apply to all [[OfferShippingDetails]] published by the same merchant, when referenced by a [[shippingSettingsLink]] in those settings. It is not meaningful to use a 'true' value for this property alongside a transitTimeLabel (for [[DeliveryTimeSettings]]) or shippingLabel (for [[ShippingRateSettings]]), since this property is for use with unlabelled settings." .

:isbn a owl:DatatypeProperty ;
    rdfs:label "isbn" ;
    :domainIncludes :Book ;
    :rangeIncludes :Text ;
    rdfs:comment "The ISBN of the book." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty bibo:isbn ;
    skos:definition "The ISBN of the book." .

:isicV4 a owl:DatatypeProperty ;
    rdfs:label "isicV4" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person,
        :Place ;
    :rangeIncludes :Text ;
    rdfs:comment "The International Standard of Industrial Classification of All Economic Activities (ISIC), Revision 4 code for a particular organization, business person, or place." ;
    skos:definition "The International Standard of Industrial Classification of All Economic Activities (ISIC), Revision 4 code for a particular organization, business person, or place." .

:iso6523Code a owl:DatatypeProperty ;
    rdfs:label "iso6523Code" ;
    :domainIncludes :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2915> ;
    rdfs:comment "An organization identifier as defined in [ISO 6523(-1)](https://en.wikipedia.org/wiki/ISO/IEC_6523). The identifier should be in the `XXXX:YYYYYY:ZZZ` or `XXXX:YYYYYY`format. Where `XXXX` is a 4 digit _ICD_ (International Code Designator), `YYYYYY` is an _OID_ (Organization Identifier) with all formatting characters (dots, dashes, spaces) removed with a maximal length of 35 characters, and `ZZZ` is an optional OPI (Organization Part Identifier) with a maximum length of 35 characters. The various components (ICD, OID, OPI) are joined with a colon character (ASCII `0x3a`). Note that many existing organization identifiers defined as attributes like [leiCode](http://schema.org/leiCode) (`0199`), [duns](http://schema.org/duns) (`0060`) or [GLN](http://schema.org/globalLocationNumber) (`0088`) can be expressed using ISO-6523. If possible, ISO-6523 codes should be preferred to populating [vatID](http://schema.org/vatID) or [taxID](http://schema.org/taxID), as ISO identifiers are less ambiguous." ;
    skos:definition "An organization identifier as defined in [ISO 6523(-1)](https://en.wikipedia.org/wiki/ISO/IEC_6523). The identifier should be in the `XXXX:YYYYYY:ZZZ` or `XXXX:YYYYYY`format. Where `XXXX` is a 4 digit _ICD_ (International Code Designator), `YYYYYY` is an _OID_ (Organization Identifier) with all formatting characters (dots, dashes, spaces) removed with a maximal length of 35 characters, and `ZZZ` is an optional OPI (Organization Part Identifier) with a maximum length of 35 characters. The various components (ICD, OID, OPI) are joined with a colon character (ASCII `0x3a`). Note that many existing organization identifiers defined as attributes like [leiCode](http://schema.org/leiCode) (`0199`), [duns](http://schema.org/duns) (`0060`) or [GLN](http://schema.org/globalLocationNumber) (`0088`) can be expressed using ISO-6523. If possible, ISO-6523 codes should be preferred to populating [vatID](http://schema.org/vatID) or [taxID](http://schema.org/taxID), as ISO identifiers are less ambiguous." .

:isrcCode a owl:DatatypeProperty ;
    rdfs:label "isrcCode" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRecording ;
    :rangeIncludes :Text ;
    rdfs:comment "The International Standard Recording Code for the recording." ;
    skos:definition "The International Standard Recording Code for the recording." .

:issn a owl:DatatypeProperty ;
    rdfs:label "issn" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :Blog,
        :CreativeWorkSeries,
        :Dataset,
        :WebSite ;
    :rangeIncludes :Text ;
    rdfs:comment "The International Standard Serial Number (ISSN) that identifies this serial publication. You can repeat this property to identify different formats of, or the linking ISSN (ISSN-L) for, this serial publication." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty bibo:issn ;
    skos:definition "The International Standard Serial Number (ISSN) that identifies this serial publication. You can repeat this property to identify different formats of, or the linking ISSN (ISSN-L) for, this serial publication." .

:issueNumber a owl:DatatypeProperty ;
    rdfs:label "issueNumber" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :PublicationIssue ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "Identifies the issue of publication; for example, \"iii\" or \"2\"." ;
    rdfs:subPropertyOf :position ;
    owl:equivalentProperty bibo:issue ;
    skos:definition "Identifies the issue of publication; for example, \"iii\" or \"2\"." .

:issuedBy a owl:ObjectProperty ;
    rdfs:label "issuedBy" ;
    :domainIncludes :Certification,
        :Permit,
        :Ticket ;
    :rangeIncludes :Organization ;
    rdfs:comment "The organization issuing the item, for example a [[Permit]], [[Ticket]], or [[Certification]]." ;
    skos:definition "The organization issuing the item, for example a [[Permit]], [[Ticket]], or [[Certification]]." .

:issuedThrough a owl:ObjectProperty ;
    rdfs:label "issuedThrough" ;
    :domainIncludes :Permit ;
    :rangeIncludes :Service ;
    rdfs:comment "The service through which the permit was granted." ;
    skos:definition "The service through which the permit was granted." .

:iswcCode a owl:DatatypeProperty ;
    rdfs:label "iswcCode" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :Text ;
    rdfs:comment "The International Standard Musical Work Code for the composition." ;
    skos:definition "The International Standard Musical Work Code for the composition." .

:item a owl:ObjectProperty ;
    rdfs:label "item" ;
    :domainIncludes :DataFeedItem,
        :ListItem ;
    :rangeIncludes :Thing ;
    rdfs:comment "An entity represented by an entry in a list or data feed (e.g. an 'artist' in a list of 'artists')." ;
    skos:definition "An entity represented by an entry in a list or data feed (e.g. an 'artist' in a list of 'artists')." .

:itemCondition a owl:ObjectProperty ;
    rdfs:label "itemCondition" ;
    :domainIncludes :Demand,
        :MerchantReturnPolicy,
        :Offer,
        :Product ;
    :rangeIncludes :OfferItemCondition ;
    rdfs:comment "A predefined value from OfferItemCondition specifying the condition of the product or service, or the products or services included in the offer. Also used for product return policies to specify the condition of products accepted for returns." ;
    skos:definition "A predefined value from OfferItemCondition specifying the condition of the product or service, or the products or services included in the offer. Also used for product return policies to specify the condition of products accepted for returns." .

:itemDefectReturnFees a owl:ObjectProperty ;
    rdfs:label "itemDefectReturnFees" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ReturnFeesEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "The type of return fees for returns of defect products." ;
    skos:definition "The type of return fees for returns of defect products." .

:itemDefectReturnLabelSource a owl:ObjectProperty ;
    rdfs:label "itemDefectReturnLabelSource" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ReturnLabelSourceEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "The method (from an enumeration) by which the customer obtains a return shipping label for a defect product." ;
    skos:definition "The method (from an enumeration) by which the customer obtains a return shipping label for a defect product." .

:itemDefectReturnShippingFeesAmount a owl:ObjectProperty ;
    rdfs:label "itemDefectReturnShippingFeesAmount" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "Amount of shipping costs for defect product returns. Applicable when property [[itemDefectReturnFees]] equals [[ReturnShippingFees]]." ;
    skos:definition "Amount of shipping costs for defect product returns. Applicable when property [[itemDefectReturnFees]] equals [[ReturnShippingFees]]." .

:itemListElement a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "itemListElement" ;
    :domainIncludes :ItemList ;
    :rangeIncludes :ListItem,
        :Text,
        :Thing ;
    rdfs:comment "For itemListElement values, you can use simple strings (e.g. \"Peter\", \"Paul\", \"Mary\"), existing entities, or use ListItem.\\n\\nText values are best if the elements in the list are plain strings. Existing entities are best for a simple, unordered list of existing things in your data. ListItem is used with ordered lists when you want to provide additional context about the element in that list or when the same item might be in different places in different lists.\\n\\nNote: The order of elements in your mark-up is not sufficient for indicating the order or elements.  Use ListItem with a 'position' property in such cases." ;
    skos:definition "For itemListElement values, you can use simple strings (e.g. \"Peter\", \"Paul\", \"Mary\"), existing entities, or use ListItem.\\n\\nText values are best if the elements in the list are plain strings. Existing entities are best for a simple, unordered list of existing things in your data. ListItem is used with ordered lists when you want to provide additional context about the element in that list or when the same item might be in different places in different lists.\\n\\nNote: The order of elements in your mark-up is not sufficient for indicating the order or elements.  Use ListItem with a 'position' property in such cases." .

:itemListOrder a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "itemListOrder" ;
    :domainIncludes :ItemList ;
    :rangeIncludes :ItemListOrderType,
        :Text ;
    rdfs:comment "Type of ordering (e.g. Ascending, Descending, Unordered)." ;
    skos:definition "Type of ordering (e.g. Ascending, Descending, Unordered)." .

:itemLocation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "itemLocation"@en ;
    :domainIncludes :ArchiveComponent ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Place,
        :PostalAddress,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1758> ;
    rdfs:comment "Current location of the item."@en ;
    rdfs:subPropertyOf :location ;
    skos:definition "Current location of the item."@en .

:itemReviewed a owl:ObjectProperty ;
    rdfs:label "itemReviewed" ;
    :domainIncludes :AggregateRating,
        :Review ;
    :rangeIncludes :Thing ;
    rdfs:comment "The item that is being reviewed/rated." ;
    skos:definition "The item that is being reviewed/rated." .

:itemShipped a owl:ObjectProperty ;
    rdfs:label "itemShipped" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :Product ;
    rdfs:comment "Item(s) being shipped." ;
    rdfs:subPropertyOf fibo-fnd-pas:hasProduct ;
    owl:equivalentProperty unece:IncludedConsignmentItem ;
    skos:definition "Item(s) being shipped." .

:itinerary a owl:ObjectProperty ;
    rdfs:label "itinerary" ;
    :contributor <http://schema.org/docs/collab/Tourism> ;
    :domainIncludes :Trip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ItemList,
        :Place ;
    :source <https://github.com/schemaorg/schemaorg/issues/1810> ;
    rdfs:comment "Destination(s) ( [[Place]] ) that make up a trip. For a trip where destination order is important use [[ItemList]] to specify that order (see examples)." ;
    skos:definition "Destination(s) ( [[Place]] ) that make up a trip. For a trip where destination order is important use [[ItemList]] to specify that order (see examples)." .

:iupacName a owl:DatatypeProperty ;
    rdfs:label "iupacName" ;
    :domainIncludes :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <http://www.bioschemas.org/MolecularEntity> ;
    rdfs:comment "Systematic method of naming chemical compounds as recommended by the International Union of Pure and Applied Chemistry (IUPAC)." ;
    skos:definition "Systematic method of naming chemical compounds as recommended by the International Union of Pure and Applied Chemistry (IUPAC)." .

:jobImmediateStart a owl:DatatypeProperty ;
    rdfs:label "jobImmediateStart" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2244> ;
    rdfs:comment "An indicator as to whether a position is available for an immediate start." ;
    skos:definition "An indicator as to whether a position is available for an immediate start." .

:jobLocation a owl:ObjectProperty ;
    rdfs:label "jobLocation" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Place ;
    rdfs:comment "A (typically single) geographic location associated with the job position." ;
    skos:definition "A (typically single) geographic location associated with the job position." .

:jobLocationType a owl:DatatypeProperty ;
    rdfs:label "jobLocationType" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1591> ;
    rdfs:comment "A description of the job location (e.g. TELECOMMUTE for telecommute jobs)." ;
    skos:definition "A description of the job location (e.g. TELECOMMUTE for telecommute jobs)." .

:jobStartDate a owl:DatatypeProperty ;
    rdfs:label "jobStartDate" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2244> ;
    rdfs:comment "The date on which a successful applicant for this job would be expected to start work. Choose a specific date in the future or use the jobImmediateStart property to indicate the position is to be filled as soon as possible." ;
    skos:definition "The date on which a successful applicant for this job would be expected to start work. Choose a specific date in the future or use the jobImmediateStart property to indicate the position is to be filled as soon as possible." .

:jobTitle a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "jobTitle" ;
    :domainIncludes :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2192> ;
    rdfs:comment "The job title of the person (for example, Financial Manager)." ;
    skos:definition "The job title of the person (for example, Financial Manager)." .

:keywords a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "keywords" ;
    :domainIncludes :CreativeWork,
        :Event,
        :Organization,
        :Place,
        :Product ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    rdfs:comment "Keywords or tags used to describe some item. Multiple textual entries in a keywords list are typically delimited by commas, or by repeating the property." ;
    skos:definition "Keywords or tags used to describe some item. Multiple textual entries in a keywords list are typically delimited by commas, or by repeating the property." .

:knownVehicleDamages a owl:DatatypeProperty ;
    rdfs:label "knownVehicleDamages" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Text ;
    rdfs:comment "A textual description of known damages, both repaired and unrepaired." ;
    skos:definition "A textual description of known damages, both repaired and unrepaired." .

:knows a owl:ObjectProperty ;
    rdfs:label "knows" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "The most generic bi-directional social/work relation." ;
    skos:definition "The most generic bi-directional social/work relation." .

:knowsAbout a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "knowsAbout" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :Organization,
        :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :Thing,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1688> ;
    rdfs:comment "Of a [[Person]], and less typically of an [[Organization]], to indicate a topic that is known about - suggesting possible expertise but not implying it. We do not distinguish skill levels here, or relate this to educational content, events, objectives or [[JobPosting]] descriptions." ;
    skos:definition "Of a [[Person]], and less typically of an [[Organization]], to indicate a topic that is known about - suggesting possible expertise but not implying it. We do not distinguish skill levels here, or relate this to educational content, events, objectives or [[JobPosting]] descriptions." .

:knowsLanguage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "knowsLanguage" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :Organization,
        :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Language,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1688> ;
    rdfs:comment "Of a [[Person]], and less typically of an [[Organization]], to indicate a known language. We do not distinguish skill levels or reading/writing/speaking/signing here. Use language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47)." ;
    skos:definition "Of a [[Person]], and less typically of an [[Organization]], to indicate a known language. We do not distinguish skill levels or reading/writing/speaking/signing here. Use language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47)." .

:labelDetails a owl:DatatypeProperty ;
    rdfs:label "labelDetails" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :URL ;
    rdfs:comment "Link to the drug's label details." ;
    skos:definition "Link to the drug's label details." .

:landlord a owl:ObjectProperty ;
    rdfs:label "landlord" ;
    :domainIncludes :RentAction ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A sub property of participant. The owner of the real estate property." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The owner of the real estate property." .

:language a owl:ObjectProperty ;
    rdfs:label "language" ;
    :domainIncludes :CommunicateAction,
        :WriteAction ;
    :rangeIncludes :Language ;
    :supersededBy :inLanguage ;
    rdfs:comment "A sub property of instrument. The language used on this action." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The language used on this action." .

:lastReviewed a owl:DatatypeProperty ;
    rdfs:label "lastReviewed" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :Date ;
    rdfs:comment "Date on which the content on this web page was last reviewed for accuracy and/or completeness." ;
    skos:definition "Date on which the content on this web page was last reviewed for accuracy and/or completeness." .

:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    :domainIncludes :GeoCoordinates,
        :Place ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The latitude of a location. For example ```37.42242``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." ;
    rdfs:subPropertyOf cmns-loc:hasLatitude ;
    skos:definition "The latitude of a location. For example ```37.42242``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." .

:layoutImage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "layoutImage" ;
    :domainIncludes :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ImageObject,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2690> ;
    rdfs:comment "A schematic image showing the floorplan layout." ;
    rdfs:subPropertyOf :image ;
    skos:definition "A schematic image showing the floorplan layout." .

:learningResourceType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "learningResourceType" ;
    :domainIncludes :CreativeWork,
        :LearningResource ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    rdfs:comment "The predominant type or kind characterizing the learning resource. For example, 'presentation', 'handout'." ;
    skos:definition "The predominant type or kind characterizing the learning resource. For example, 'presentation', 'handout'." .

:leaseLength a owl:ObjectProperty ;
    rdfs:label "leaseLength" ;
    :domainIncludes :Accommodation,
        :Offer,
        :RealEstateListing ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Duration,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Length of the lease for some [[Accommodation]], either particular to some [[Offer]] or in some cases intrinsic to the property." ;
    skos:definition "Length of the lease for some [[Accommodation]], either particular to some [[Offer]] or in some cases intrinsic to the property." .

:legalAddress a owl:ObjectProperty ;
    rdfs:label "legalAddress" ;
    :domainIncludes :Organization ;
    :rangeIncludes :PostalAddress ;
    rdfs:comment "The legal address of an organization which acts as the officially registered address used for legal and tax purposes. The legal address can be different from the place of operations of a business and other addresses can be part of an organization." ;
    rdfs:subPropertyOf cmns-loc:hasAddress ;
    owl:equivalentProperty fibo-fnd-plc:hasRegisteredAddress ;
    skos:definition "The legal address of an organization which acts as the officially registered address used for legal and tax purposes. The legal address can be different from the place of operations of a business and other addresses can be part of an organization." .

:legalName a owl:DatatypeProperty ;
    rdfs:label "legalName" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization ;
    :rangeIncludes :Text ;
    rdfs:comment "The official name of the organization, e.g. the registered company name." ;
    rdfs:subPropertyOf cmns-txt:hasName ;
    owl:equivalentProperty gs1:organizationLegalName,
        fibo-fnd-rel:hasLegalName ;
    skos:definition "The official name of the organization, e.g. the registered company name." .

:legalRepresentative a owl:ObjectProperty ;
    rdfs:label "legalRepresentative" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Person ;
    rdfs:comment "One or multiple persons who represent this organization legally such as CEO or sole administrator." ;
    skos:definition "One or multiple persons who represent this organization legally such as CEO or sole administrator." .

:legalStatus a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "legalStatus" ;
    :domainIncludes :DietarySupplement,
        :Drug,
        :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DrugLegalStatus,
        :MedicalEnumeration,
        :Text ;
    rdfs:comment "The drug or supplement's legal status, including any controlled substance schedules that apply." ;
    skos:definition "The drug or supplement's legal status, including any controlled substance schedules that apply." .

:legislationAmends a owl:ObjectProperty ;
    rdfs:label "legislationAmends" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Another legislation that this legislation amends, introducing legal changes." ;
    rdfs:subPropertyOf :legislationChanges ;
    owl:equivalentProperty eli:amends ;
    skos:definition "Another legislation that this legislation amends, introducing legal changes." ;
    skos:exactMatch eli:amends .

:legislationCommences a owl:ObjectProperty ;
    rdfs:label "legislationCommences" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Another legislation that this one sets into force." ;
    rdfs:subPropertyOf :legislationChanges ;
    owl:equivalentProperty eli:commences ;
    skos:definition "Another legislation that this one sets into force." ;
    skos:exactMatch eli:commences .

:legislationConsolidates a owl:ObjectProperty ;
    rdfs:label "legislationConsolidates" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Indicates another legislation taken into account in this consolidated legislation (which is usually the product of an editorial process that revises the legislation). This property should be used multiple times to refer to both the original version or the previous consolidated version, and to the legislations making the change." ;
    owl:equivalentProperty eli:consolidates ;
    skos:definition "Indicates another legislation taken into account in this consolidated legislation (which is usually the product of an editorial process that revises the legislation). This property should be used multiple times to refer to both the original version or the previous consolidated version, and to the legislations making the change." ;
    skos:exactMatch eli:consolidates .

:legislationCorrects a owl:ObjectProperty ;
    rdfs:label "legislationCorrects" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Another legislation in which this one introduces textual changes, like correction of spelling mistakes, with no legal impact (for modifications that have legal impact, use <a href=\"/legislationAmends\">legislationAmends</a>)." ;
    owl:equivalentProperty eli:corrects ;
    skos:definition "Another legislation in which this one introduces textual changes, like correction of spelling mistakes, with no legal impact (for modifications that have legal impact, use <a href=\"/legislationAmends\">legislationAmends</a>)." ;
    skos:exactMatch eli:corrects .

:legislationCountersignedBy a owl:ObjectProperty ;
    rdfs:label "legislationCountersignedBy" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The person or organization that countersigned the legislation. Depending on the legal context, a countersignature can indicate that the signed authority undertakes to assume responsibility for texts emanating from a person who is inviolable and irresponsible, (for example a King, Grand Duc or President), or that the authority is in charge of the implementation of the text." ;
    owl:equivalentProperty eli:countersigned_by ;
    skos:definition "The person or organization that countersigned the legislation. Depending on the legal context, a countersignature can indicate that the signed authority undertakes to assume responsibility for texts emanating from a person who is inviolable and irresponsible, (for example a King, Grand Duc or President), or that the authority is in charge of the implementation of the text." ;
    skos:exactMatch eli:countersigned_by .

:legislationDate a owl:DatatypeProperty ;
    rdfs:label "legislationDate" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The date of adoption or signature of the legislation. This is the date at which the text is officially aknowledged to be a legislation, even though it might not even be published or in force." ;
    rdfs:subPropertyOf :dateCreated ;
    owl:equivalentProperty eli:date_document ;
    skos:definition "The date of adoption or signature of the legislation. This is the date at which the text is officially aknowledged to be a legislation, even though it might not even be published or in force." ;
    skos:exactMatch eli:date_document .

:legislationDateOfApplicability a owl:DatatypeProperty ;
    rdfs:label "legislationDateOfApplicability" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The date at which the Legislation becomes applicable. This can sometimes be distinct from the date of entry into force : a text may come in force today, and state it will become applicable in 3 months." ;
    owl:equivalentProperty eli:date_applicability ;
    skos:definition "The date at which the Legislation becomes applicable. This can sometimes be distinct from the date of entry into force : a text may come in force today, and state it will become applicable in 3 months." ;
    skos:exactMatch eli:date_applicability .

:legislationDateVersion a owl:DatatypeProperty ;
    rdfs:label "legislationDateVersion" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The point-in-time at which the provided description of the legislation is valid (e.g.: when looking at the law on the 2016-04-07 (= dateVersion), I get the consolidation of 2015-04-12 of the \"National Insurance Contributions Act 2015\")" ;
    owl:equivalentProperty eli:version_date ;
    skos:definition "The point-in-time at which the provided description of the legislation is valid (e.g.: when looking at the law on the 2016-04-07 (= dateVersion), I get the consolidation of 2015-04-12 of the \"National Insurance Contributions Act 2015\")" ;
    skos:exactMatch eli:version_date .

:legislationEnsuresImplementationOf a owl:ObjectProperty ;
    rdfs:label "legislationEnsuresImplementationOf" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Indicates that this Legislation ensures the implementation of another Legislation, for example by modifying national legislations so that they do not contradict to an EU regulation or decision. This implies a legal meaning. Transpositions of EU Directive should be captured with <a href=\"/legislationTransposes\">legislationTransposes</a>." ;
    rdfs:subPropertyOf :legislationApplies ;
    owl:equivalentProperty eli:ensures_implementation_of ;
    skos:definition "Indicates that this Legislation ensures the implementation of another Legislation, for example by modifying national legislations so that they do not contradict to an EU regulation or decision. This implies a legal meaning. Transpositions of EU Directive should be captured with <a href=\"/legislationTransposes\">legislationTransposes</a>." ;
    skos:exactMatch eli:ensures_implementation_of .

:legislationIdentifier a owl:DatatypeProperty ;
    rdfs:label "legislationIdentifier" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "An identifier for the legislation. This can be either a string-based identifier, like the CELEX at EU level or the NOR in France, or a web-based, URL/URI identifier, like an ELI (European Legislation Identifier) or an URN-Lex." ;
    rdfs:subPropertyOf :identifier ;
    skos:closeMatch eli:id_local ;
    skos:definition "An identifier for the legislation. This can be either a string-based identifier, like the CELEX at EU level or the NOR in France, or a web-based, URL/URI identifier, like an ELI (European Legislation Identifier) or an URN-Lex." .

:legislationJurisdiction a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "legislationJurisdiction" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AdministrativeArea,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The jurisdiction from which the legislation originates." ;
    rdfs:subPropertyOf :jurisdiction,
        :spatialCoverage ;
    owl:equivalentProperty eli:jurisdiction ;
    skos:definition "The jurisdiction from which the legislation originates." ;
    skos:exactMatch eli:jurisdiction .

:legislationLegalForce a owl:ObjectProperty ;
    rdfs:label "legislationLegalForce" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :LegalForceStatus ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Whether the legislation is currently in force, not in force, or partially in force." ;
    owl:equivalentProperty eli:in_force ;
    skos:definition "Whether the legislation is currently in force, not in force, or partially in force." ;
    skos:exactMatch eli:in_force .

:legislationLegalValue a owl:ObjectProperty ;
    rdfs:label "legislationLegalValue" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :LegislationObject ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :LegalValueLevel ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The legal value of this legislation file. The same legislation can be written in multiple files with different legal values. Typically a digitally signed PDF have a \"stronger\" legal value than the HTML file of the same act." ;
    owl:equivalentProperty eli:legal_value ;
    skos:definition "The legal value of this legislation file. The same legislation can be written in multiple files with different legal values. Typically a digitally signed PDF have a \"stronger\" legal value than the HTML file of the same act." ;
    skos:exactMatch eli:legal_value .

:legislationPassedBy a owl:ObjectProperty ;
    rdfs:label "legislationPassedBy" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The person or organization that originally passed or made the law: typically parliament (for primary legislation) or government (for secondary legislation). This indicates the \"legal author\" of the law, as opposed to its physical author." ;
    rdfs:subPropertyOf :creator ;
    owl:equivalentProperty eli:passed_by ;
    skos:definition "The person or organization that originally passed or made the law: typically parliament (for primary legislation) or government (for secondary legislation). This indicates the \"legal author\" of the law, as opposed to its physical author." ;
    skos:exactMatch eli:passed_by .

:legislationRepeals a owl:ObjectProperty ;
    rdfs:label "legislationRepeals" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/2698>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Another legislation that this legislation repeals (cancels, abrogates)." ;
    rdfs:subPropertyOf :legislationChanges ;
    owl:equivalentProperty eli:repeals ;
    skos:definition "Another legislation that this legislation repeals (cancels, abrogates)." ;
    skos:exactMatch eli:repeals .

:legislationResponsible a owl:ObjectProperty ;
    rdfs:label "legislationResponsible" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "An individual or organization that has some kind of responsibility for the legislation. Typically the ministry who is/was in charge of elaborating the legislation, or the adressee for potential questions about the legislation once it is published." ;
    owl:equivalentProperty eli:responsibility_of ;
    skos:definition "An individual or organization that has some kind of responsibility for the legislation. Typically the ministry who is/was in charge of elaborating the legislation, or the adressee for potential questions about the legislation once it is published." ;
    skos:exactMatch eli:responsibility_of .

:legislationTransposes a owl:ObjectProperty ;
    rdfs:label "legislationTransposes" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Legislation ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Indicates that this legislation (or part of legislation) fulfills the objectives set by another legislation, by passing appropriate implementation measures. Typically, some legislations of European Union's member states or regions transpose European Directives. This indicates a legally binding link between the 2 legislations." ;
    rdfs:subPropertyOf :legislationApplies ;
    owl:equivalentProperty eli:transposes ;
    skos:definition "Indicates that this legislation (or part of legislation) fulfills the objectives set by another legislation, by passing appropriate implementation measures. Typically, some legislations of European Union's member states or regions transpose European Directives. This indicates a legally binding link between the 2 legislations." ;
    skos:exactMatch eli:transposes .

:legislationType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "legislationType" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :domainIncludes :Legislation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CategoryCode,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "The type of the legislation. Examples of values are \"law\", \"act\", \"directive\", \"decree\", \"regulation\", \"statutory instrument\", \"loi organique\", \"règlement grand-ducal\", etc., depending on the country." ;
    rdfs:subPropertyOf :genre ;
    owl:equivalentProperty eli:type_document ;
    skos:definition "The type of the legislation. Examples of values are \"law\", \"act\", \"directive\", \"decree\", \"regulation\", \"statutory instrument\", \"loi organique\", \"règlement grand-ducal\", etc., depending on the country." ;
    skos:exactMatch eli:type_document .

:leiCode a owl:DatatypeProperty ;
    rdfs:label "leiCode" ;
    :contributor <http://schema.org/docs/collab/FIBO>,
        <http://schema.org/docs/collab/GLEIF> ;
    :domainIncludes :Organization ;
    :rangeIncludes :Text ;
    rdfs:comment "An organization identifier that uniquely identifies a legal entity as defined in ISO 17442." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/hasLegalEntityIdentifier>,
        <https://www.gleif.org/ontology/L1/hasLEI> ;
    skos:definition "An organization identifier that uniquely identifies a legal entity as defined in ISO 17442." .

:lender a owl:ObjectProperty ;
    rdfs:label "lender" ;
    :domainIncludes :BorrowAction ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A sub property of participant. The person that lends the object being borrowed." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The person that lends the object being borrowed." .

:lesser a owl:ObjectProperty ;
    rdfs:label "lesser" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :QualitativeValue ;
    :rangeIncludes :QualitativeValue ;
    rdfs:comment "This ordering relation for qualitative values indicates that the subject is lesser than the object." ;
    skos:definition "This ordering relation for qualitative values indicates that the subject is lesser than the object." .

:lesserOrEqual a owl:ObjectProperty ;
    rdfs:label "lesserOrEqual" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :QualitativeValue ;
    :rangeIncludes :QualitativeValue ;
    rdfs:comment "This ordering relation for qualitative values indicates that the subject is lesser than or equal to the object." ;
    skos:definition "This ordering relation for qualitative values indicates that the subject is lesser than or equal to the object." .

:letterer a owl:ObjectProperty ;
    rdfs:label "letterer" ;
    :domainIncludes :ComicIssue,
        :ComicStory,
        :VisualArtwork ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Person ;
    rdfs:comment "The individual who adds lettering, including speech balloons and sound effects, to artwork." ;
    skos:definition "The individual who adds lettering, including speech balloons and sound effects, to artwork." .

:license a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "license" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :CreativeWork,
        :URL ;
    rdfs:comment "A license document that applies to this content, typically indicated by URL." ;
    skos:definition "A license document that applies to this content, typically indicated by URL." .

:lifeEvent a owl:ObjectProperty ;
    rdfs:label "lifeEvent" ;
    :domainIncludes :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Event ;
    :source <https://github.com/schemaorg/schemaorg/issues/4540> ;
    rdfs:comment "A life event like baptism, communions, Bar Mitzvahs, Aqiqah, Namakarana, Miyamairi, burial, ...." ;
    skos:definition "A life event like baptism, communions, Bar Mitzvahs, Aqiqah, Namakarana, Miyamairi, burial, ...." .

:line a owl:DatatypeProperty ;
    rdfs:label "line" ;
    :domainIncludes :GeoShape ;
    :rangeIncludes :Text ;
    rdfs:comment "A line is a point-to-point path consisting of two or more points. A line is expressed as a series of two or more point objects separated by space." ;
    skos:definition "A line is a point-to-point path consisting of two or more points. A line is expressed as a series of two or more point objects separated by space." .

:linkRelationship a owl:DatatypeProperty ;
    rdfs:label "linkRelationship" ;
    :domainIncludes :LinkRole ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1045> ;
    rdfs:comment "Indicates the relationship type of a Web link. " ;
    skos:definition "Indicates the relationship type of a Web link. " .

:liveBlogUpdate a owl:ObjectProperty ;
    rdfs:label "liveBlogUpdate" ;
    :domainIncludes :LiveBlogPosting ;
    :rangeIncludes :BlogPosting ;
    rdfs:comment "An update to the LiveBlog." ;
    skos:definition "An update to the LiveBlog." .

:loanMortgageMandateAmount a owl:ObjectProperty ;
    rdfs:label "loanMortgageMandateAmount" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :MortgageLoan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "Amount of mortgage mandate that can be converted into a proper mortgage at a later stage." ;
    skos:definition "Amount of mortgage mandate that can be converted into a proper mortgage at a later stage." .

:loanPaymentAmount a owl:ObjectProperty ;
    rdfs:label "loanPaymentAmount" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :RepaymentSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The amount of money to pay in a single payment." ;
    skos:definition "The amount of money to pay in a single payment." .

:loanPaymentFrequency a owl:DatatypeProperty ;
    rdfs:label "loanPaymentFrequency" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :RepaymentSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "Frequency of payments due, i.e. number of months between payments. This is defined as a frequency, i.e. the reciprocal of a period of time." ;
    skos:definition "Frequency of payments due, i.e. number of months between payments. This is defined as a frequency, i.e. the reciprocal of a period of time." .

:loanRepaymentForm a owl:ObjectProperty ;
    rdfs:label "loanRepaymentForm" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :RepaymentSpecification ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A form of paying back money previously borrowed from a lender. Repayment usually takes the form of periodic payments that normally include part principal plus interest in each payment." ;
    skos:definition "A form of paying back money previously borrowed from a lender. Repayment usually takes the form of periodic payments that normally include part principal plus interest in each payment." .

:loanTerm a owl:ObjectProperty ;
    rdfs:label "loanTerm" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The duration of the loan or credit agreement." ;
    rdfs:subPropertyOf :duration ;
    skos:definition "The duration of the loan or credit agreement." .

:loanType a owl:DatatypeProperty ;
    rdfs:label "loanType" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The type of a loan or credit." ;
    skos:definition "The type of a loan or credit." .

:locationCreated a owl:ObjectProperty ;
    rdfs:label "locationCreated" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Place ;
    rdfs:comment "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork." ;
    skos:definition "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork." .

:lodgingUnitDescription a owl:DatatypeProperty ;
    rdfs:label "lodgingUnitDescription" ;
    :domainIncludes :LodgingReservation ;
    :rangeIncludes :Text ;
    rdfs:comment "A full description of the lodging unit." ;
    skos:definition "A full description of the lodging unit." .

:lodgingUnitType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "lodgingUnitType" ;
    :domainIncludes :LodgingReservation ;
    :rangeIncludes :QualitativeValue,
        :Text ;
    rdfs:comment "Textual description of the unit type (including suite vs. room, size of bed, etc.)." ;
    skos:definition "Textual description of the unit type (including suite vs. room, size of bed, etc.)." .

:logo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "logo" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Brand,
        :Certification,
        :Organization,
        :Place,
        :Product,
        :Service ;
    :rangeIncludes :ImageObject,
        :URL ;
    rdfs:comment "An associated logo." ;
    rdfs:subPropertyOf :image ;
    owl:equivalentProperty unece:logoReferencedDocument ;
    skos:definition "An associated logo." .

:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    :domainIncludes :GeoCoordinates,
        :Place ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The longitude of a location. For example ```-122.08585``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." ;
    rdfs:subPropertyOf cmns-loc:hasLongitude ;
    skos:definition "The longitude of a location. For example ```-122.08585``` ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System))." .

:loser a owl:ObjectProperty ;
    rdfs:label "loser" ;
    :domainIncludes :WinAction ;
    :rangeIncludes :Person ;
    rdfs:comment "A sub property of participant. The loser of the action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The loser of the action." .

:lowPrice a owl:DatatypeProperty ;
    rdfs:label "lowPrice" ;
    :domainIncludes :AggregateOffer ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The lowest price of all offers available.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasMonetaryAmount>,
        cmns-qtu:hasLowerBound ;
    skos:definition "The lowest price of all offers available.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

:lyricist a owl:ObjectProperty ;
    rdfs:label "lyricist" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :Person ;
    rdfs:comment "The person who wrote the words." ;
    skos:definition "The person who wrote the words." .

:lyrics a owl:ObjectProperty ;
    rdfs:label "lyrics" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "The words in the song." ;
    skos:definition "The words in the song." .

:maintainer a owl:ObjectProperty ;
    rdfs:label "maintainer" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/2311> ;
    rdfs:comment """A maintainer of a [[Dataset]], software package ([[SoftwareApplication]]), or other [[Project]]. A maintainer is a [[Person]] or [[Organization]] that manages contributions to, and/or publication of, some (typically complex) artifact. It is common for distributions of software and data to be based on "upstream" sources. When [[maintainer]] is applied to a specific version of something e.g. a particular version or packaging of a [[Dataset]], it is always  possible that the upstream source has a different maintainer. The [[isBasedOn]] property can be used to indicate such relationships between datasets to make the different maintenance roles clear. Similarly in the case of software, a package may have dedicated maintainers working on integration into software distributions such as Ubuntu, as well as upstream maintainers of the underlying work.
      """ ;
    skos:definition """A maintainer of a [[Dataset]], software package ([[SoftwareApplication]]), or other [[Project]]. A maintainer is a [[Person]] or [[Organization]] that manages contributions to, and/or publication of, some (typically complex) artifact. It is common for distributions of software and data to be based on "upstream" sources. When [[maintainer]] is applied to a specific version of something e.g. a particular version or packaging of a [[Dataset]], it is always  possible that the upstream source has a different maintainer. The [[isBasedOn]] property can be used to indicate such relationships between datasets to make the different maintenance roles clear. Similarly in the case of software, a package may have dedicated maintainers working on integration into software distributions such as Ubuntu, as well as upstream maintainers of the underlying work.
      """ .

:manufacturer a owl:ObjectProperty ;
    rdfs:label "manufacturer" ;
    :domainIncludes :Product ;
    :rangeIncludes :Organization ;
    rdfs:comment "The manufacturer of the product." ;
    rdfs:subPropertyOf fibo-fnd-pas:isProvisionedBy ;
    owl:equivalentProperty unece:manufacturerParty,
        gs1:manufacturer ;
    skos:definition "The manufacturer of the product." .

:map a owl:DatatypeProperty ;
    rdfs:label "map" ;
    :domainIncludes :Place ;
    :rangeIncludes :URL ;
    :supersededBy :hasMap ;
    rdfs:comment "A URL to a map of the place." ;
    skos:definition "A URL to a map of the place." .

:mapType a owl:ObjectProperty ;
    rdfs:label "mapType" ;
    :domainIncludes :Map ;
    :rangeIncludes :MapCategoryType ;
    rdfs:comment "Indicates the kind of Map, from the MapCategoryType Enumeration." ;
    skos:definition "Indicates the kind of Map, from the MapCategoryType Enumeration." .

:maps a owl:DatatypeProperty ;
    rdfs:label "maps" ;
    :domainIncludes :Place ;
    :rangeIncludes :URL ;
    :supersededBy :hasMap ;
    rdfs:comment "A URL to a map of the place." ;
    skos:definition "A URL to a map of the place." .

:marginOfError a owl:ObjectProperty ;
    rdfs:label "marginOfError" ;
    :domainIncludes :Observation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2291> ;
    rdfs:comment "A [[marginOfError]] for an [[Observation]]." ;
    skos:definition "A [[marginOfError]] for an [[Observation]]." .

:masthead a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "masthead" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For a [[NewsMediaOrganization]], a link to the masthead page or a page listing top editorial management." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For a [[NewsMediaOrganization]], a link to the masthead page or a page listing top editorial management." .

:materialExtent a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "materialExtent"@en ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1759> ;
    rdfs:comment "The quantity of the materials being described or an expression of the physical space they occupy."@en ;
    skos:definition "The quantity of the materials being described or an expression of the physical space they occupy."@en .

:mathExpression a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "mathExpression" ;
    :domainIncludes :MathSolver ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :SolveMathAction,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2740> ;
    rdfs:comment "A mathematical expression (e.g. 'x^2-3x=0') that may be solved for a specific variable, simplified, or transformed. This can take many formats, e.g. LaTeX, Ascii-Math, or math as you would write with a keyboard." ;
    skos:definition "A mathematical expression (e.g. 'x^2-3x=0') that may be solved for a specific variable, simplified, or transformed. This can take many formats, e.g. LaTeX, Ascii-Math, or math as you would write with a keyboard." .

:maxPrice a owl:DatatypeProperty ;
    rdfs:label "maxPrice" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :PriceSpecification ;
    :rangeIncludes :Number ;
    rdfs:comment "The highest price if the price is a range." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasMonetaryAmount>,
        cmns-qtu:hasUpperBound ;
    skos:definition "The highest price if the price is a range." .

:maxValue a owl:DatatypeProperty ;
    rdfs:label "maxValue" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :MonetaryAmount,
        :PropertyValue,
        :PropertyValueSpecification,
        :QuantitativeValue ;
    :rangeIncludes :Number ;
    rdfs:comment "The upper value of some characteristic or property." ;
    rdfs:subPropertyOf cmns-qtu:hasUpperBound ;
    skos:definition "The upper value of some characteristic or property." .

:maximumAttendeeCapacity a owl:DatatypeProperty ;
    rdfs:label "maximumAttendeeCapacity" ;
    :domainIncludes :Event,
        :Place ;
    :rangeIncludes :Integer ;
    rdfs:comment "The total number of individuals that may attend an event or venue." ;
    rdfs:subPropertyOf cmns-qtu:hasUpperBound ;
    skos:definition "The total number of individuals that may attend an event or venue." .

:maximumEnrollment a owl:DatatypeProperty ;
    rdfs:label "maximumEnrollment" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The maximum number of students who may be enrolled in the program." ;
    skos:definition "The maximum number of students who may be enrolled in the program." .

:maximumIntake a owl:ObjectProperty ;
    rdfs:label "maximumIntake" ;
    :domainIncludes :DietarySupplement,
        :Drug,
        :DrugStrength,
        :Substance ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MaximumDoseSchedule ;
    rdfs:comment "Recommended intake of this supplement for a given population as defined by a specific recommending authority." ;
    skos:definition "Recommended intake of this supplement for a given population as defined by a specific recommending authority." .

:maximumPhysicalAttendeeCapacity a owl:DatatypeProperty ;
    rdfs:label "maximumPhysicalAttendeeCapacity" ;
    :domainIncludes :Event ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1842> ;
    rdfs:comment "The maximum physical attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OfflineEventAttendanceMode]] (or the offline aspects, in the case of a [[MixedEventAttendanceMode]]). " ;
    skos:definition "The maximum physical attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OfflineEventAttendanceMode]] (or the offline aspects, in the case of a [[MixedEventAttendanceMode]]). " .

:maximumVirtualAttendeeCapacity a owl:DatatypeProperty ;
    rdfs:label "maximumVirtualAttendeeCapacity" ;
    :domainIncludes :Event ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1842> ;
    rdfs:comment "The maximum virtual attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OnlineEventAttendanceMode]] (or the online aspects, in the case of a [[MixedEventAttendanceMode]]). " ;
    skos:definition "The maximum virtual attendee capacity of an [[Event]] whose [[eventAttendanceMode]] is [[OnlineEventAttendanceMode]] (or the online aspects, in the case of a [[MixedEventAttendanceMode]]). " .

:mealService a owl:DatatypeProperty ;
    rdfs:label "mealService" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text ;
    rdfs:comment "Description of the meals that will be provided or available for purchase." ;
    skos:definition "Description of the meals that will be provided or available for purchase." .

:measuredProperty a owl:ObjectProperty ;
    rdfs:label "measuredProperty" ;
    :domainIncludes :Observation,
        :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Property ;
    :source <https://github.com/schemaorg/schemaorg/issues/2291> ;
    rdfs:comment "The measuredProperty of an [[Observation]], typically via its [[StatisticalVariable]]. There are various kinds of applicable [[Property]]: a schema.org property, a property from other RDF-compatible systems, e.g. W3C RDF Data Cube, Data Commons, Wikidata, or schema.org extensions such as [GS1's](https://www.gs1.org/voc/?show=properties)." ;
    skos:definition "The measuredProperty of an [[Observation]], typically via its [[StatisticalVariable]]. There are various kinds of applicable [[Property]]: a schema.org property, a property from other RDF-compatible systems, e.g. W3C RDF Data Cube, Data Commons, Wikidata, or schema.org extensions such as [GS1's](https://www.gs1.org/voc/?show=properties)." .

:measurementDenominator a owl:ObjectProperty ;
    rdfs:label "measurementDenominator" ;
    :domainIncludes :Observation,
        :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :StatisticalVariable ;
    :source <https://github.com/schemaorg/schemaorg/issues/2564> ;
    rdfs:comment "Identifies the denominator variable when an observation represents a ratio or percentage." ;
    skos:definition "Identifies the denominator variable when an observation represents a ratio or percentage." .

:measurementMethod a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "measurementMethod" ;
    :domainIncludes :DataCatalog,
        :DataDownload,
        :Dataset,
        :Observation,
        :PropertyValue,
        :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :MeasurementMethodEnum,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1425> ;
    rdfs:comment "A subproperty of [[measurementTechnique]] that can be used for specifying specific methods, in particular via [[MeasurementMethodEnum]]." ;
    rdfs:subPropertyOf :measurementTechnique ;
    skos:definition "A subproperty of [[measurementTechnique]] that can be used for specifying specific methods, in particular via [[MeasurementMethodEnum]]." .

:measurementQualifier a owl:ObjectProperty ;
    rdfs:label "measurementQualifier" ;
    :domainIncludes :Observation,
        :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Enumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2564> ;
    rdfs:comment "Provides additional qualification to an observation. For example, a GDP observation measures the Nominal value." ;
    skos:definition "Provides additional qualification to an observation. For example, a GDP observation measures the Nominal value." .

:mechanismOfAction a owl:DatatypeProperty ;
    rdfs:label "mechanismOfAction" ;
    :domainIncludes :DietarySupplement,
        :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The specific biochemical interaction through which this drug or supplement produces its pharmacological effect." ;
    skos:definition "The specific biochemical interaction through which this drug or supplement produces its pharmacological effect." .

:mediaAuthenticityCategory a owl:ObjectProperty ;
    rdfs:label "mediaAuthenticityCategory" ;
    :domainIncludes :MediaReview ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MediaManipulationRatingEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "Indicates a MediaManipulationRatingEnumeration classification of a media object (in the context of how it was published or shared)." ;
    skos:definition "Indicates a MediaManipulationRatingEnumeration classification of a media object (in the context of how it was published or shared)." .

