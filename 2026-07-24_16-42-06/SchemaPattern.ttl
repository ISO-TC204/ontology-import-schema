    skos:definition "numventuse - MECHANICAL VENTILATORS IN USE: Total number of ventilators in use." .

:data a owl:ObjectProperty ;
    rdfs:label "data" ;
    :domainIncludes :InstantaneousEvent ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Thing ;
    :source <https://github.com/schemaorg/schemaorg/issues/4527> ;
    rdfs:comment "Data associated with the event, like for instance a log message." ;
    skos:definition "Data associated with the event, like for instance a log message." .

:dataFeedElement a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "dataFeedElement" ;
    :domainIncludes :DataFeed ;
    :rangeIncludes :DataFeedItem,
        :Text,
        :Thing ;
    rdfs:comment "An item within a data feed. Data feeds may have many elements." ;
    skos:definition "An item within a data feed. Data feeds may have many elements." .

:datasetTimeInterval a owl:DatatypeProperty ;
    rdfs:label "datasetTimeInterval" ;
    :domainIncludes :Dataset ;
    :rangeIncludes :DateTime ;
    :supersededBy :temporalCoverage ;
    rdfs:comment "The range of temporal applicability of a dataset, e.g. for a 2011 census dataset, the year 2011 (in ISO 8601 time interval format)." ;
    skos:definition "The range of temporal applicability of a dataset, e.g. for a 2011 census dataset, the year 2011 (in ISO 8601 time interval format)." .

:dateDeleted a owl:DatatypeProperty ;
    rdfs:label "dateDeleted" ;
    :domainIncludes :DataFeedItem ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The datetime the item was removed from the DataFeed." ;
    skos:definition "The datetime the item was removed from the DataFeed." .

:dateIssued a owl:DatatypeProperty ;
    rdfs:label "dateIssued" ;
    :domainIncludes :Ticket ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date the ticket was issued." ;
    skos:definition "The date the ticket was issued." .

:dateModified a owl:DatatypeProperty ;
    rdfs:label "dateModified" ;
    :domainIncludes :CreativeWork,
        :DataFeedItem ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed." ;
    skos:definition "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed." .

:datePosted a owl:DatatypeProperty ;
    rdfs:label "datePosted" ;
    :domainIncludes :CDCPMDRecord,
        :JobPosting,
        :RealEstateListing,
        :SpecialAnnouncement ;
    :rangeIncludes :Date,
        :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490>,
        <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "Publication date of an online listing." ;
    skos:definition "Publication date of an online listing." .

:datePublished a owl:DatatypeProperty ;
    rdfs:label "datePublished" ;
    :domainIncludes :Certification,
        :CreativeWork ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "Date of first publication or broadcast. For example the date a [[CreativeWork]] was broadcast or a [[Certification]] was issued." ;
    skos:definition "Date of first publication or broadcast. For example the date a [[CreativeWork]] was broadcast or a [[Certification]] was issued." .

:dateRead a owl:DatatypeProperty ;
    rdfs:label "dateRead" ;
    :domainIncludes :Message ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date/time at which the message has been read by the recipient if a single recipient exists." ;
    skos:definition "The date/time at which the message has been read by the recipient if a single recipient exists." .

:dateReceived a owl:DatatypeProperty ;
    rdfs:label "dateReceived" ;
    :domainIncludes :Message ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The date/time the message was received if a single recipient exists." ;
    skos:definition "The date/time the message was received if a single recipient exists." .

:dateSent a owl:DatatypeProperty ;
    rdfs:label "dateSent" ;
    :domainIncludes :Message ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The date/time at which the message was sent." ;
    skos:definition "The date/time at which the message was sent." .

:dateVehicleFirstRegistered a owl:DatatypeProperty ;
    rdfs:label "dateVehicleFirstRegistered" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Date ;
    rdfs:comment "The date of the first registration of the vehicle with the respective public authorities." ;
    skos:definition "The date of the first registration of the vehicle with the respective public authorities." .

:dateline a owl:DatatypeProperty ;
    rdfs:label "dateline" ;
    :domainIncludes :NewsArticle ;
    :rangeIncludes :Text ;
    rdfs:comment """A [dateline](https://en.wikipedia.org/wiki/Dateline) is a brief piece of text included in news articles that describes where and when the story was written or filed though the date is often omitted. Sometimes only a placename is provided.

Structured representations of dateline-related information can also be expressed more explicitly using [[locationCreated]] (which represents where a work was created, e.g. where a news report was written).  For location depicted or described in the content, use [[contentLocation]].

Dateline summaries are oriented more towards human readers than towards automated processing, and can vary substantially. Some examples: "BEIRUT, Lebanon, June 2.", "Paris, France", "December 19, 2017 11:43AM Reporting from Washington", "Beijing/Moscow", "QUEZON CITY, Philippines".
      """ ;
    skos:definition """A [dateline](https://en.wikipedia.org/wiki/Dateline) is a brief piece of text included in news articles that describes where and when the story was written or filed though the date is often omitted. Sometimes only a placename is provided.

Structured representations of dateline-related information can also be expressed more explicitly using [[locationCreated]] (which represents where a work was created, e.g. where a news report was written).  For location depicted or described in the content, use [[contentLocation]].

Dateline summaries are oriented more towards human readers than towards automated processing, and can vary substantially. Some examples: "BEIRUT, Lebanon, June 2.", "Paris, France", "December 19, 2017 11:43AM Reporting from Washington", "Beijing/Moscow", "QUEZON CITY, Philippines".
      """ .

:dayOfWeek a owl:ObjectProperty ;
    rdfs:label "dayOfWeek" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :EducationalOccupationalProgram,
        :OpeningHoursSpecification ;
    :rangeIncludes :DayOfWeek ;
    rdfs:comment "The day of the week for which these opening hours are valid." ;
    skos:definition "The day of the week for which these opening hours are valid." .

:deathDate a owl:DatatypeProperty ;
    rdfs:label "deathDate" ;
    :domainIncludes :Person ;
    :rangeIncludes :Date ;
    rdfs:comment "Date of death." ;
    skos:definition "Date of death." .

:deathPlace a owl:ObjectProperty ;
    rdfs:label "deathPlace" ;
    :domainIncludes :Person ;
    :rangeIncludes :Place ;
    rdfs:comment "The place where the person died." ;
    skos:definition "The place where the person died." .

:defaultValue a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "defaultValue" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Text,
        :Thing ;
    rdfs:comment "The default value of the input.  For properties that expect a literal, the default is a literal value, for properties that expect an object, it's an ID reference to one of the current values." ;
    skos:definition "The default value of the input.  For properties that expect a literal, the default is a literal value, for properties that expect an object, it's an ID reference to one of the current values." .

:deliveryAddress a owl:ObjectProperty ;
    rdfs:label "deliveryAddress" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :PostalAddress ;
    rdfs:comment "Destination address." ;
    owl:equivalentProperty unece:ShipToAddress ;
    skos:definition "Destination address." .

:deliveryLeadTime a owl:ObjectProperty ;
    rdfs:label "deliveryLeadTime" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup." ;
    skos:definition "The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup." .

:deliveryMethod a owl:ObjectProperty ;
    rdfs:label "deliveryMethod" ;
    :domainIncludes :OrderAction,
        :ReceiveAction,
        :SendAction,
        :TrackAction ;
    :rangeIncludes :DeliveryMethod ;
    rdfs:comment "A sub property of instrument. The method of delivery." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The method of delivery." .

:deliveryStatus a owl:ObjectProperty ;
    rdfs:label "deliveryStatus" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :DeliveryEvent ;
    rdfs:comment "New entry added as the package passes through each leg of its journey (from shipment to final delivery)." ;
    skos:definition "New entry added as the package passes through each leg of its journey (from shipment to final delivery)." .

:deliveryTime a owl:ObjectProperty ;
    rdfs:label "deliveryTime" ;
    :domainIncludes :OfferShippingDetails ;
    :rangeIncludes :ShippingDeliveryTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "The total delay between the receipt of the order and the goods reaching the final customer." ;
    skos:definition "The total delay between the receipt of the order and the goods reaching the final customer." .

:department a owl:ObjectProperty ;
    rdfs:label "department" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Organization ;
    rdfs:comment "A relationship between an organization and a department of that organization, also described as an organization (allowing different urls, logos, opening hours). For example: a store with a pharmacy, or a bakery with a cafe." ;
    skos:definition "A relationship between an organization and a department of that organization, also described as an organization (allowing different urls, logos, opening hours). For example: a store with a pharmacy, or a bakery with a cafe." .

:departureAirport a owl:ObjectProperty ;
    rdfs:label "departureAirport" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Airport ;
    rdfs:comment "The airport where the flight originates." ;
    skos:definition "The airport where the flight originates." .

:departureBoatTerminal a owl:ObjectProperty ;
    rdfs:label "departureBoatTerminal" ;
    :domainIncludes :BoatTrip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :BoatTerminal ;
    :source <https://github.com/schemaorg/schemaorg/issues/1755> ;
    rdfs:comment "The terminal or port from which the boat departs." ;
    skos:definition "The terminal or port from which the boat departs." .

:departureBusStop a owl:ObjectProperty ;
    rdfs:label "departureBusStop" ;
    :domainIncludes :BusTrip ;
    :rangeIncludes :BusStation,
        :BusStop ;
    rdfs:comment "The stop or station from which the bus departs." ;
    skos:definition "The stop or station from which the bus departs." .

:departureGate a owl:DatatypeProperty ;
    rdfs:label "departureGate" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text ;
    rdfs:comment "Identifier of the flight's departure gate." ;
    skos:definition "Identifier of the flight's departure gate." .

:departurePlatform a owl:DatatypeProperty ;
    rdfs:label "departurePlatform" ;
    :domainIncludes :TrainTrip ;
    :rangeIncludes :Text ;
    rdfs:comment "The platform from which the train departs." ;
    skos:definition "The platform from which the train departs." .

:departureStation a owl:ObjectProperty ;
    rdfs:label "departureStation" ;
    :domainIncludes :TrainTrip ;
    :rangeIncludes :TrainStation ;
    rdfs:comment "The station from which the train departs." ;
    skos:definition "The station from which the train departs." .

:departureTerminal a owl:DatatypeProperty ;
    rdfs:label "departureTerminal" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text ;
    rdfs:comment "Identifier of the flight's departure terminal." ;
    skos:definition "Identifier of the flight's departure terminal." .

:departureTime a owl:DatatypeProperty ;
    rdfs:label "departureTime" ;
    :domainIncludes :Trip ;
    :rangeIncludes :DateTime,
        :Time ;
    rdfs:comment "The expected departure time." ;
    skos:definition "The expected departure time." .

:dependencies a owl:DatatypeProperty ;
    rdfs:label "dependencies" ;
    :domainIncludes :TechArticle ;
    :rangeIncludes :Text ;
    rdfs:comment "Prerequisites needed to fulfill steps in article." ;
    skos:definition "Prerequisites needed to fulfill steps in article." .

:depth a owl:ObjectProperty ;
    rdfs:label "depth" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OfferShippingDetails,
        :Product,
        :ShippingConditions,
        :VisualArtwork ;
    :rangeIncludes :Distance,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The depth of the item." ;
    skos:definition "The depth of the item." .

:device a owl:DatatypeProperty ;
    rdfs:label "device" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    :supersededBy :availableOnDevice ;
    rdfs:comment "Device required to run the application. Used in cases where a specific make/model is required to run the application." ;
    skos:definition "Device required to run the application. Used in cases where a specific make/model is required to run the application." .

:diagnosis a owl:ObjectProperty ;
    rdfs:label "diagnosis" ;
    :domainIncludes :DDxElement,
        :Patient ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalCondition ;
    rdfs:comment "One or more alternative conditions considered in the differential diagnosis process as output of a diagnosis process." ;
    skos:definition "One or more alternative conditions considered in the differential diagnosis process as output of a diagnosis process." .

:diagram a owl:ObjectProperty ;
    rdfs:label "diagram" ;
    :domainIncludes :AnatomicalStructure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :ImageObject ;
    rdfs:comment "An image containing a diagram that illustrates the structure and/or its component substructures and/or connections with other structures." ;
    skos:definition "An image containing a diagram that illustrates the structure and/or its component substructures and/or connections with other structures." .

:diet a owl:ObjectProperty ;
    rdfs:label "diet" ;
    :domainIncludes :ExerciseAction ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Diet ;
    rdfs:comment "A sub property of instrument. The diet used in this action." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The diet used in this action." .

:dietFeatures a owl:DatatypeProperty ;
    rdfs:label "dietFeatures" ;
    :domainIncludes :Diet ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Nutritional information specific to the dietary plan. May include dietary recommendations on what foods to avoid, what foods to consume, and specific alterations/deviations from the USDA or other regulatory body's approved dietary guidelines." ;
    skos:definition "Nutritional information specific to the dietary plan. May include dietary recommendations on what foods to avoid, what foods to consume, and specific alterations/deviations from the USDA or other regulatory body's approved dietary guidelines." .

:differentialDiagnosis a owl:ObjectProperty ;
    rdfs:label "differentialDiagnosis" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DDxElement ;
    rdfs:comment "One of a set of differential diagnoses for the condition. Specifically, a closely-related or competing diagnosis typically considered later in the cognitive process whereby this medical condition is distinguished from others most likely responsible for a similar collection of signs and symptoms to reach the most parsimonious diagnosis or diagnoses in a patient." ;
    skos:definition "One of a set of differential diagnoses for the condition. Specifically, a closely-related or competing diagnosis typically considered later in the cognitive process whereby this medical condition is distinguished from others most likely responsible for a similar collection of signs and symptoms to reach the most parsimonious diagnosis or diagnoses in a patient." .

:digitalSourceType a owl:ObjectProperty ;
    rdfs:label "digitalSourceType" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :IPTCDigitalSourceEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/3392> ;
    rdfs:comment "Indicates an IPTCDigitalSourceEnumeration code indicating the nature of the digital source(s) for some [[CreativeWork]]." ;
    skos:definition "Indicates an IPTCDigitalSourceEnumeration code indicating the nature of the digital source(s) for some [[CreativeWork]]." .

:directApply a owl:DatatypeProperty ;
    rdfs:label "directApply" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2907> ;
    rdfs:comment "Indicates whether an [[url]] that is associated with a [[JobPosting]] enables direct application for the job, via the posting website. A job posting is considered to have directApply of [[True]] if an application process for the specified job can be directly initiated via the url(s) given (noting that e.g. multiple internet domains might nevertheless be involved at an implementation level). A value of [[False]] is appropriate if there is no clear path to applying directly online for the specified job, navigating directly from the JobPosting url(s) supplied." ;
    skos:definition "Indicates whether an [[url]] that is associated with a [[JobPosting]] enables direct application for the job, via the posting website. A job posting is considered to have directApply of [[True]] if an application process for the specified job can be directly initiated via the url(s) given (noting that e.g. multiple internet domains might nevertheless be involved at an implementation level). A value of [[False]] is appropriate if there is no clear path to applying directly online for the specified job, navigating directly from the JobPosting url(s) supplied." .

:directors a owl:ObjectProperty ;
    rdfs:label "directors" ;
    :domainIncludes :Clip,
        :Episode,
        :Movie,
        :MovieSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGame,
        :VideoGameSeries,
        :VideoObject ;
    :rangeIncludes :Person ;
    :supersededBy :director ;
    rdfs:comment "A director of e.g. TV, radio, movie, video games etc. content. Directors can be associated with individual items or with a series, episode, clip." ;
    skos:definition "A director of e.g. TV, radio, movie, video games etc. content. Directors can be associated with individual items or with a series, episode, clip." .

:disambiguatingDescription a owl:DatatypeProperty ;
    rdfs:label "disambiguatingDescription" ;
    :domainIncludes :Thing ;
    :rangeIncludes :Text ;
    rdfs:comment "A sub property of description. A short description of the item used to disambiguate from other, similar items. Information from other properties (in particular, name) may be necessary for the description to be useful for disambiguation." ;
    rdfs:subPropertyOf :description ;
    skos:definition "A sub property of description. A short description of the item used to disambiguate from other, similar items. Information from other properties (in particular, name) may be necessary for the description to be useful for disambiguation." .

:discount a owl:DatatypeProperty ;
    rdfs:label "discount" ;
    :domainIncludes :Order ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "Any discount applied (to an Order)." ;
    skos:definition "Any discount applied (to an Order)." .

:discountCode a owl:DatatypeProperty ;
    rdfs:label "discountCode" ;
    :domainIncludes :Order ;
    :rangeIncludes :Text ;
    rdfs:comment "Code used to redeem a discount." ;
    skos:definition "Code used to redeem a discount." .

:discountCurrency a owl:DatatypeProperty ;
    rdfs:label "discountCurrency" ;
    :domainIncludes :Order ;
    :rangeIncludes :Text ;
    rdfs:comment "The currency of the discount.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." ;
    skos:definition "The currency of the discount.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." .

:discusses a owl:ObjectProperty ;
    rdfs:label "discusses" ;
    :domainIncludes :UserComments ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "Specifies the CreativeWork associated with the UserComment." ;
    skos:definition "Specifies the CreativeWork associated with the UserComment." .

:discussionUrl a owl:DatatypeProperty ;
    rdfs:label "discussionUrl" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :URL ;
    rdfs:comment "A link to the page containing the comments of the CreativeWork." ;
    skos:definition "A link to the page containing the comments of the CreativeWork." .

:diseasePreventionInfo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "diseasePreventionInfo" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Information about disease prevention." ;
    skos:definition "Information about disease prevention." .

:diseaseSpreadStatistics a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "diseaseSpreadStatistics" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Dataset,
        :Observation,
        :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment """Statistical information about the spread of a disease, either as [[WebContent]], or
  described directly as a [[Dataset]], or the specific [[Observation]]s in the dataset. When a [[WebContent]] URL is
  provided, the page indicated might also contain more such markup.""" ;
    skos:definition """Statistical information about the spread of a disease, either as [[WebContent]], or
  described directly as a [[Dataset]], or the specific [[Observation]]s in the dataset. When a [[WebContent]] URL is
  provided, the page indicated might also contain more such markup.""" .

:displayLocation a owl:ObjectProperty ;
    rdfs:label "displayLocation" ;
    :domainIncludes :CreativeWork,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Place ;
    :source <https://github.com/schemaorg/schemaorg/issues/4513> ;
    rdfs:comment "The location at which an item can be viewed or experienced in-person." ;
    skos:definition "The location at which an item can be viewed or experienced in-person." .

:dissolutionDate a owl:DatatypeProperty ;
    rdfs:label "dissolutionDate" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Date ;
    rdfs:comment "The date that this organization was dissolved." ;
    owl:equivalentProperty gs1:organizationTerminationDate ;
    skos:definition "The date that this organization was dissolved." .

:distance a owl:ObjectProperty ;
    rdfs:label "distance" ;
    :domainIncludes :ExerciseAction,
        :TravelAction ;
    :rangeIncludes :Distance ;
    rdfs:comment "The distance travelled, e.g. exercising or travelling." ;
    skos:definition "The distance travelled, e.g. exercising or travelling." .

:distinguishingSign a owl:ObjectProperty ;
    rdfs:label "distinguishingSign" ;
    :domainIncludes :DDxElement ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalSignOrSymptom ;
    rdfs:comment "One of a set of signs and symptoms that can be used to distinguish this diagnosis from others in the differential diagnosis." ;
    skos:definition "One of a set of signs and symptoms that can be used to distinguish this diagnosis from others in the differential diagnosis." .

:distribution a owl:ObjectProperty ;
    rdfs:label "distribution" ;
    :domainIncludes :Dataset ;
    :rangeIncludes :DataDownload ;
    rdfs:comment "A downloadable form of this dataset, at a specific location, in a specific format. This property can be repeated if different variations are available. There is no expectation that different downloadable distributions must contain exactly equivalent information (see also [DCAT](https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution) on this point). Different distributions might include or exclude different subsets of the entire dataset, for example." ;
    skos:definition "A downloadable form of this dataset, at a specific location, in a specific format. This property can be repeated if different variations are available. There is no expectation that different downloadable distributions must contain exactly equivalent information (see also [DCAT](https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution) on this point). Different distributions might include or exclude different subsets of the entire dataset, for example." .

:diversityPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "diversityPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "Statement on diversity policy by an [[Organization]] e.g. a [[NewsMediaOrganization]]. For a [[NewsMediaOrganization]], a statement describing the newsroom’s diversity policy on both staffing and sources, typically providing staffing data." ;
    skos:definition "Statement on diversity policy by an [[Organization]] e.g. a [[NewsMediaOrganization]]. For a [[NewsMediaOrganization]], a statement describing the newsroom’s diversity policy on both staffing and sources, typically providing staffing data." .

:diversityStaffingReport a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "diversityStaffingReport" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Article,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a report on staffing diversity issues. In a news context this might be for example ASNE or RTDNA (US) reports, or self-reported." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a report on staffing diversity issues. In a news context this might be for example ASNE or RTDNA (US) reports, or self-reported." .

:documentation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "documentation" ;
    :domainIncludes :WebAPI ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1423> ;
    rdfs:comment "Further documentation describing the Web API in more detail." ;
    skos:definition "Further documentation describing the Web API in more detail." .

:doesNotShip a owl:DatatypeProperty ;
    rdfs:label "doesNotShip" ;
    :domainIncludes :OfferShippingDetails,
        :ShippingConditions,
        :ShippingRateSettings ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Indicates when shipping to a particular [[shippingDestination]] is not available." ;
    skos:definition "Indicates when shipping to a particular [[shippingDestination]] is not available." .

:domainIncludes a owl:ObjectProperty ;
    rdfs:label "domainIncludes" ;
    :domainIncludes :Property ;
    :isPartOf <http://meta.schema.org> ;
    :rangeIncludes :Class ;
    rdfs:comment "Relates a property to a class that is (one of) the type(s) the property is expected to be used on." ;
    skos:definition "Relates a property to a class that is (one of) the type(s) the property is expected to be used on." .

:domiciledMortgage a owl:DatatypeProperty ;
    rdfs:label "domiciledMortgage" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :MortgageLoan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "Whether borrower is a resident of the jurisdiction where the property is located." ;
    skos:definition "Whether borrower is a resident of the jurisdiction where the property is located." .

:doorTime a owl:DatatypeProperty ;
    rdfs:label "doorTime" ;
    :domainIncludes :Event ;
    :rangeIncludes :DateTime,
        :Time ;
    rdfs:comment "The time admission will commence." ;
    skos:definition "The time admission will commence." .

:dosageForm a owl:DatatypeProperty ;
    rdfs:label "dosageForm" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "A dosage form in which this drug/supplement is available, e.g. 'tablet', 'suspension', 'injection'." ;
    skos:definition "A dosage form in which this drug/supplement is available, e.g. 'tablet', 'suspension', 'injection'." .

:doseSchedule a owl:ObjectProperty ;
    rdfs:label "doseSchedule" ;
    :domainIncludes :Drug,
        :TherapeuticProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DoseSchedule ;
    rdfs:comment "A dosing schedule for the drug for a given population, either observed, recommended, or maximum dose based on the type used." ;
    skos:definition "A dosing schedule for the drug for a given population, either observed, recommended, or maximum dose based on the type used." .

:doseUnit a owl:DatatypeProperty ;
    rdfs:label "doseUnit" ;
    :domainIncludes :DoseSchedule ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The unit of the dose, e.g. 'mg'." ;
    skos:definition "The unit of the dose, e.g. 'mg'." .

:doseValue a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "doseValue" ;
    :domainIncludes :DoseSchedule ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Number,
        :QualitativeValue ;
    rdfs:comment "The value of the dose, e.g. 500." ;
    skos:definition "The value of the dose, e.g. 500." .

:downPayment a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "downPayment" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :RepaymentSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "a type of payment made in cash during the onset of the purchase of an expensive good/service. The payment typically represents only a percentage of the full purchase price." ;
    skos:definition "a type of payment made in cash during the onset of the purchase of an expensive good/service. The payment typically represents only a percentage of the full purchase price." .

:downloadUrl a owl:DatatypeProperty ;
    rdfs:label "downloadUrl" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :URL ;
    rdfs:comment "If the file can be downloaded, URL to download the binary." ;
    skos:definition "If the file can be downloaded, URL to download the binary." .

:downvoteCount a owl:DatatypeProperty ;
    rdfs:label "downvoteCount" ;
    :domainIncludes :Comment ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of downvotes this question, answer or comment has received from the community." ;
    skos:definition "The number of downvotes this question, answer or comment has received from the community." .

:drainsTo a owl:ObjectProperty ;
    rdfs:label "drainsTo" ;
    :domainIncludes :Vein ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Vessel ;
    rdfs:comment "The vasculature that the vein drains into." ;
    skos:definition "The vasculature that the vein drains into." .

:driveWheelConfiguration a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "driveWheelConfiguration" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :DriveWheelConfigurationValue,
        :Text ;
    rdfs:comment "The drive wheel configuration, i.e. which roadwheels will receive torque from the vehicle's engine via the drivetrain." ;
    skos:definition "The drive wheel configuration, i.e. which roadwheels will receive torque from the vehicle's engine via the drivetrain." .

:dropoffLocation a owl:ObjectProperty ;
    rdfs:label "dropoffLocation" ;
    :domainIncludes :RentalCarReservation ;
    :rangeIncludes :Place ;
    rdfs:comment "Where a rental car can be dropped off." ;
    skos:definition "Where a rental car can be dropped off." .

:dropoffTime a owl:DatatypeProperty ;
    rdfs:label "dropoffTime" ;
    :domainIncludes :RentalCarReservation ;
    :rangeIncludes :DateTime ;
    rdfs:comment "When a rental car can be dropped off." ;
    skos:definition "When a rental car can be dropped off." .

:drug a owl:ObjectProperty ;
    rdfs:label "drug" ;
    :domainIncludes :DrugClass,
        :MedicalCondition,
        :Patient,
        :TherapeuticProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Drug ;
    rdfs:comment "Specifying a drug or medicine used in a medication procedure." ;
    skos:definition "Specifying a drug or medicine used in a medication procedure." .

:drugClass a owl:ObjectProperty ;
    rdfs:label "drugClass" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DrugClass ;
    rdfs:comment "The class of drug this belongs to (e.g., statins)." ;
    skos:definition "The class of drug this belongs to (e.g., statins)." .

:drugUnit a owl:DatatypeProperty ;
    rdfs:label "drugUnit" ;
    :domainIncludes :Drug,
        :DrugCost ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The unit in which the drug is measured, e.g. '5 mg tablet'." ;
    skos:definition "The unit in which the drug is measured, e.g. '5 mg tablet'." .

:duns a owl:DatatypeProperty ;
    rdfs:label "duns" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "The Dun & Bradstreet DUNS number for identifying an organization or business person." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty unece:dUNSId ;
    skos:definition "The Dun & Bradstreet DUNS number for identifying an organization or business person." .

:duplicateTherapy a owl:ObjectProperty ;
    rdfs:label "duplicateTherapy" ;
    :domainIncludes :MedicalTherapy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalTherapy ;
    rdfs:comment "A therapy that duplicates or overlaps this one." ;
    skos:definition "A therapy that duplicates or overlaps this one." .

:durationOfWarranty a owl:ObjectProperty ;
    rdfs:label "durationOfWarranty" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :WarrantyPromise ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The duration of the warranty promise. Common unitCode values are ANN for year, MON for months, or DAY for days." ;
    rdfs:subPropertyOf :duration ;
    skos:definition "The duration of the warranty promise. Common unitCode values are ANN for year, MON for months, or DAY for days." .

:duringMedia a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "duringMedia" ;
    :domainIncludes :HowToDirection ;
    :rangeIncludes :MediaObject,
        :URL ;
    rdfs:comment "A media object representing the circumstances while performing this direction." ;
    skos:definition "A media object representing the circumstances while performing this direction." .

:earlyPrepaymentPenalty a owl:ObjectProperty ;
    rdfs:label "earlyPrepaymentPenalty" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :RepaymentSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The amount to be paid as a penalty in the event of early payment of the loan." ;
    skos:definition "The amount to be paid as a penalty in the event of early payment of the loan." .

:editEIDR a owl:DatatypeProperty ;
    rdfs:label "editEIDR" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2469> ;
    rdfs:comment """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing a specific edit / edition for a work of film or television.

For example, the motion picture known as "Ghostbusters" whose [[titleEIDR]] is "10.5240/7EC7-228A-510A-053E-CBB8-J" has several edits, e.g. "10.5240/1F2A-E1C5-680A-14C6-E76B-I" and "10.5240/8A35-3BEE-6497-5D12-9E4F-3".

Since schema.org types like [[Movie]] and [[TVEpisode]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" ;
    rdfs:subPropertyOf :identifier ;
    skos:definition """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing a specific edit / edition for a work of film or television.

For example, the motion picture known as "Ghostbusters" whose [[titleEIDR]] is "10.5240/7EC7-228A-510A-053E-CBB8-J" has several edits, e.g. "10.5240/1F2A-E1C5-680A-14C6-E76B-I" and "10.5240/8A35-3BEE-6497-5D12-9E4F-3".

Since schema.org types like [[Movie]] and [[TVEpisode]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" .

:editor a owl:ObjectProperty ;
    rdfs:label "editor" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Person ;
    rdfs:comment "Specifies the Person who edited the CreativeWork." ;
    skos:definition "Specifies the Person who edited the CreativeWork." .

:eduQuestionType a owl:DatatypeProperty ;
    rdfs:label "eduQuestionType" ;
    :domainIncludes :Question,
        :SolveMathAction ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2636> ;
    rdfs:comment "For questions that are part of learning resources (e.g. Quiz), eduQuestionType indicates the format of question being given. Example: \"Multiple choice\", \"Open ended\", \"Flashcard\"." ;
    skos:definition "For questions that are part of learning resources (e.g. Quiz), eduQuestionType indicates the format of question being given. Example: \"Multiple choice\", \"Open ended\", \"Flashcard\"." .

:educationRequirements a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "educationRequirements" ;
    :domainIncludes :JobPosting,
        :Occupation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EducationalOccupationalCredential,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698>,
        <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "Educational background needed for the position or Occupation." ;
    skos:definition "Educational background needed for the position or Occupation." .

:educationalAlignment a owl:ObjectProperty ;
    rdfs:label "educationalAlignment" ;
    :domainIncludes :CreativeWork,
        :LearningResource ;
    :rangeIncludes :AlignmentObject ;
    rdfs:comment """An alignment to an established educational framework.

This property should not be used where the nature of the alignment can be described using a simple property, for example to express that a resource [[teaches]] or [[assesses]] a competency.""" ;
    skos:definition """An alignment to an established educational framework.

This property should not be used where the nature of the alignment can be described using a simple property, for example to express that a resource [[teaches]] or [[assesses]] a competency.""" .

:educationalCredentialAwarded a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "educationalCredentialAwarded" ;
    :domainIncludes :Course,
        :EducationalOccupationalProgram ;
    :rangeIncludes :EducationalOccupationalCredential,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "A description of the qualification, award, certificate, diploma or other educational credential awarded as a consequence of successful completion of this course or program." ;
    skos:definition "A description of the qualification, award, certificate, diploma or other educational credential awarded as a consequence of successful completion of this course or program." .

:educationalFramework a owl:DatatypeProperty ;
    rdfs:label "educationalFramework" ;
    :domainIncludes :AlignmentObject ;
    :rangeIncludes :Text ;
    rdfs:comment "The framework to which the resource being described is aligned." ;
    skos:definition "The framework to which the resource being described is aligned." .

:educationalLevel a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "educationalLevel" ;
    :domainIncludes :CreativeWork,
        :EducationEvent,
        :EducationalOccupationalCredential,
        :LearningResource ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "The level in terms of progression through an educational or training context. Examples of educational levels include 'beginner', 'intermediate' or 'advanced', and formal sets of level indicators." ;
    skos:definition "The level in terms of progression through an educational or training context. Examples of educational levels include 'beginner', 'intermediate' or 'advanced', and formal sets of level indicators." .

:educationalProgramMode a owl:DatatypeProperty ;
    rdfs:label "educationalProgramMode" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "Similar to courseMode, the medium or means of delivery of the program as a whole. The value may either be a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous )." ;
    skos:definition "Similar to courseMode, the medium or means of delivery of the program as a whole. The value may either be a text label (e.g. \"online\", \"onsite\" or \"blended\"; \"synchronous\" or \"asynchronous\"; \"full-time\" or \"part-time\") or a URL reference to a term from a controlled vocabulary (e.g. https://ceds.ed.gov/element/001311#Asynchronous )." .

:educationalRole a owl:DatatypeProperty ;
    rdfs:label "educationalRole" ;
    :domainIncludes :EducationalAudience ;
    :rangeIncludes :Text ;
    rdfs:comment "An educationalRole of an EducationalAudience." ;
    skos:definition "An educationalRole of an EducationalAudience." .

:educationalUse a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "educationalUse" ;
    :domainIncludes :CreativeWork,
        :LearningResource ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    rdfs:comment "The purpose of a work in the context of education; for example, 'assignment', 'group work'." ;
    skos:definition "The purpose of a work in the context of education; for example, 'assignment', 'group work'." .

:elevation a owl:DatatypeProperty ;
    rdfs:label "elevation" ;
    :domainIncludes :GeoCoordinates,
        :GeoShape ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The elevation of a location ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System)). Values may be of the form 'NUMBER UNIT\\_OF\\_MEASUREMENT' (e.g., '1,000 m', '3,200 ft') while numbers alone should be assumed to be a value in meters." ;
    skos:definition "The elevation of a location ([WGS 84](https://en.wikipedia.org/wiki/World_Geodetic_System)). Values may be of the form 'NUMBER UNIT\\_OF\\_MEASUREMENT' (e.g., '1,000 m', '3,200 ft') while numbers alone should be assumed to be a value in meters." .

:eligibilityToWorkRequirement a owl:DatatypeProperty ;
    rdfs:label "eligibilityToWorkRequirement" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2384> ;
    rdfs:comment "The legal requirements such as citizenship, visa and other documentation required for an applicant to this job." ;
    skos:definition "The legal requirements such as citizenship, visa and other documentation required for an applicant to this job." .

:eligibleCustomerType a owl:ObjectProperty ;
    rdfs:label "eligibleCustomerType" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :BusinessEntityType ;
    rdfs:comment "The type(s) of customers for which the given offer is valid." ;
    skos:definition "The type(s) of customers for which the given offer is valid." .

:eligibleDuration a owl:ObjectProperty ;
    rdfs:label "eligibleDuration" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The duration for which the given offer is valid." ;
    skos:definition "The duration for which the given offer is valid." .

:eligibleQuantity a owl:ObjectProperty ;
    rdfs:label "eligibleQuantity" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :PriceSpecification ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The interval and unit of measurement of ordering quantities for which the offer or price specification is valid. This allows e.g. specifying that a certain freight charge is valid only for a certain quantity." ;
    skos:definition "The interval and unit of measurement of ordering quantities for which the offer or price specification is valid. This allows e.g. specifying that a certain freight charge is valid only for a certain quantity." .

:eligibleRegion a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "eligibleRegion" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :ActionAccessSpecification,
        :DeliveryChargeSpecification,
        :Demand,
        :Offer ;
    :rangeIncludes :GeoShape,
        :Place,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment """The ISO 3166-1 (ISO 3166-1 alpha-2) or ISO 3166-2 code, the place, or the GeoShape for the geo-political region(s) for which the offer or delivery charge specification is valid.\\n\\nSee also [[ineligibleRegion]].
    """ ;
    rdfs:subPropertyOf :areaServed ;
    skos:definition """The ISO 3166-1 (ISO 3166-1 alpha-2) or ISO 3166-2 code, the place, or the GeoShape for the geo-political region(s) for which the offer or delivery charge specification is valid.\\n\\nSee also [[ineligibleRegion]].
    """ .

:eligibleTransactionVolume a owl:ObjectProperty ;
    rdfs:label "eligibleTransactionVolume" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :PriceSpecification ;
    :rangeIncludes :PriceSpecification ;
    rdfs:comment "The transaction volume, in a monetary unit, for which the offer or price specification is valid, e.g. for indicating a minimal purchasing volume, to express free shipping above a certain order volume, or to limit the acceptance of credit cards to purchases to a certain minimal amount." ;
    skos:definition "The transaction volume, in a monetary unit, for which the offer or price specification is valid, e.g. for indicating a minimal purchasing volume, to express free shipping above a certain order volume, or to limit the acceptance of credit cards to purchases to a certain minimal amount." .

:eligibleWithSupplier a owl:ObjectProperty ;
    rdfs:label "eligibleWithSupplier" ;
    :domainIncludes :FinancialIncentive ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization ;
    :source <https://github.com/schemaorg/schemaorg/issues/3572> ;
    rdfs:comment "The supplier of the incentivized item/service for which the incentive is valid for such as a utility company, merchant, or contractor." ;
    skos:definition "The supplier of the incentivized item/service for which the incentive is valid for such as a utility company, merchant, or contractor." .

:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    :domainIncludes :ContactPoint,
        :Organization,
        :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "Email address." ;
    owl:equivalentProperty gs1:email ;
    skos:definition "Email address." .

:embedUrl a owl:DatatypeProperty ;
    rdfs:label "embedUrl" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :URL ;
    rdfs:comment "A URL pointing to a player for a specific video. In general, this is the information in the ```src``` element of an ```embed``` tag and should not be the same as the content of the ```loc``` tag." ;
    skos:definition "A URL pointing to a player for a specific video. In general, this is the information in the ```src``` element of an ```embed``` tag and should not be the same as the content of the ```loc``` tag." .

:embeddedTextCaption a owl:DatatypeProperty ;
    rdfs:label "embeddedTextCaption" ;
    :domainIncludes :AudioObject,
        :ImageObject,
        :VideoObject ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "Represents textual captioning from a [[MediaObject]], e.g. text of a 'meme'." ;
    rdfs:subPropertyOf :caption ;
    skos:definition "Represents textual captioning from a [[MediaObject]], e.g. text of a 'meme'." .

:emissionsCO2 a owl:DatatypeProperty ;
    rdfs:label "emissionsCO2" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :Number ;
    rdfs:comment "The CO2 emissions in g/km. When used in combination with a QuantitativeValue, put \"g/km\" into the unitText property of that value, since there is no UN/CEFACT Common Code for \"g/km\"." ;
    skos:definition "The CO2 emissions in g/km. When used in combination with a QuantitativeValue, put \"g/km\" into the unitText property of that value, since there is no UN/CEFACT Common Code for \"g/km\"." .

:employees a owl:ObjectProperty ;
    rdfs:label "employees" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Person ;
    :supersededBy :employee ;
    rdfs:comment "People working for this organization." ;
    skos:definition "People working for this organization." .

:employerOverview a owl:DatatypeProperty ;
    rdfs:label "employerOverview" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2396> ;
    rdfs:comment "A description of the employer, career opportunities and work environment for this position." ;
    skos:definition "A description of the employer, career opportunities and work environment for this position." .

:employmentType a owl:DatatypeProperty ;
    rdfs:label "employmentType" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "Type of employment (e.g. full-time, part-time, contract, temporary, seasonal, internship)." ;
    skos:definition "Type of employment (e.g. full-time, part-time, contract, temporary, seasonal, internship)." .

:employmentUnit a owl:ObjectProperty ;
    rdfs:label "employmentUnit" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization ;
    :source <https://github.com/schemaorg/schemaorg/issues/2296> ;
    rdfs:comment "Indicates the department, unit and/or facility where the employee reports and/or in which the job is to be performed." ;
    skos:definition "Indicates the department, unit and/or facility where the employee reports and/or in which the job is to be performed." .

:encodingType a owl:DatatypeProperty ;
    rdfs:label "encodingType" ;
    :domainIncludes :EntryPoint ;
    :rangeIncludes :Text ;
    rdfs:comment "The supported encoding type(s) for an EntryPoint request." ;
    skos:definition "The supported encoding type(s) for an EntryPoint request." .

:encodings a owl:ObjectProperty ;
    rdfs:label "encodings" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :MediaObject ;
    :supersededBy :encoding ;
    rdfs:comment "A media object that encodes this CreativeWork." ;
    skos:definition "A media object that encodes this CreativeWork." .

:endOffset a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "endOffset" ;
    :domainIncludes :Clip ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :HyperTocEntry,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2021> ;
    rdfs:comment "The end time of the clip expressed as the number of seconds from the beginning of the work." ;
    skos:definition "The end time of the clip expressed as the number of seconds from the beginning of the work." .

:endTime a owl:DatatypeProperty ;
    rdfs:label "endTime" ;
    :domainIncludes :Action,
        :FoodEstablishmentReservation,
        :InteractionCounter,
        :MediaObject,
        :Schedule ;
    :rangeIncludes :DateTime,
        :Time ;
    :source <https://github.com/schemaorg/schemaorg/issues/2493> ;
    rdfs:comment "The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. E.g. John wrote a book from January to *December*. For media, including audio and video, it's the time offset of the end of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." ;
    skos:definition "The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. E.g. John wrote a book from January to *December*. For media, including audio and video, it's the time offset of the end of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." .

:endorsee a owl:ObjectProperty ;
    rdfs:label "endorsee" ;
    :domainIncludes :EndorseAction ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A sub property of participant. The person/organization being supported." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The person/organization being supported." .

:endorsers a owl:ObjectProperty ;
    rdfs:label "endorsers" ;
    :domainIncludes :Diet ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "People or organizations that endorse the plan." ;
    skos:definition "People or organizations that endorse the plan." .

:energyEfficiencyScaleMax a owl:ObjectProperty ;
    rdfs:label "energyEfficiencyScaleMax" ;
    :domainIncludes :EnergyConsumptionDetails ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EUEnergyEfficiencyEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2670> ;
    rdfs:comment "Specifies the most energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." ;
    skos:definition "Specifies the most energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." .

:energyEfficiencyScaleMin a owl:ObjectProperty ;
    rdfs:label "energyEfficiencyScaleMin" ;
    :domainIncludes :EnergyConsumptionDetails ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EUEnergyEfficiencyEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2670> ;
    rdfs:comment "Specifies the least energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." ;
    skos:definition "Specifies the least energy efficient class on the regulated EU energy consumption scale for the product category a product belongs to. For example, energy consumption for televisions placed on the market after January 1, 2020 is scaled from D to A+++." .

:engineDisplacement a owl:ObjectProperty ;
    rdfs:label "engineDisplacement" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :EngineSpecification ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The volume swept by all of the pistons inside the cylinders of an internal combustion engine in a single movement. \\n\\nTypical unit code(s): CMQ for cubic centimeter, LTR for liters, INQ for cubic inches\\n* Note 1: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The volume swept by all of the pistons inside the cylinders of an internal combustion engine in a single movement. \\n\\nTypical unit code(s): CMQ for cubic centimeter, LTR for liters, INQ for cubic inches\\n* Note 1: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." .

:enginePower a owl:ObjectProperty ;
    rdfs:label "enginePower" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :EngineSpecification ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment """The power of the vehicle's engine.
    Typical unit code(s): KWT for kilowatt, BHP for brake horsepower, N12 for metric horsepower (PS, with 1 PS = 735,49875 W)\\n\\n* Note 1: There are many different ways of measuring an engine's power. For an overview, see  [http://en.wikipedia.org/wiki/Horsepower#Engine\\_power\\_test\\_codes](http://en.wikipedia.org/wiki/Horsepower#Engine_power_test_codes).\\n* Note 2: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 3: You can use [[minValue]] and [[maxValue]] to indicate ranges.""" ;
    skos:definition """The power of the vehicle's engine.
    Typical unit code(s): KWT for kilowatt, BHP for brake horsepower, N12 for metric horsepower (PS, with 1 PS = 735,49875 W)\\n\\n* Note 1: There are many different ways of measuring an engine's power. For an overview, see  [http://en.wikipedia.org/wiki/Horsepower#Engine\\_power\\_test\\_codes](http://en.wikipedia.org/wiki/Horsepower#Engine_power_test_codes).\\n* Note 2: You can link to information about how the given value has been determined using the [[valueReference]] property.\\n* Note 3: You can use [[minValue]] and [[maxValue]] to indicate ranges.""" .

:engineType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "engineType" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :EngineSpecification ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QualitativeValue,
        :Text,
        :URL ;
    rdfs:comment "The type of engine or engines powering the vehicle." ;
    skos:definition "The type of engine or engines powering the vehicle." .

:entertainmentBusiness a owl:ObjectProperty ;
    rdfs:label "entertainmentBusiness" ;
    :domainIncludes :PerformAction ;
    :rangeIncludes :EntertainmentBusiness ;
    rdfs:comment "A sub property of location. The entertainment business where the action occurred." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The entertainment business where the action occurred." .

:epidemiology a owl:DatatypeProperty ;
    rdfs:label "epidemiology" ;
    :domainIncludes :MedicalCondition,
        :PhysicalActivity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The characteristics of associated patients, such as age, gender, race etc." ;
    skos:definition "The characteristics of associated patients, such as age, gender, race etc." .

:episodeNumber a owl:DatatypeProperty ;
    rdfs:label "episodeNumber" ;
    :domainIncludes :Episode ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "Position of the episode within an ordered group of episodes." ;
    rdfs:subPropertyOf :position ;
    skos:definition "Position of the episode within an ordered group of episodes." .

:episodes a owl:ObjectProperty ;
    rdfs:label "episodes" ;
    :domainIncludes :CreativeWorkSeason,
        :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :Episode ;
    :supersededBy :episode ;
    rdfs:comment "An episode of a TV/radio series or season." ;
    skos:definition "An episode of a TV/radio series or season." .

:equal a owl:ObjectProperty ;
    rdfs:label "equal" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :QualitativeValue ;
    :rangeIncludes :QualitativeValue ;
    rdfs:comment "This ordering relation for qualitative values indicates that the subject is equal to the object." ;
    skos:definition "This ordering relation for qualitative values indicates that the subject is equal to the object." .

:error a owl:ObjectProperty ;
    rdfs:label "error" ;
    :domainIncludes :Action ;
    :rangeIncludes :Thing ;
    rdfs:comment "For failed actions, more information on the cause of the failure. Consider using the Error type." ;
    skos:definition "For failed actions, more information on the cause of the failure. Consider using the Error type." .

:errorCode a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "errorCode" ;
    :domainIncludes :Error ;
    :rangeIncludes :DefinedTerm,
        :Integer,
        :StatusEnumeration,
        :Text ;
    rdfs:comment "Application or platform dependant error code." ;
    rdfs:seeAlso hydra:statusCode ;
    skos:definition "Application or platform dependant error code." .

:estimatedCost a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "estimatedCost" ;
    :domainIncludes :HowTo,
        :HowToSupply ;
    :rangeIncludes :MonetaryAmount,
        :Text ;
    rdfs:comment "The estimated cost of the supply or supplies consumed when performing instructions." ;
    skos:definition "The estimated cost of the supply or supplies consumed when performing instructions." .

:estimatedFlightDuration a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "estimatedFlightDuration" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Duration,
        :Text ;
    rdfs:comment "The estimated time the flight will take." ;
    skos:definition "The estimated time the flight will take." .

:estimatedSalary a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "estimatedSalary" ;
    :domainIncludes :JobPosting,
        :Occupation ;
    :rangeIncludes :MonetaryAmount,
        :MonetaryAmountDistribution,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "An estimated salary for a job posting or occupation, based on a variety of variables including, but not limited to industry, job title, and location. Estimated salaries  are often computed by outside organizations rather than the hiring organization, who may not have committed to the estimated value." ;
    skos:definition "An estimated salary for a job posting or occupation, based on a variety of variables including, but not limited to industry, job title, and location. Estimated salaries  are often computed by outside organizations rather than the hiring organization, who may not have committed to the estimated value." .

:estimatesRiskOf a owl:ObjectProperty ;
    rdfs:label "estimatesRiskOf" ;
    :domainIncludes :MedicalRiskEstimator ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity ;
    rdfs:comment "The condition, complication, or symptom whose risk is being estimated." ;
    skos:definition "The condition, complication, or symptom whose risk is being estimated." .

:ethicsPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "ethicsPolicy" ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "Statement about ethics policy, e.g. of a [[NewsMediaOrganization]] regarding journalistic and publishing practices, or of a [[Restaurant]], a page describing food source policies. In the case of a [[NewsMediaOrganization]], an ethicsPolicy is typically a statement describing the personal, organizational, and corporate standards of behavior expected by the organization." ;
    skos:definition "Statement about ethics policy, e.g. of a [[NewsMediaOrganization]] regarding journalistic and publishing practices, or of a [[Restaurant]], a page describing food source policies. In the case of a [[NewsMediaOrganization]], an ethicsPolicy is typically a statement describing the personal, organizational, and corporate standards of behavior expected by the organization." .

:eventAttendanceMode a owl:ObjectProperty ;
    rdfs:label "eventAttendanceMode" ;
    :domainIncludes :Event ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EventAttendanceModeEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/1842> ;
    rdfs:comment "The eventAttendanceMode of an event indicates whether it occurs online, offline, or a mix." ;
    skos:definition "The eventAttendanceMode of an event indicates whether it occurs online, offline, or a mix." .

:eventSchedule a owl:ObjectProperty ;
    rdfs:label "eventSchedule" ;
    :domainIncludes :Event ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Schedule ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment """Associates an [[Event]] with a [[Schedule]]. There are circumstances where it is preferable to share a schedule for a series of
      repeating events rather than data on the individual events themselves. For example, a website or application might prefer to publish a schedule for a weekly
      gym class rather than provide data on every event. A schedule could be processed by applications to add forthcoming events to a calendar. An [[Event]] that
      is associated with a [[Schedule]] using this property should not have [[startDate]] or [[endDate]] properties. These are instead defined within the associated
      [[Schedule]], this avoids any ambiguity for clients using the data. The property might have repeated values to specify different schedules, e.g. for different months
      or seasons.""" ;
    skos:definition """Associates an [[Event]] with a [[Schedule]]. There are circumstances where it is preferable to share a schedule for a series of
      repeating events rather than data on the individual events themselves. For example, a website or application might prefer to publish a schedule for a weekly
      gym class rather than provide data on every event. A schedule could be processed by applications to add forthcoming events to a calendar. An [[Event]] that
      is associated with a [[Schedule]] using this property should not have [[startDate]] or [[endDate]] properties. These are instead defined within the associated
      [[Schedule]], this avoids any ambiguity for clients using the data. The property might have repeated values to specify different schedules, e.g. for different months
      or seasons.""" .

:eventStatus a owl:ObjectProperty ;
    rdfs:label "eventStatus" ;
    :domainIncludes :Event ;
    :rangeIncludes :EventStatusType ;
    rdfs:comment "An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled." ;
    skos:definition "An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled." .

:events a owl:ObjectProperty ;
    rdfs:label "events" ;
    :domainIncludes :Organization,
        :Place ;
    :rangeIncludes :Event ;
    :supersededBy :event ;
    rdfs:comment "Upcoming or past events associated with this place or organization." ;
    skos:definition "Upcoming or past events associated with this place or organization." .

:evidenceLevel a owl:ObjectProperty ;
    rdfs:label "evidenceLevel" ;
    :domainIncludes :MedicalGuideline ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEvidenceLevel ;
    rdfs:comment "Strength of evidence of the data used to formulate the guideline (enumerated)." ;
    skos:definition "Strength of evidence of the data used to formulate the guideline (enumerated)." .

:evidenceOrigin a owl:DatatypeProperty ;
    rdfs:label "evidenceOrigin" ;
    :domainIncludes :MedicalGuideline ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Source of the data used to formulate the guidance, e.g. RCT, consensus opinion, etc." ;
    skos:definition "Source of the data used to formulate the guidance, e.g. RCT, consensus opinion, etc." .

:exceptDate a owl:DatatypeProperty ;
    rdfs:label "exceptDate" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date,
        :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment """Defines a [[Date]] or [[DateTime]] during which a scheduled [[Event]] will not take place. The property allows exceptions to
      a [[Schedule]] to be specified. If an exception is specified as a [[DateTime]] then only the event that would have started at that specific date and time
      should be excluded from the schedule. If an exception is specified as a [[Date]] then any event that is scheduled for that 24 hour period should be
      excluded from the schedule. This allows a whole day to be excluded from the schedule without having to itemise every scheduled event.""" ;
    skos:definition """Defines a [[Date]] or [[DateTime]] during which a scheduled [[Event]] will not take place. The property allows exceptions to
      a [[Schedule]] to be specified. If an exception is specified as a [[DateTime]] then only the event that would have started at that specific date and time
      should be excluded from the schedule. If an exception is specified as a [[Date]] then any event that is scheduled for that 24 hour period should be
      excluded from the schedule. This allows a whole day to be excluded from the schedule without having to itemise every scheduled event.""" .

:exchangeRateSpread a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "exchangeRateSpread" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :ExchangeRateSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The difference between the price at which a broker or other intermediary buys and sells foreign currency." ;
    skos:definition "The difference between the price at which a broker or other intermediary buys and sells foreign currency." .

:exercisePlan a owl:ObjectProperty ;
    rdfs:label "exercisePlan" ;
    :domainIncludes :ExerciseAction ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :ExercisePlan ;
    rdfs:comment "A sub property of instrument. The exercise plan used on this action." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The exercise plan used on this action." .

:exerciseRelatedDiet a owl:ObjectProperty ;
    rdfs:label "exerciseRelatedDiet" ;
    :domainIncludes :ExerciseAction ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Diet ;
    rdfs:comment "A sub property of instrument. The diet used in this action." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The diet used in this action." .

:exerciseType a owl:DatatypeProperty ;
    rdfs:label "exerciseType" ;
    :domainIncludes :ExerciseAction,
        :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Type(s) of exercise or activity, such as strength training, flexibility training, aerobics, cardiac rehabilitation, etc." ;
    skos:definition "Type(s) of exercise or activity, such as strength training, flexibility training, aerobics, cardiac rehabilitation, etc." .

:exifData a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "exifData" ;
    :domainIncludes :ImageObject ;
    :rangeIncludes :PropertyValue,
        :Text ;
    rdfs:comment "exif data for this object." ;
    skos:definition "exif data for this object." .

:expectedArrivalFrom a owl:DatatypeProperty ;
    rdfs:label "expectedArrivalFrom" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The earliest date the package may arrive." ;
    skos:definition "The earliest date the package may arrive." .

:expectedArrivalUntil a owl:DatatypeProperty ;
    rdfs:label "expectedArrivalUntil" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The latest date the package may arrive." ;
    skos:definition "The latest date the package may arrive." .

:expectedPrognosis a owl:DatatypeProperty ;
    rdfs:label "expectedPrognosis" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The likely outcome in either the short term or long term of the medical condition." ;
    skos:definition "The likely outcome in either the short term or long term of the medical condition." .

:expectsAcceptanceOf a owl:ObjectProperty ;
    rdfs:label "expectsAcceptanceOf" ;
    :domainIncludes :ActionAccessSpecification,
        :ConsumeAction,
        :MediaSubscription ;
    :rangeIncludes :Offer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "An Offer which must be accepted before the user can perform the Action. For example, the user may need to buy a movie before being able to watch it." ;
    skos:definition "An Offer which must be accepted before the user can perform the Action. For example, the user may need to buy a movie before being able to watch it." .

:experienceInPlaceOfEducation a owl:DatatypeProperty ;
    rdfs:label "experienceInPlaceOfEducation" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2681> ;
    rdfs:comment "Indicates whether a [[JobPosting]] will accept experience (as indicated by [[OccupationalExperienceRequirements]]) in place of its formal educational qualifications (as indicated by [[educationRequirements]]). If true, indicates that satisfying one of these requirements is sufficient." ;
    skos:definition "Indicates whether a [[JobPosting]] will accept experience (as indicated by [[OccupationalExperienceRequirements]]) in place of its formal educational qualifications (as indicated by [[educationRequirements]]). If true, indicates that satisfying one of these requirements is sufficient." .

:experienceRequirements a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "experienceRequirements" ;
    :domainIncludes :JobPosting,
        :Occupation ;
    :rangeIncludes :OccupationalExperienceRequirements,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "Description of skills and experience needed for the position or Occupation." ;
    skos:definition "Description of skills and experience needed for the position or Occupation." .

:expertConsiderations a owl:DatatypeProperty ;
    rdfs:label "expertConsiderations" ;
    :domainIncludes :Diet ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Medical expert advice related to the plan." ;
    skos:definition "Medical expert advice related to the plan." .

:expires a owl:DatatypeProperty ;
    rdfs:label "expires" ;
    :domainIncludes :Certification,
        :CreativeWork ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "Date the content expires and is no longer useful or available. For example a [[VideoObject]] or [[NewsArticle]] whose availability or relevance is time-limited, a [[ClaimReview]] fact check whose publisher wants to indicate that it may no longer be relevant (or helpful to highlight) after some date, or a [[Certification]] the validity has expired." ;
    skos:definition "Date the content expires and is no longer useful or available. For example a [[VideoObject]] or [[NewsArticle]] whose availability or relevance is time-limited, a [[ClaimReview]] fact check whose publisher wants to indicate that it may no longer be relevant (or helpful to highlight) after some date, or a [[Certification]] the validity has expired." .

:expressedIn a owl:ObjectProperty ;
    rdfs:label "expressedIn" ;
    :domainIncludes :Gene ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AnatomicalStructure,
        :AnatomicalSystem,
        :BioChemEntity,
        :DefinedTerm ;
    :source <http://www.bioschemas.org/Gene> ;
    rdfs:comment "Tissue, organ, biological sample, etc in which activity of this gene has been observed experimentally. For example brain, digestive system." ;
    skos:definition "Tissue, organ, biological sample, etc in which activity of this gene has been observed experimentally. For example brain, digestive system." .

:extendedAddress a owl:DatatypeProperty ;
    rdfs:label "extendedAddress" ;
    :domainIncludes :PostalAddress ;
    :rangeIncludes :Text ;
    rdfs:comment "An address extension such as an apartment number, C/O or alternative name." ;
    skos:definition "An address extension such as an apartment number, C/O or alternative name." .

:familyName a owl:DatatypeProperty ;
    rdfs:label "familyName" ;
    :domainIncludes :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "Family name. In the U.S., the last name of a Person." ;
    skos:definition "Family name. In the U.S., the last name of a Person." .

:fatContent a owl:ObjectProperty ;
    rdfs:label "fatContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of fat." ;
    skos:definition "The number of grams of fat." .

:faxNumber a owl:DatatypeProperty ;
    rdfs:label "faxNumber" ;
    :domainIncludes :ContactPoint,
        :Organization,
        :Person,
        :Place ;
    :rangeIncludes :Text ;
    rdfs:comment "The fax number." ;
    owl:equivalentProperty gs1:faxNumber ;
    skos:definition "The fax number." .

:featureList a owl:DatatypeProperty ;
    rdfs:label "featureList" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Features or modules provided by this application (and possibly required by other applications)." ;
    skos:definition "Features or modules provided by this application (and possibly required by other applications)." .

:feesAndCommissionsSpecification a owl:DatatypeProperty ;
    rdfs:label "feesAndCommissionsSpecification" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :FinancialProduct,
        :FinancialService ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Description of fees, commissions, and other terms applied either to a class of financial product, or by a financial service organization." ;
    skos:definition "Description of fees, commissions, and other terms applied either to a class of financial product, or by a financial service organization." .

:fiberContent a owl:ObjectProperty ;
    rdfs:label "fiberContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of fiber." ;
    skos:definition "The number of grams of fiber." .

:fileFormat a owl:DatatypeProperty ;
    rdfs:label "fileFormat" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text,
        :URL ;
    :supersededBy :encodingFormat ;
    rdfs:comment "Media type, typically MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml)) of the content, e.g. application/zip of a SoftwareApplication binary. In cases where a CreativeWork has several media type representations, 'encoding' can be used to indicate each MediaObject alongside particular fileFormat information. Unregistered or niche file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia entry." ;
    skos:definition "Media type, typically MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml)) of the content, e.g. application/zip of a SoftwareApplication binary. In cases where a CreativeWork has several media type representations, 'encoding' can be used to indicate each MediaObject alongside particular fileFormat information. Unregistered or niche file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia entry." .

:fileSize a owl:DatatypeProperty ;
    rdfs:label "fileSize" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Size of the application / package (e.g. 18MB). In the absence of a unit (MB, KB etc.), KB will be assumed." ;
    skos:definition "Size of the application / package (e.g. 18MB). In the absence of a unit (MB, KB etc.), KB will be assumed." .

:financialAidEligible a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "financialAidEligible" ;
    :domainIncludes :Course,
        :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2418> ;
    rdfs:comment "A financial aid type or program which students may use to pay for tuition or fees associated with the program." ;
    skos:definition "A financial aid type or program which students may use to pay for tuition or fees associated with the program." .

:firstAppearance a owl:ObjectProperty ;
    rdfs:label "firstAppearance" ;
    :domainIncludes :Claim ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork ;
    :source <https://github.com/schemaorg/schemaorg/issues/1828> ;
    rdfs:comment "Indicates the first known occurrence of a [[Claim]] in some [[CreativeWork]]." ;
    rdfs:subPropertyOf :workExample ;
    skos:definition "Indicates the first known occurrence of a [[Claim]] in some [[CreativeWork]]." .

:firstPerformance a owl:ObjectProperty ;
    rdfs:label "firstPerformance" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :Event ;
    rdfs:comment "The date and place the work was first performed." ;
    skos:definition "The date and place the work was first performed." .

:flightDistance a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "flightDistance" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Distance,
        :Text ;
    rdfs:comment "The distance of the flight." ;
    skos:definition "The distance of the flight." .

:flightNumber a owl:DatatypeProperty ;
    rdfs:label "flightNumber" ;
    :domainIncludes :Flight ;
    :rangeIncludes :Text ;
    rdfs:comment "The unique identifier for a flight including the airline IATA code. For example, if describing United flight 110, where the IATA code for United is 'UA', the flightNumber is 'UA110'." ;
    rdfs:subPropertyOf :identifier ;
    skos:definition "The unique identifier for a flight including the airline IATA code. For example, if describing United flight 110, where the IATA code for United is 'UA', the flightNumber is 'UA110'." .

:floorLevel a owl:DatatypeProperty ;
    rdfs:label "floorLevel" ;
    :domainIncludes :Accommodation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment """The floor level for an [[Accommodation]] in a multi-storey building. Since counting
  systems [vary internationally](https://en.wikipedia.org/wiki/Storey#Consecutive_number_floor_designations), the local system should be used where possible.""" ;
    skos:definition """The floor level for an [[Accommodation]] in a multi-storey building. Since counting
  systems [vary internationally](https://en.wikipedia.org/wiki/Storey#Consecutive_number_floor_designations), the local system should be used where possible.""" .

:floorLimit a owl:ObjectProperty ;
    rdfs:label "floorLimit" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :PaymentCard ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A floor limit is the amount of money above which credit card transactions must be authorized." ;
    skos:definition "A floor limit is the amount of money above which credit card transactions must be authorized." .

:floorSize a owl:ObjectProperty ;
    rdfs:label "floorSize" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation,
        :FloorPlan ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment """The size of the accommodation, e.g. in square meter or squarefoot.
Typical unit code(s): MTK for square meter, FTK for square foot, or YDK for square yard.""" ;
    skos:definition """The size of the accommodation, e.g. in square meter or squarefoot.
Typical unit code(s): MTK for square meter, FTK for square foot, or YDK for square yard.""" .

:followee a owl:ObjectProperty ;
    rdfs:label "followee" ;
    :domainIncludes :FollowAction ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A sub property of object. The person or organization being followed." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The person or organization being followed." .

:follows a owl:ObjectProperty ;
    rdfs:label "follows" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "The most generic uni-directional social relation." ;
    skos:definition "The most generic uni-directional social relation." .

:followup a owl:DatatypeProperty ;
    rdfs:label "followup" ;
    :domainIncludes :MedicalProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Typical or recommended followup care after the procedure is performed." ;
    skos:definition "Typical or recommended followup care after the procedure is performed." .

:foodEstablishment a owl:ObjectProperty ;
    rdfs:label "foodEstablishment" ;
    :domainIncludes :CookAction ;
    :rangeIncludes :FoodEstablishment,
        :Place ;
    rdfs:comment "A sub property of location. The specific food establishment where the action occurred." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The specific food establishment where the action occurred." .

:foodEvent a owl:ObjectProperty ;
    rdfs:label "foodEvent" ;
    :domainIncludes :CookAction ;
    :rangeIncludes :FoodEvent ;
    rdfs:comment "A sub property of location. The specific food event where the action occurred." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The specific food event where the action occurred." .

:foodWarning a owl:DatatypeProperty ;
    rdfs:label "foodWarning" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any precaution, guidance, contraindication, etc. related to consumption of specific foods while taking this drug." ;
    skos:definition "Any precaution, guidance, contraindication, etc. related to consumption of specific foods while taking this drug." .

:founders a owl:ObjectProperty ;
    rdfs:label "founders" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Person ;
    :supersededBy :founder ;
    rdfs:comment "A person who founded this organization." ;
    skos:definition "A person who founded this organization." .

:foundingDate a owl:DatatypeProperty ;
    rdfs:label "foundingDate" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Date ;
    rdfs:comment "The date that this organization was founded." ;
    owl:equivalentProperty gs1:organizationFormationDate ;
    skos:definition "The date that this organization was founded." .

:foundingLocation a owl:ObjectProperty ;
    rdfs:label "foundingLocation" ;
    :domainIncludes :Organization ;
    :rangeIncludes :Place ;
    rdfs:comment "The place where the Organization was founded." ;
    skos:definition "The place where the Organization was founded." .

:free a owl:DatatypeProperty ;
    rdfs:label "free" ;
    :domainIncludes :PublicationEvent ;
    :rangeIncludes :Boolean ;
    :supersededBy :isAccessibleForFree ;
    rdfs:comment "A flag to signal that the item, event, or place is accessible for free." ;
    skos:definition "A flag to signal that the item, event, or place is accessible for free." .

:freeShippingThreshold a owl:ObjectProperty ;
    rdfs:label "freeShippingThreshold" ;
    :domainIncludes :ShippingRateSettings ;
    :rangeIncludes :DeliveryChargeSpecification,
        :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "A monetary value above (or at) which the shipping rate becomes free. Intended to be used via an [[OfferShippingDetails]] with [[shippingSettingsLink]] matching this [[ShippingRateSettings]]." ;
    skos:definition "A monetary value above (or at) which the shipping rate becomes free. Intended to be used via an [[OfferShippingDetails]] with [[shippingSettingsLink]] matching this [[ShippingRateSettings]]." .

:fromLocation a owl:ObjectProperty ;
    rdfs:label "fromLocation" ;
    :domainIncludes :ExerciseAction,
        :MoveAction,
        :TransferAction ;
    :rangeIncludes :Place ;
    rdfs:comment "A sub property of location. The original location of the object or the agent before the action." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The original location of the object or the agent before the action." .

:fuelCapacity a owl:ObjectProperty ;
    rdfs:label "fuelCapacity" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The capacity of the fuel tank or in the case of electric cars, the battery. If there are multiple components for storage, this should indicate the total of all storage of the same type.\\n\\nTypical unit code(s): LTR for liters, GLL of US gallons, GLI for UK / imperial gallons, AMH for ampere-hours (for electrical vehicles)." ;
    skos:definition "The capacity of the fuel tank or in the case of electric cars, the battery. If there are multiple components for storage, this should indicate the total of all storage of the same type.\\n\\nTypical unit code(s): LTR for liters, GLL of US gallons, GLI for UK / imperial gallons, AMH for ampere-hours (for electrical vehicles)." .

:fuelConsumption a owl:ObjectProperty ;
    rdfs:label "fuelConsumption" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The amount of fuel consumed for traveling a particular distance or temporal duration with the given vehicle (e.g. liters per 100 km).\\n\\n* Note 1: There are unfortunately no standard unit codes for liters per 100 km.  Use [[unitText]] to indicate the unit of measurement, e.g. L/100 km.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel consumption to another value." ;
    skos:definition "The amount of fuel consumed for traveling a particular distance or temporal duration with the given vehicle (e.g. liters per 100 km).\\n\\n* Note 1: There are unfortunately no standard unit codes for liters per 100 km.  Use [[unitText]] to indicate the unit of measurement, e.g. L/100 km.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel consumption to another value." .

:fuelEfficiency a owl:ObjectProperty ;
    rdfs:label "fuelEfficiency" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The distance traveled per unit of fuel used; most commonly miles per gallon (mpg) or kilometers per liter (km/L).\\n\\n* Note 1: There are unfortunately no standard unit codes for miles per gallon or kilometers per liter. Use [[unitText]] to indicate the unit of measurement, e.g. mpg or km/L.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel economy to another value." ;
    skos:definition "The distance traveled per unit of fuel used; most commonly miles per gallon (mpg) or kilometers per liter (km/L).\\n\\n* Note 1: There are unfortunately no standard unit codes for miles per gallon or kilometers per liter. Use [[unitText]] to indicate the unit of measurement, e.g. mpg or km/L.\\n* Note 2: There are two ways of indicating the fuel consumption, [[fuelConsumption]] (e.g. 8 liters per 100 km) and [[fuelEfficiency]] (e.g. 30 miles per gallon). They are reciprocal.\\n* Note 3: Often, the absolute value is useful only when related to driving speed (\"at 80 km/h\") or usage pattern (\"city traffic\"). You can use [[valueReference]] to link the value for the fuel economy to another value." .

:fuelType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "fuelType" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :EngineSpecification,
        :Vehicle ;
    :rangeIncludes :QualitativeValue,
        :Text,
        :URL ;
    rdfs:comment "The type of fuel suitable for the engine or engines of the vehicle. If the vehicle has only one engine, this property can be attached directly to the vehicle." ;
    skos:definition "The type of fuel suitable for the engine or engines of the vehicle. If the vehicle has only one engine, this property can be attached directly to the vehicle." .

:fulfillmentType a owl:ObjectProperty ;
    rdfs:label "fulfillmentType" ;
    :domainIncludes :ShippingService ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :FulfillmentTypeEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Type of fulfillment applicable to the [[ShippingService]]." ;
    skos:definition "Type of fulfillment applicable to the [[ShippingService]]." .

:functionalClass a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "functionalClass" ;
    :domainIncludes :Joint ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity,
        :Text ;
    rdfs:comment "The degree of mobility the joint allows." ;
    skos:definition "The degree of mobility the joint allows." .

:funder a owl:ObjectProperty ;
    rdfs:label "funder" ;
    :domainIncludes :CreativeWork,
        :Event,
        :Grant,
        :MonetaryGrant,
        :Organization,
        :Person ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "A person or organization that supports (sponsors) something through some kind of financial contribution." ;
    rdfs:subPropertyOf :sponsor ;
    skos:definition "A person or organization that supports (sponsors) something through some kind of financial contribution." .

:gameAvailabilityType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "gameAvailabilityType" ;
    :domainIncludes :PlayGameAction ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :GameAvailabilityEnumeration,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3058> ;
    rdfs:comment "Indicates the availability type of the game content associated with this action, such as whether it is a full version or a demo." ;
    skos:definition "Indicates the availability type of the game content associated with this action, such as whether it is a full version or a demo." .

:gameEdition a owl:DatatypeProperty ;
    rdfs:label "gameEdition" ;
    :domainIncludes :VideoGame ;
    :rangeIncludes :Text ;
    rdfs:comment "The edition of a video game." ;
    skos:definition "The edition of a video game." .

:gameItem a owl:ObjectProperty ;
    rdfs:label "gameItem" ;
    :domainIncludes :Game,
        :VideoGameSeries ;
    :rangeIncludes :Thing ;
    rdfs:comment "An item is an object within the game world that can be collected by a player or, occasionally, a non-player character." ;
    skos:definition "An item is an object within the game world that can be collected by a player or, occasionally, a non-player character." .

:gameLocation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "gameLocation" ;
    :domainIncludes :Game,
        :VideoGameSeries ;
    :rangeIncludes :Place,
        :PostalAddress,
        :URL ;
    rdfs:comment "Real or fictional location of the game (or part of game)." ;
    skos:definition "Real or fictional location of the game (or part of game)." .

:gamePlatform a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "gamePlatform" ;
    :domainIncludes :VideoGame,
        :VideoGameSeries ;
    :rangeIncludes :Text,
        :Thing,
        :URL ;
    rdfs:comment "The electronic systems used to play <a href=\"http://en.wikipedia.org/wiki/Category:Video_game_platforms\">video games</a>." ;
    skos:definition "The electronic systems used to play <a href=\"http://en.wikipedia.org/wiki/Category:Video_game_platforms\">video games</a>." .

:gameTip a owl:ObjectProperty ;
    rdfs:label "gameTip" ;
    :domainIncludes :VideoGame ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "Links to tips, tactics, etc." ;
    skos:definition "Links to tips, tactics, etc." .

:gender a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "gender" ;
    :domainIncludes :Person,
        :SportsTeam ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :GenderType,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2341> ;
    rdfs:comment "Gender of something, typically a [[Person]], but possibly also fictional characters, animals, etc. While http://schema.org/Male and http://schema.org/Female may be used, text strings are also acceptable for people who are not a binary gender. The [[gender]] property can also be used in an extended sense to cover e.g. the gender of sports teams. As with the gender of individuals, we do not try to enumerate all possibilities. A mixed-gender [[SportsTeam]] can be indicated with a text value of \"Mixed\"." ;
    skos:definition "Gender of something, typically a [[Person]], but possibly also fictional characters, animals, etc. While http://schema.org/Male and http://schema.org/Female may be used, text strings are also acceptable for people who are not a binary gender. The [[gender]] property can also be used in an extended sense to cover e.g. the gender of sports teams. As with the gender of individuals, we do not try to enumerate all possibilities. A mixed-gender [[SportsTeam]] can be indicated with a text value of \"Mixed\"." .

:geo a owl:ObjectProperty ;
    rdfs:label "geo" ;
    :domainIncludes :Place ;
    :rangeIncludes :GeoCoordinates,
        :GeoShape ;
    rdfs:comment "The geo coordinates of the place." ;
    skos:definition "The geo coordinates of the place." .

:geoContains a owl:ObjectProperty ;
    rdfs:label "geoContains" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a containing geometry to a contained geometry. \"a contains b iff no points of b lie in the exterior of a, and at least one point of the interior of b lies in the interior of a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents a relationship between two geometries (or the places they represent), relating a containing geometry to a contained geometry. \"a contains b iff no points of b lie in the exterior of a, and at least one point of the interior of b lies in the interior of a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geoCoveredBy a owl:ObjectProperty ;
    rdfs:label "geoCoveredBy" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that covers it. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that covers it. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geoCovers a owl:ObjectProperty ;
    rdfs:label "geoCovers" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a covering geometry to a covered geometry. \"Every point of b is a point of (the interior or boundary of) a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents a relationship between two geometries (or the places they represent), relating a covering geometry to a covered geometry. \"Every point of b is a point of (the interior or boundary of) a\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geoCrosses a owl:ObjectProperty ;
    rdfs:label "geoCrosses" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that crosses it: \"a crosses b: they have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that crosses it: \"a crosses b: they have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them\". As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geoDisjoint a owl:ObjectProperty ;
    rdfs:label "geoDisjoint" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) are topologically disjoint: \"they have no point in common. They form a set of disconnected geometries.\" (A symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM).)" ;
    skos:definition "Represents spatial relations in which two geometries (or the places they represent) are topologically disjoint: \"they have no point in common. They form a set of disconnected geometries.\" (A symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM).)" .

:geoEquals a owl:ObjectProperty ;
    rdfs:label "geoEquals" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) are topologically equal, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM). \"Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other\" (a symmetric relationship)." ;
    skos:definition "Represents spatial relations in which two geometries (or the places they represent) are topologically equal, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM). \"Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other\" (a symmetric relationship)." .

:geoIntersects a owl:ObjectProperty ;
    rdfs:label "geoIntersects" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) have at least one point in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents spatial relations in which two geometries (or the places they represent) have at least one point in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geoMidpoint a owl:ObjectProperty ;
    rdfs:label "geoMidpoint" ;
    :domainIncludes :GeoCircle ;
    :rangeIncludes :GeoCoordinates ;
    rdfs:comment "Indicates the GeoCoordinates at the centre of a GeoShape, e.g. GeoCircle." ;
    skos:definition "Indicates the GeoCoordinates at the centre of a GeoShape, e.g. GeoCircle." .

:geoOverlaps a owl:ObjectProperty ;
    rdfs:label "geoOverlaps" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that geospatially overlaps it, i.e. they have some but not all points in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that geospatially overlaps it, i.e. they have some but not all points in common. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geoRadius a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "geoRadius" ;
    :domainIncludes :GeoCircle ;
    :rangeIncludes :Distance,
        :Number,
        :Text ;
    rdfs:comment "Indicates the approximate radius of a GeoCircle (metres unless indicated otherwise via Distance notation)." ;
    skos:definition "Indicates the approximate radius of a GeoCircle (metres unless indicated otherwise via Distance notation)." .

:geoTouches a owl:ObjectProperty ;
    rdfs:label "geoTouches" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) touch: \"they have at least one boundary point in common, but no interior points.\" (A symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM).)" ;
    skos:definition "Represents spatial relations in which two geometries (or the places they represent) touch: \"they have at least one boundary point in common, but no interior points.\" (A symmetric relationship, as defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM).)" .

:geoWithin a owl:ObjectProperty ;
    rdfs:label "geoWithin" ;
    :domainIncludes :GeospatialGeometry,
        :Place ;
    :rangeIncludes :GeospatialGeometry,
        :Place ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to one that contains it, i.e. it is inside (i.e. within) its interior. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." ;
    skos:definition "Represents a relationship between two geometries (or the places they represent), relating a geometry to one that contains it, i.e. it is inside (i.e. within) its interior. As defined in [DE-9IM](https://en.wikipedia.org/wiki/DE-9IM)." .

:geographicArea a owl:ObjectProperty ;
    rdfs:label "geographicArea" ;
    :domainIncludes :Audience ;
    :rangeIncludes :AdministrativeArea ;
    rdfs:comment "The geographic area associated with the audience." ;
    skos:definition "The geographic area associated with the audience." .

:gettingTestedInfo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "gettingTestedInfo" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Information about getting tested (for a [[MedicalCondition]]), e.g. in the context of a pandemic." ;
    skos:definition "Information about getting tested (for a [[MedicalCondition]]), e.g. in the context of a pandemic." .

:givenName a owl:DatatypeProperty ;
    rdfs:label "givenName" ;
    :domainIncludes :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "Given name. In the U.S., the first name of a Person." ;
    skos:definition "Given name. In the U.S., the first name of a Person." .

:globalLocationNumber a owl:DatatypeProperty ;
    rdfs:label "globalLocationNumber" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person,
        :Place ;
    :rangeIncludes :Text ;
    rdfs:comment "The [Global Location Number](http://www.gs1.org/gln) (GLN, sometimes also referred to as International Location Number or ILN) of the respective organization, person, or place. The GLN is a 13-digit number used to identify parties and physical locations." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty unece:gLNId,
        gs1:globalLocationNumber ;
    skos:definition "The [Global Location Number](http://www.gs1.org/gln) (GLN, sometimes also referred to as International Location Number or ILN) of the respective organization, person, or place. The GLN is a 13-digit number used to identify parties and physical locations." .

:governmentBenefitsInfo a owl:ObjectProperty ;
    rdfs:label "governmentBenefitsInfo" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :GovernmentService ;
    :source <https://github.com/schemaorg/schemaorg/issues/2534> ;
    rdfs:comment "governmentBenefitsInfo provides information about government benefits associated with a SpecialAnnouncement." ;
    skos:definition "governmentBenefitsInfo provides information about government benefits associated with a SpecialAnnouncement." .

:gracePeriod a owl:ObjectProperty ;
    rdfs:label "gracePeriod" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Duration ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The period of time after any due date that the borrower has to fulfil its obligations before a default (failure to pay) is deemed to have occurred." ;
    skos:definition "The period of time after any due date that the borrower has to fulfil its obligations before a default (failure to pay) is deemed to have occurred." .

:grantee a owl:ObjectProperty ;
    rdfs:label "grantee" ;
    :domainIncludes :DigitalDocumentPermission ;
    :rangeIncludes :Audience,
        :ContactPoint,
        :Organization,
        :Person ;
    rdfs:comment "The person, organization, contact point, or audience that has been granted this permission." ;
    skos:definition "The person, organization, contact point, or audience that has been granted this permission." .

:greater a owl:ObjectProperty ;
    rdfs:label "greater" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :QualitativeValue ;
    :rangeIncludes :QualitativeValue ;
    rdfs:comment "This ordering relation for qualitative values indicates that the subject is greater than the object." ;
    skos:definition "This ordering relation for qualitative values indicates that the subject is greater than the object." .

:greaterOrEqual a owl:ObjectProperty ;
    rdfs:label "greaterOrEqual" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :QualitativeValue ;
    :rangeIncludes :QualitativeValue ;
    rdfs:comment "This ordering relation for qualitative values indicates that the subject is greater than or equal to the object." ;
    skos:definition "This ordering relation for qualitative values indicates that the subject is greater than or equal to the object." .

:gtin12 a owl:DatatypeProperty ;
    rdfs:label "gtin12" ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The GTIN-12 code of the product, or the product to which the offer refers. The GTIN-12 is the 12-digit GS1 Identification Key composed of a U.P.C. Company Prefix, Item Reference, and Check Digit used to identify trade items. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    rdfs:subPropertyOf :gtin,
        :identifier ;
    skos:definition "The GTIN-12 code of the product, or the product to which the offer refers. The GTIN-12 is the 12-digit GS1 Identification Key composed of a U.P.C. Company Prefix, Item Reference, and Check Digit used to identify trade items. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." .

:gtin13 a owl:DatatypeProperty ;
    rdfs:label "gtin13" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The GTIN-13 code of the product, or the product to which the offer refers. This is equivalent to 13-digit ISBN codes and EAN UCC-13. Former 12-digit UPC codes can be converted into a GTIN-13 code by simply adding a preceding zero. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    rdfs:subPropertyOf :gtin,
        :identifier ;
    skos:definition "The GTIN-13 code of the product, or the product to which the offer refers. This is equivalent to 13-digit ISBN codes and EAN UCC-13. Former 12-digit UPC codes can be converted into a GTIN-13 code by simply adding a preceding zero. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." .

:gtin14 a owl:DatatypeProperty ;
    rdfs:label "gtin14" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The GTIN-14 code of the product, or the product to which the offer refers. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    rdfs:subPropertyOf :gtin,
        :identifier ;
    skos:definition "The GTIN-14 code of the product, or the product to which the offer refers. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." .

:gtin8 a owl:DatatypeProperty ;
    rdfs:label "gtin8" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The GTIN-8 code of the product, or the product to which the offer refers. This code is also known as EAN/UCC-8 or 8-digit EAN. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." ;
    rdfs:subPropertyOf :gtin,
        :identifier ;
    skos:definition "The GTIN-8 code of the product, or the product to which the offer refers. This code is also known as EAN/UCC-8 or 8-digit EAN. See [GS1 GTIN Summary](http://www.gs1.org/barcodes/technical/idkeys/gtin) for more details." .

:guideline a owl:ObjectProperty ;
    rdfs:label "guideline" ;
    :domainIncludes :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalGuideline ;
    rdfs:comment "A medical guideline related to this entity." ;
    skos:definition "A medical guideline related to this entity." .

:guidelineDate a owl:DatatypeProperty ;
    rdfs:label "guidelineDate" ;
    :domainIncludes :MedicalGuideline ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Date ;
    rdfs:comment "Date on which this guideline's recommendation was made." ;
    skos:definition "Date on which this guideline's recommendation was made." .

:guidelineSubject a owl:ObjectProperty ;
    rdfs:label "guidelineSubject" ;
    :domainIncludes :MedicalGuideline ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity ;
    rdfs:comment "The medical conditions, treatments, etc. that are the subject of the guideline." ;
    skos:definition "The medical conditions, treatments, etc. that are the subject of the guideline." .

:handlingTime a owl:ObjectProperty ;
    rdfs:label "handlingTime" ;
    :domainIncludes :ShippingDeliveryTime,
        :ShippingService ;
    :rangeIncludes :QuantitativeValue,
        :ServicePeriod ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment """The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup.

In the context of [[ShippingDeliveryTime]], Typical properties: minValue, maxValue, unitCode (d for DAY).  This is by common convention assumed to mean business days (if a unitCode is used, coded as "d"), i.e. only counting days when the business normally operates.

In the context of [[ShippingService]], use the [[ServicePeriod]] format, that contains the same information in a structured form, with cut-off time, business days and duration.""" ;
    rdfs:subPropertyOf :duration ;
    skos:definition """The typical delay between the receipt of the order and the goods either leaving the warehouse or being prepared for pickup, in case the delivery method is on site pickup.

In the context of [[ShippingDeliveryTime]], Typical properties: minValue, maxValue, unitCode (d for DAY).  This is by common convention assumed to mean business days (if a unitCode is used, coded as "d"), i.e. only counting days when the business normally operates.

In the context of [[ShippingService]], use the [[ServicePeriod]] format, that contains the same information in a structured form, with cut-off time, business days and duration.""" .

:hasAdultConsideration a owl:ObjectProperty ;
    rdfs:label "hasAdultConsideration" ;
    :domainIncludes :Offer,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AdultOrientedEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2989> ;
    rdfs:comment "Used to tag an item to be intended or suitable for consumption or use by adults only." ;
    skos:definition "Used to tag an item to be intended or suitable for consumption or use by adults only." .

:hasBioPolymerSequence a owl:DatatypeProperty ;
    rdfs:label "hasBioPolymerSequence" ;
    :domainIncludes :Gene,
        :Protein ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <http://www.bioschemas.org/Gene> ;
    rdfs:comment "A symbolic representation of a BioChemEntity. For example, a nucleotide sequence of a Gene or an amino acid sequence of a Protein." ;
    rdfs:subPropertyOf :hasRepresentation ;
    skos:definition "A symbolic representation of a BioChemEntity. For example, a nucleotide sequence of a Gene or an amino acid sequence of a Protein." .

:hasCategoryCode a owl:ObjectProperty ;
    rdfs:label "hasCategoryCode" ;
    :domainIncludes :CategoryCodeSet ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CategoryCode ;
    :source <https://github.com/schemaorg/schemaorg/issues/894> ;
    rdfs:comment "A Category code contained in this code set." ;
    rdfs:subPropertyOf :hasDefinedTerm ;
    skos:definition "A Category code contained in this code set." .

:hasCertification a owl:ObjectProperty ;
    rdfs:label "hasCertification" ;
    :domainIncludes :Organization,
        :Person,
        :Place,
        :Product,
        :Service ;
    :rangeIncludes :Certification ;
    :source <https://github.com/schemaorg/schemaorg/issues/3230> ;
    rdfs:comment "Certification information about a product, organization, service, place, or person." ;
    rdfs:subPropertyOf fibo-fnd-doc:isReferencedIn,
        cmns-cls:isClassifiedBy ;
    owl:equivalentProperty unece:ApplicableCertificate ;
    skos:definition "Certification information about a product, organization, service, place, or person." .

:hasCourse a owl:ObjectProperty ;
    rdfs:label "hasCourse" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Course ;
    :source <https://github.com/schemaorg/schemaorg/issues/2483> ;
    rdfs:comment "A course or class that is one of the learning opportunities that constitute an educational / occupational program. No information is implied about whether the course is mandatory or optional; no guarantee is implied about whether the course will be available to everyone on the program." ;
    skos:definition "A course or class that is one of the learning opportunities that constitute an educational / occupational program. No information is implied about whether the course is mandatory or optional; no guarantee is implied about whether the course will be available to everyone on the program." .

:hasCourseInstance a owl:ObjectProperty ;
    rdfs:label "hasCourseInstance" ;
    :domainIncludes :Course ;
    :rangeIncludes :CourseInstance ;
    rdfs:comment "An offering of the course at a specific time and place or through specific media or mode of study or to a specific section of students." ;
    skos:definition "An offering of the course at a specific time and place or through specific media or mode of study or to a specific section of students." .

:hasCredential a owl:ObjectProperty ;
    rdfs:label "hasCredential" ;
    :domainIncludes :Organization,
        :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EducationalOccupationalCredential ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "A credential awarded to the Person or Organization." ;
    skos:definition "A credential awarded to the Person or Organization." .

:hasDeliveryMethod a owl:ObjectProperty ;
    rdfs:label "hasDeliveryMethod" ;
    :domainIncludes :DeliveryEvent,
        :ParcelDelivery ;
    :rangeIncludes :DeliveryMethod ;
    rdfs:comment "Method used for delivery or shipping." ;
    skos:definition "Method used for delivery or shipping." .

:hasDigitalDocumentPermission a owl:ObjectProperty ;
    rdfs:label "hasDigitalDocumentPermission" ;
    :domainIncludes :DigitalDocument ;
    :rangeIncludes :DigitalDocumentPermission ;
    rdfs:comment "A permission related to the access to this document (e.g. permission to read or write an electronic document). For a public document, specify a grantee with an Audience with audienceType equal to \"public\"." ;
    skos:definition "A permission related to the access to this document (e.g. permission to read or write an electronic document). For a public document, specify a grantee with an Audience with audienceType equal to \"public\"." .

:hasDriveThroughService a owl:DatatypeProperty ;
    rdfs:label "hasDriveThroughService" ;
    :domainIncludes :Place ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Indicates whether some facility (e.g. [[FoodEstablishment]], [[CovidTestingFacility]]) offers a service that can be used by driving through in a car. In the case of [[CovidTestingFacility]] such facilities could potentially help with social distancing from other potentially-infected users." ;
    skos:definition "Indicates whether some facility (e.g. [[FoodEstablishment]], [[CovidTestingFacility]]) offers a service that can be used by driving through in a car. In the case of [[CovidTestingFacility]] such facilities could potentially help with social distancing from other potentially-infected users." .

:hasEnergyConsumptionDetails a owl:ObjectProperty ;
    rdfs:label "hasEnergyConsumptionDetails" ;
    :domainIncludes :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EnergyConsumptionDetails ;
    :source <https://github.com/schemaorg/schemaorg/issues/2670> ;
    rdfs:comment "Defines the energy efficiency Category (also known as \"class\" or \"rating\") for a product according to an international energy efficiency standard." ;
    skos:definition "Defines the energy efficiency Category (also known as \"class\" or \"rating\") for a product according to an international energy efficiency standard." .

:hasEnergyEfficiencyCategory a owl:ObjectProperty ;
    rdfs:label "hasEnergyEfficiencyCategory" ;
    :domainIncludes :EnergyConsumptionDetails ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EnergyEfficiencyEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2670> ;
    rdfs:comment "Defines the energy efficiency Category (which could be either a rating out of range of values or a yes/no certification) for a product according to an international energy efficiency standard." ;
    skos:definition "Defines the energy efficiency Category (which could be either a rating out of range of values or a yes/no certification) for a product according to an international energy efficiency standard." .

:hasGS1DigitalLink a owl:DatatypeProperty ;
    rdfs:label "hasGS1DigitalLink" ;
    :domainIncludes :Offer,
        :Organization,
        :Place,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/3475> ;
    rdfs:comment "The <a href=\"https://www.gs1.org/standards/gs1-digital-link\">GS1 digital link</a> associated with the object. This URL should conform to the particular requirements of digital links. The link should only contain the Application Identifiers (AIs) that are relevant for the entity being annotated, for instance a [[Product]] or an [[Organization]], and for the correct granularity. In particular, for products:<ul><li>A Digital Link that contains a serial number (AI <code>21</code>) should only be present on instances of [[IndividualProduct]]</li><li>A Digital Link that contains a lot number (AI <code>10</code>) should be annotated as [[SomeProduct]] if only products from that lot are sold, or [[IndividualProduct]] if there is only a specific product.</li><li>A Digital Link that contains a global model number (AI <code>8013</code>)  should be attached to a [[Product]] or a [[ProductModel]].</li></ul> Other item types should be adapted similarly." ;
    rdfs:subPropertyOf :identifier ;
    skos:definition "The <a href=\"https://www.gs1.org/standards/gs1-digital-link\">GS1 digital link</a> associated with the object. This URL should conform to the particular requirements of digital links. The link should only contain the Application Identifiers (AIs) that are relevant for the entity being annotated, for instance a [[Product]] or an [[Organization]], and for the correct granularity. In particular, for products:<ul><li>A Digital Link that contains a serial number (AI <code>21</code>) should only be present on instances of [[IndividualProduct]]</li><li>A Digital Link that contains a lot number (AI <code>10</code>) should be annotated as [[SomeProduct]] if only products from that lot are sold, or [[IndividualProduct]] if there is only a specific product.</li><li>A Digital Link that contains a global model number (AI <code>8013</code>)  should be attached to a [[Product]] or a [[ProductModel]].</li></ul> Other item types should be adapted similarly." .

:hasHealthAspect a owl:ObjectProperty ;
    rdfs:label "hasHealthAspect" ;
    :domainIncludes :HealthTopicContent ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :HealthAspectEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Indicates the aspect or aspects specifically addressed in some [[HealthTopicContent]]. For example, that the content is an overview, or that it talks about treatment, self-care, treatments or their side-effects." ;
    skos:definition "Indicates the aspect or aspects specifically addressed in some [[HealthTopicContent]]. For example, that the content is an overview, or that it talks about treatment, self-care, treatments or their side-effects." .

:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "hasMeasurement" ;
    :domainIncludes :Certification,
        :Offer,
        :Product,
        :SizeSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "A measurement of an item, For example, the inseam of pants, the wheel size of a bicycle, the gauge of a screw, or the carbon footprint measured for certification by an authority. Usually an exact measurement, but can also be a range of measurements for adjustable products, for example belts and ski bindings." ;
    skos:definition "A measurement of an item, For example, the inseam of pants, the wheel size of a bicycle, the gauge of a screw, or the carbon footprint measured for certification by an authority. Usually an exact measurement, but can also be a range of measurements for adjustable products, for example belts and ski bindings." .

