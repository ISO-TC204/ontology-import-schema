    rdfs:comment "Content about the allergy-related aspects of a health topic." ;
    skos:definition "Content about the allergy-related aspects of a health topic." .

:AmpStory a owl:Class ;
    rdfs:label "AmpStory" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2646> ;
    rdfs:comment "A creative work with a visual storytelling format intended to be viewed online, particularly on mobile devices." ;
    rdfs:subClassOf :CreativeWork,
        :MediaObject ;
    skos:definition "A creative work with a visual storytelling format intended to be viewed online, particularly on mobile devices." .

:AmusementPark a owl:Class ;
    rdfs:label "AmusementPark" ;
    rdfs:comment "An amusement park." ;
    rdfs:subClassOf :EntertainmentBusiness ;
    skos:definition "An amusement park." .

:AnaerobicActivity a :PhysicalActivityCategory ;
    rdfs:label "AnaerobicActivity" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Physical activity that is of high-intensity which utilizes the anaerobic metabolism of the body." ;
    skos:definition "Physical activity that is of high-intensity which utilizes the anaerobic metabolism of the body." .

:AnalysisNewsArticle a owl:Class ;
    rdfs:label "AnalysisNewsArticle" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "An AnalysisNewsArticle is a [[NewsArticle]] that, while based on factual reporting, incorporates the expertise of the author/producer, offering interpretations and conclusions." ;
    rdfs:subClassOf :NewsArticle ;
    skos:definition "An AnalysisNewsArticle is a [[NewsArticle]] that, while based on factual reporting, incorporates the expertise of the author/producer, offering interpretations and conclusions." .

:AndroidPlatform a :DigitalPlatformEnumeration ;
    rdfs:label "AndroidPlatform" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3057> ;
    rdfs:comment "Represents the broad notion of Android-based operating systems." ;
    skos:definition "Represents the broad notion of Android-based operating systems." .

:Anesthesia a :MedicalSpecialty ;
    rdfs:label "Anesthesia" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A specific branch of medical science that pertains to study of anesthetics and their application." ;
    skos:definition "A specific branch of medical science that pertains to study of anesthetics and their application." .

:AnimalShelter a owl:Class ;
    rdfs:label "AnimalShelter" ;
    rdfs:comment "Animal shelter." ;
    rdfs:subClassOf :LocalBusiness ;
    skos:definition "Animal shelter." .

:Appearance a :PhysicalExam ;
    rdfs:label "Appearance" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Appearance assessment with clinical examination." ;
    skos:definition "Appearance assessment with clinical examination." .

:AppendAction a owl:Class ;
    rdfs:label "AppendAction" ;
    rdfs:comment "The act of inserting at the end if an ordered collection." ;
    rdfs:subClassOf :InsertAction ;
    skos:definition "The act of inserting at the end if an ordered collection." .

:ApplyAction a owl:Class ;
    rdfs:label "ApplyAction" ;
    rdfs:comment "The act of registering to an organization/service without the guarantee to receive it.\\n\\nRelated actions:\\n\\n* [[RegisterAction]]: Unlike RegisterAction, ApplyAction has no guarantees that the application will be accepted." ;
    rdfs:subClassOf :OrganizeAction ;
    skos:definition "The act of registering to an organization/service without the guarantee to receive it.\\n\\nRelated actions:\\n\\n* [[RegisterAction]]: Unlike RegisterAction, ApplyAction has no guarantees that the application will be accepted." .

:ApprovedIndication a owl:Class ;
    rdfs:label "ApprovedIndication" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "An indication for a medical therapy that has been formally specified or approved by a regulatory body that regulates use of the therapy; for example, the US FDA approves indications for most drugs in the US." ;
    rdfs:subClassOf :MedicalIndication ;
    skos:definition "An indication for a medical therapy that has been formally specified or approved by a regulatory body that regulates use of the therapy; for example, the US FDA approves indications for most drugs in the US." .

:Aquarium a owl:Class ;
    rdfs:label "Aquarium" ;
    rdfs:comment "Aquarium." ;
    rdfs:subClassOf :CivicStructure ;
    skos:definition "Aquarium." .

:ArriveAction a owl:Class ;
    rdfs:label "ArriveAction" ;
    rdfs:comment "The act of arriving at a place. An agent arrives at a destination from a fromLocation, optionally with participants." ;
    rdfs:subClassOf :MoveAction ;
    skos:definition "The act of arriving at a place. An agent arrives at a destination from a fromLocation, optionally with participants." .

:ArtGallery a owl:Class ;
    rdfs:label "ArtGallery" ;
    rdfs:comment "An art gallery." ;
    rdfs:subClassOf :EntertainmentBusiness ;
    skos:definition "An art gallery." .

:AskPublicNewsArticle a owl:Class ;
    rdfs:label "AskPublicNewsArticle" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "A [[NewsArticle]] expressing an open call by a [[NewsMediaOrganization]] asking the public for input, insights, clarifications, anecdotes, documentation, etc., on an issue, for reporting purposes." ;
    rdfs:subClassOf :NewsArticle ;
    skos:definition "A [[NewsArticle]] expressing an open call by a [[NewsMediaOrganization]] asking the public for input, insights, clarifications, anecdotes, documentation, etc., on an issue, for reporting purposes." .

:AssignAction a owl:Class ;
    rdfs:label "AssignAction" ;
    rdfs:comment "The act of allocating an action/event/task to some destination (someone or something)." ;
    rdfs:subClassOf :AllocateAction ;
    skos:definition "The act of allocating an action/event/task to some destination (someone or something)." .

:Atlas a owl:Class ;
    rdfs:label "Atlas" ;
    :isPartOf <http://bib.schema.org> ;
    :source <http://www.productontology.org/id/Atlas> ;
    rdfs:comment "A collection or bound volume of maps, charts, plates or tables, physical or in media form illustrating any subject." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A collection or bound volume of maps, charts, plates or tables, physical or in media form illustrating any subject." .

:Attorney a owl:Class ;
    rdfs:label "Attorney" ;
    rdfs:comment "Professional service: Attorney. \\n\\nThis type is deprecated - [[LegalService]] is more inclusive and less ambiguous." ;
    rdfs:subClassOf :LegalService ;
    skos:definition "Professional service: Attorney. \\n\\nThis type is deprecated - [[LegalService]] is more inclusive and less ambiguous." .

:AudioObjectSnapshot a owl:Class ;
    rdfs:label "AudioObjectSnapshot" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "A specific and exact (byte-for-byte) version of an [[AudioObject]]. Two byte-for-byte identical files, for the purposes of this type, considered identical. If they have different embedded metadata the files will differ. Different external facts about the files, e.g. creator or dateCreated that aren't represented in their actual content, do not affect this notion of identity." ;
    rdfs:subClassOf :AudioObject ;
    skos:definition "A specific and exact (byte-for-byte) version of an [[AudioObject]]. Two byte-for-byte identical files, for the purposes of this type, considered identical. If they have different embedded metadata the files will differ. Different external facts about the files, e.g. creator or dateCreated that aren't represented in their actual content, do not affect this notion of identity." .

:AudiobookFormat a :BookFormatType ;
    rdfs:label "AudiobookFormat" ;
    rdfs:comment "Book format: Audiobook. This is an enumerated value for use with the bookFormat property. There is also a type 'Audiobook' in the bib extension which includes Audiobook specific properties." ;
    skos:definition "Book format: Audiobook. This is an enumerated value for use with the bookFormat property. There is also a type 'Audiobook' in the bib extension which includes Audiobook specific properties." .

:AuthenticateAction a owl:Class ;
    rdfs:label "AuthenticateAction" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/4507> ;
    rdfs:comment "The action of authenticating into a device or application." ;
    rdfs:subClassOf :ControlAction ;
    skos:definition "The action of authenticating into a device or application." .

:AuthoritativeLegalValue a :LegalValueLevel ;
    rdfs:label "AuthoritativeLegalValue" ;
    :contributor <http://schema.org/docs/collab/ELI> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1156>,
        <https://op.europa.eu/en/web/eu-vocabularies/model/-/resource/dataset/eli> ;
    rdfs:comment "Indicates that the publisher gives some special status to the publication of the document. (\"The Queens Printer\" version of a UK Act of Parliament, or the PDF version of a Directive published by the EU Office of Publications). Something \"Authoritative\" is considered to be also [[OfficialLegalValue]]\"." ;
    skos:definition "Indicates that the publisher gives some special status to the publication of the document. (\"The Queens Printer\" version of a UK Act of Parliament, or the PDF version of a Directive published by the EU Office of Publications). Something \"Authoritative\" is considered to be also [[OfficialLegalValue]]\"." ;
    skos:exactMatch eli:LegalValue-authoritative .

