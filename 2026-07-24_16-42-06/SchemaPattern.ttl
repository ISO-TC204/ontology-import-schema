:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    :domainIncludes :Organization,
        :ProgramMembership ;
    :rangeIncludes :Organization,
        :Person ;
    :supersededBy :member ;
    rdfs:comment "A member of this organization." ;
    skos:definition "A member of this organization." .

:membershipNumber a owl:DatatypeProperty ;
    rdfs:label "membershipNumber" ;
    :domainIncludes :ProgramMembership ;
    :rangeIncludes :Text ;
    rdfs:comment "A unique identifier for the membership." ;
    skos:definition "A unique identifier for the membership." .

:membershipPointsEarned a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "membershipPointsEarned" ;
    :domainIncludes :MemberProgramTier,
        :PriceSpecification,
        :ProgramMembership ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2085> ;
    rdfs:comment "The number of membership points earned by the member. If necessary, the unitText can be used to express the units the points are issued in. (E.g. stars, miles, etc.)" ;
    skos:definition "The number of membership points earned by the member. If necessary, the unitText can be used to express the units the points are issued in. (E.g. stars, miles, etc.)" .

:memoryRequirements a owl:DatatypeProperty ;
    rdfs:label "memoryRequirements" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Minimum memory requirements." ;
    skos:definition "Minimum memory requirements." .

:mentions a owl:ObjectProperty ;
    rdfs:label "mentions" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Thing ;
    rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept." ;
    skos:definition "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept." .

:menu a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "menu" ;
    :domainIncludes :FoodEstablishment ;
    :rangeIncludes :Menu,
        :Text,
        :URL ;
    :supersededBy :hasMenu ;
    rdfs:comment "Either the actual menu as a structured representation, as text, or a URL of the menu." ;
    skos:definition "Either the actual menu as a structured representation, as text, or a URL of the menu." .

:menuAddOn a owl:ObjectProperty ;
    rdfs:label "menuAddOn" ;
    :domainIncludes :MenuItem ;
    :rangeIncludes :MenuItem,
        :MenuSection ;
    :source <https://github.com/schemaorg/schemaorg/issues/1541> ;
    rdfs:comment "Additional menu item(s) such as a side dish of salad or side order of fries that can be added to this menu item. Additionally it can be a menu section containing allowed add-on menu items for this menu item." ;
    skos:definition "Additional menu item(s) such as a side dish of salad or side order of fries that can be added to this menu item. Additionally it can be a menu section containing allowed add-on menu items for this menu item." .

:merchant a owl:ObjectProperty ;
    rdfs:label "merchant" ;
    :domainIncludes :Order ;
    :rangeIncludes :Organization,
        :Person ;
    :supersededBy :seller ;
    rdfs:comment "'merchant' is an out-dated term for 'seller'." ;
    skos:definition "'merchant' is an out-dated term for 'seller'." .

:merchantReturnDays a owl:DatatypeProperty ;
    rdfs:label "merchantReturnDays" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date,
        :DateTime,
        :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/2288> ;
    rdfs:comment "Specifies either a fixed return date or the number of days (from the delivery date) that a product can be returned. Used when the [[returnPolicyCategory]] property is specified as [[MerchantReturnFiniteReturnWindow]]." ;
    skos:definition "Specifies either a fixed return date or the number of days (from the delivery date) that a product can be returned. Used when the [[returnPolicyCategory]] property is specified as [[MerchantReturnFiniteReturnWindow]]." .

:merchantReturnLink a owl:DatatypeProperty ;
    rdfs:label "merchantReturnLink" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2288> ;
    rdfs:comment "Specifies a Web page or service by URL, for product returns." ;
    skos:definition "Specifies a Web page or service by URL, for product returns." .

:messageAttachment a owl:ObjectProperty ;
    rdfs:label "messageAttachment" ;
    :domainIncludes :Message ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "A CreativeWork attached to the message." ;
    skos:definition "A CreativeWork attached to the message." .

:mileageFromOdometer a owl:ObjectProperty ;
    rdfs:label "mileageFromOdometer" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The total distance travelled by the particular vehicle since its initial production, as read from its odometer.\\n\\nTypical unit code(s): KMT for kilometers, SMI for statute miles." ;
    skos:definition "The total distance travelled by the particular vehicle since its initial production, as read from its odometer.\\n\\nTypical unit code(s): KMT for kilometers, SMI for statute miles." .

:minPrice a owl:DatatypeProperty ;
    rdfs:label "minPrice" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :PriceSpecification ;
    :rangeIncludes :Number ;
    rdfs:comment "The lowest price if the price is a range." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasMonetaryAmount>,
        cmns-qtu:hasLowerBound ;
    skos:definition "The lowest price if the price is a range." .

:minValue a owl:DatatypeProperty ;
    rdfs:label "minValue" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :MonetaryAmount,
        :PropertyValue,
        :PropertyValueSpecification,
        :QuantitativeValue ;
    :rangeIncludes :Number ;
    rdfs:comment "The lower value of some characteristic or property." ;
    rdfs:subPropertyOf cmns-qtu:hasLowerBound ;
    skos:definition "The lower value of some characteristic or property." .

:minimumPaymentDue a owl:ObjectProperty ;
    rdfs:label "minimumPaymentDue" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :MonetaryAmount,
        :PriceSpecification ;
    rdfs:comment "The minimum payment required at this time." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasMonetaryAmount>,
        cmns-qtu:hasLowerBound ;
    skos:definition "The minimum payment required at this time." .

:missionCoveragePrioritiesPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "missionCoveragePrioritiesPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For a [[NewsMediaOrganization]], a statement on coverage priorities, including any public agenda or stance on issues." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For a [[NewsMediaOrganization]], a statement on coverage priorities, including any public agenda or stance on issues." .

:mobileUrl a owl:DatatypeProperty ;
    rdfs:label "mobileUrl" ;
    :domainIncludes :Offer,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3134> ;
    rdfs:comment """The [[mobileUrl]] property is provided for specific situations in which data consumers need to determine whether one of several provided URLs is a dedicated 'mobile site'.

To discourage over-use, and reflecting intial usecases, the property is expected only on [[Product]] and [[Offer]], rather than [[Thing]]. The general trend in web technology is towards [responsive design](https://en.wikipedia.org/wiki/Responsive_web_design) in which content can be flexibly adapted to a wide range of browsing environments. Pages and sites referenced with the long-established [[url]] property should ideally also be usable on a wide variety of devices, including mobile phones. In most cases, it would be pointless and counter productive to attempt to update all [[url]] markup to use [[mobileUrl]] for more mobile-oriented pages. The property is intended for the case when items (primarily [[Product]] and [[Offer]]) have extra URLs hosted on an additional "mobile site" alongside the main one. It should not be taken as an endorsement of this publication style.
    """ ;
    skos:definition """The [[mobileUrl]] property is provided for specific situations in which data consumers need to determine whether one of several provided URLs is a dedicated 'mobile site'.

To discourage over-use, and reflecting intial usecases, the property is expected only on [[Product]] and [[Offer]], rather than [[Thing]]. The general trend in web technology is towards [responsive design](https://en.wikipedia.org/wiki/Responsive_web_design) in which content can be flexibly adapted to a wide range of browsing environments. Pages and sites referenced with the long-established [[url]] property should ideally also be usable on a wide variety of devices, including mobile phones. In most cases, it would be pointless and counter productive to attempt to update all [[url]] markup to use [[mobileUrl]] for more mobile-oriented pages. The property is intended for the case when items (primarily [[Product]] and [[Offer]]) have extra URLs hosted on an additional "mobile site" alongside the main one. It should not be taken as an endorsement of this publication style.
    """ .

:model a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "model" ;
    :domainIncludes :Product ;
    :rangeIncludes :ProductModel,
        :Text ;
    rdfs:comment "The model of the product. Use with the URL of a ProductModel or a textual representation of the model identifier. The URL of the ProductModel can be from an external source. It is recommended to additionally provide strong product identifiers via the gtin8/gtin13/gtin14 and mpn properties." ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    owl:equivalentProperty unece:ModelName ;
    skos:definition "The model of the product. Use with the URL of a ProductModel or a textual representation of the model identifier. The URL of the ProductModel can be from an external source. It is recommended to additionally provide strong product identifiers via the gtin8/gtin13/gtin14 and mpn properties." .

:modelDate a owl:DatatypeProperty ;
    rdfs:label "modelDate" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :Date ;
    rdfs:comment "The release date of a vehicle model (often used to differentiate versions of the same make and model)." ;
    skos:definition "The release date of a vehicle model (often used to differentiate versions of the same make and model)." .

:modifiedTime a owl:DatatypeProperty ;
    rdfs:label "modifiedTime" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The date and time the reservation was modified." ;
    skos:definition "The date and time the reservation was modified." .

:molecularFormula a owl:DatatypeProperty ;
    rdfs:label "molecularFormula" ;
    :domainIncludes :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <http://www.bioschemas.org/MolecularEntity> ;
    rdfs:comment "The empirical formula is the simplest whole number ratio of all the atoms in a molecule." ;
    skos:definition "The empirical formula is the simplest whole number ratio of all the atoms in a molecule." .

:molecularWeight a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "molecularWeight" ;
    :domainIncludes :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    :source <http://www.bioschemas.org/MolecularEntity> ;
    rdfs:comment "This is the molecular weight of the entity being described, not of the parent. Units should be included in the form '&lt;Number&gt; &lt;unit&gt;', for example '12 amu' or as '&lt;QuantitativeValue&gt;." ;
    skos:definition "This is the molecular weight of the entity being described, not of the parent. Units should be included in the form '&lt;Number&gt; &lt;unit&gt;', for example '12 amu' or as '&lt;QuantitativeValue&gt;." .

:monoisotopicMolecularWeight a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "monoisotopicMolecularWeight" ;
    :domainIncludes :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    :source <http://www.bioschemas.org/MolecularEntity> ;
    rdfs:comment "The monoisotopic mass is the sum of the masses of the atoms in a molecule using the unbound, ground-state, rest mass of the principal (most abundant) isotope for each element instead of the isotopic average mass. Please include the units in the form '&lt;Number&gt; &lt;unit&gt;', for example '770.230488 g/mol' or as '&lt;QuantitativeValue&gt;." ;
    skos:definition "The monoisotopic mass is the sum of the masses of the atoms in a molecule using the unbound, ground-state, rest mass of the principal (most abundant) isotope for each element instead of the isotopic average mass. Please include the units in the form '&lt;Number&gt; &lt;unit&gt;', for example '770.230488 g/mol' or as '&lt;QuantitativeValue&gt;." .

:monthlyMinimumRepaymentAmount a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "monthlyMinimumRepaymentAmount" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :PaymentCard ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The minimum payment is the lowest amount of money that one is required to pay on a credit card statement each month." ;
    skos:definition "The minimum payment is the lowest amount of money that one is required to pay on a credit card statement each month." .

:monthsOfExperience a owl:DatatypeProperty ;
    rdfs:label "monthsOfExperience" ;
    :domainIncludes :OccupationalExperienceRequirements ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2681> ;
    rdfs:comment "Indicates the minimal number of months of experience required for a position." ;
    skos:definition "Indicates the minimal number of months of experience required for a position." .

:mpn a owl:DatatypeProperty ;
    rdfs:label "mpn" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The Manufacturer Part Number (MPN) of the product, or the product to which the offer refers." ;
    owl:equivalentProperty unece:manufacturerAssignedId ;
    skos:definition "The Manufacturer Part Number (MPN) of the product, or the product to which the offer refers." .

:multipleValues a owl:DatatypeProperty ;
    rdfs:label "multipleValues" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Whether multiple values are allowed for the property.  Default is false." ;
    skos:definition "Whether multiple values are allowed for the property.  Default is false." .

:muscleAction a owl:DatatypeProperty ;
    rdfs:label "muscleAction" ;
    :domainIncludes :Muscle ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The movement the muscle generates." ;
    skos:definition "The movement the muscle generates." .

:musicArrangement a owl:ObjectProperty ;
    rdfs:label "musicArrangement" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :MusicComposition ;
    rdfs:comment "An arrangement derived from the composition." ;
    skos:definition "An arrangement derived from the composition." .

:musicBy a owl:ObjectProperty ;
    rdfs:label "musicBy" ;
    :domainIncludes :Clip,
        :Episode,
        :Movie,
        :MovieSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGame,
        :VideoGameSeries,
        :VideoObject ;
    :rangeIncludes :MusicGroup,
        :Person ;
    rdfs:comment "The composer of the soundtrack." ;
    skos:definition "The composer of the soundtrack." .

:musicCompositionForm a owl:DatatypeProperty ;
    rdfs:label "musicCompositionForm" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :Text ;
    rdfs:comment "The type of composition (e.g. overture, sonata, symphony, etc.)." ;
    skos:definition "The type of composition (e.g. overture, sonata, symphony, etc.)." .

:musicGroupMember a owl:ObjectProperty ;
    rdfs:label "musicGroupMember" ;
    :domainIncludes :MusicGroup ;
    :rangeIncludes :Person ;
    :supersededBy :member ;
    rdfs:comment "A member of a music group&#x2014;for example, John, Paul, George, or Ringo." ;
    skos:definition "A member of a music group&#x2014;for example, John, Paul, George, or Ringo." .

:musicReleaseFormat a owl:ObjectProperty ;
    rdfs:label "musicReleaseFormat" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRelease ;
    :rangeIncludes :MusicReleaseFormatType ;
    rdfs:comment "Format of this release (the type of recording media used, i.e. compact disc, digital media, LP, etc.)." ;
    skos:definition "Format of this release (the type of recording media used, i.e. compact disc, digital media, LP, etc.)." .

:musicalKey a owl:DatatypeProperty ;
    rdfs:label "musicalKey" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicComposition ;
    :rangeIncludes :Text ;
    rdfs:comment "The key, mode, or scale this composition uses." ;
    skos:definition "The key, mode, or scale this composition uses." .

:naics a owl:DatatypeProperty ;
    rdfs:label "naics" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "The North American Industry Classification System (NAICS) code for a particular organization or business person." ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    skos:definition "The North American Industry Classification System (NAICS) code for a particular organization or business person." .

:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    :domainIncludes :Thing ;
    :rangeIncludes :Text ;
    rdfs:comment "The name of the item." ;
    rdfs:subPropertyOf rdfs:label ;
    owl:equivalentProperty dcterms:title,
        cmns-txt:hasName ;
    skos:definition "The name of the item." .

:namedPosition a owl:DatatypeProperty ;
    rdfs:label "namedPosition" ;
    :domainIncludes :Role ;
    :rangeIncludes :Text,
        :URL ;
    :supersededBy :roleName ;
    rdfs:comment "A position played, performed or filled by a person or organization, as part of an organization. For example, an athlete in a SportsTeam might play in the position named 'Quarterback'." ;
    skos:definition "A position played, performed or filled by a person or organization, as part of an organization. For example, an athlete in a SportsTeam might play in the position named 'Quarterback'." .

:nationality a owl:ObjectProperty ;
    rdfs:label "nationality" ;
    :domainIncludes :Person ;
    :rangeIncludes :Country ;
    rdfs:comment "Nationality of the person." ;
    skos:definition "Nationality of the person." .

:naturalProgression a owl:DatatypeProperty ;
    rdfs:label "naturalProgression" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The expected progression of the condition if it is not treated and allowed to progress naturally." ;
    skos:definition "The expected progression of the condition if it is not treated and allowed to progress naturally." .

:negativeNotes a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "negativeNotes" ;
    :domainIncludes :Product,
        :Review ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ItemList,
        :ListItem,
        :Text,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2832> ;
    rdfs:comment """Provides negative considerations regarding something, most typically in pro/con lists for reviews (alongside [[positiveNotes]]). For symmetry 

In the case of a [[Review]], the property describes the [[itemReviewed]] from the perspective of the review; in the case of a [[Product]], the product itself is being described. Since product descriptions 
tend to emphasise positive claims, it may be relatively unusual to find [[negativeNotes]] used in this way. Nevertheless for the sake of symmetry, [[negativeNotes]] can be used on [[Product]].

The property values can be expressed either as unstructured text (repeated as necessary), or if ordered, as a list (in which case the most negative is at the beginning of the list).""" ;
    skos:definition """Provides negative considerations regarding something, most typically in pro/con lists for reviews (alongside [[positiveNotes]]). For symmetry 

In the case of a [[Review]], the property describes the [[itemReviewed]] from the perspective of the review; in the case of a [[Product]], the product itself is being described. Since product descriptions 
tend to emphasise positive claims, it may be relatively unusual to find [[negativeNotes]] used in this way. Nevertheless for the sake of symmetry, [[negativeNotes]] can be used on [[Product]].

The property values can be expressed either as unstructured text (repeated as necessary), or if ordered, as a list (in which case the most negative is at the beginning of the list).""" .

:nerve a owl:ObjectProperty ;
    rdfs:label "nerve" ;
    :domainIncludes :Muscle ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Nerve ;
    rdfs:comment "The underlying innervation associated with the muscle." ;
    skos:definition "The underlying innervation associated with the muscle." .

:nerveMotor a owl:ObjectProperty ;
    rdfs:label "nerveMotor" ;
    :domainIncludes :Nerve ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Muscle ;
    rdfs:comment "The neurological pathway extension that involves muscle control." ;
    skos:definition "The neurological pathway extension that involves muscle control." .

:netWorth a owl:ObjectProperty ;
    rdfs:label "netWorth" ;
    :domainIncludes :Person ;
    :rangeIncludes :MonetaryAmount,
        :PriceSpecification ;
    rdfs:comment "The total financial value of the person as calculated by subtracting the total value of liabilities from the total value of assets." ;
    skos:definition "The total financial value of the person as calculated by subtracting the total value of liabilities from the total value of assets." .

:newsUpdatesAndGuidelines a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "newsUpdatesAndGuidelines" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Indicates a page with news updates and guidelines. This could often be (but is not required to be) the main page containing [[SpecialAnnouncement]] markup on a site." ;
    skos:definition "Indicates a page with news updates and guidelines. This could often be (but is not required to be) the main page containing [[SpecialAnnouncement]] markup on a site." .

:nextItem a owl:ObjectProperty ;
    rdfs:label "nextItem" ;
    :domainIncludes :ListItem ;
    :rangeIncludes :ListItem ;
    rdfs:comment "A link to the ListItem that follows the current one." ;
    skos:definition "A link to the ListItem that follows the current one." .

:noBylinesPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "noBylinesPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1688> ;
