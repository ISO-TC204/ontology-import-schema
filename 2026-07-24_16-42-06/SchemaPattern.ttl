    rdfs:subClassOf :MediaObject ;
    owl:equivalentClass dcat:Distribution ;
    skos:definition "All or part of a [[Dataset]] in downloadable form. " .

:DigitalDocumentPermission a owl:Class ;
    rdfs:label "DigitalDocumentPermission" ;
    rdfs:comment "A permission for a particular person or group to access a particular file." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "A permission for a particular person or group to access a particular file." .

:DrugPrescriptionStatus a owl:Class ;
    rdfs:label "DrugPrescriptionStatus" ;
    :isPartOf <http://health-lifesci.schema.org> ;
