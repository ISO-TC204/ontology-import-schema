    :domainIncludes :ApartmentComplex,
        :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Indicates the number of available accommodation units in an [[ApartmentComplex]], or the number of accommodation units for a specific [[FloorPlan]] (within its specific [[ApartmentComplex]]). See also [[numberOfAccommodationUnits]]." ;
    skos:definition "Indicates the number of available accommodation units in an [[ApartmentComplex]], or the number of accommodation units for a specific [[FloorPlan]] (within its specific [[ApartmentComplex]]). See also [[numberOfAccommodationUnits]]." .

:numberOfAxles a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "numberOfAxles" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The number of axles.\\n\\nTypical unit code(s): C62." ;
    skos:definition "The number of axles.\\n\\nTypical unit code(s): C62." .

:numberOfBathroomsTotal a owl:DatatypeProperty ;
    rdfs:label "numberOfBathroomsTotal" ;
    :domainIncludes :Accommodation,
        :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "The total integer number of bathrooms in some [[Accommodation]], following real estate conventions as [documented in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsTotalInteger+Field): \"The simple sum of the number of bathrooms. For example for a property with two Full Bathrooms and one Half Bathroom, the Bathrooms Total Integer will be 3.\". See also [[numberOfRooms]]." ;
    skos:definition "The total integer number of bathrooms in some [[Accommodation]], following real estate conventions as [documented in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsTotalInteger+Field): \"The simple sum of the number of bathrooms. For example for a property with two Full Bathrooms and one Half Bathroom, the Bathrooms Total Integer will be 3.\". See also [[numberOfRooms]]." .

:numberOfBedrooms a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "numberOfBedrooms" ;
    :domainIncludes :Accommodation,
        :ApartmentComplex,
        :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "The total integer number of bedrooms in a some [[Accommodation]], [[ApartmentComplex]] or [[FloorPlan]]." ;
    skos:definition "The total integer number of bedrooms in a some [[Accommodation]], [[ApartmentComplex]] or [[FloorPlan]]." .

