    owl:equivalentClass dcat:Catalog ;
    skos:definition "A collection of datasets." .

:DataType a owl:Class ;
    rdfs:label "DataType" ;
    rdfs:comment "The basic data types such as Integers, Strings, etc." ;
    rdfs:subClassOf rdfs:Class ;
    skos:definition "The basic data types such as Integers, Strings, etc." .

:DigitalPlatformEnumeration a owl:Class ;
    rdfs:label "DigitalPlatformEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3057> ;
    rdfs:comment "Enumerates some common technology platforms, for use with properties such as [[actionPlatform]]. It is not supposed to be comprehensive - when a suitable code is not enumerated here, textual or URL values can be used instead. These codes are at a fairly high level and do not deal with versioning and other nuance. Additional codes can be suggested [in github](https://github.com/schemaorg/schemaorg/issues/3057). " ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerates some common technology platforms, for use with properties such as [[actionPlatform]]. It is not supposed to be comprehensive - when a suitable code is not enumerated here, textual or URL values can be used instead. These codes are at a fairly high level and do not deal with versioning and other nuance. Additional codes can be suggested [in github](https://github.com/schemaorg/schemaorg/issues/3057). " .

:Distance a owl:Class ;
    rdfs:label "Distance" ;
    rdfs:comment "Properties that take Distances as values are of the form '&lt;Number&gt; &lt;Length unit of measure&gt;'. E.g., '7 ft'." ;
    rdfs:subClassOf :Quantity ;
    skos:definition "Properties that take Distances as values are of the form '&lt;Number&gt; &lt;Length unit of measure&gt;'. E.g., '7 ft'." .

:DrugCost a owl:Class ;
    rdfs:label "DrugCost" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "The cost per unit of a medical drug. Note that this type is not meant to represent the price in an offer of a drug for sale; see the Offer type for that. This type will typically be used to tag wholesale or average retail cost of a drug, or maximum reimbursable cost. Costs of medical drugs vary widely depending on how and where they are paid for, so while this type captures some of the variables, costs should be used with caution by consumers of this schema's markup." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "The cost per unit of a medical drug. Note that this type is not meant to represent the price in an offer of a drug for sale; see the Offer type for that. This type will typically be used to tag wholesale or average retail cost of a drug, or maximum reimbursable cost. Costs of medical drugs vary widely depending on how and where they are paid for, so while this type captures some of the variables, costs should be used with caution by consumers of this schema's markup." .

:DrugStrength a owl:Class ;
    rdfs:label "DrugStrength" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A specific strength in which a medical drug is available in a specific country." ;
    rdfs:subClassOf :MedicalIntangible ;
    skos:definition "A specific strength in which a medical drug is available in a specific country." .

:EngineSpecification a owl:Class ;
    rdfs:label "EngineSpecification" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    rdfs:comment "Information about the engine of the vehicle. A vehicle can have multiple engines represented by multiple engine specification entities." ;
    rdfs:subClassOf :StructuredValue ;
    skos:definition "Information about the engine of the vehicle. A vehicle can have multiple engines represented by multiple engine specification entities." .

:FulfillmentTypeEnumeration a owl:Class ;
    rdfs:label "FulfillmentTypeEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "A type of product fulfillment." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "A type of product fulfillment." .

:Game a owl:Class ;
    rdfs:label "Game" ;
    rdfs:comment "The Game type represents things which are games. These are typically rule-governed recreational activities, e.g. role-playing games in which players assume the role of characters in a fictional setting." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "The Game type represents things which are games. These are typically rule-governed recreational activities, e.g. role-playing games in which players assume the role of characters in a fictional setting." .

:Gene a owl:Class ;
    rdfs:label "Gene" ;
    :isPartOf <http://pending.schema.org> ;
    :source <http://bioschemas.org> ;
    rdfs:comment "A discrete unit of inheritance which affects one or more biological traits (Source: [https://en.wikipedia.org/wiki/Gene](https://en.wikipedia.org/wiki/Gene)). Examples include FOXP2 (Forkhead box protein P2), SCARNA21 (small Cajal body-specific RNA 21), A- (agouti genotype)." ;
    rdfs:subClassOf :BioChemEntity ;
    skos:definition "A discrete unit of inheritance which affects one or more biological traits (Source: [https://en.wikipedia.org/wiki/Gene](https://en.wikipedia.org/wiki/Gene)). Examples include FOXP2 (Forkhead box protein P2), SCARNA21 (small Cajal body-specific RNA 21), A- (agouti genotype)." .

:HealthAndBeautyBusiness a owl:Class ;
    rdfs:label "HealthAndBeautyBusiness" ;
    rdfs:comment "Health and beauty." ;
    rdfs:subClassOf :LocalBusiness ;
    skos:definition "Health and beauty." .

:HealthPlanCostSharingSpecification a owl:Class ;
