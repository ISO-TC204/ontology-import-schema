        :MedicalClinic,
        :MedicalOrganization,
        :Physician ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalSpecialty ;
    rdfs:comment "A medical specialty of the provider." ;
    skos:definition "A medical specialty of the provider." .

:medicineSystem a owl:ObjectProperty ;
    rdfs:label "medicineSystem" ;
    :domainIncludes :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicineSystem ;
    rdfs:comment "The system of medicine that includes this MedicalEntity, for example 'evidence-based', 'homeopathic', 'chiropractic', etc." ;
    skos:definition "The system of medicine that includes this MedicalEntity, for example 'evidence-based', 'homeopathic', 'chiropractic', etc." .

:meetsEmissionStandard a owl:DatatypeProperty,
