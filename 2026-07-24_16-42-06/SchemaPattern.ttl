    rdfs:comment "Languages in which subtitles/captions are available, in [IETF BCP 47 standard format](http://tools.ietf.org/html/bcp47)." ;
    skos:definition "Languages in which subtitles/captions are available, in [IETF BCP 47 standard format](http://tools.ietf.org/html/bcp47)." .

:successorOf a owl:ObjectProperty ;
    rdfs:label "successorOf" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :ProductModel ;
    :rangeIncludes :ProductModel ;
    rdfs:comment "A pointer from a newer variant of a product  to its previous, often discontinued predecessor." ;
    skos:definition "A pointer from a newer variant of a product  to its previous, often discontinued predecessor." .

:sugarContent a owl:ObjectProperty ;
    rdfs:label "sugarContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of sugar." ;
    skos:definition "The number of grams of sugar." .

:suggestedAge a owl:ObjectProperty ;
    rdfs:label "suggestedAge" ;
    :domainIncludes :PeopleAudience,
        :SizeSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "The age or age range for the intended audience or person, for example 3-12 months for infants, 1-5 years for toddlers." ;
    skos:definition "The age or age range for the intended audience or person, for example 3-12 months for infants, 1-5 years for toddlers." .

:suggestedGender a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "suggestedGender" ;
    :domainIncludes :PeopleAudience,
        :SizeSpecification ;
    :rangeIncludes :GenderType,
        :Text ;
    rdfs:comment "The suggested gender of the intended person or audience, for example \"male\", \"female\", or \"unisex\"." ;
    skos:definition "The suggested gender of the intended person or audience, for example \"male\", \"female\", or \"unisex\"." .

:suggestedMaxAge a owl:DatatypeProperty ;
    rdfs:label "suggestedMaxAge" ;
    :domainIncludes :PeopleAudience ;
    :rangeIncludes :Number ;
    rdfs:comment "Maximum recommended age in years for the audience or user." ;
    skos:definition "Maximum recommended age in years for the audience or user." .

:suggestedMeasurement a owl:ObjectProperty ;
    rdfs:label "suggestedMeasurement" ;
    :domainIncludes :PeopleAudience,
        :SizeSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "A suggested range of body measurements for the intended audience or person, for example inseam between 32 and 34 inches or height between 170 and 190 cm. Typically found on a size chart for wearable products." ;
    skos:definition "A suggested range of body measurements for the intended audience or person, for example inseam between 32 and 34 inches or height between 170 and 190 cm. Typically found on a size chart for wearable products." .

:suggestedMinAge a owl:DatatypeProperty ;
    rdfs:label "suggestedMinAge" ;
    :domainIncludes :PeopleAudience ;
    :rangeIncludes :Number ;
    rdfs:comment "Minimum recommended age in years for the audience or user." ;
    skos:definition "Minimum recommended age in years for the audience or user." .

:suitableForDiet a owl:ObjectProperty ;
    rdfs:label "suitableForDiet" ;
    :domainIncludes :MenuItem,
        :Recipe ;
    :rangeIncludes :RestrictedDiet ;
    rdfs:comment "Indicates a dietary restriction or guideline for which this recipe or menu item is suitable, e.g. diabetic, halal etc." ;
    skos:definition "Indicates a dietary restriction or guideline for which this recipe or menu item is suitable, e.g. diabetic, halal etc." .

:supersededBy a owl:ObjectProperty ;
    rdfs:label "supersededBy" ;
    :domainIncludes :Class,
        :Enumeration,
        :Property ;
    :isPartOf <http://meta.schema.org> ;
    :rangeIncludes :Class,
        :Enumeration,
        :Property ;
    rdfs:comment "Relates a term (i.e. a property, class or enumeration) to one that supersedes it." ;
    skos:definition "Relates a term (i.e. a property, class or enumeration) to one that supersedes it." .

:supplyTo a owl:ObjectProperty ;
    rdfs:label "supplyTo" ;
    :domainIncludes :Artery ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure ;
    rdfs:comment "The area to which the artery supplies blood." ;
    skos:definition "The area to which the artery supplies blood." .

:supportingData a owl:ObjectProperty ;
    rdfs:label "supportingData" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :DataFeed ;
    rdfs:comment "Supporting data for a SoftwareApplication." ;
    skos:definition "Supporting data for a SoftwareApplication." .

:surface a owl:DatatypeProperty ;
    rdfs:label "surface" ;
    :domainIncludes :VisualArtwork ;
    :rangeIncludes :Text,
        :URL ;
    :supersededBy :artworkSurface ;
    rdfs:comment "A material used as a surface in some artwork, e.g. Canvas, Paper, Wood, Board, etc." ;
    rdfs:subPropertyOf :material ;
    skos:definition "A material used as a surface in some artwork, e.g. Canvas, Paper, Wood, Board, etc." .

:syllabusSections a owl:ObjectProperty ;
    rdfs:label "syllabusSections" ;
    :domainIncludes :Course ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Syllabus ;
    :source <https://github.com/schemaorg/schemaorg/issues/3281> ;
    rdfs:comment "Indicates (typically several) Syllabus entities that lay out what each section of the overall course will cover." ;
    skos:definition "Indicates (typically several) Syllabus entities that lay out what each section of the overall course will cover." .

:target a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "target" ;
    :domainIncludes :Action ;
    :rangeIncludes :EntryPoint,
        :URL ;
    rdfs:comment "Indicates a target EntryPoint, or url, for an Action." ;
    skos:definition "Indicates a target EntryPoint, or url, for an Action." .

:targetDescription a owl:DatatypeProperty ;
    rdfs:label "targetDescription" ;
    :domainIncludes :AlignmentObject ;
    :rangeIncludes :Text ;
    rdfs:comment "The description of a node in an established educational framework." ;
    skos:definition "The description of a node in an established educational framework." .

:targetName a owl:DatatypeProperty ;
    rdfs:label "targetName" ;
    :domainIncludes :AlignmentObject ;
    :rangeIncludes :Text ;
    rdfs:comment "The name of a node in an established educational framework." ;
    skos:definition "The name of a node in an established educational framework." .

:targetPlatform a owl:DatatypeProperty ;
    rdfs:label "targetPlatform" ;
    :domainIncludes :APIReference ;
    :rangeIncludes :Text ;
    rdfs:comment "Type of app development: phone, Metro style, desktop, XBox, etc." ;
    skos:definition "Type of app development: phone, Metro style, desktop, XBox, etc." .

:targetPopulation a owl:DatatypeProperty ;
    rdfs:label "targetPopulation" ;
    :domainIncludes :DietarySupplement,
        :DoseSchedule ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Characteristics of the population for which this is intended, or which typically uses it, e.g. 'adults'." ;
    skos:definition "Characteristics of the population for which this is intended, or which typically uses it, e.g. 'adults'." .

:targetProduct a owl:ObjectProperty ;
    rdfs:label "targetProduct" ;
    :domainIncludes :SoftwareSourceCode ;
    :rangeIncludes :SoftwareApplication ;
    rdfs:comment "Target Operating System / Product to which the code applies.  If applies to several versions, just the product name can be used." ;
    skos:definition "Target Operating System / Product to which the code applies.  If applies to several versions, just the product name can be used." .

:targetUrl a owl:DatatypeProperty ;
    rdfs:label "targetUrl" ;
    :domainIncludes :AlignmentObject ;
    :rangeIncludes :URL ;
    rdfs:comment "The URL of a node in an established educational framework." ;
    skos:definition "The URL of a node in an established educational framework." .

:taxID a owl:DatatypeProperty ;
    rdfs:label "taxID" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "The Tax / Fiscal ID of the organization or person, e.g. the TIN in the US or the CIF/NIF in Spain." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/hasTaxIdentifier> ;
    skos:definition "The Tax / Fiscal ID of the organization or person, e.g. the TIN in the US or the CIF/NIF in Spain." .

:taxonRank a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "taxonRank" ;
    :domainIncludes :Taxon ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :PropertyValue,
        :Text,
        :URL ;
    :source <http://www.bioschemas.org/Taxon> ;
    rdfs:comment "The taxonomic rank of this taxon given preferably as a URI from a controlled vocabulary – typically the ranks from TDWG TaxonRank ontology or equivalent Wikidata URIs." ;
    skos:definition "The taxonomic rank of this taxon given preferably as a URI from a controlled vocabulary – typically the ranks from TDWG TaxonRank ontology or equivalent Wikidata URIs." .

:taxonomicRange a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "taxonomicRange" ;
    :domainIncludes :BioChemEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Taxon,
        :Text,
        :URL ;
    :source <http://www.bioschemas.org> ;
    rdfs:comment "The taxonomic grouping of the organism that expresses, encodes, or in some way related to the BioChemEntity." ;
    skos:definition "The taxonomic grouping of the organism that expresses, encodes, or in some way related to the BioChemEntity." .

:teaches a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "teaches" ;
    :domainIncludes :CreativeWork,
        :EducationEvent,
        :LearningResource ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2427> ;
    rdfs:comment "The item being described is intended to help a person learn the competency or learning outcome defined by the referenced term." ;
    skos:definition "The item being described is intended to help a person learn the competency or learning outcome defined by the referenced term." .

:telephone a owl:DatatypeProperty ;
    rdfs:label "telephone" ;
    :domainIncludes :ContactPoint,
        :Organization,
        :Person,
        :Place ;
    :rangeIncludes :Text ;
    rdfs:comment "The telephone number." ;
    owl:equivalentProperty gs1:telephone ;
    skos:definition "The telephone number." .

:temporal a owl:DatatypeProperty ;
    rdfs:label "temporal" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :DateTime,
        :Text ;
    rdfs:comment """The "temporal" property can be used in cases where more specific properties
(e.g. [[temporalCoverage]], [[dateCreated]], [[dateModified]], [[datePublished]]) are not known to be appropriate.""" ;
    skos:definition """The "temporal" property can be used in cases where more specific properties
(e.g. [[temporalCoverage]], [[dateCreated]], [[dateModified]], [[datePublished]]) are not known to be appropriate.""" .

:termDuration a owl:ObjectProperty ;
    rdfs:label "termDuration" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Duration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The amount of time in a term as defined by the institution. A term is a length of time where students take one or more classes. Semesters and quarters are common units for term." ;
    skos:definition "The amount of time in a term as defined by the institution. A term is a length of time where students take one or more classes. Semesters and quarters are common units for term." .

:termsOfService a owl:DatatypeProperty ;
    rdfs:label "termsOfService" ;
    :domainIncludes :Service ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1423> ;
    rdfs:comment "Human-readable terms of service documentation." ;
    skos:definition "Human-readable terms of service documentation." .

:termsPerYear a owl:DatatypeProperty ;
    rdfs:label "termsPerYear" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The number of times terms of study are offered per year. Semesters and quarters are common units for term. For example, if the student can only take 2 semesters for the program in one year, then termsPerYear should be 2." ;
    skos:definition "The number of times terms of study are offered per year. Semesters and quarters are common units for term. For example, if the student can only take 2 semesters for the program in one year, then termsPerYear should be 2." .

:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text ;
    rdfs:comment "The textual content of this CreativeWork." ;
    skos:definition "The textual content of this CreativeWork." .

:textValue a owl:DatatypeProperty ;
    rdfs:label "textValue" ;
    :domainIncludes :PronounceableText ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2108> ;
    rdfs:comment "Text value being annotated." ;
    skos:definition "Text value being annotated." .

:thumbnail a owl:ObjectProperty ;
    rdfs:label "thumbnail" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :ImageObject ;
    rdfs:comment "Thumbnail image for an image or video." ;
    skos:definition "Thumbnail image for an image or video." .

:thumbnailUrl a owl:DatatypeProperty ;
    rdfs:label "thumbnailUrl" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :URL ;
    rdfs:comment "A thumbnail image relevant to the Thing." ;
    skos:definition "A thumbnail image relevant to the Thing." .

:tickerSymbol a owl:DatatypeProperty ;
    rdfs:label "tickerSymbol" ;
    :domainIncludes :Corporation ;
    :rangeIncludes :Text ;
    rdfs:comment "The exchange traded instrument associated with a Corporation object. The tickerSymbol is expressed as an exchange and an instrument name separated by a space character. For the exchange component of the tickerSymbol attribute, we recommend using the controlled vocabulary of Market Identifier Codes (MIC) specified in ISO 15022." ;
    skos:definition "The exchange traded instrument associated with a Corporation object. The tickerSymbol is expressed as an exchange and an instrument name separated by a space character. For the exchange component of the tickerSymbol attribute, we recommend using the controlled vocabulary of Market Identifier Codes (MIC) specified in ISO 15022." .

:ticketNumber a owl:DatatypeProperty ;
    rdfs:label "ticketNumber" ;
    :domainIncludes :Ticket ;
    :rangeIncludes :Text ;
    rdfs:comment "The unique identifier for the ticket." ;
    skos:definition "The unique identifier for the ticket." .

:ticketToken a owl:DatatypeProperty ;
    rdfs:label "ticketToken" ;
    :domainIncludes :Ticket ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Reference to an asset (e.g., Barcode, QR code image or PDF) usable for entrance." ;
    skos:definition "Reference to an asset (e.g., Barcode, QR code image or PDF) usable for entrance." .

:ticketedSeat a owl:ObjectProperty ;
    rdfs:label "ticketedSeat" ;
    :domainIncludes :Ticket ;
    :rangeIncludes :Seat ;
    rdfs:comment "The seat associated with the ticket." ;
    skos:definition "The seat associated with the ticket." .

:timeOfDay a owl:DatatypeProperty ;
    rdfs:label "timeOfDay" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The time of day the program normally runs. For example, \"evenings\"." ;
    skos:definition "The time of day the program normally runs. For example, \"evenings\"." .

:timeRequired a owl:ObjectProperty ;
    rdfs:label "timeRequired" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Duration ;
    rdfs:comment "Approximate or typical time it usually takes to work with or through the content of this work for the typical or target audience." ;
    skos:definition "Approximate or typical time it usually takes to work with or through the content of this work for the typical or target audience." .

:timeToComplete a owl:ObjectProperty ;
    rdfs:label "timeToComplete" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Duration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "The expected length of time to complete the program if attending full-time." ;
    skos:definition "The expected length of time to complete the program if attending full-time." .

:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    :domainIncludes :InstantaneousEvent ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/4527> ;
    rdfs:comment "The instant the event occured." ;
    owl:equivalentClass prov:atTime ;
    skos:definition "The instant the event occured." .

:tissueSample a owl:DatatypeProperty ;
    rdfs:label "tissueSample" ;
    :domainIncludes :PathologyTest ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The type of tissue sample required for the test." ;
    skos:definition "The type of tissue sample required for the test." .

:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "The title of the job." ;
    skos:definition "The title of the job." .

:titleEIDR a owl:DatatypeProperty ;
    rdfs:label "titleEIDR" ;
    :domainIncludes :Movie,
        :TVEpisode,
        :TVSeason,
        :TVSeries ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2469> ;
    rdfs:comment """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing at the most general/abstract level, a work of film or television.

For example, the motion picture known as "Ghostbusters" has a titleEIDR of  "10.5240/7EC7-228A-510A-053E-CBB8-J". This title (or work) may have several variants, which EIDR calls "edits". See [[editEIDR]].

Since schema.org types like [[Movie]], [[TVEpisode]], [[TVSeason]], and [[TVSeries]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" ;
    rdfs:subPropertyOf :identifier ;
    skos:definition """An [EIDR](https://eidr.org/) (Entertainment Identifier Registry) [[identifier]] representing at the most general/abstract level, a work of film or television.

For example, the motion picture known as "Ghostbusters" has a titleEIDR of  "10.5240/7EC7-228A-510A-053E-CBB8-J". This title (or work) may have several variants, which EIDR calls "edits". See [[editEIDR]].

Since schema.org types like [[Movie]], [[TVEpisode]], [[TVSeason]], and [[TVSeries]] can be used for both works and their multiple expressions, it is possible to use [[titleEIDR]] alone (for a general description), or alongside [[editEIDR]] for a more edit-specific description.
""" .

:toLocation a owl:ObjectProperty ;
    rdfs:label "toLocation" ;
    :domainIncludes :ExerciseAction,
        :InsertAction,
        :MoveAction,
        :TransferAction ;
    :rangeIncludes :Place ;
    rdfs:comment "A sub property of location. The final location of the object or the agent after the action." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The final location of the object or the agent after the action." .

:toRecipient a owl:ObjectProperty ;
    rdfs:label "toRecipient" ;
    :domainIncludes :Message ;
    :rangeIncludes :Audience,
        :ContactPoint,
        :Organization,
        :Person ;
    rdfs:comment "A sub property of recipient. The recipient who was directly sent the message." ;
    rdfs:subPropertyOf :recipient ;
    skos:definition "A sub property of recipient. The recipient who was directly sent the message." .

:tocContinuation a owl:ObjectProperty ;
    rdfs:label "tocContinuation" ;
    :domainIncludes :HyperTocEntry ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :HyperTocEntry ;
    :source <https://github.com/schemaorg/schemaorg/issues/2766> ;
    rdfs:comment "A [[HyperTocEntry]] can have a [[tocContinuation]] indicated, which is another [[HyperTocEntry]] that would be the default next item to play or render." ;
    skos:definition "A [[HyperTocEntry]] can have a [[tocContinuation]] indicated, which is another [[HyperTocEntry]] that would be the default next item to play or render." .

:tocEntry a owl:ObjectProperty ;
    rdfs:label "tocEntry" ;
    :domainIncludes :HyperToc ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :HyperTocEntry ;
    :source <https://github.com/schemaorg/schemaorg/issues/2766> ;
    rdfs:comment "Indicates a [[HyperTocEntry]] in a [[HyperToc]]." ;
    rdfs:subPropertyOf :hasPart ;
    skos:definition "Indicates a [[HyperTocEntry]] in a [[HyperToc]]." .

:tongueWeight a owl:ObjectProperty ;
    rdfs:label "tongueWeight" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The permitted vertical load (TWR) of a trailer attached to the vehicle. Also referred to as Tongue Load Rating (TLR) or Vertical Load Rating (VLR).\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The permitted vertical load (TWR) of a trailer attached to the vehicle. Also referred to as Tongue Load Rating (TLR) or Vertical Load Rating (VLR).\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

:tool a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "tool" ;
    :domainIncludes :HowTo,
        :HowToDirection ;
    :rangeIncludes :HowToTool,
        :Text ;
    rdfs:comment "A sub property of instrument. An object used (but not consumed) when performing instructions or a direction." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. An object used (but not consumed) when performing instructions or a direction." .

:torque a owl:ObjectProperty ;
    rdfs:label "torque" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :EngineSpecification ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The torque (turning force) of the vehicle's engine.\\n\\nTypical unit code(s): NU for newton metre (N m), F17 for pound-force per foot, or F48 for pound-force per inch\\n\\n* Note 1: You can link to information about how the given value has been determined (e.g. reference RPM) using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The torque (turning force) of the vehicle's engine.\\n\\nTypical unit code(s): NU for newton metre (N m), F17 for pound-force per foot, or F48 for pound-force per inch\\n\\n* Note 1: You can link to information about how the given value has been determined (e.g. reference RPM) using the [[valueReference]] property.\\n* Note 2: You can use [[minValue]] and [[maxValue]] to indicate ranges." .

:totalHistoricalEnrollment a owl:DatatypeProperty ;
    rdfs:label "totalHistoricalEnrollment" ;
    :domainIncludes :Course ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/3281> ;
    rdfs:comment "The total number of students that have enrolled in the history of the course." ;
    skos:definition "The total number of students that have enrolled in the history of the course." .

:totalJobOpenings a owl:DatatypeProperty ;
    rdfs:label "totalJobOpenings" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/2329> ;
    rdfs:comment "The number of positions open for this job posting. Use a positive integer. Do not use if the number of positions is unclear or not known." ;
    skos:definition "The number of positions open for this job posting. Use a positive integer. Do not use if the number of positions is unclear or not known." .

:totalPaymentDue a owl:ObjectProperty ;
    rdfs:label "totalPaymentDue" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :MonetaryAmount,
        :PriceSpecification ;
    rdfs:comment "The total amount due." ;
    skos:definition "The total amount due." .

:totalPrice a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "totalPrice" ;
    :domainIncludes :Reservation,
        :Ticket ;
    :rangeIncludes :Number,
        :PriceSpecification,
        :Text ;
    rdfs:comment "The total price for the reservation or ticket, including applicable taxes, shipping, etc.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    skos:definition "The total price for the reservation or ticket, including applicable taxes, shipping, etc.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

:totalTime a owl:ObjectProperty ;
    rdfs:label "totalTime" ;
    :domainIncludes :HowTo,
        :HowToDirection ;
    :rangeIncludes :Duration ;
    rdfs:comment "The total time required to perform instructions or a direction (including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    skos:definition "The total time required to perform instructions or a direction (including time to prepare the supplies), in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

:tourBookingPage a owl:DatatypeProperty ;
    rdfs:label "tourBookingPage" ;
    :domainIncludes :Accommodation,
        :ApartmentComplex,
        :Place ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "A page providing information on how to book a tour of some [[Place]], such as an [[Accommodation]] or [[ApartmentComplex]] in a real estate setting, as well as other kinds of tours as appropriate." ;
    skos:definition "A page providing information on how to book a tour of some [[Place]], such as an [[Accommodation]] or [[ApartmentComplex]] in a real estate setting, as well as other kinds of tours as appropriate." .

:touristType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "touristType" ;
    :contributor <http://schema.org/docs/collab/IIT-CNR.it>,
        <http://schema.org/docs/collab/Tourism> ;
    :domainIncludes :TouristAttraction,
        :TouristDestination,
        :TouristTrip ;
    :rangeIncludes :Audience,
        :Text ;
    rdfs:comment "Attraction suitable for type(s) of tourist. E.g. children, visitors from a particular country, etc. " ;
    skos:definition "Attraction suitable for type(s) of tourist. E.g. children, visitors from a particular country, etc. " .

:trackingNumber a owl:DatatypeProperty ;
    rdfs:label "trackingNumber" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :Text ;
    rdfs:comment "Shipper tracking number." ;
    skos:definition "Shipper tracking number." .

:trackingUrl a owl:DatatypeProperty ;
    rdfs:label "trackingUrl" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :URL ;
    rdfs:comment "Tracking url for the parcel delivery." ;
    skos:definition "Tracking url for the parcel delivery." .

:tracks a owl:ObjectProperty ;
    rdfs:label "tracks" ;
    :domainIncludes :MusicGroup,
        :MusicPlaylist ;
    :rangeIncludes :MusicRecording ;
    :supersededBy :track ;
    rdfs:comment "A music recording (track)&#x2014;usually a single song." ;
    skos:definition "A music recording (track)&#x2014;usually a single song." .

:trailer a owl:ObjectProperty ;
    rdfs:label "trailer" ;
    :domainIncludes :CreativeWorkSeason,
        :Episode,
        :Movie,
        :MovieSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGame,
        :VideoGameSeries ;
    :rangeIncludes :VideoObject ;
    rdfs:comment "The trailer of a movie or TV/radio series, season, episode, etc." ;
    skos:definition "The trailer of a movie or TV/radio series, season, episode, etc." .

:trailerWeight a owl:ObjectProperty ;
    rdfs:label "trailerWeight" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The permitted weight of a trailer attached to the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The permitted weight of a trailer attached to the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

:trainName a owl:DatatypeProperty ;
    rdfs:label "trainName" ;
    :domainIncludes :TrainTrip ;
    :rangeIncludes :Text ;
    rdfs:comment "The name of the train (e.g. The Orient Express)." ;
    skos:definition "The name of the train (e.g. The Orient Express)." .

:trainNumber a owl:DatatypeProperty ;
    rdfs:label "trainNumber" ;
    :domainIncludes :TrainTrip ;
    :rangeIncludes :Text ;
    rdfs:comment "The unique identifier for the train." ;
    skos:definition "The unique identifier for the train." .

:trainingSalary a owl:ObjectProperty ;
    rdfs:label "trainingSalary" ;
    :domainIncludes :EducationalOccupationalProgram,
        :WorkBasedProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmountDistribution ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289>,
        <https://github.com/schemaorg/schemaorg/issues/2460> ;
    rdfs:comment "The estimated salary earned while in the program." ;
    skos:definition "The estimated salary earned while in the program." .

:transFatContent a owl:ObjectProperty ;
    rdfs:label "transFatContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of trans fat." ;
    skos:definition "The number of grams of trans fat." .

:transcript a owl:DatatypeProperty ;
    rdfs:label "transcript" ;
    :domainIncludes :AudioObject,
        :VideoObject ;
    :rangeIncludes :Text ;
    rdfs:comment "If this MediaObject is an AudioObject or VideoObject, the transcript of that object." ;
    skos:definition "If this MediaObject is an AudioObject or VideoObject, the transcript of that object." .

:transitTime a owl:ObjectProperty ;
    rdfs:label "transitTime" ;
    :domainIncludes :ShippingConditions,
        :ShippingDeliveryTime ;
    :rangeIncludes :QuantitativeValue,
        :ServicePeriod ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment """The typical delay the order has been sent for delivery and the goods reach the final customer.

  In the context of [[ShippingDeliveryTime]], use the [[QuantitativeValue]]. Typical properties: minValue, maxValue, unitCode (d for DAY).

  In the context of [[ShippingConditions]], use the [[ServicePeriod]]. It has a duration (as a [[QuantitativeValue]]) and also business days and a cut-off time.
""" ;
    skos:definition """The typical delay the order has been sent for delivery and the goods reach the final customer.

  In the context of [[ShippingDeliveryTime]], use the [[QuantitativeValue]]. Typical properties: minValue, maxValue, unitCode (d for DAY).

  In the context of [[ShippingConditions]], use the [[ServicePeriod]]. It has a duration (as a [[QuantitativeValue]]) and also business days and a cut-off time.
""" .

:translator a owl:ObjectProperty ;
    rdfs:label "translator" ;
    :domainIncludes :CreativeWork,
        :Event ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "Organization or person who adapts a creative work to different languages, regional differences and technical requirements of a target market, or that translates during some event." ;
    skos:definition "Organization or person who adapts a creative work to different languages, regional differences and technical requirements of a target market, or that translates during some event." .

:transmissionMethod a owl:DatatypeProperty ;
    rdfs:label "transmissionMethod" ;
    :domainIncludes :InfectiousDisease ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "How the disease spreads, either as a route or vector, for example 'direct contact', 'Aedes aegypti', etc." ;
    skos:definition "How the disease spreads, either as a route or vector, for example 'direct contact', 'Aedes aegypti', etc." .

:travelBans a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "travelBans" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Information about travel bans, e.g. in the context of a pandemic." ;
    skos:definition "Information about travel bans, e.g. in the context of a pandemic." .

:trialDesign a owl:ObjectProperty ;
    rdfs:label "trialDesign" ;
    :domainIncludes :MedicalTrial ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalTrialDesign ;
    rdfs:comment "Specifics about the trial design (enumerated)." ;
    skos:definition "Specifics about the trial design (enumerated)." .

:tributary a owl:ObjectProperty ;
    rdfs:label "tributary" ;
    :domainIncludes :Vein ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure ;
    rdfs:comment "The anatomical or organ system that the vein flows into; a larger structure that the vein connects to." ;
    skos:definition "The anatomical or organ system that the vein flows into; a larger structure that the vein connects to." .

:tripOrigin a owl:ObjectProperty ;
    rdfs:label "tripOrigin" ;
    :domainIncludes :Trip ;
    :rangeIncludes :Place ;
    rdfs:comment "The location of origin of the trip, prior to any destination(s)." ;
    skos:definition "The location of origin of the trip, prior to any destination(s)." .

:typeOfBed a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "typeOfBed" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :BedDetails ;
    :rangeIncludes :BedType,
        :Text ;
    rdfs:comment "The type of bed to which the BedDetail refers, i.e. the type of bed available in the quantity indicated by quantity." ;
    skos:definition "The type of bed to which the BedDetail refers, i.e. the type of bed available in the quantity indicated by quantity." .

:typeOfGood a owl:ObjectProperty ;
    rdfs:label "typeOfGood" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OwnershipInfo,
        :TypeAndQuantityNode ;
    :rangeIncludes :Product,
        :Service ;
    rdfs:comment "The product that this structured value is referring to." ;
    skos:definition "The product that this structured value is referring to." .

:typicalAgeRange a owl:DatatypeProperty ;
    rdfs:label "typicalAgeRange" ;
    :domainIncludes :CreativeWork,
        :Event ;
    :rangeIncludes :Text ;
    rdfs:comment "The typical expected age range, e.g. '7-9', '11-'." ;
    skos:definition "The typical expected age range, e.g. '7-9', '11-'." .

:typicalCreditsPerTerm a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "typicalCreditsPerTerm" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer,
        :StructuredValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/2419> ;
    rdfs:comment "The number of credits or units a full-time student would be expected to take in 1 term however 'term' is defined by the institution." ;
    skos:definition "The number of credits or units a full-time student would be expected to take in 1 term however 'term' is defined by the institution." .

:typicalTest a owl:ObjectProperty ;
    rdfs:label "typicalTest" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalTest ;
    rdfs:comment "A medical test typically performed given this condition." ;
    skos:definition "A medical test typically performed given this condition." .

:underName a owl:ObjectProperty ;
    rdfs:label "underName" ;
    :domainIncludes :Reservation,
        :Ticket ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The person or organization the reservation or ticket is for." ;
    skos:definition "The person or organization the reservation or ticket is for." .

:unitCode a owl:DatatypeProperty ;
    rdfs:label "unitCode" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :PropertyValue,
        :QuantitativeValue,
        :TypeAndQuantityNode,
        :UnitPriceSpecification ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL. Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon." ;
    skos:definition "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL. Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon." .

:unitText a owl:DatatypeProperty ;
    rdfs:label "unitText" ;
    :domainIncludes :PropertyValue,
        :QuantitativeValue,
        :TypeAndQuantityNode,
        :UnitPriceSpecification ;
    :rangeIncludes :Text ;
    rdfs:comment """A string or text indicating the unit of measurement. Useful if you cannot provide a standard unit code for
<a href='unitCode'>unitCode</a>.""" ;
    skos:definition """A string or text indicating the unit of measurement. Useful if you cannot provide a standard unit code for
<a href='unitCode'>unitCode</a>.""" .

:unnamedSourcesPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "unnamedSourcesPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For an [[Organization]] (typically a [[NewsMediaOrganization]]), a statement about policy on use of unnamed sources and the decision process required." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For an [[Organization]] (typically a [[NewsMediaOrganization]]), a statement about policy on use of unnamed sources and the decision process required." .

:unsaturatedFatContent a owl:ObjectProperty ;
    rdfs:label "unsaturatedFatContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of unsaturated fat." ;
    skos:definition "The number of grams of unsaturated fat." .

:uploadDate a owl:DatatypeProperty ;
    rdfs:label "uploadDate" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "Date (including time if available) when this media object was uploaded to this site." ;
    skos:definition "Date (including time if available) when this media object was uploaded to this site." .

:upvoteCount a owl:DatatypeProperty ;
    rdfs:label "upvoteCount" ;
    :domainIncludes :Comment ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of upvotes this question, answer or comment has received from the community." ;
    skos:definition "The number of upvotes this question, answer or comment has received from the community." .

:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    :domainIncludes :Thing ;
    :rangeIncludes :URL ;
    rdfs:comment "URL of the item." ;
    skos:definition "URL of the item." .

:urlTemplate a owl:DatatypeProperty ;
    rdfs:label "urlTemplate" ;
    :domainIncludes :EntryPoint ;
    :rangeIncludes :Text ;
    rdfs:comment "An url template (RFC6570) that will be used to construct the target of the execution of the action." ;
    skos:definition "An url template (RFC6570) that will be used to construct the target of the execution of the action." .

:usNPI a owl:DatatypeProperty ;
    rdfs:label "usNPI" ;
    :domainIncludes :Physician ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3420> ;
    rdfs:comment """A <a href="https://en.wikipedia.org/wiki/National_Provider_Identifier">National Provider Identifier</a> (NPI) 
    is a unique 10-digit identification number issued to health care providers in the United States by the Centers for Medicare and Medicaid Services.""" ;
    rdfs:subPropertyOf :identifier ;
    skos:definition """A <a href="https://en.wikipedia.org/wiki/National_Provider_Identifier">National Provider Identifier</a> (NPI) 
    is a unique 10-digit identification number issued to health care providers in the United States by the Centers for Medicare and Medicaid Services.""" .

:usedToDiagnose a owl:ObjectProperty ;
    rdfs:label "usedToDiagnose" ;
    :domainIncludes :MedicalTest ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalCondition ;
    rdfs:comment "A condition the test is used to diagnose." ;
    skos:definition "A condition the test is used to diagnose." .

:userInteractionCount a owl:DatatypeProperty ;
    rdfs:label "userInteractionCount" ;
    :domainIncludes :InteractionCounter ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication." ;
    skos:definition "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication." .

:usesDevice a owl:ObjectProperty ;
    rdfs:label "usesDevice" ;
    :domainIncludes :MedicalTest ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalDevice ;
    rdfs:comment "Device used to perform the test." ;
    skos:definition "Device used to perform the test." .

:usesHealthPlanIdStandard a owl:DatatypeProperty ;
    rdfs:label "usesHealthPlanIdStandard" ;
    :domainIncludes :HealthInsurancePlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1062> ;
    rdfs:comment "The standard for interpreting the Plan ID. The preferred is \"HIOS\". See the Centers for Medicare & Medicaid Services for more details." ;
    skos:definition "The standard for interpreting the Plan ID. The preferred is \"HIOS\". See the Centers for Medicare & Medicaid Services for more details." .

:utterances a owl:DatatypeProperty ;
    rdfs:label "utterances" ;
    :domainIncludes :HyperTocEntry ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2766> ;
    rdfs:comment "Text of an utterances (spoken words, lyrics etc.) that occurs at a certain section of a media object, represented as a [[HyperTocEntry]]." ;
    skos:definition "Text of an utterances (spoken words, lyrics etc.) that occurs at a certain section of a media object, represented as a [[HyperTocEntry]]." .

:validFor a owl:ObjectProperty ;
    rdfs:label "validFor" ;
    :domainIncludes :EducationalOccupationalCredential,
        :Permit ;
    :rangeIncludes :Duration ;
    :source <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "The duration of validity of a permit or similar thing." ;
    skos:definition "The duration of validity of a permit or similar thing." .

:validForMemberTier a owl:ObjectProperty ;
    rdfs:label "validForMemberTier" ;
    :domainIncludes :MerchantReturnPolicy,
        :Offer,
        :OfferShippingDetails,
        :PriceSpecification,
        :ShippingService ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MemberProgramTier ;
    :source <https://github.com/schemaorg/schemaorg/issues/3563>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The membership program tier an Offer (or a PriceSpecification, OfferShippingDetails, or MerchantReturnPolicy under an Offer) is valid for." ;
    skos:definition "The membership program tier an Offer (or a PriceSpecification, OfferShippingDetails, or MerchantReturnPolicy under an Offer) is valid for." .

:validFrom a owl:DatatypeProperty ;
    rdfs:label "validFrom" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Certification,
        :Demand,
        :FinancialIncentive,
        :LocationFeatureSpecification,
        :MonetaryAmount,
        :Offer,
        :OpeningHoursSpecification,
        :Permit,
        :PriceSpecification ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date when the item becomes valid." ;
    owl:equivalentProperty cmns-dt:hasStartDate ;
    skos:definition "The date when the item becomes valid." .

:validIn a owl:ObjectProperty ;
    rdfs:label "validIn" ;
    :domainIncludes :Certification,
        :EducationalOccupationalCredential,
        :Permit ;
    :rangeIncludes :AdministrativeArea ;
    :source <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "The geographic area where the item is valid. Applies for example to a [[Permit]], a [[Certification]], or an [[EducationalOccupationalCredential]]. " ;
    skos:definition "The geographic area where the item is valid. Applies for example to a [[Permit]], a [[Certification]], or an [[EducationalOccupationalCredential]]. " .

:validThrough a owl:DatatypeProperty ;
    rdfs:label "validThrough" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :FinancialIncentive,
        :JobPosting,
        :LocationFeatureSpecification,
        :MonetaryAmount,
        :Offer,
        :OpeningHoursSpecification,
        :PriceSpecification ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The date after when the item is not valid. For example the end of an offer, salary period, or a period of opening hours." ;
    owl:equivalentProperty cmns-dt:hasEndDate ;
    skos:definition "The date after when the item is not valid. For example the end of an offer, salary period, or a period of opening hours." .

:validUntil a owl:DatatypeProperty ;
    rdfs:label "validUntil" ;
    :domainIncludes :Permit ;
    :rangeIncludes :Date ;
    rdfs:comment "The date when the item is no longer valid." ;
    skos:definition "The date when the item is no longer valid." .

:value a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "value" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :MonetaryAmount,
        :PropertyValue,
        :QuantitativeValue ;
    :rangeIncludes :Boolean,
        :Number,
        :StructuredValue,
        :Text ;
    rdfs:comment "The value of a [[QuantitativeValue]] (including [[Observation]]) or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    skos:definition "The value of a [[QuantitativeValue]] (including [[Observation]]) or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

:valueAddedTaxIncluded a owl:DatatypeProperty ;
    rdfs:label "valueAddedTaxIncluded" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :PriceSpecification ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Specifies whether the applicable value-added tax (VAT) is included in the price specification or not." ;
    skos:definition "Specifies whether the applicable value-added tax (VAT) is included in the price specification or not." .

:valueMaxLength a owl:DatatypeProperty ;
    rdfs:label "valueMaxLength" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Number ;
    rdfs:comment "Specifies the allowed range for number of characters in a literal value." ;
    skos:definition "Specifies the allowed range for number of characters in a literal value." .

:valueMinLength a owl:DatatypeProperty ;
    rdfs:label "valueMinLength" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Number ;
    rdfs:comment "Specifies the minimum allowed range for number of characters in a literal value." ;
    skos:definition "Specifies the minimum allowed range for number of characters in a literal value." .

:valueName a owl:DatatypeProperty ;
    rdfs:label "valueName" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Text ;
    rdfs:comment "Indicates the name of the PropertyValueSpecification to be used in URL templates and form encoding in a manner analogous to HTML's input@name." ;
    skos:definition "Indicates the name of the PropertyValueSpecification to be used in URL templates and form encoding in a manner analogous to HTML's input@name." .

:valuePattern a owl:DatatypeProperty ;
    rdfs:label "valuePattern" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Text ;
    rdfs:comment "Specifies a regular expression for testing literal values according to the HTML spec." ;
    skos:definition "Specifies a regular expression for testing literal values according to the HTML spec." .

:valueReference a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "valueReference" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :PropertyValue,
        :QualitativeValue,
        :QuantitativeValue ;
    :rangeIncludes :DefinedTerm,
        :Enumeration,
        :MeasurementTypeEnumeration,
        :PropertyValue,
        :QualitativeValue,
        :QuantitativeValue,
        :StructuredValue,
        :Text ;
    rdfs:comment "A secondary value that provides additional information on the original value, e.g. a reference temperature or a type of measurement." ;
    skos:definition "A secondary value that provides additional information on the original value, e.g. a reference temperature or a type of measurement." .

:valueRequired a owl:DatatypeProperty ;
    rdfs:label "valueRequired" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Whether the property must be filled in to complete the action.  Default is false." ;
    skos:definition "Whether the property must be filled in to complete the action.  Default is false." .

:variableMeasured a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "variableMeasured" ;
    :domainIncludes :Dataset,
        :Observation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Property,
        :PropertyValue,
        :StatisticalVariable,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1083> ;
    rdfs:comment "The variableMeasured property can indicate (repeated as necessary) the  variables that are measured in some dataset, either described as text or as pairs of identifier and description using PropertyValue, or more explicitly as a [[StatisticalVariable]]." ;
    skos:definition "The variableMeasured property can indicate (repeated as necessary) the  variables that are measured in some dataset, either described as text or as pairs of identifier and description using PropertyValue, or more explicitly as a [[StatisticalVariable]]." .

:variantCover a owl:DatatypeProperty ;
    rdfs:label "variantCover" ;
    :domainIncludes :ComicIssue ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment """A description of the variant cover
    	for the issue, if the issue is a variant printing. For example, "Bryan Hitch
    	Variant Cover" or "2nd Printing Variant".""" ;
    skos:definition """A description of the variant cover
    	for the issue, if the issue is a variant printing. For example, "Bryan Hitch
    	Variant Cover" or "2nd Printing Variant".""" .

:variesBy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "variesBy" ;
    :domainIncludes :ProductGroup ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1797> ;
    rdfs:comment "Indicates the property or properties by which the variants in a [[ProductGroup]] vary, e.g. their size, color etc. Schema.org properties can be referenced by their short name e.g. \"color\"; terms defined elsewhere can be referenced with their URIs." ;
    skos:definition "Indicates the property or properties by which the variants in a [[ProductGroup]] vary, e.g. their size, color etc. Schema.org properties can be referenced by their short name e.g. \"color\"; terms defined elsewhere can be referenced with their URIs." .

:vatID a owl:DatatypeProperty ;
    rdfs:label "vatID" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :rangeIncludes :Text ;
    rdfs:comment "The Value-added Tax ID of the organization or person." ;
    skos:definition "The Value-added Tax ID of the organization or person." .

:vehicleConfiguration a owl:DatatypeProperty ;
    rdfs:label "vehicleConfiguration" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Text ;
    rdfs:comment "A short text indicating the configuration of the vehicle, e.g. '5dr hatchback ST 2.5 MT 225 hp' or 'limited edition'." ;
    skos:definition "A short text indicating the configuration of the vehicle, e.g. '5dr hatchback ST 2.5 MT 225 hp' or 'limited edition'." .

:vehicleEngine a owl:ObjectProperty ;
    rdfs:label "vehicleEngine" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :EngineSpecification ;
    rdfs:comment "Information about the engine or engines of the vehicle." ;
    skos:definition "Information about the engine or engines of the vehicle." .

:vehicleIdentificationNumber a owl:DatatypeProperty ;
    rdfs:label "vehicleIdentificationNumber" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Text ;
    rdfs:comment "The Vehicle Identification Number (VIN) is a unique serial number used by the automotive industry to identify individual motor vehicles." ;
    rdfs:subPropertyOf :serialNumber ;
    skos:definition "The Vehicle Identification Number (VIN) is a unique serial number used by the automotive industry to identify individual motor vehicles." .

:vehicleInteriorColor a owl:DatatypeProperty ;
    rdfs:label "vehicleInteriorColor" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Text ;
    rdfs:comment "The color or color combination of the interior of the vehicle." ;
    skos:definition "The color or color combination of the interior of the vehicle." .

:vehicleInteriorType a owl:DatatypeProperty ;
    rdfs:label "vehicleInteriorType" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Text ;
    rdfs:comment "The type or material of the interior of the vehicle (e.g. synthetic fabric, leather, wood, etc.). While most interior types are characterized by the material used, an interior type can also be based on vehicle usage or target audience." ;
    skos:definition "The type or material of the interior of the vehicle (e.g. synthetic fabric, leather, wood, etc.). While most interior types are characterized by the material used, an interior type can also be based on vehicle usage or target audience." .

:vehicleModelDate a owl:DatatypeProperty ;
    rdfs:label "vehicleModelDate" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Date ;
    rdfs:comment "The release date of a vehicle model (often used to differentiate versions of the same make and model)." ;
    skos:definition "The release date of a vehicle model (often used to differentiate versions of the same make and model)." .

:vehicleSeatingCapacity a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "vehicleSeatingCapacity" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons." ;
    skos:definition "The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons." .

:vehicleSpecialUsage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "vehicleSpecialUsage" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :CarUsageType,
        :Text ;
    rdfs:comment "Indicates whether the vehicle has been used for special purposes, like commercial rental, driving school, or as a taxi. The legislation in many countries requires this information to be revealed when offering a car for sale." ;
    skos:definition "Indicates whether the vehicle has been used for special purposes, like commercial rental, driving school, or as a taxi. The legislation in many countries requires this information to be revealed when offering a car for sale." .

:vehicleTransmission a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "vehicleTransmission" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :QualitativeValue,
        :Text,
        :URL ;
    rdfs:comment "The type of component used for transmitting the power from a rotating power source to the wheels or other relevant component(s) (\"gearbox\" for cars)." ;
    skos:definition "The type of component used for transmitting the power from a rotating power source to the wheels or other relevant component(s) (\"gearbox\" for cars)." .

:vendor a owl:ObjectProperty ;
    rdfs:label "vendor" ;
    :domainIncludes :BuyAction ;
    :rangeIncludes :Organization,
        :Person ;
    :supersededBy :seller ;
    rdfs:comment "'vendor' is an earlier term for 'seller'." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "'vendor' is an earlier term for 'seller'." .

:verificationFactCheckingPolicy a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "verificationFactCheckingPolicy" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "Disclosure about verification and fact-checking processes for a [[NewsMediaOrganization]] or other fact-checking [[Organization]]." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "Disclosure about verification and fact-checking processes for a [[NewsMediaOrganization]] or other fact-checking [[Organization]]." .

:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The version of the CreativeWork embodied by a specified resource." ;
    skos:definition "The version of the CreativeWork embodied by a specified resource." .

:video a owl:ObjectProperty ;
    rdfs:label "video" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Clip,
        :VideoObject ;
    rdfs:comment "An embedded video object." ;
    skos:definition "An embedded video object." .

:videoFormat a owl:DatatypeProperty ;
    rdfs:label "videoFormat" ;
    :domainIncludes :BroadcastEvent,
        :BroadcastService,
        :ScreeningEvent ;
    :rangeIncludes :Text ;
    rdfs:comment "The type of screening or video broadcast used (e.g. IMAX, 3D, SD, HD, etc.)." ;
    skos:definition "The type of screening or video broadcast used (e.g. IMAX, 3D, SD, HD, etc.)." .

:videoFrameSize a owl:DatatypeProperty ;
    rdfs:label "videoFrameSize" ;
    :domainIncludes :VideoObject ;
    :rangeIncludes :Text ;
    rdfs:comment "The frame size of the video." ;
    skos:definition "The frame size of the video." .

:videoQuality a owl:DatatypeProperty ;
    rdfs:label "videoQuality" ;
    :domainIncludes :VideoObject ;
    :rangeIncludes :Text ;
    rdfs:comment "The quality of the video." ;
    skos:definition "The quality of the video." .

:volumeNumber a owl:DatatypeProperty ;
    rdfs:label "volumeNumber" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :PublicationVolume ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\"." ;
    rdfs:subPropertyOf :position ;
    owl:equivalentProperty bibo:volume ;
    skos:definition "Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\"." .

:warning a owl:DatatypeProperty ;
    rdfs:label "warning" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Any FDA or other warnings about the drug (text or URL)." ;
    skos:definition "Any FDA or other warnings about the drug (text or URL)." .

:warrantyPromise a owl:ObjectProperty ;
    rdfs:label "warrantyPromise" ;
    :domainIncludes :BuyAction,
        :SellAction ;
    :rangeIncludes :WarrantyPromise ;
    :supersededBy :warranty ;
    rdfs:comment "The warranty promise(s) included in the offer." ;
    skos:definition "The warranty promise(s) included in the offer." .

:warrantyScope a owl:ObjectProperty ;
    rdfs:label "warrantyScope" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :WarrantyPromise ;
    :rangeIncludes :WarrantyScope ;
    rdfs:comment "The scope of the warranty promise." ;
    skos:definition "The scope of the warranty promise." .

:webCheckinTime a owl:DatatypeProperty ;
    rdfs:label "webCheckinTime" ;
    :domainIncludes :Flight ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The time when a passenger can check into the flight online." ;
    skos:definition "The time when a passenger can check into the flight online." .

:webFeed a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "webFeed" ;
    :domainIncludes :PodcastSeries,
        :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DataFeed,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/373> ;
    rdfs:comment "The URL for a feed, e.g. associated with a podcast series, blog, or series of date-stamped updates. This is usually RSS or Atom." ;
    skos:definition "The URL for a feed, e.g. associated with a podcast series, blog, or series of date-stamped updates. This is usually RSS or Atom." .

:weight a owl:ObjectProperty ;
    rdfs:label "weight" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OfferShippingDetails,
        :Person,
        :Product,
        :ShippingConditions,
        :VisualArtwork ;
    :rangeIncludes :Mass,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The weight of the product or person." ;
    skos:definition "The weight of the product or person." .

:weightPercentage a owl:DatatypeProperty ;
    rdfs:label "weightPercentage" ;
    :domainIncludes :ShippingRateSettings ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Value in the range [0.0 ; 1.0] representing the fraction of the weight that is used to compute the shipping price." ;
    skos:definition "Value in the range [0.0 ; 1.0] representing the fraction of the weight that is used to compute the shipping price." .

:weightTotal a owl:ObjectProperty ;
    rdfs:label "weightTotal" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The permitted total weight of the loaded vehicle, including passengers and cargo and the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The permitted total weight of the loaded vehicle, including passengers and cargo and the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

:wheelbase a owl:ObjectProperty ;
    rdfs:label "wheelbase" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The distance between the centers of the front and rear wheels.\\n\\nTypical unit code(s): CMT for centimeters, MTR for meters, INH for inches, FOT for foot/feet." ;
    skos:definition "The distance between the centers of the front and rear wheels.\\n\\nTypical unit code(s): CMT for centimeters, MTR for meters, INH for inches, FOT for foot/feet." .

:width a owl:ObjectProperty ;
    rdfs:label "width" ;
    :domainIncludes :MediaObject,
        :OfferShippingDetails,
        :Product,
        :ShippingConditions,
        :VisualArtwork ;
    :rangeIncludes :Distance,
        :QuantitativeValue ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The width of the item." ;
    skos:definition "The width of the item." .

:winner a owl:ObjectProperty ;
    rdfs:label "winner" ;
    :domainIncludes :LoseAction ;
    :rangeIncludes :Person ;
    rdfs:comment "A sub property of participant. The winner of the action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The winner of the action." .

:wordCount a owl:DatatypeProperty ;
    rdfs:label "wordCount" ;
    :domainIncludes :Article,
        :CreativeWork ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of words in the text of the CreativeWork such as an Article, Book, etc." ;
    skos:definition "The number of words in the text of the CreativeWork such as an Article, Book, etc." .

:workHours a owl:DatatypeProperty ;
    rdfs:label "workHours" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "The typical working hours for this job (e.g. 1st shift, night shift, 8am-5pm)." ;
    skos:definition "The typical working hours for this job (e.g. 1st shift, night shift, 8am-5pm)." .

:workLocation a owl:ObjectProperty ;
    rdfs:label "workLocation" ;
    :domainIncludes :Person ;
    :rangeIncludes :ContactPoint,
        :Place ;
    rdfs:comment "A contact location for a person's place of work." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A contact location for a person's place of work." .

:workPerformed a owl:ObjectProperty ;
    rdfs:label "workPerformed" ;
    :domainIncludes :Event ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "A work performed in some event, for example a play performed in a TheaterEvent." ;
    rdfs:subPropertyOf :workFeatured ;
    skos:definition "A work performed in some event, for example a play performed in a TheaterEvent." .

:workPresented a owl:ObjectProperty ;
    rdfs:label "workPresented" ;
    :domainIncludes :ScreeningEvent ;
    :rangeIncludes :Movie ;
    rdfs:comment "The movie presented during this event." ;
    rdfs:subPropertyOf :workFeatured ;
    skos:definition "The movie presented during this event." .

:workload a owl:ObjectProperty ;
    rdfs:label "workload" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Energy,
        :QuantitativeValue ;
    rdfs:comment "Quantitative measure of the physiologic output of the exercise; also referred to as energy expenditure." ;
    skos:definition "Quantitative measure of the physiologic output of the exercise; also referred to as energy expenditure." .

:worksFor a owl:ObjectProperty ;
    rdfs:label "worksFor" ;
    :domainIncludes :Person ;
    :rangeIncludes :Organization ;
    rdfs:comment "Organizations that the person works for." ;
    skos:definition "Organizations that the person works for." .

:worstRating a owl:DatatypeProperty ;
    rdfs:label "worstRating" ;
    :domainIncludes :Rating ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The lowest value allowed in this rating system." ;
    skos:definition "The lowest value allowed in this rating system." .

:xpath a owl:DatatypeProperty ;
    rdfs:label "xpath" ;
    :domainIncludes :SpeakableSpecification,
        :WebPageElement ;
    :rangeIncludes :XPathType ;
    :source <https://github.com/schemaorg/schemaorg/issues/1389> ;
    rdfs:comment "An XPath, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." ;
    skos:definition "An XPath, e.g. of a [[SpeakableSpecification]] or [[WebPageElement]]. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\"." .

:yearBuilt a owl:DatatypeProperty ;
    rdfs:label "yearBuilt" ;
    :domainIncludes :Accommodation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "The year an [[Accommodation]] was constructed. This corresponds to the [YearBuilt field in RESO](https://ddwiki.reso.org/display/DDW17/YearBuilt+Field). " ;
    skos:definition "The year an [[Accommodation]] was constructed. This corresponds to the [YearBuilt field in RESO](https://ddwiki.reso.org/display/DDW17/YearBuilt+Field). " .

:yearlyRevenue a owl:ObjectProperty ;
    rdfs:label "yearlyRevenue" ;
    :domainIncludes :BusinessAudience ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The size of the business in annual revenue." ;
    skos:definition "The size of the business in annual revenue." .

:yearsInOperation a owl:ObjectProperty ;
    rdfs:label "yearsInOperation" ;
    :domainIncludes :BusinessAudience ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The age of the business." ;
    skos:definition "The age of the business." .

