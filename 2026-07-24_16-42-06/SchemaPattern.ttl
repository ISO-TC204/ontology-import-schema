    rdfs:label "ReactAction" ;
    rdfs:comment "The act of responding instinctively and emotionally to an object, expressing a sentiment." ;
    rdfs:subClassOf :AssessAction ;
    skos:definition "The act of responding instinctively and emotionally to an object, expressing a sentiment." .

:RepaymentSpecification a owl:Class ;
    rdfs:label "RepaymentSpecification" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "A structured value representing repayment." ;
    rdfs:subClassOf :StructuredValue ;
    skos:definition "A structured value representing repayment." .

:ReturnLabelSourceEnumeration a owl:Class ;
    rdfs:label "ReturnLabelSourceEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "Enumerates several types of return labels for product returns." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerates several types of return labels for product returns." .

:SportsEvent a owl:Class ;
    rdfs:label "SportsEvent" ;
    rdfs:comment "Event type: Sports event." ;
    rdfs:subClassOf :Event ;
    skos:definition "Event type: Sports event." .

:TrainTrip a owl:Class ;
    rdfs:label "TrainTrip" ;
    rdfs:comment "A trip on a commercial train line." ;
    rdfs:subClassOf :Trip ;
    skos:definition "A trip on a commercial train line." .

:TypeAndQuantityNode a owl:Class ;
    rdfs:label "TypeAndQuantityNode" ;
    :contributor <https://blog.schema.org/2012/11/08/good-relations-and-schema-org/> ;
    rdfs:comment "A structured value indicating the quantity, unit of measurement, and business function of goods included in a bundle offer." ;
    rdfs:subClassOf :StructuredValue ;
    skos:definition "A structured value indicating the quantity, unit of measurement, and business function of goods included in a bundle offer." .

:isPartOf a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "isPartOf" ;
    :domainIncludes :CreativeWork ;
    :inverseOf :hasPart ;
    :rangeIncludes :CreativeWork,
        :URL ;
    rdfs:comment "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of." ;
    skos:definition "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of." .

