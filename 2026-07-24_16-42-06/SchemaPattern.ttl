    skos:definition "Indicates whether this drug is available by prescription or over-the-counter." .

:EducationEvent a owl:Class ;
    rdfs:label "EducationEvent" ;
    rdfs:comment "Event type: Education event." ;
    rdfs:subClassOf :Event ;
    skos:definition "Event type: Education event." .

:EmergencyService a owl:Class ;
    rdfs:label "EmergencyService" ;
    rdfs:comment "An emergency service, such as a fire station or ER." ;
    rdfs:subClassOf :LocalBusiness ;
    skos:definition "An emergency service, such as a fire station or ER." .

:EnergyEfficiencyEnumeration a owl:Class ;
    rdfs:label "EnergyEfficiencyEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2670> ;
    rdfs:comment "Enumerates energy efficiency levels (also known as \"classes\" or \"ratings\") and certifications that are part of several international energy efficiency standards." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerates energy efficiency levels (also known as \"classes\" or \"ratings\") and certifications that are part of several international energy efficiency standards." .

:ExchangeRateSpecification a owl:Class ;
