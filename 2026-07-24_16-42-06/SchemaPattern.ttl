    skos:definition "The number of episodes in this season or series." .

:numberOfForwardGears a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "numberOfForwardGears" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The total number of forward gears available for the transmission system of the vehicle.\\n\\nTypical unit code(s): C62." ;
    skos:definition "The total number of forward gears available for the transmission system of the vehicle.\\n\\nTypical unit code(s): C62." .

:numberOfFullBathrooms a owl:DatatypeProperty ;
    rdfs:label "numberOfFullBathrooms" ;
    :domainIncludes :Accommodation,
        :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Number of full bathrooms - The total number of full and ¾ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsFull field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsFull+Field)." ;
    skos:definition "Number of full bathrooms - The total number of full and ¾ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsFull field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsFull+Field)." .

:numberOfItems a owl:DatatypeProperty ;
    rdfs:label "numberOfItems" ;
    :domainIncludes :ItemList ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of items in an ItemList. Note that some descriptions might not fully describe all items in a list (e.g., multi-page pagination); in such cases, the numberOfItems would be for the entire list." ;
    skos:definition "The number of items in an ItemList. Note that some descriptions might not fully describe all items in a list (e.g., multi-page pagination); in such cases, the numberOfItems would be for the entire list." .

:numberOfLoanPayments a owl:DatatypeProperty ;
    rdfs:label "numberOfLoanPayments" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :RepaymentSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The number of payments contractually required at origination to repay the loan. For monthly paying loans this is the number of months from the contractual first payment date to the maturity date." ;
    skos:definition "The number of payments contractually required at origination to repay the loan. For monthly paying loans this is the number of months from the contractual first payment date to the maturity date." .

:numberOfPages a owl:DatatypeProperty ;
    rdfs:label "numberOfPages" ;
    :domainIncludes :Book ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of pages in the book." ;
    skos:definition "The number of pages in the book." .

:numberOfPartialBathrooms a owl:DatatypeProperty ;
    rdfs:label "numberOfPartialBathrooms" ;
    :domainIncludes :Accommodation,
        :FloorPlan ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2373> ;
    rdfs:comment "Number of partial bathrooms - The total number of half and ¼ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsPartial field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsPartial+Field). " ;
    skos:definition "Number of partial bathrooms - The total number of half and ¼ bathrooms in an [[Accommodation]]. This corresponds to the [BathroomsPartial field in RESO](https://ddwiki.reso.org/display/DDW17/BathroomsPartial+Field). " .

:numberOfPlayers a owl:ObjectProperty ;
    rdfs:label "numberOfPlayers" ;
    :domainIncludes :Game,
        :VideoGameSeries ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "Indicate how many people can play this game (minimum, maximum, or range)." ;
    skos:definition "Indicate how many people can play this game (minimum, maximum, or range)." .

:numberOfPreviousOwners a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "numberOfPreviousOwners" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The number of owners of the vehicle, including the current one.\\n\\nTypical unit code(s): C62." ;
    skos:definition "The number of owners of the vehicle, including the current one.\\n\\nTypical unit code(s): C62." .

:numberOfRooms a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "numberOfRooms" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation,
        :Apartment,
        :FloorPlan,
        :House,
        :LodgingBusiness,
        :SingleFamilyResidence,
        :Suite ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment """The number of rooms (excluding bathrooms and closets) of the accommodation or lodging business.
Typical unit code(s): ROM for room or C62 for no unit. The type of room can be put in the unitText property of the QuantitativeValue.""" ;
    skos:definition """The number of rooms (excluding bathrooms and closets) of the accommodation or lodging business.
Typical unit code(s): ROM for room or C62 for no unit. The type of room can be put in the unitText property of the QuantitativeValue.""" .

:numberOfSeasons a owl:DatatypeProperty ;
    rdfs:label "numberOfSeasons" ;
    :domainIncludes :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of seasons in this series." ;
    skos:definition "The number of seasons in this series." .

:numberedPosition a owl:DatatypeProperty ;
    rdfs:label "numberedPosition" ;
    :domainIncludes :OrganizationRole ;
    :rangeIncludes :Number ;
    rdfs:comment "A number associated with a role in an organization, for example, the number on an athlete's jersey." ;
    skos:definition "A number associated with a role in an organization, for example, the number on an athlete's jersey." .

:nutrition a owl:ObjectProperty ;
    rdfs:label "nutrition" ;
    :domainIncludes :MenuItem,
        :Recipe ;
    :rangeIncludes :NutritionInformation ;
    rdfs:comment "Nutrition information about the recipe or menu item." ;
    skos:definition "Nutrition information about the recipe or menu item." .

:observationAbout a owl:ObjectProperty ;
    rdfs:label "observationAbout" ;
    :domainIncludes :Observation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Place,
        :Thing ;
    :source <https://github.com/schemaorg/schemaorg/issues/2291> ;
    rdfs:comment "The [[observationAbout]] property identifies an entity, often a [[Place]], associated with an [[Observation]]." ;
    skos:definition "The [[observationAbout]] property identifies an entity, often a [[Place]], associated with an [[Observation]]." .

:observationDate a owl:DatatypeProperty ;
    rdfs:label "observationDate" ;
    :domainIncludes :Observation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date,
        :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/2291> ;
    rdfs:comment "The observationDate of an [[Observation]]." ;
    skos:definition "The observationDate of an [[Observation]]." .

:observationPeriod a owl:DatatypeProperty ;
    rdfs:label "observationPeriod" ;
    :domainIncludes :Observation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2564> ;
    rdfs:comment "The length of time an Observation took place over. The format follows `P[0-9]*[Y|M|D|h|m|s]`. For example, P1Y is Period 1 Year, P3M is Period 3 Months, P3h is Period 3 hours." ;
    skos:definition "The length of time an Observation took place over. The format follows `P[0-9]*[Y|M|D|h|m|s]`. For example, P1Y is Period 1 Year, P3M is Period 3 Months, P3h is Period 3 hours." .

:occupancy a owl:ObjectProperty ;
    rdfs:label "occupancy" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation,
        :Apartment,
        :HotelRoom,
        :SingleFamilyResidence,
        :Suite ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment """The allowed total occupancy for the accommodation in persons (including infants etc). For individual accommodations, this is not necessarily the legal maximum but defines the permitted usage as per the contractual agreement (e.g. a double room used by a single person).
Typical unit code(s): C62 for person.""" ;
    skos:definition """The allowed total occupancy for the accommodation in persons (including infants etc). For individual accommodations, this is not necessarily the legal maximum but defines the permitted usage as per the contractual agreement (e.g. a double room used by a single person).
Typical unit code(s): C62 for person.""" .

:occupationLocation a owl:ObjectProperty ;
    rdfs:label "occupationLocation" ;
    :domainIncludes :Occupation ;
    :rangeIncludes :AdministrativeArea ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment " The region/country for which this occupational description is appropriate. Note that educational requirements and qualifications can vary between jurisdictions." ;
    skos:definition " The region/country for which this occupational description is appropriate. Note that educational requirements and qualifications can vary between jurisdictions." .

:occupationalCategory a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "occupationalCategory" ;
    :domainIncludes :EducationalOccupationalProgram,
        :JobPosting,
        :Occupation,
        :Physician,
        :WorkBasedProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CategoryCode,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698>,
        <https://github.com/schemaorg/schemaorg/issues/2192>,
        <https://github.com/schemaorg/schemaorg/issues/2289>,
        <https://github.com/schemaorg/schemaorg/issues/2460>,
        <https://github.com/schemaorg/schemaorg/issues/3420> ;
    rdfs:comment """A category describing the job, preferably using a term from a taxonomy such as [BLS O*NET-SOC](http://www.onetcenter.org/taxonomy.html), [ISCO-08](https://www.ilo.org/public/english/bureau/stat/isco/isco08/) or similar, with the property repeated for each applicable value. Ideally the taxonomy should be identified, and both the textual label and formal code for the category should be provided.\\n
Note: for historical reasons, any textual label and formal code provided as a literal may be assumed to be from O*NET-SOC.""" ;
    skos:definition """A category describing the job, preferably using a term from a taxonomy such as [BLS O*NET-SOC](http://www.onetcenter.org/taxonomy.html), [ISCO-08](https://www.ilo.org/public/english/bureau/stat/isco/isco08/) or similar, with the property repeated for each applicable value. Ideally the taxonomy should be identified, and both the textual label and formal code for the category should be provided.\\n
Note: for historical reasons, any textual label and formal code provided as a literal may be assumed to be from O*NET-SOC.""" .

:occupationalCredentialAwarded a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "occupationalCredentialAwarded" ;
    :domainIncludes :Course,
        :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EducationalOccupationalCredential,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "A description of the qualification, award, certificate, diploma or other occupational credential awarded as a consequence of successful completion of this course or program." ;
    skos:definition "A description of the qualification, award, certificate, diploma or other occupational credential awarded as a consequence of successful completion of this course or program." .

:offerCount a owl:DatatypeProperty ;
    rdfs:label "offerCount" ;
    :domainIncludes :AggregateOffer ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of offers for the product." ;
    skos:definition "The number of offers for the product." .

:offersPrescriptionByMail a owl:DatatypeProperty ;
    rdfs:label "offersPrescriptionByMail" ;
    :domainIncludes :HealthPlanFormulary ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/1062> ;
    rdfs:comment "Whether prescriptions can be delivered by mail." ;
    skos:definition "Whether prescriptions can be delivered by mail." .

:openingHours a owl:DatatypeProperty ;
    rdfs:label "openingHours" ;
    :domainIncludes :CivicStructure,
        :LocalBusiness ;
    :rangeIncludes :Text ;
    rdfs:comment "The general opening hours for a business. Opening hours can be specified as a weekly time range, starting with days, then times per day. Multiple days can be listed with commas ',' separating each day. Day or time ranges are specified using a hyphen '-'.\\n\\n* Days are specified using the following two-letter combinations: ```Mo```, ```Tu```, ```We```, ```Th```, ```Fr```, ```Sa```, ```Su```.\\n* Times are specified using 24:00 format. For example, 3pm is specified as ```15:00```, 10am as ```10:00```. \\n* Here is an example: <code>&lt;time itemprop=\"openingHours\" datetime=&quot;Tu,Th 16:00-20:00&quot;&gt;Tuesdays and Thursdays 4-8pm&lt;/time&gt;</code>.\\n* If a business is open 7 days a week, then it can be specified as <code>&lt;time itemprop=&quot;openingHours&quot; datetime=&quot;Mo-Su&quot;&gt;Monday through Sunday, all day&lt;/time&gt;</code>." ;
    skos:definition "The general opening hours for a business. Opening hours can be specified as a weekly time range, starting with days, then times per day. Multiple days can be listed with commas ',' separating each day. Day or time ranges are specified using a hyphen '-'.\\n\\n* Days are specified using the following two-letter combinations: ```Mo```, ```Tu```, ```We```, ```Th```, ```Fr```, ```Sa```, ```Su```.\\n* Times are specified using 24:00 format. For example, 3pm is specified as ```15:00```, 10am as ```10:00```. \\n* Here is an example: <code>&lt;time itemprop=\"openingHours\" datetime=&quot;Tu,Th 16:00-20:00&quot;&gt;Tuesdays and Thursdays 4-8pm&lt;/time&gt;</code>.\\n* If a business is open 7 days a week, then it can be specified as <code>&lt;time itemprop=&quot;openingHours&quot; datetime=&quot;Mo-Su&quot;&gt;Monday through Sunday, all day&lt;/time&gt;</code>." .

:openingHoursSpecification a owl:ObjectProperty ;
    rdfs:label "openingHoursSpecification" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Place ;
    :rangeIncludes :OpeningHoursSpecification ;
    rdfs:comment "The opening hours of a certain place." ;
    skos:definition "The opening hours of a certain place." .

:opens a owl:DatatypeProperty ;
    rdfs:label "opens" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OpeningHoursSpecification ;
    :rangeIncludes :Time ;
    rdfs:comment "The opening hour of the place or service on the given day(s) of the week." ;
    skos:definition "The opening hour of the place or service on the given day(s) of the week." .

:operatingSystem a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "operatingSystem" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :OperatingSystem,
        :Text ;
    rdfs:comment "Operating systems supported (Windows 7, OS X 10.6, Android 1.6)." ;
    skos:definition "Operating systems supported (Windows 7, OS X 10.6, Android 1.6)." .

:opponent a owl:ObjectProperty ;
    rdfs:label "opponent" ;
    :domainIncludes :ExerciseAction ;
    :rangeIncludes :Person ;
    rdfs:comment "A sub property of participant. The opponent on this action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The opponent on this action." .

:option a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "option" ;
    :domainIncludes :ChooseAction ;
    :rangeIncludes :Text,
        :Thing ;
    :supersededBy :actionOption ;
    rdfs:comment "A sub property of object. The options subject to this action." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The options subject to this action." .

:orderDate a owl:DatatypeProperty ;
    rdfs:label "orderDate" ;
    :domainIncludes :Order ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "Date order was placed." ;
    rdfs:subPropertyOf cmns-dt:hasDate ;
    owl:equivalentProperty unece:OrderDate ;
    skos:definition "Date order was placed." .

:orderDelivery a owl:ObjectProperty ;
    rdfs:label "orderDelivery" ;
    :domainIncludes :Order,
        :OrderItem ;
    :rangeIncludes :ParcelDelivery ;
    rdfs:comment "The delivery of the parcel related to this order or order item." ;
    skos:definition "The delivery of the parcel related to this order or order item." .

:orderItemNumber a owl:DatatypeProperty ;
    rdfs:label "orderItemNumber" ;
    :domainIncludes :OrderItem ;
    :rangeIncludes :Text ;
    rdfs:comment "The identifier of the order item." ;
    owl:equivalentProperty unece:LineItemIdentifier ;
    skos:definition "The identifier of the order item." .

:orderItemStatus a owl:ObjectProperty ;
    rdfs:label "orderItemStatus" ;
    :domainIncludes :OrderItem ;
    :rangeIncludes :OrderStatus ;
    rdfs:comment "The current status of the order item." ;
    skos:definition "The current status of the order item." .

:orderNumber a owl:DatatypeProperty ;
    rdfs:label "orderNumber" ;
    :domainIncludes :Order ;
    :rangeIncludes :Text ;
    rdfs:comment "The identifier of the transaction." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty unece:OrderIdentifier ;
    skos:definition "The identifier of the transaction." .

:orderPercentage a owl:DatatypeProperty ;
    rdfs:label "orderPercentage" ;
    :domainIncludes :ShippingRateSettings ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Value in the range [0.0 ; 1.0] representing the fraction of the value of the order that is charged as shipping cost." ;
    skos:definition "Value in the range [0.0 ; 1.0] representing the fraction of the value of the order that is charged as shipping cost." .

:orderQuantity a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "orderQuantity" ;
    :domainIncludes :OrderItem ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The number of the item ordered. If the property is not set, assume the quantity is one." ;
    rdfs:subPropertyOf cmns-qtu:hasQuantity ;
    owl:equivalentProperty unece:orderQuantity ;
    skos:definition "The number of the item ordered. If the property is not set, assume the quantity is one." .

:orderStatus a owl:ObjectProperty ;
    rdfs:label "orderStatus" ;
    :domainIncludes :Order ;
    :rangeIncludes :OrderStatus ;
    rdfs:comment "The current status of the order." ;
    skos:definition "The current status of the order." .

:orderValue a owl:ObjectProperty ;
    rdfs:label "orderValue" ;
    :domainIncludes :ShippingConditions ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Minimum and maximum order value for which these shipping conditions are valid." ;
    skos:definition "Minimum and maximum order value for which these shipping conditions are valid." .

:orderedItem a owl:ObjectProperty ;
    rdfs:label "orderedItem" ;
    :domainIncludes :Order,
        :OrderItem ;
    :rangeIncludes :OrderItem,
        :Product,
        :Service ;
    rdfs:comment "The item ordered." ;
    rdfs:subPropertyOf fibo-fnd-pas:hasProduct ;
    skos:definition "The item ordered." .

:organizer a owl:ObjectProperty ;
    rdfs:label "organizer" ;
    :domainIncludes :Event ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "An organizer of an Event." ;
    skos:definition "An organizer of an Event." .

:originAddress a owl:ObjectProperty ;
    rdfs:label "originAddress" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :PostalAddress ;
    rdfs:comment "Shipper's address." ;
    skos:definition "Shipper's address." .

:originalMediaContextDescription a owl:DatatypeProperty ;
    rdfs:label "originalMediaContextDescription" ;
    :domainIncludes :MediaReview ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "Describes, in a [[MediaReview]] when dealing with [[DecontextualizedContent]], background information that can contribute to better interpretation of the [[MediaObject]]." ;
    rdfs:subPropertyOf :description ;
    skos:definition "Describes, in a [[MediaReview]] when dealing with [[DecontextualizedContent]], background information that can contribute to better interpretation of the [[MediaObject]]." .

:originalMediaLink a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "originalMediaLink" ;
    :domainIncludes :MediaReview ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MediaObject,
        :URL,
        :WebPage ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "Link to the page containing an original version of the content, or directly to an online copy of the original [[MediaObject]] content, e.g. video file." ;
    skos:definition "Link to the page containing an original version of the content, or directly to an online copy of the original [[MediaObject]] content, e.g. video file." .

:originatesFrom a owl:ObjectProperty ;
    rdfs:label "originatesFrom" ;
    :domainIncludes :LymphaticVessel ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Vessel ;
    rdfs:comment "The vasculature the lymphatic structure originates, or afferents, from." ;
    skos:definition "The vasculature the lymphatic structure originates, or afferents, from." .

:overdosage a owl:DatatypeProperty ;
    rdfs:label "overdosage" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any information related to overdose on a drug, including signs or symptoms, treatments, contact information for emergency response." ;
    skos:definition "Any information related to overdose on a drug, including signs or symptoms, treatments, contact information for emergency response." .

:ownedFrom a owl:DatatypeProperty ;
    rdfs:label "ownedFrom" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OwnershipInfo ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The date and time of obtaining the product." ;
    skos:definition "The date and time of obtaining the product." .

:ownedThrough a owl:DatatypeProperty ;
    rdfs:label "ownedThrough" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :OwnershipInfo ;
    :rangeIncludes :DateTime ;
    rdfs:comment "The date and time of giving up ownership on the product." ;
    skos:definition "The date and time of giving up ownership on the product." .

:ownershipFundingInfo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "ownershipFundingInfo" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :domainIncludes :NewsMediaOrganization,
        :Organization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AboutPage,
        :CreativeWork,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a description of organizational ownership structure; funding and grants. In a news/media setting, this is with particular reference to editorial independence.   Note that the [[funder]] is also available and can be used to make basic funder information machine-readable." ;
    rdfs:subPropertyOf :publishingPrinciples ;
    skos:definition "For an [[Organization]] (often but not necessarily a [[NewsMediaOrganization]]), a description of organizational ownership structure; funding and grants. In a news/media setting, this is with particular reference to editorial independence.   Note that the [[funder]] is also available and can be used to make basic funder information machine-readable." .

:pageEnd a owl:DatatypeProperty ;
    rdfs:label "pageEnd" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :Article,
        :Chapter,
        :PublicationIssue,
        :PublicationVolume ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "The page on which the work ends; for example \"138\" or \"xvi\"." ;
    owl:equivalentProperty bibo:pageEnd ;
    skos:definition "The page on which the work ends; for example \"138\" or \"xvi\"." .

:pageStart a owl:DatatypeProperty ;
    rdfs:label "pageStart" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :Article,
        :Chapter,
        :PublicationIssue,
        :PublicationVolume ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "The page on which the work starts; for example \"135\" or \"xiii\"." ;
    owl:equivalentProperty bibo:pageStart ;
    skos:definition "The page on which the work starts; for example \"135\" or \"xiii\"." .

:pagination a owl:DatatypeProperty ;
    rdfs:label "pagination" ;
    :contributor <http://schema.org/docs/collab/bibex> ;
    :domainIncludes :Article,
        :Chapter,
        :PublicationIssue,
        :PublicationVolume ;
    :rangeIncludes :Text ;
    rdfs:comment "Any description of pages that is not separated into pageStart and pageEnd; for example, \"1-6, 9, 55\" or \"10-12, 46-49\"." ;
    owl:equivalentProperty bibo:pages ;
    skos:definition "Any description of pages that is not separated into pageStart and pageEnd; for example, \"1-6, 9, 55\" or \"10-12, 46-49\"." .

:parentItem a owl:ObjectProperty ;
    rdfs:label "parentItem" ;
    :domainIncludes :Answer,
        :Comment,
        :Question ;
    :rangeIncludes :Comment,
        :CreativeWork ;
    rdfs:comment "The parent of a question, answer or item in general. Typically used for Q/A discussion threads e.g. a chain of comments with the first comment being an [[Article]] or other [[CreativeWork]]. See also [[comment]] which points from something to a comment about it." ;
    skos:definition "The parent of a question, answer or item in general. Typically used for Q/A discussion threads e.g. a chain of comments with the first comment being an [[Article]] or other [[CreativeWork]]. See also [[comment]] which points from something to a comment about it." .

:parentService a owl:ObjectProperty ;
    rdfs:label "parentService" ;
    :domainIncludes :BroadcastService ;
    :rangeIncludes :BroadcastService ;
    rdfs:comment "A broadcast service to which the broadcast service may belong to such as regional variations of a national channel." ;
    skos:definition "A broadcast service to which the broadcast service may belong to such as regional variations of a national channel." .

:parents a owl:ObjectProperty ;
    rdfs:label "parents" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    :supersededBy :parent ;
    rdfs:comment "A parents of the person." ;
    skos:definition "A parents of the person." .

:partOfEpisode a owl:ObjectProperty ;
    rdfs:label "partOfEpisode" ;
    :domainIncludes :Clip ;
    :rangeIncludes :Episode ;
    rdfs:comment "The episode to which this clip belongs." ;
    rdfs:subPropertyOf :isPartOf ;
    skos:definition "The episode to which this clip belongs." .

:partOfInvoice a owl:ObjectProperty ;
    rdfs:label "partOfInvoice" ;
    :domainIncludes :Order ;
    :rangeIncludes :Invoice ;
    rdfs:comment "The order is being paid as part of the referenced Invoice." ;
    rdfs:subPropertyOf fibo-fnd-doc:isReferencedIn,
        cmns-coll:isPartOf ;
    skos:definition "The order is being paid as part of the referenced Invoice." .

:partOfOrder a owl:ObjectProperty ;
    rdfs:label "partOfOrder" ;
    :domainIncludes :ParcelDelivery ;
    :rangeIncludes :Order ;
    rdfs:comment "The overall order the items in this delivery were included in." ;
    rdfs:subPropertyOf fibo-fnd-doc:refersTo ;
    owl:equivalentProperty unece:ReferencedOrder ;
    skos:definition "The overall order the items in this delivery were included in." .

:partOfSeason a owl:ObjectProperty ;
    rdfs:label "partOfSeason" ;
    :domainIncludes :Clip,
        :Episode ;
    :rangeIncludes :CreativeWorkSeason ;
    rdfs:comment "The season to which this episode belongs." ;
    rdfs:subPropertyOf :isPartOf ;
    skos:definition "The season to which this episode belongs." .

:partOfSystem a owl:ObjectProperty ;
    rdfs:label "partOfSystem" ;
    :domainIncludes :AnatomicalStructure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalSystem ;
    rdfs:comment "The anatomical or organ system that this structure is part of." ;
    skos:definition "The anatomical or organ system that this structure is part of." .

:partOfTVSeries a owl:ObjectProperty ;
    rdfs:label "partOfTVSeries" ;
    :domainIncludes :TVClip,
        :TVEpisode,
        :TVSeason ;
    :rangeIncludes :TVSeries ;
    :supersededBy :partOfSeries ;
    rdfs:comment "The TV series to which this episode or season belongs." ;
    rdfs:subPropertyOf :isPartOf ;
    skos:definition "The TV series to which this episode or season belongs." .

:partySize a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "partySize" ;
    :domainIncludes :FoodEstablishmentReservation,
        :TaxiReservation ;
    :rangeIncludes :Integer,
        :QuantitativeValue ;
    rdfs:comment "Number of people the reservation should accommodate." ;
    skos:definition "Number of people the reservation should accommodate." .

:passengerPriorityStatus a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "passengerPriorityStatus" ;
    :domainIncludes :FlightReservation ;
    :rangeIncludes :QualitativeValue,
        :Text ;
    rdfs:comment "The priority status assigned to a passenger for security or boarding (e.g. FastTrack or Priority)." ;
    skos:definition "The priority status assigned to a passenger for security or boarding (e.g. FastTrack or Priority)." .

:passengerSequenceNumber a owl:DatatypeProperty ;
    rdfs:label "passengerSequenceNumber" ;
    :domainIncludes :FlightReservation ;
    :rangeIncludes :Text ;
    rdfs:comment "The passenger's sequence number as assigned by the airline." ;
    skos:definition "The passenger's sequence number as assigned by the airline." .

:pathophysiology a owl:DatatypeProperty ;
    rdfs:label "pathophysiology" ;
    :domainIncludes :MedicalCondition,
        :PhysicalActivity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Changes in the normal mechanical, physical, and biochemical functions that are associated with this activity or condition." ;
    skos:definition "Changes in the normal mechanical, physical, and biochemical functions that are associated with this activity or condition." .

:pattern a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "pattern" ;
    :domainIncludes :CreativeWork,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1797> ;
    rdfs:comment "A pattern that something has, for example 'polka dot', 'striped', 'Canadian flag'. Values are typically expressed as text, although links to controlled value schemes are also supported." ;
    owl:equivalentProperty unece:printDesignDescription ;
    skos:definition "A pattern that something has, for example 'polka dot', 'striped', 'Canadian flag'. Values are typically expressed as text, although links to controlled value schemes are also supported." .

:payload a owl:ObjectProperty ;
    rdfs:label "payload" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The permitted weight of passengers and cargo, EXCLUDING the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: Many databases specify the permitted TOTAL weight instead, which is the sum of [[weight]] and [[payload]]\\n* Note 2: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 3: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 4: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The permitted weight of passengers and cargo, EXCLUDING the weight of the empty vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: Many databases specify the permitted TOTAL weight instead, which is the sum of [[weight]] and [[payload]]\\n* Note 2: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 3: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]].\\n* Note 4: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

:paymentAccepted a owl:DatatypeProperty ;
    rdfs:label "paymentAccepted" ;
    :domainIncludes :LocalBusiness ;
    :rangeIncludes :Text ;
    rdfs:comment "Cash, Credit Card, Cryptocurrency, Local Exchange Tradings System, etc." ;
    skos:definition "Cash, Credit Card, Cryptocurrency, Local Exchange Tradings System, etc." .

:paymentDue a owl:DatatypeProperty ;
    rdfs:label "paymentDue" ;
    :domainIncludes :Invoice,
        :Order ;
    :rangeIncludes :DateTime ;
    :supersededBy :paymentDueDate ;
    rdfs:comment "The date that payment is due." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasPaymentDueDate> ;
    owl:equivalentProperty unece:PaymentDueDate ;
    skos:definition "The date that payment is due." .

:paymentMethod a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "paymentMethod" ;
    :domainIncludes :Invoice,
        :Order ;
    :rangeIncludes :PaymentMethod,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/3537> ;
    rdfs:comment "The name of the credit card or other method of payment for the order." ;
    rdfs:subPropertyOf fibo-fbc:hasPaymentMechanism ;
    skos:definition "The name of the credit card or other method of payment for the order." .

:paymentMethodId a owl:DatatypeProperty ;
    rdfs:label "paymentMethodId" ;
    :domainIncludes :Invoice,
        :Order ;
    :rangeIncludes :Text ;
    rdfs:comment "An identifier for the method of payment used (e.g. the last 4 digits of the credit card)." ;
    owl:equivalentProperty unece:PaymentMeansID ;
    skos:definition "An identifier for the method of payment used (e.g. the last 4 digits of the credit card)." .

:paymentMethodType a owl:ObjectProperty ;
    rdfs:label "paymentMethodType" ;
    :domainIncludes :PaymentMethod ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :PaymentMethodType ;
    :source <https://github.com/schemaorg/schemaorg/issues/3537> ;
    rdfs:comment "The type of a payment method." ;
    skos:definition "The type of a payment method." .

:paymentStatus a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "paymentStatus" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :PaymentStatusType,
        :Text ;
    rdfs:comment "The status of payment; whether the invoice has been paid or not." ;
    skos:definition "The status of payment; whether the invoice has been paid or not." .

:paymentUrl a owl:DatatypeProperty ;
    rdfs:label "paymentUrl" ;
    :domainIncludes :Order ;
    :rangeIncludes :URL ;
    rdfs:comment "The URL for sending a payment." ;
    rdfs:subPropertyOf cmns-loc:hasAddress ;
    skos:definition "The URL for sending a payment." .

:penciler a owl:ObjectProperty ;
    rdfs:label "penciler" ;
    :domainIncludes :ComicIssue,
        :ComicStory,
        :VisualArtwork ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Person ;
    rdfs:comment "The individual who draws the primary narrative artwork." ;
    skos:definition "The individual who draws the primary narrative artwork." .

:percentile10 a owl:DatatypeProperty ;
    rdfs:label "percentile10" ;
    :domainIncludes :QuantitativeValueDistribution ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "The 10th percentile value." ;
    skos:definition "The 10th percentile value." .

:percentile25 a owl:DatatypeProperty ;
    rdfs:label "percentile25" ;
    :domainIncludes :QuantitativeValueDistribution ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "The 25th percentile value." ;
    skos:definition "The 25th percentile value." .

:percentile75 a owl:DatatypeProperty ;
    rdfs:label "percentile75" ;
    :domainIncludes :QuantitativeValueDistribution ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "The 75th percentile value." ;
    skos:definition "The 75th percentile value." .

:percentile90 a owl:DatatypeProperty ;
    rdfs:label "percentile90" ;
    :domainIncludes :QuantitativeValueDistribution ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "The 90th percentile value." ;
    skos:definition "The 90th percentile value." .

:performerIn a owl:ObjectProperty ;
    rdfs:label "performerIn" ;
    :domainIncludes :Person ;
    :rangeIncludes :Event ;
    rdfs:comment "Event that this person is a performer or participant in." ;
    skos:definition "Event that this person is a performer or participant in." .

:performers a owl:ObjectProperty ;
    rdfs:label "performers" ;
    :domainIncludes :Event ;
    :rangeIncludes :Organization,
        :Person ;
    :supersededBy :performer ;
    rdfs:comment "The main performer or performers of the event&#x2014;for example, a presenter, musician, or actor." ;
    skos:definition "The main performer or performers of the event&#x2014;for example, a presenter, musician, or actor." .

:permissionType a owl:ObjectProperty ;
    rdfs:label "permissionType" ;
    :domainIncludes :DigitalDocumentPermission ;
    :rangeIncludes :DigitalDocumentPermissionType ;
    rdfs:comment "The type of permission granted the person, organization, or audience." ;
    skos:definition "The type of permission granted the person, organization, or audience." .

:permissions a owl:DatatypeProperty ;
    rdfs:label "permissions" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Permission(s) required to run the app (for example, a mobile app may require full internet access or may run only on wifi)." ;
    skos:definition "Permission(s) required to run the app (for example, a mobile app may require full internet access or may run only on wifi)." .

:permitAudience a owl:ObjectProperty ;
    rdfs:label "permitAudience" ;
    :domainIncludes :Permit ;
    :rangeIncludes :Audience ;
    rdfs:comment "The target audience for this permit." ;
    skos:definition "The target audience for this permit." .

:permittedUsage a owl:DatatypeProperty ;
    rdfs:label "permittedUsage" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation ;
    :rangeIncludes :Text ;
    rdfs:comment "Indications regarding the permitted usage of the accommodation." ;
    skos:definition "Indications regarding the permitted usage of the accommodation." .

:petsAllowed a owl:DatatypeProperty ;
    rdfs:label "petsAllowed" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Accommodation,
        :ApartmentComplex,
        :FloorPlan,
        :LodgingBusiness ;
    :rangeIncludes :Boolean,
        :Text ;
    rdfs:comment "Indicates whether pets are allowed to enter the accommodation or lodging business. More detailed information can be put in a text value." ;
    skos:definition "Indicates whether pets are allowed to enter the accommodation or lodging business. More detailed information can be put in a text value." .

:phoneticText a owl:DatatypeProperty ;
    rdfs:label "phoneticText" ;
    :domainIncludes :PronounceableText ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2108> ;
    rdfs:comment "Representation of a text [[textValue]] using the specified [[speechToTextMarkup]]. For example the city name of Houston in IPA: /ˈhjuːstən/." ;
    skos:definition "Representation of a text [[textValue]] using the specified [[speechToTextMarkup]]. For example the city name of Houston in IPA: /ˈhjuːstən/." .

:photos a owl:ObjectProperty ;
    rdfs:label "photos" ;
    :domainIncludes :Place ;
    :rangeIncludes :ImageObject,
        :Photograph ;
    :supersededBy :photo ;
    rdfs:comment "Photographs of this place." ;
    skos:definition "Photographs of this place." .

:physicalRequirement a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "physicalRequirement" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2384> ;
    rdfs:comment "A description of the types of physical activity associated with the job. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." ;
    skos:definition "A description of the types of physical activity associated with the job. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." .

:physiologicalBenefits a owl:DatatypeProperty ;
    rdfs:label "physiologicalBenefits" ;
    :domainIncludes :Diet ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Specific physiologic benefits associated to the plan." ;
    skos:definition "Specific physiologic benefits associated to the plan." .

:pickupLocation a owl:ObjectProperty ;
    rdfs:label "pickupLocation" ;
    :domainIncludes :RentalCarReservation,
        :TaxiReservation ;
    :rangeIncludes :Place ;
    rdfs:comment "Where a taxi will pick up a passenger or a rental car can be picked up." ;
    skos:definition "Where a taxi will pick up a passenger or a rental car can be picked up." .

:pickupTime a owl:DatatypeProperty ;
    rdfs:label "pickupTime" ;
    :domainIncludes :RentalCarReservation,
        :TaxiReservation ;
    :rangeIncludes :DateTime ;
    rdfs:comment "When a taxi will pick up a passenger or a rental car can be picked up." ;
    skos:definition "When a taxi will pick up a passenger or a rental car can be picked up." .

:playMode a owl:ObjectProperty ;
    rdfs:label "playMode" ;
    :domainIncludes :VideoGame,
        :VideoGameSeries ;
    :rangeIncludes :GamePlayMode ;
    rdfs:comment "Indicates whether this game is multi-player, co-op or single-player.  The game can be marked as multi-player, co-op and single-player at the same time." ;
    skos:definition "Indicates whether this game is multi-player, co-op or single-player.  The game can be marked as multi-player, co-op and single-player at the same time." .

:playerType a owl:DatatypeProperty ;
    rdfs:label "playerType" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :Text ;
    rdfs:comment "Player type required&#x2014;for example, Flash or Silverlight." ;
    skos:definition "Player type required&#x2014;for example, Flash or Silverlight." .

:playersOnline a owl:DatatypeProperty ;
    rdfs:label "playersOnline" ;
    :domainIncludes :GameServer ;
    :rangeIncludes :Integer ;
    rdfs:comment "Number of players on the server." ;
    skos:definition "Number of players on the server." .

:polygon a owl:DatatypeProperty ;
    rdfs:label "polygon" ;
    :domainIncludes :GeoShape ;
    :rangeIncludes :Text ;
    rdfs:comment "A polygon is the area enclosed by a point-to-point path for which the starting and ending points are the same. A polygon is expressed as a series of four or more space delimited points where the first and final points are identical." ;
    skos:definition "A polygon is the area enclosed by a point-to-point path for which the starting and ending points are the same. A polygon is expressed as a series of four or more space delimited points where the first and final points are identical." .

:populationType a owl:ObjectProperty ;
    rdfs:label "populationType" ;
    :domainIncludes :StatisticalPopulation,
        :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Class ;
    :source <https://github.com/schemaorg/schemaorg/issues/2291> ;
    rdfs:comment "Indicates the populationType common to all members of a [[StatisticalPopulation]] or all cases within the scope of a [[StatisticalVariable]]." ;
    skos:definition "Indicates the populationType common to all members of a [[StatisticalPopulation]] or all cases within the scope of a [[StatisticalVariable]]." .

:positiveNotes a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "positiveNotes" ;
    :domainIncludes :Product,
        :Review ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ItemList,
        :ListItem,
        :Text,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2832> ;
    rdfs:comment """Provides positive considerations regarding something, for example product highlights or (alongside [[negativeNotes]]) pro/con lists for reviews.

In the case of a [[Review]], the property describes the [[itemReviewed]] from the perspective of the review; in the case of a [[Product]], the product itself is being described.

The property values can be expressed either as unstructured text (repeated as necessary), or if ordered, as a list (in which case the most positive is at the beginning of the list).""" ;
    skos:definition """Provides positive considerations regarding something, for example product highlights or (alongside [[negativeNotes]]) pro/con lists for reviews.

In the case of a [[Review]], the property describes the [[itemReviewed]] from the perspective of the review; in the case of a [[Product]], the product itself is being described.

The property values can be expressed either as unstructured text (repeated as necessary), or if ordered, as a list (in which case the most positive is at the beginning of the list).""" .

:possibleComplication a owl:DatatypeProperty ;
    rdfs:label "possibleComplication" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "A possible unexpected and unfavorable evolution of a medical condition. Complications may include worsening of the signs or symptoms of the disease, extension of the condition to other organ systems, etc." ;
    skos:definition "A possible unexpected and unfavorable evolution of a medical condition. Complications may include worsening of the signs or symptoms of the disease, extension of the condition to other organ systems, etc." .

:possibleTreatment a owl:ObjectProperty ;
    rdfs:label "possibleTreatment" ;
    :domainIncludes :MedicalCondition,
        :MedicalSignOrSymptom ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Drug,
        :DrugClass,
        :LifestyleModification,
        :MedicalTherapy ;
    rdfs:comment "A possible treatment to address this condition, sign or symptom." ;
    skos:definition "A possible treatment to address this condition, sign or symptom." .

:postOfficeBoxNumber a owl:DatatypeProperty ;
    rdfs:label "postOfficeBoxNumber" ;
    :domainIncludes :PostalAddress ;
    :rangeIncludes :Text ;
    rdfs:comment "The post office box number for PO box addresses." ;
    owl:equivalentProperty unece:postOfficeBox ;
    skos:definition "The post office box number for PO box addresses." .

:postOp a owl:DatatypeProperty ;
    rdfs:label "postOp" ;
    :domainIncludes :MedicalDevice ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "A description of the postoperative procedures, care, and/or followups for this device." ;
    skos:definition "A description of the postoperative procedures, care, and/or followups for this device." .

:postalCode a owl:DatatypeProperty ;
    rdfs:label "postalCode" ;
    :domainIncludes :DefinedRegion,
        :GeoCoordinates,
        :GeoShape,
        :PostalAddress ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "The postal code. For example, 94043." ;
    owl:equivalentProperty unece:postcodeCode,
        fibo-fnd-plc:hasPostalCode ;
    skos:definition "The postal code. For example, 94043." .

:postalCodeBegin a owl:DatatypeProperty ;
    rdfs:label "postalCodeBegin" ;
    :domainIncludes :PostalCodeRangeSpecification ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "First postal code in a range (included)." ;
    rdfs:subPropertyOf cmns-qtu:hasLowerBound ;
    skos:definition "First postal code in a range (included)." .

:postalCodeEnd a owl:DatatypeProperty ;
    rdfs:label "postalCodeEnd" ;
    :domainIncludes :PostalCodeRangeSpecification ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "Last postal code in the range (included). Needs to be after [[postalCodeBegin]]." ;
    rdfs:subPropertyOf cmns-qtu:hasUpperBound ;
    skos:definition "Last postal code in the range (included). Needs to be after [[postalCodeBegin]]." .

:postalCodePrefix a owl:DatatypeProperty ;
    rdfs:label "postalCodePrefix" ;
    :domainIncludes :DefinedRegion ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "A defined range of postal codes indicated by a common textual prefix. Used for non-numeric systems such as UK." ;
    skos:definition "A defined range of postal codes indicated by a common textual prefix. Used for non-numeric systems such as UK." .

:postalCodeRange a owl:ObjectProperty ;
    rdfs:label "postalCodeRange" ;
    :domainIncludes :DefinedRegion ;
    :rangeIncludes :PostalCodeRangeSpecification ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "A defined range of postal codes." ;
    skos:definition "A defined range of postal codes." .

:potentialAction a owl:ObjectProperty ;
    rdfs:label "potentialAction" ;
    :domainIncludes :Thing ;
    :rangeIncludes :Action ;
    rdfs:comment "Indicates a potential Action, which describes an idealized action in which this thing would play an 'object' role." ;
    skos:definition "Indicates a potential Action, which describes an idealized action in which this thing would play an 'object' role." .

:potentialUse a owl:ObjectProperty ;
    rdfs:label "potentialUse" ;
    :domainIncludes :ChemicalSubstance,
        :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm ;
    :source <http://www.bioschemas.org/ChemicalSubstance> ;
    rdfs:comment "Intended use of the BioChemEntity by humans." ;
    skos:definition "Intended use of the BioChemEntity by humans." .

:practicesAt a owl:ObjectProperty ;
    rdfs:label "practicesAt" ;
    :domainIncludes :IndividualPhysician ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MedicalOrganization ;
    :source <https://github.com/schemaorg/schemaorg/issues/3420> ;
    rdfs:comment "A [[MedicalOrganization]] where the [[IndividualPhysician]] practices." ;
    skos:definition "A [[MedicalOrganization]] where the [[IndividualPhysician]] practices." .

:preOp a owl:DatatypeProperty ;
    rdfs:label "preOp" ;
    :domainIncludes :MedicalDevice ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "A description of the workup, testing, and other preparations required before implanting this device." ;
    skos:definition "A description of the workup, testing, and other preparations required before implanting this device." .

:predecessorOf a owl:ObjectProperty ;
    rdfs:label "predecessorOf" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :ProductModel ;
    :rangeIncludes :ProductModel ;
    rdfs:comment "A pointer from a previous, often discontinued variant of the product to its newer variant." ;
    skos:definition "A pointer from a previous, often discontinued variant of the product to its newer variant." .

:pregnancyCategory a owl:ObjectProperty ;
    rdfs:label "pregnancyCategory" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DrugPregnancyCategory ;
    rdfs:comment "Pregnancy category of this drug." ;
    skos:definition "Pregnancy category of this drug." .

:pregnancyWarning a owl:DatatypeProperty ;
    rdfs:label "pregnancyWarning" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any precaution, guidance, contraindication, etc. related to this drug's use during pregnancy." ;
    skos:definition "Any precaution, guidance, contraindication, etc. related to this drug's use during pregnancy." .

:prepTime a owl:ObjectProperty ;
    rdfs:label "prepTime" ;
    :domainIncludes :HowTo,
        :HowToDirection ;
    :rangeIncludes :Duration ;
    rdfs:comment "The length of time it takes to prepare the items to be used in instructions or a direction, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." ;
    skos:definition "The length of time it takes to prepare the items to be used in instructions or a direction, in [ISO 8601 duration format](http://en.wikipedia.org/wiki/ISO_8601)." .

:preparation a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "preparation" ;
    :domainIncludes :MedicalProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity,
        :Text ;
    rdfs:comment "Typical preparation that a patient must undergo before having the procedure performed." ;
    skos:definition "Typical preparation that a patient must undergo before having the procedure performed." .

:prescribingInfo a owl:DatatypeProperty ;
    rdfs:label "prescribingInfo" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :URL ;
    rdfs:comment "Link to prescribing information for the drug." ;
    skos:definition "Link to prescribing information for the drug." .

:prescriptionStatus a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "prescriptionStatus" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :DrugPrescriptionStatus,
        :Text ;
    rdfs:comment "Indicates the status of drug prescription, e.g. local catalogs classifications or whether the drug is available by prescription or over-the-counter, etc." ;
    skos:definition "Indicates the status of drug prescription, e.g. local catalogs classifications or whether the drug is available by prescription or over-the-counter, etc." .

:previousItem a owl:ObjectProperty ;
    rdfs:label "previousItem" ;
    :domainIncludes :ListItem ;
    :rangeIncludes :ListItem ;
    rdfs:comment "A link to the ListItem that precedes the current one." ;
    skos:definition "A link to the ListItem that precedes the current one." .

:previousStartDate a owl:DatatypeProperty ;
    rdfs:label "previousStartDate" ;
    :domainIncludes :Event ;
    :rangeIncludes :Date ;
    rdfs:comment "Used in conjunction with eventStatus for rescheduled or cancelled events. This property contains the previously scheduled start date. For rescheduled events, the startDate property should be used for the newly scheduled start date. In the (rare) case of an event that has been postponed and rescheduled multiple times, this field may be repeated." ;
    skos:definition "Used in conjunction with eventStatus for rescheduled or cancelled events. This property contains the previously scheduled start date. For rescheduled events, the startDate property should be used for the newly scheduled start date. In the (rare) case of an event that has been postponed and rescheduled multiple times, this field may be repeated." .

:price a owl:DatatypeProperty ;
    rdfs:label "price" ;
    :domainIncludes :DonateAction,
        :Offer,
        :PriceSpecification,
        :TradeAction ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment """The offer price of a product, or of a price component when attached to PriceSpecification and its subtypes.\\n\\nUsage guidelines:\\n\\n* Use the [[priceCurrency]] property (with standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. "USD"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. "BTC"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. "Ithaca HOUR") instead of including [ambiguous symbols](http://en.wikipedia.org/wiki/Dollar_sign#Currencies_that_use_the_dollar_or_peso_sign) such as '$' in the value.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.\\n* Note that both [RDFa](http://www.w3.org/TR/xhtml-rdfa-primer/#using-the-content-attribute) and Microdata syntax allow the use of a "content=" attribute for publishing simple machine-readable values alongside more human-friendly formatting.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.
      """ ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasAmount>,
        cmns-qtu:hasNumericValue ;
    skos:definition """The offer price of a product, or of a price component when attached to PriceSpecification and its subtypes.\\n\\nUsage guidelines:\\n\\n* Use the [[priceCurrency]] property (with standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. "USD"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. "BTC"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. "Ithaca HOUR") instead of including [ambiguous symbols](http://en.wikipedia.org/wiki/Dollar_sign#Currencies_that_use_the_dollar_or_peso_sign) such as '$' in the value.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.\\n* Note that both [RDFa](http://www.w3.org/TR/xhtml-rdfa-primer/#using-the-content-attribute) and Microdata syntax allow the use of a "content=" attribute for publishing simple machine-readable values alongside more human-friendly formatting.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.
      """ .

:priceComponent a owl:ObjectProperty ;
    rdfs:label "priceComponent" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :CompoundPriceSpecification ;
    :rangeIncludes :PriceSpecification ;
    rdfs:comment "This property links to all [[UnitPriceSpecification]] nodes that apply in parallel for the [[CompoundPriceSpecification]] node." ;
    skos:definition "This property links to all [[UnitPriceSpecification]] nodes that apply in parallel for the [[CompoundPriceSpecification]] node." .

:priceComponentType a owl:ObjectProperty ;
    rdfs:label "priceComponentType" ;
    :domainIncludes :UnitPriceSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :PriceComponentTypeEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2689> ;
    rdfs:comment "Identifies a price component (for example, a line item on an invoice), part of the total price for an offer." ;
    skos:definition "Identifies a price component (for example, a line item on an invoice), part of the total price for an offer." .

:priceCurrency a owl:DatatypeProperty ;
    rdfs:label "priceCurrency" ;
    :domainIncludes :DonateAction,
        :Offer,
        :PriceSpecification,
        :Reservation,
        :Ticket,
        :TradeAction ;
    :rangeIncludes :Text ;
    rdfs:comment "The currency of the price, or a price component when attached to [[PriceSpecification]] and its subtypes.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." ;
    rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> ;
    skos:definition "The currency of the price, or a price component when attached to [[PriceSpecification]] and its subtypes.\\n\\nUse standard formats: [ISO 4217 currency format](http://en.wikipedia.org/wiki/ISO_4217), e.g. \"USD\"; [Ticker symbol](https://en.wikipedia.org/wiki/List_of_cryptocurrencies) for cryptocurrencies, e.g. \"BTC\"; well known names for [Local Exchange Trading Systems](https://en.wikipedia.org/wiki/Local_exchange_trading_system) (LETS) and other currency types, e.g. \"Ithaca HOUR\"." .

:priceRange a owl:DatatypeProperty ;
    rdfs:label "priceRange" ;
    :domainIncludes :LocalBusiness ;
    :rangeIncludes :Text ;
    rdfs:comment "The price range of the business, for example ```$$$```." ;
    skos:definition "The price range of the business, for example ```$$$```." .

:priceSpecification a owl:ObjectProperty ;
    rdfs:label "priceSpecification" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :DonateAction,
        :Offer,
        :TradeAction ;
    :rangeIncludes :PriceSpecification ;
    rdfs:comment "One or more detailed price specifications, indicating the unit price and delivery or payment charges." ;
    owl:equivalentClass unece:AmountType ;
    skos:definition "One or more detailed price specifications, indicating the unit price and delivery or payment charges." .

:priceType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "priceType" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :CompoundPriceSpecification,
        :UnitPriceSpecification ;
    :rangeIncludes :PriceTypeEnumeration,
        :Text ;
    rdfs:comment "Defines the type of a price specified for an offered product, for example a list price, a (temporary) sale price or a manufacturer suggested retail price. If multiple prices are specified for an offer the [[priceType]] property can be used to identify the type of each such specified price. The value of priceType can be specified as a value from enumeration PriceTypeEnumeration or, a UN/EDIFACT 5387 code, or as a free form text string for price types that are not already predefined in PriceTypeEnumeration." ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    owl:equivalentProperty unece:PriceTypeCode ;
    skos:definition "Defines the type of a price specified for an offered product, for example a list price, a (temporary) sale price or a manufacturer suggested retail price. If multiple prices are specified for an offer the [[priceType]] property can be used to identify the type of each such specified price. The value of priceType can be specified as a value from enumeration PriceTypeEnumeration or, a UN/EDIFACT 5387 code, or as a free form text string for price types that are not already predefined in PriceTypeEnumeration." .

:priceValidUntil a owl:DatatypeProperty ;
    rdfs:label "priceValidUntil" ;
    :domainIncludes :Offer ;
    :rangeIncludes :Date ;
    rdfs:comment "The date after which the price is no longer available." ;
    rdfs:subPropertyOf :endDate ;
    owl:equivalentProperty unece:EffectiveEndDateTime ;
    skos:definition "The date after which the price is no longer available." .

:primaryImageOfPage a owl:ObjectProperty ;
    rdfs:label "primaryImageOfPage" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :ImageObject ;
    rdfs:comment "Indicates the main image on the page." ;
    skos:definition "Indicates the main image on the page." .

:primaryPrevention a owl:ObjectProperty ;
    rdfs:label "primaryPrevention" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalTherapy ;
    rdfs:comment "A preventative therapy used to prevent an initial occurrence of the medical condition, such as vaccination." ;
    skos:definition "A preventative therapy used to prevent an initial occurrence of the medical condition, such as vaccination." .

:printColumn a owl:DatatypeProperty ;
    rdfs:label "printColumn" ;
    :domainIncludes :NewsArticle ;
    :rangeIncludes :Text ;
    rdfs:comment "The number of the column in which the NewsArticle appears in the print edition." ;
    skos:definition "The number of the column in which the NewsArticle appears in the print edition." .

:printEdition a owl:DatatypeProperty ;
    rdfs:label "printEdition" ;
    :domainIncludes :NewsArticle ;
    :rangeIncludes :Text ;
    rdfs:comment "The edition of the print product in which the NewsArticle appears." ;
    skos:definition "The edition of the print product in which the NewsArticle appears." .

:printPage a owl:DatatypeProperty ;
    rdfs:label "printPage" ;
    :domainIncludes :NewsArticle ;
    :rangeIncludes :Text ;
    rdfs:comment "If this NewsArticle appears in print, this field indicates the name of the page on which the article is found. Please note that this field is intended for the exact page name (e.g. A5, B18)." ;
    skos:definition "If this NewsArticle appears in print, this field indicates the name of the page on which the article is found. Please note that this field is intended for the exact page name (e.g. A5, B18)." .

:printSection a owl:DatatypeProperty ;
    rdfs:label "printSection" ;
    :domainIncludes :NewsArticle ;
    :rangeIncludes :Text ;
    rdfs:comment "If this NewsArticle appears in print, this field indicates the print section in which the article appeared." ;
    skos:definition "If this NewsArticle appears in print, this field indicates the print section in which the article appeared." .

:procedure a owl:DatatypeProperty ;
    rdfs:label "procedure" ;
    :domainIncludes :MedicalDevice ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "A description of the procedure involved in setting up, using, and/or installing the device." ;
    skos:definition "A description of the procedure involved in setting up, using, and/or installing the device." .

:procedureType a owl:ObjectProperty ;
    rdfs:label "procedureType" ;
    :domainIncludes :MedicalProcedure ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalProcedureType ;
    rdfs:comment "The type of procedure, for example Surgical, Noninvasive, or Percutaneous." ;
    skos:definition "The type of procedure, for example Surgical, Noninvasive, or Percutaneous." .

:processingTime a owl:ObjectProperty ;
    rdfs:label "processingTime" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :Duration ;
    rdfs:comment "Estimated processing time for the service using this channel." ;
    skos:definition "Estimated processing time for the service using this channel." .

:processorRequirements a owl:DatatypeProperty ;
    rdfs:label "processorRequirements" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Processor architecture required to run the application (e.g. IA64)." ;
    skos:definition "Processor architecture required to run the application (e.g. IA64)." .

:producer a owl:ObjectProperty ;
    rdfs:label "producer" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The person or organization who produced the work (e.g. music album, movie, TV/radio series etc.)." ;
    skos:definition "The person or organization who produced the work (e.g. music album, movie, TV/radio series etc.)." .

:produces a owl:ObjectProperty ;
    rdfs:label "produces" ;
    :domainIncludes :Service ;
    :rangeIncludes :Thing ;
    :supersededBy :serviceOutput ;
    rdfs:comment "The tangible thing generated by the service, e.g. a passport, permit, etc." ;
    skos:definition "The tangible thing generated by the service, e.g. a passport, permit, etc." .

:productGroupID a owl:DatatypeProperty ;
    rdfs:label "productGroupID" ;
    :domainIncludes :ProductGroup ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1797> ;
    rdfs:comment "Indicates a textual identifier for a ProductGroup." ;
    skos:definition "Indicates a textual identifier for a ProductGroup." .

:productID a owl:DatatypeProperty ;
    rdfs:label "productID" ;
    :domainIncludes :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The product identifier, such as ISBN. For example: ``` meta itemprop=\"productID\" content=\"isbn:123-456-789\" ```." ;
    rdfs:subPropertyOf :identifier ;
    skos:definition "The product identifier, such as ISBN. For example: ``` meta itemprop=\"productID\" content=\"isbn:123-456-789\" ```." .

:productSupported a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "productSupported" ;
    :domainIncludes :ContactPoint ;
    :rangeIncludes :Product,
        :Text ;
    rdfs:comment "The product or service this support contact point is related to (such as product support for a particular product line). This can be a specific product or product line (e.g. \"iPhone\") or a general category of products or services (e.g. \"smartphones\")." ;
    skos:definition "The product or service this support contact point is related to (such as product support for a particular product line). This can be a specific product or product line (e.g. \"iPhone\") or a general category of products or services (e.g. \"smartphones\")." .

:productionCompany a owl:ObjectProperty ;
    rdfs:label "productionCompany" ;
    :domainIncludes :CreativeWorkSeason,
        :Episode,
        :MediaObject,
        :Movie,
        :MovieSeries,
        :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :Organization ;
    rdfs:comment "The production company or studio responsible for the item, e.g. series, video game, episode etc." ;
    skos:definition "The production company or studio responsible for the item, e.g. series, video game, episode etc." .

:productionDate a owl:DatatypeProperty ;
    rdfs:label "productionDate" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Product,
        :Vehicle ;
    :rangeIncludes :Date ;
    rdfs:comment "The date of production of the item, e.g. vehicle." ;
    owl:equivalentProperty unece:ProductionDate ;
    skos:definition "The date of production of the item, e.g. vehicle." .

:proficiencyLevel a owl:DatatypeProperty ;
    rdfs:label "proficiencyLevel" ;
    :domainIncludes :TechArticle ;
    :rangeIncludes :Text ;
    rdfs:comment "Proficiency needed for this content; expected values: 'Beginner', 'Expert'." ;
    skos:definition "Proficiency needed for this content; expected values: 'Beginner', 'Expert'." .

:program a owl:ObjectProperty ;
    rdfs:label "program" ;
    :domainIncludes :ProgramMembership ;
    :rangeIncludes :MemberProgram ;
    :source <https://github.com/schemaorg/schemaorg/issues/3563> ;
    rdfs:comment "The [MemberProgram](http://schema.org/MemberProgram) associated with a [ProgramMembership](http://schema.org/ProgramMembership)." ;
    skos:definition "The [MemberProgram](http://schema.org/MemberProgram) associated with a [ProgramMembership](http://schema.org/ProgramMembership)." .

:programMembershipUsed a owl:ObjectProperty ;
    rdfs:label "programMembershipUsed" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :ProgramMembership ;
    rdfs:comment "Any membership in a frequent flyer, hotel loyalty program, etc. being applied to the reservation." ;
    skos:definition "Any membership in a frequent flyer, hotel loyalty program, etc. being applied to the reservation." .

:programName a owl:DatatypeProperty ;
    rdfs:label "programName" ;
    :domainIncludes :ProgramMembership ;
    :rangeIncludes :Text ;
    rdfs:comment "The program providing the membership. It is preferable to use [:program](http://schema.org/program) instead." ;
    skos:definition "The program providing the membership. It is preferable to use [:program](http://schema.org/program) instead." .

:programPrerequisites a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "programPrerequisites" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :AlignmentObject,
        :Course,
        :EducationalOccupationalCredential,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "Prerequisites for enrolling in the program." ;
    skos:definition "Prerequisites for enrolling in the program." .

:programType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "programType" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2460> ;
    rdfs:comment "The type of educational or occupational program. For example, classroom, internship, alternance, etc." ;
    skos:definition "The type of educational or occupational program. For example, classroom, internship, alternance, etc." .

:programmingLanguage a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "programmingLanguage" ;
    :domainIncludes :SoftwareSourceCode ;
    :rangeIncludes :ComputerLanguage,
        :Text ;
    rdfs:comment "The computer programming language." ;
    skos:definition "The computer programming language." .

:programmingModel a owl:DatatypeProperty ;
    rdfs:label "programmingModel" ;
    :domainIncludes :APIReference ;
    :rangeIncludes :Text ;
    rdfs:comment "Indicates whether API is managed or unmanaged." ;
    skos:definition "Indicates whether API is managed or unmanaged." .

:pronouns a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "pronouns" ;
    :domainIncludes :Person ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :StructuredValue,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2935> ;
    rdfs:comment """A short string listing or describing pronouns for a person. Typically the person concerned is the best authority as pronouns are a critical part of personal identity and expression. Publishers and consumers of this information are reminded to treat this data responsibly, take country-specific laws related to gender expression into account, and be wary of out-of-date data and drawing unwarranted inferences about the person being described.

In English, formulations such as "they/them", "she/her", and "he/him" are commonly used online and can also be used here. We do not intend to enumerate all possible micro-syntaxes in all languages. More structured and well-defined external values for pronouns can be referenced using the [[StructuredValue]] or [[DefinedTerm]] values.
""" ;
    skos:definition """A short string listing or describing pronouns for a person. Typically the person concerned is the best authority as pronouns are a critical part of personal identity and expression. Publishers and consumers of this information are reminded to treat this data responsibly, take country-specific laws related to gender expression into account, and be wary of out-of-date data and drawing unwarranted inferences about the person being described.

In English, formulations such as "they/them", "she/her", and "he/him" are commonly used online and can also be used here. We do not intend to enumerate all possible micro-syntaxes in all languages. More structured and well-defined external values for pronouns can be referenced using the [[StructuredValue]] or [[DefinedTerm]] values.
""" .

:propertyID a owl:DatatypeProperty ;
    rdfs:label "propertyID" ;
    :domainIncludes :PropertyValue ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment """A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be
(1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific ID of the property), or (3)
a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry).
Standards bodies should promote a standard prefix for the identifiers of properties from their standards.""" ;
    skos:definition """A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be
(1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific ID of the property), or (3)
a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry).
Standards bodies should promote a standard prefix for the identifiers of properties from their standards.""" .

:proprietaryName a owl:DatatypeProperty ;
    rdfs:label "proprietaryName" ;
    :domainIncludes :DietarySupplement,
        :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Proprietary name given to the diet plan, typically by its originator or creator." ;
    skos:definition "Proprietary name given to the diet plan, typically by its originator or creator." .

:proteinContent a owl:ObjectProperty ;
    rdfs:label "proteinContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of protein." ;
    skos:definition "The number of grams of protein." .

:providerMobility a owl:DatatypeProperty ;
    rdfs:label "providerMobility" ;
    :domainIncludes :Service ;
    :rangeIncludes :Text ;
    rdfs:comment "Indicates the mobility of a provided service (e.g. 'static', 'dynamic')." ;
    skos:definition "Indicates the mobility of a provided service (e.g. 'static', 'dynamic')." .

:providesService a owl:ObjectProperty ;
    rdfs:label "providesService" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :Service ;
    rdfs:comment "The service provided by this channel." ;
    skos:definition "The service provided by this channel." .

:publicAccess a owl:DatatypeProperty ;
    rdfs:label "publicAccess" ;
    :domainIncludes :Place ;
    :rangeIncludes :Boolean ;
    rdfs:comment "A flag to signal that the [[Place]] is open to public visitors.  If this property is omitted there is no assumed default boolean value." ;
    skos:definition "A flag to signal that the [[Place]] is open to public visitors.  If this property is omitted there is no assumed default boolean value." .

:publicTransportClosuresInfo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "publicTransportClosuresInfo" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Information about public transport closures." ;
    skos:definition "Information about public transport closures." .

:publication a owl:ObjectProperty ;
    rdfs:label "publication" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :PublicationEvent ;
    rdfs:comment "A publication event associated with the item." ;
    skos:definition "A publication event associated with the item." .

:publicationType a owl:DatatypeProperty ;
    rdfs:label "publicationType" ;
    :domainIncludes :MedicalScholarlyArticle ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The type of the medical article, taken from the US NLM MeSH publication type catalog. See also [MeSH documentation](http://www.nlm.nih.gov/mesh/pubtypes.html)." ;
    skos:definition "The type of the medical article, taken from the US NLM MeSH publication type catalog. See also [MeSH documentation](http://www.nlm.nih.gov/mesh/pubtypes.html)." .

:publishedBy a owl:ObjectProperty ;
    rdfs:label "publishedBy" ;
    :domainIncludes :PublicationEvent ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "An agent associated with the publication event." ;
    skos:definition "An agent associated with the publication event." .

:publishedOn a owl:ObjectProperty ;
    rdfs:label "publishedOn" ;
    :domainIncludes :PublicationEvent ;
    :rangeIncludes :BroadcastService ;
    rdfs:comment "A broadcast service associated with the publication event." ;
    skos:definition "A broadcast service associated with the publication event." .

:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    :domainIncludes :CreativeWork,
        :FinancialIncentive ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "The publisher of the article in question." ;
    skos:definition "The publisher of the article in question." .

:publisherImprint a owl:ObjectProperty ;
    rdfs:label "publisherImprint" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Organization ;
    rdfs:comment "The publishing division which published the comic." ;
    skos:definition "The publishing division which published the comic." .

:purchaseDate a owl:DatatypeProperty ;
    rdfs:label "purchaseDate" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Product,
        :Vehicle ;
    :rangeIncludes :Date ;
    rdfs:comment "The date the item, e.g. vehicle, was purchased by the current owner." ;
    skos:definition "The date the item, e.g. vehicle, was purchased by the current owner." .

:purchasePriceLimit a owl:ObjectProperty ;
    rdfs:label "purchasePriceLimit" ;
    :domainIncludes :FinancialIncentive ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/3572> ;
    rdfs:comment "Optional. The maximum price the item can have and still qualify for this offer." ;
    skos:definition "Optional. The maximum price the item can have and still qualify for this offer." .

:purchaseType a owl:ObjectProperty ;
    rdfs:label "purchaseType" ;
    :domainIncludes :FinancialIncentive ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :PurchaseType ;
    :source <https://github.com/schemaorg/schemaorg/issues/3572> ;
    rdfs:comment "Optional. The type of purchase the consumer must make in order to qualify for this incentive." ;
    skos:definition "Optional. The type of purchase the consumer must make in order to qualify for this incentive." .

:qualifications a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "qualifications" ;
    :domainIncludes :JobPosting,
        :Occupation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :EducationalOccupationalCredential,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698>,
        <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "Specific qualifications required for this role or Occupation." ;
    skos:definition "Specific qualifications required for this role or Occupation." .

:qualifiedExpense a owl:ObjectProperty ;
    rdfs:label "qualifiedExpense" ;
    :domainIncludes :FinancialIncentive ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :IncentiveQualifiedExpenseType ;
    :source <https://github.com/schemaorg/schemaorg/issues/3572> ;
    rdfs:comment "Optional. The types of expenses that are covered by the incentive. For example some incentives are only for the goods (tangible items) but the services (labor) are excluded." ;
    skos:definition "Optional. The types of expenses that are covered by the incentive. For example some incentives are only for the goods (tangible items) but the services (labor) are excluded." .

:quarantineGuidelines a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "quarantineGuidelines" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Guidelines about quarantine rules, e.g. in the context of a pandemic." ;
    skos:definition "Guidelines about quarantine rules, e.g. in the context of a pandemic." .

:query a owl:DatatypeProperty ;
    rdfs:label "query" ;
    :domainIncludes :SearchAction ;
    :rangeIncludes :Text ;
    rdfs:comment "A sub property of instrument. The query used on this action." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The query used on this action." .

:quest a owl:ObjectProperty ;
    rdfs:label "quest" ;
    :domainIncludes :Game,
        :VideoGameSeries ;
    :rangeIncludes :Thing ;
    rdfs:comment "The task that a player-controlled character, or group of characters may complete in order to gain a reward." ;
    skos:definition "The task that a player-controlled character, or group of characters may complete in order to gain a reward." .

:question a owl:ObjectProperty ;
    rdfs:label "question" ;
    :domainIncludes :AskAction ;
    :rangeIncludes :Question ;
    rdfs:comment "A sub property of object. A question." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. A question." .

:rangeIncludes a owl:ObjectProperty ;
    rdfs:label "rangeIncludes" ;
    :domainIncludes :Property ;
    :isPartOf <http://meta.schema.org> ;
    :rangeIncludes :Class ;
    rdfs:comment "Relates a property to a class that constitutes (one of) the expected type(s) for values of the property." ;
    skos:definition "Relates a property to a class that constitutes (one of) the expected type(s) for values of the property." .

:ratingCount a owl:DatatypeProperty ;
    rdfs:label "ratingCount" ;
    :domainIncludes :AggregateRating ;
    :rangeIncludes :Integer ;
    rdfs:comment "The count of total number of ratings." ;
    skos:definition "The count of total number of ratings." .

:ratingExplanation a owl:DatatypeProperty ;
    rdfs:label "ratingExplanation" ;
    :domainIncludes :Rating ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2300> ;
    rdfs:comment "A short explanation (e.g. one to two sentences) providing background context and other information that led to the conclusion expressed in the rating. This is particularly applicable to ratings associated with \"fact check\" markup using [[ClaimReview]]." ;
    skos:definition "A short explanation (e.g. one to two sentences) providing background context and other information that led to the conclusion expressed in the rating. This is particularly applicable to ratings associated with \"fact check\" markup using [[ClaimReview]]." .

:ratingValue a owl:DatatypeProperty ;
    rdfs:label "ratingValue" ;
    :domainIncludes :Rating ;
    :rangeIncludes :Number,
        :Text ;
    rdfs:comment "The rating for the content.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    skos:definition "The rating for the content.\\n\\nUsage guidelines:\\n\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." .

:readBy a owl:ObjectProperty ;
    rdfs:label "readBy" ;
    :domainIncludes :Audiobook ;
    :isPartOf <http://bib.schema.org> ;
    :rangeIncludes :Person ;
    rdfs:comment "A person who reads (performs) the audiobook." ;
    rdfs:subPropertyOf :actor ;
    skos:definition "A person who reads (performs) the audiobook." .

:readonlyValue a owl:DatatypeProperty ;
    rdfs:label "readonlyValue" ;
    :domainIncludes :PropertyValueSpecification ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Whether or not a property is mutable.  Default is false. Specifying this for a property that also has a value makes it act similar to a \"hidden\" input in an HTML form." ;
    skos:definition "Whether or not a property is mutable.  Default is false. Specifying this for a property that also has a value makes it act similar to a \"hidden\" input in an HTML form." .

:realEstateAgent a owl:ObjectProperty ;
    rdfs:label "realEstateAgent" ;
    :domainIncludes :RentAction ;
    :rangeIncludes :RealEstateAgent ;
    rdfs:comment "A sub property of participant. The real estate agent involved in the action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The real estate agent involved in the action." .

:recipe a owl:ObjectProperty ;
    rdfs:label "recipe" ;
    :domainIncludes :CookAction ;
    :rangeIncludes :Recipe ;
    rdfs:comment "A sub property of instrument. The recipe/instructions used to perform the action." ;
    rdfs:subPropertyOf :instrument ;
    skos:definition "A sub property of instrument. The recipe/instructions used to perform the action." .

:recipeCategory a owl:DatatypeProperty ;
    rdfs:label "recipeCategory" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :Text ;
    rdfs:comment "The category of the recipe—for example, appetizer, entree, etc." ;
    skos:definition "The category of the recipe—for example, appetizer, entree, etc." .

:recipeCuisine a owl:DatatypeProperty ;
    rdfs:label "recipeCuisine" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :Text ;
    rdfs:comment "The cuisine of the recipe (for example, French or Ethiopian)." ;
    skos:definition "The cuisine of the recipe (for example, French or Ethiopian)." .

:recipeInstructions a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "recipeInstructions" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :CreativeWork,
        :ItemList,
        :Text ;
    rdfs:comment "A step in making the recipe, in the form of a single item (document, video, etc.) or an ordered list with HowToStep and/or HowToSection items." ;
    rdfs:subPropertyOf :step ;
    skos:definition "A step in making the recipe, in the form of a single item (document, video, etc.) or an ordered list with HowToStep and/or HowToSection items." .

:recipeYield a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "recipeYield" ;
    :domainIncludes :Recipe ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    rdfs:comment "The quantity produced by the recipe (for example, number of people served, number of servings, etc)." ;
    rdfs:subPropertyOf :yield ;
    skos:definition "The quantity produced by the recipe (for example, number of people served, number of servings, etc)." .

:recognizedBy a owl:ObjectProperty ;
    rdfs:label "recognizedBy" ;
    :domainIncludes :EducationalOccupationalCredential ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization ;
    :source <https://github.com/schemaorg/schemaorg/issues/1779> ;
    rdfs:comment "An organization that acknowledges the validity, value or utility of a credential. Note: recognition may include a process of quality assurance or accreditation." ;
    skos:definition "An organization that acknowledges the validity, value or utility of a credential. Note: recognition may include a process of quality assurance or accreditation." .

:recognizingAuthority a owl:ObjectProperty ;
    rdfs:label "recognizingAuthority" ;
    :domainIncludes :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Organization ;
    rdfs:comment "If applicable, the organization that officially recognizes this entity as part of its endorsed system of medicine." ;
    skos:definition "If applicable, the organization that officially recognizes this entity as part of its endorsed system of medicine." .

:recommendationStrength a owl:DatatypeProperty ;
    rdfs:label "recommendationStrength" ;
    :domainIncludes :MedicalGuidelineRecommendation ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Strength of the guideline's recommendation (e.g. 'class I')." ;
    skos:definition "Strength of the guideline's recommendation (e.g. 'class I')." .

:recommendedIntake a owl:ObjectProperty ;
    rdfs:label "recommendedIntake" ;
    :domainIncludes :DietarySupplement ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :RecommendedDoseSchedule ;
    rdfs:comment "Recommended intake of this supplement for a given population as defined by a specific recommending authority." ;
    skos:definition "Recommended intake of this supplement for a given population as defined by a specific recommending authority." .

:recordLabel a owl:ObjectProperty ;
    rdfs:label "recordLabel" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    :domainIncludes :MusicRelease ;
    :rangeIncludes :Organization ;
    rdfs:comment "The label that issued the release." ;
    owl:equivalentProperty <http://purl.org/ontology/mo/label> ;
    skos:definition "The label that issued the release." .

:recourseLoan a owl:DatatypeProperty ;
    rdfs:label "recourseLoan" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "The only way you get the money back in the event of default is the security. Recourse is where you still have the opportunity to go back to the borrower for the rest of the money." ;
    skos:definition "The only way you get the money back in the event of default is the security. Recourse is where you still have the opportunity to go back to the borrower for the rest of the money." .

:referee a owl:ObjectProperty ;
    rdfs:label "referee" ;
    :domainIncludes :SportsEvent ;
    :rangeIncludes :Person ;
    rdfs:comment "An official who watches a game or match closely to enforce the rules and arbitrate on matters arising from the play such as referees, umpires or judges. The name of the effective function can vary according to the sport." ;
    skos:definition "An official who watches a game or match closely to enforce the rules and arbitrate on matters arising from the play such as referees, umpires or judges. The name of the effective function can vary according to the sport." .

:referenceQuantity a owl:ObjectProperty ;
    rdfs:label "referenceQuantity" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :UnitPriceSpecification ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The reference quantity for which a certain price applies, e.g. 1 EUR per 4 kWh of electricity. This property is a replacement for unitOfMeasurement for the advanced cases where the price does not relate to a standard unit." ;
    skos:definition "The reference quantity for which a certain price applies, e.g. 1 EUR per 4 kWh of electricity. This property is a replacement for unitOfMeasurement for the advanced cases where the price does not relate to a standard unit." .

:referencesOrder a owl:ObjectProperty ;
    rdfs:label "referencesOrder" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :Order ;
    rdfs:comment "The Order(s) related to this Invoice. One or more Orders may be combined into a single Invoice." ;
    skos:definition "The Order(s) related to this Invoice. One or more Orders may be combined into a single Invoice." .

:refundType a owl:ObjectProperty ;
    rdfs:label "refundType" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :RefundTypeEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2288> ;
    rdfs:comment "A refund type, from an enumerated list." ;
    skos:definition "A refund type, from an enumerated list." .

:regionDrained a owl:ObjectProperty ;
    rdfs:label "regionDrained" ;
    :domainIncludes :LymphaticVessel,
        :Vein ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure,
        :AnatomicalSystem ;
    rdfs:comment "The anatomical or organ system drained by this vessel; generally refers to a specific part of an organ." ;
    skos:definition "The anatomical or organ system drained by this vessel; generally refers to a specific part of an organ." .

:regionsAllowed a owl:ObjectProperty ;
    rdfs:label "regionsAllowed" ;
    :domainIncludes :MediaObject ;
    :rangeIncludes :Place ;
    rdfs:comment "The regions where the media is allowed. If not specified, then it's assumed to be allowed everywhere. Specify the countries in [ISO 3166 format](http://en.wikipedia.org/wiki/ISO_3166)." ;
    skos:definition "The regions where the media is allowed. If not specified, then it's assumed to be allowed everywhere. Specify the countries in [ISO 3166 format](http://en.wikipedia.org/wiki/ISO_3166)." .

:relatedAnatomy a owl:ObjectProperty ;
    rdfs:label "relatedAnatomy" ;
    :domainIncludes :SuperficialAnatomy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure,
        :AnatomicalSystem ;
    rdfs:comment "Anatomical systems or structures that relate to the superficial anatomy." ;
    skos:definition "Anatomical systems or structures that relate to the superficial anatomy." .

:relatedCondition a owl:ObjectProperty ;
    rdfs:label "relatedCondition" ;
    :domainIncludes :AnatomicalStructure,
        :AnatomicalSystem,
        :SuperficialAnatomy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalCondition ;
    rdfs:comment "A medical condition associated with this anatomy." ;
    skos:definition "A medical condition associated with this anatomy." .

:relatedDrug a owl:ObjectProperty ;
    rdfs:label "relatedDrug" ;
    :domainIncludes :Drug ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Drug ;
    rdfs:comment "Any other drug related to this one, for example commonly-prescribed alternatives." ;
    skos:definition "Any other drug related to this one, for example commonly-prescribed alternatives." .

:relatedLink a owl:DatatypeProperty ;
    rdfs:label "relatedLink" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :URL ;
    rdfs:comment "A link related to this web page, for example to other related web pages." ;
    skos:definition "A link related to this web page, for example to other related web pages." .

:relatedStructure a owl:ObjectProperty ;
    rdfs:label "relatedStructure" ;
    :domainIncludes :AnatomicalSystem ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure ;
    rdfs:comment "Related anatomical structure(s) that are not part of the system but relate or connect to it, such as vascular bundles associated with an organ system." ;
    skos:definition "Related anatomical structure(s) that are not part of the system but relate or connect to it, such as vascular bundles associated with an organ system." .

:relatedTherapy a owl:ObjectProperty ;
    rdfs:label "relatedTherapy" ;
    :domainIncludes :AnatomicalStructure,
        :AnatomicalSystem,
        :SuperficialAnatomy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalTherapy ;
    rdfs:comment "A medical therapy related to this anatomy." ;
    skos:definition "A medical therapy related to this anatomy." .

:relatedTo a owl:ObjectProperty ;
    rdfs:label "relatedTo" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "The most generic familial relation." ;
    skos:definition "The most generic familial relation." .

:releaseDate a owl:DatatypeProperty ;
    rdfs:label "releaseDate" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Product ;
    :rangeIncludes :Date ;
    rdfs:comment "The release date of a product or product model. This can be used to distinguish the exact variant of a product." ;
    owl:equivalentProperty unece:ProductAvailabilityDate ;
    skos:definition "The release date of a product or product model. This can be used to distinguish the exact variant of a product." .

:releaseNotes a owl:DatatypeProperty ;
    rdfs:label "releaseNotes" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment "Description of what changed in this version." ;
    skos:definition "Description of what changed in this version." .

:releasedEvent a owl:ObjectProperty ;
    rdfs:label "releasedEvent" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :PublicationEvent ;
    rdfs:comment "The place and time the release was issued, expressed as a PublicationEvent." ;
    skos:definition "The place and time the release was issued, expressed as a PublicationEvent." .

:relevantOccupation a owl:ObjectProperty ;
    rdfs:label "relevantOccupation" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Occupation ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "The Occupation for the JobPosting." ;
    skos:definition "The Occupation for the JobPosting." .

:relevantSpecialty a owl:ObjectProperty ;
    rdfs:label "relevantSpecialty" ;
    :domainIncludes :MedicalEntity ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalSpecialty ;
    rdfs:comment "If applicable, a medical specialty in which this entity is relevant." ;
    skos:definition "If applicable, a medical specialty in which this entity is relevant." .

:remainingAttendeeCapacity a owl:DatatypeProperty ;
    rdfs:label "remainingAttendeeCapacity" ;
    :domainIncludes :Event ;
    :rangeIncludes :Integer ;
    rdfs:comment "The number of attendee places for an event that remain unallocated." ;
    skos:definition "The number of attendee places for an event that remain unallocated." .

:renegotiableLoan a owl:DatatypeProperty ;
    rdfs:label "renegotiableLoan" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Boolean ;
    :source <https://github.com/schemaorg/schemaorg/issues/1253> ;
    rdfs:comment "Whether the terms for payment of interest can be renegotiated during the life of the loan." ;
    skos:definition "Whether the terms for payment of interest can be renegotiated during the life of the loan." .

:repeatCount a owl:DatatypeProperty ;
    rdfs:label "repeatCount" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Integer ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment "Defines the number of times a recurring [[Event]] will take place." ;
    skos:definition "Defines the number of times a recurring [[Event]] will take place." .

:repeatFrequency a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "repeatFrequency" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Duration,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment """Defines the frequency at which [[Event]]s will occur according to a schedule [[Schedule]]. The intervals between
      events should be defined as a [[Duration]] of time.""" ;
    rdfs:subPropertyOf :frequency ;
    skos:definition """Defines the frequency at which [[Event]]s will occur according to a schedule [[Schedule]]. The intervals between
      events should be defined as a [[Duration]] of time.""" .

:repetitions a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "repetitions" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "Number of times one should repeat the activity." ;
    skos:definition "Number of times one should repeat the activity." .

:replacee a owl:ObjectProperty ;
    rdfs:label "replacee" ;
    :domainIncludes :ReplaceAction ;
    :rangeIncludes :Thing ;
    rdfs:comment "A sub property of object. The object that is being replaced." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The object that is being replaced." .

:replacer a owl:ObjectProperty ;
    rdfs:label "replacer" ;
    :domainIncludes :ReplaceAction ;
    :rangeIncludes :Thing ;
    rdfs:comment "A sub property of object. The object that replaces." ;
    rdfs:subPropertyOf :object ;
    skos:definition "A sub property of object. The object that replaces." .

:replyToUrl a owl:DatatypeProperty ;
    rdfs:label "replyToUrl" ;
    :domainIncludes :UserComments ;
    :rangeIncludes :URL ;
    rdfs:comment "The URL at which a reply may be posted to the specified UserComment." ;
    skos:definition "The URL at which a reply may be posted to the specified UserComment." .

:reportNumber a owl:DatatypeProperty ;
    rdfs:label "reportNumber" ;
    :domainIncludes :Report ;
    :rangeIncludes :Text ;
    rdfs:comment "The number or other unique designator assigned to a Report by the publishing organization." ;
    skos:definition "The number or other unique designator assigned to a Report by the publishing organization." .

:representativeOfPage a owl:DatatypeProperty ;
    rdfs:label "representativeOfPage" ;
    :domainIncludes :ImageObject ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Indicates whether this image is representative of the content of the page." ;
    skos:definition "Indicates whether this image is representative of the content of the page." .

:requiredCollateral a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "requiredCollateral" ;
    :contributor <http://schema.org/docs/collab/FIBO> ;
    :domainIncludes :LoanOrCredit ;
    :rangeIncludes :Text,
        :Thing ;
    rdfs:comment "Assets required to secure loan or credit repayments. It may take form of third party pledge, goods, financial instruments (cash, securities, etc.)" ;
    skos:definition "Assets required to secure loan or credit repayments. It may take form of third party pledge, goods, financial instruments (cash, securities, etc.)" .

:requiredGender a owl:DatatypeProperty ;
    rdfs:label "requiredGender" ;
    :domainIncludes :PeopleAudience ;
    :rangeIncludes :Text ;
    rdfs:comment "Audiences defined by a person's gender." ;
    skos:definition "Audiences defined by a person's gender." .

:requiredMaxAge a owl:DatatypeProperty ;
    rdfs:label "requiredMaxAge" ;
    :domainIncludes :PeopleAudience ;
    :rangeIncludes :Integer ;
    rdfs:comment "Audiences defined by a person's maximum age." ;
    skos:definition "Audiences defined by a person's maximum age." .

:requiredMinAge a owl:DatatypeProperty ;
    rdfs:label "requiredMinAge" ;
    :domainIncludes :PeopleAudience ;
    :rangeIncludes :Integer ;
    rdfs:comment "Audiences defined by a person's minimum age." ;
    skos:definition "Audiences defined by a person's minimum age." .

:requiredQuantity a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "requiredQuantity" ;
    :domainIncludes :HowToItem ;
    :rangeIncludes :Number,
        :QuantitativeValue,
        :Text ;
    rdfs:comment "The required quantity of the item(s)." ;
    skos:definition "The required quantity of the item(s)." .

:requirements a owl:DatatypeProperty ;
    rdfs:label "requirements" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text,
        :URL ;
    :supersededBy :softwareRequirements ;
    rdfs:comment "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime)." ;
    skos:definition "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (examples: DirectX, Java or .NET runtime)." .

:requiresSubscription a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "requiresSubscription" ;
    :domainIncludes :ActionAccessSpecification,
        :MediaObject ;
    :rangeIncludes :Boolean,
        :MediaSubscription ;
    :source <https://github.com/schemaorg/schemaorg/issues/1741> ;
    rdfs:comment "Indicates if use of the media require a subscription  (either paid or free). Allowed values are ```true``` or ```false``` (note that an earlier version had 'yes', 'no')." ;
    skos:definition "Indicates if use of the media require a subscription  (either paid or free). Allowed values are ```true``` or ```false``` (note that an earlier version had 'yes', 'no')." .

:reservationFor a owl:ObjectProperty ;
    rdfs:label "reservationFor" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :Thing ;
    rdfs:comment "The thing -- flight, event, restaurant, etc. being reserved." ;
    skos:definition "The thing -- flight, event, restaurant, etc. being reserved." .

:reservationId a owl:DatatypeProperty ;
    rdfs:label "reservationId" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :Text ;
    rdfs:comment "A unique identifier for the reservation." ;
    skos:definition "A unique identifier for the reservation." .

:reservationStatus a owl:ObjectProperty ;
    rdfs:label "reservationStatus" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :ReservationStatusType ;
    rdfs:comment "The current status of the reservation." ;
    skos:definition "The current status of the reservation." .

:reservedTicket a owl:ObjectProperty ;
    rdfs:label "reservedTicket" ;
    :domainIncludes :Reservation ;
    :rangeIncludes :Ticket ;
    rdfs:comment "A ticket associated with the reservation." ;
    skos:definition "A ticket associated with the reservation." .

:responsibilities a owl:DatatypeProperty ;
    rdfs:label "responsibilities" ;
    :domainIncludes :JobPosting,
        :Occupation ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698> ;
    rdfs:comment "Responsibilities associated with this role or Occupation." ;
    skos:definition "Responsibilities associated with this role or Occupation." .

:restPeriods a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "restPeriods" ;
    :domainIncludes :ExercisePlan ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :QuantitativeValue,
        :Text ;
    rdfs:comment "How often one should break from the activity." ;
    skos:definition "How often one should break from the activity." .

:restockingFee a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "restockingFee" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "Use [[MonetaryAmount]] to specify a fixed restocking fee for product returns, or use [[Number]] to specify a percentage of the product price paid by the customer." ;
    skos:definition "Use [[MonetaryAmount]] to specify a fixed restocking fee for product returns, or use [[Number]] to specify a percentage of the product price paid by the customer." .

:resultComment a owl:ObjectProperty ;
    rdfs:label "resultComment" ;
    :domainIncludes :CommentAction,
        :ReplyAction ;
    :rangeIncludes :Comment ;
    rdfs:comment "A sub property of result. The Comment created or sent as a result of this action." ;
    rdfs:subPropertyOf :result ;
    skos:definition "A sub property of result. The Comment created or sent as a result of this action." .

:resultReview a owl:ObjectProperty ;
    rdfs:label "resultReview" ;
    :domainIncludes :ReviewAction ;
    :rangeIncludes :Review ;
    rdfs:comment "A sub property of result. The review that resulted in the performing of the action." ;
    rdfs:subPropertyOf :result ;
    skos:definition "A sub property of result. The review that resulted in the performing of the action." .

:returnFees a owl:ObjectProperty ;
    rdfs:label "returnFees" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ReturnFeesEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2288> ;
    rdfs:comment "The type of return fees for purchased products (for any return reason)." ;
    skos:definition "The type of return fees for purchased products (for any return reason)." .

:returnLabelSource a owl:ObjectProperty ;
    rdfs:label "returnLabelSource" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ReturnLabelSourceEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "The method (from an enumeration) by which the customer obtains a return shipping label for a product returned for any reason." ;
    skos:definition "The method (from an enumeration) by which the customer obtains a return shipping label for a product returned for any reason." .

:returnMethod a owl:ObjectProperty ;
    rdfs:label "returnMethod" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ReturnMethodEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "The type of return method offered, specified from an enumeration." ;
    skos:definition "The type of return method offered, specified from an enumeration." .

:returnPolicyCategory a owl:ObjectProperty ;
    rdfs:label "returnPolicyCategory" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MerchantReturnEnumeration ;
    :source <https://github.com/schemaorg/schemaorg/issues/2288> ;
    rdfs:comment "Specifies an applicable return policy (from an enumeration)." ;
    skos:definition "Specifies an applicable return policy (from an enumeration)." .

:returnPolicyCountry a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "returnPolicyCountry" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Country,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "The country where the product has to be sent to for returns, for example \"Ireland\" using the [[name]] property of [[Country]]. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1). Note that this can be different from the country where the product was originally shipped from or sent to." ;
    skos:definition "The country where the product has to be sent to for returns, for example \"Ireland\" using the [[name]] property of [[Country]]. You can also provide the two-letter [ISO 3166-1 alpha-2 country code](http://en.wikipedia.org/wiki/ISO_3166-1). Note that this can be different from the country where the product was originally shipped from or sent to." .

:returnPolicySeasonalOverride a owl:ObjectProperty ;
    rdfs:label "returnPolicySeasonalOverride" ;
    :domainIncludes :MerchantReturnPolicy ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MerchantReturnPolicySeasonalOverride ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "Seasonal override of a return policy." ;
    skos:definition "Seasonal override of a return policy." .

:returnShippingFeesAmount a owl:ObjectProperty ;
    rdfs:label "returnShippingFeesAmount" ;
    :domainIncludes :MerchantReturnPolicy,
        :MerchantReturnPolicySeasonalOverride ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmount ;
    :source <https://github.com/schemaorg/schemaorg/issues/2880> ;
    rdfs:comment "Amount of shipping costs for product returns (for any reason). Applicable when property [[returnFees]] equals [[ReturnShippingFees]]." ;
    skos:definition "Amount of shipping costs for product returns (for any reason). Applicable when property [[returnFees]] equals [[ReturnShippingFees]]." .

:reviewAspect a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "reviewAspect" ;
    :domainIncludes :Guide,
        :Rating,
        :Review ;
    :rangeIncludes :StructuredValue,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1689> ;
    rdfs:comment "This Review or Rating is relevant to this part or facet of the itemReviewed." ;
    skos:definition "This Review or Rating is relevant to this part or facet of the itemReviewed." .

:reviewBody a owl:DatatypeProperty ;
    rdfs:label "reviewBody" ;
    :domainIncludes :Review ;
    :rangeIncludes :Text ;
    rdfs:comment "The actual body of the review." ;
    skos:definition "The actual body of the review." .

:reviewCount a owl:DatatypeProperty ;
    rdfs:label "reviewCount" ;
    :domainIncludes :AggregateRating ;
    :rangeIncludes :Integer ;
    rdfs:comment "The count of total number of reviews." ;
    skos:definition "The count of total number of reviews." .

:reviewRating a owl:ObjectProperty ;
    rdfs:label "reviewRating" ;
    :domainIncludes :Review ;
    :rangeIncludes :Rating ;
    rdfs:comment "The rating given in this review. Note that reviews can themselves be rated. The ```reviewRating``` applies to rating given by the review. The [[aggregateRating]] property applies to the review itself, as a creative work." ;
    skos:definition "The rating given in this review. Note that reviews can themselves be rated. The ```reviewRating``` applies to rating given by the review. The [[aggregateRating]] property applies to the review itself, as a creative work." .

:reviewedBy a owl:ObjectProperty ;
    rdfs:label "reviewedBy" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :Organization,
        :Person ;
    rdfs:comment "People or organizations that have reviewed the content on this web page for accuracy and/or completeness." ;
    skos:definition "People or organizations that have reviewed the content on this web page for accuracy and/or completeness." .

:reviews a owl:ObjectProperty ;
    rdfs:label "reviews" ;
    :domainIncludes :CreativeWork,
        :Offer,
        :Organization,
        :Place,
        :Product ;
    :rangeIncludes :Review ;
    :supersededBy :review ;
    rdfs:comment "Review of the item." ;
    skos:definition "Review of the item." .

:riskFactor a owl:ObjectProperty ;
    rdfs:label "riskFactor" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalRiskFactor ;
    rdfs:comment "A modifiable or non-modifiable factor that increases the risk of a patient contracting this condition, e.g. age,  coexisting condition." ;
    skos:definition "A modifiable or non-modifiable factor that increases the risk of a patient contracting this condition, e.g. age,  coexisting condition." .

:risks a owl:DatatypeProperty ;
    rdfs:label "risks" ;
    :domainIncludes :Diet ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Specific physiologic risks associated to the diet plan." ;
    skos:definition "Specific physiologic risks associated to the diet plan." .

:roofLoad a owl:ObjectProperty ;
    rdfs:label "roofLoad" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :BusOrCoach,
        :Car ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The permitted total weight of cargo and installations (e.g. a roof rack) on top of the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]]\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." ;
    skos:definition "The permitted total weight of cargo and installations (e.g. a roof rack) on top of the vehicle.\\n\\nTypical unit code(s): KGM for kilogram, LBR for pound\\n\\n* Note 1: You can indicate additional information in the [[name]] of the [[QuantitativeValue]] node.\\n* Note 2: You may also link to a [[QualitativeValue]] node that provides additional information using [[valueReference]]\\n* Note 3: Note that you can use [[minValue]] and [[maxValue]] to indicate ranges." .

:rsvpResponse a owl:ObjectProperty ;
    rdfs:label "rsvpResponse" ;
    :domainIncludes :RsvpAction ;
    :rangeIncludes :RsvpResponseType ;
    rdfs:comment "The response (yes, no, maybe) to the RSVP." ;
    skos:definition "The response (yes, no, maybe) to the RSVP." .

:runsTo a owl:ObjectProperty ;
    rdfs:label "runsTo" ;
    :domainIncludes :LymphaticVessel ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Vessel ;
    rdfs:comment "The vasculature the lymphatic structure runs, or efferents, to." ;
    skos:definition "The vasculature the lymphatic structure runs, or efferents, to." .

:runtime a owl:DatatypeProperty ;
    rdfs:label "runtime" ;
    :domainIncludes :SoftwareSourceCode ;
    :rangeIncludes :Text ;
    :supersededBy :runtimePlatform ;
    rdfs:comment "Runtime platform or script interpreter dependencies (example: Java v1, Python 2.3, .NET Framework 3.0)." ;
    skos:definition "Runtime platform or script interpreter dependencies (example: Java v1, Python 2.3, .NET Framework 3.0)." .

:rxcui a owl:DatatypeProperty ;
    rdfs:label "rxcui" ;
    :domainIncludes :Drug ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1062> ;
    rdfs:comment "The RxCUI drug identifier from RXNORM." ;
    skos:definition "The RxCUI drug identifier from RXNORM." .

:safetyConsideration a owl:DatatypeProperty ;
    rdfs:label "safetyConsideration" ;
    :domainIncludes :DietarySupplement ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "Any potential safety concern associated with the supplement. May include interactions with other drugs and foods, pregnancy, breastfeeding, known adverse reactions, and documented efficacy of the supplement." ;
    skos:definition "Any potential safety concern associated with the supplement. May include interactions with other drugs and foods, pregnancy, breastfeeding, known adverse reactions, and documented efficacy of the supplement." .

:salaryCurrency a owl:DatatypeProperty ;
    rdfs:label "salaryCurrency" ;
    :domainIncludes :EmployeeRole,
        :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "The currency (coded using [ISO 4217](http://en.wikipedia.org/wiki/ISO_4217)) used for the main salary information in this job posting or for this employee." ;
    skos:definition "The currency (coded using [ISO 4217](http://en.wikipedia.org/wiki/ISO_4217)) used for the main salary information in this job posting or for this employee." .

:salaryUponCompletion a owl:ObjectProperty ;
    rdfs:label "salaryUponCompletion" ;
    :domainIncludes :EducationalOccupationalProgram ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :MonetaryAmountDistribution ;
    :source <https://github.com/schemaorg/schemaorg/issues/2289> ;
    rdfs:comment "The expected salary upon completing the training." ;
    skos:definition "The expected salary upon completing the training." .

:sameAs a owl:DatatypeProperty ;
    rdfs:label "sameAs" ;
    :domainIncludes :Thing ;
    :rangeIncludes :URL ;
    rdfs:comment "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website." ;
    skos:definition "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website." .

:sampleType a owl:DatatypeProperty ;
    rdfs:label "sampleType" ;
    :domainIncludes :SoftwareSourceCode ;
    :rangeIncludes :Text ;
    :supersededBy :codeSampleType ;
    rdfs:comment "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." ;
    skos:definition "What type of code sample: full (compile ready) solution, code snippet, inline code, scripts, template." .

:saturatedFatContent a owl:ObjectProperty ;
    rdfs:label "saturatedFatContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of grams of saturated fat." ;
    skos:definition "The number of grams of saturated fat." .

:scheduleTimezone a owl:DatatypeProperty ;
    rdfs:label "scheduleTimezone" ;
    :domainIncludes :Schedule ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1457> ;
    rdfs:comment "Indicates the timezone for which the time(s) indicated in the [[Schedule]] are given. The value provided should be among those listed in the IANA Time Zone Database." ;
    skos:definition "Indicates the timezone for which the time(s) indicated in the [[Schedule]] are given. The value provided should be among those listed in the IANA Time Zone Database." .

:scheduledPaymentDate a owl:DatatypeProperty ;
    rdfs:label "scheduledPaymentDate" ;
    :domainIncludes :Invoice ;
    :rangeIncludes :Date ;
    rdfs:comment "The date the invoice is scheduled to be paid." ;
    skos:definition "The date the invoice is scheduled to be paid." .

:scheduledTime a owl:DatatypeProperty ;
    rdfs:label "scheduledTime" ;
    :domainIncludes :PlanAction ;
    :rangeIncludes :Date,
        :DateTime ;
    rdfs:comment "The time the object is scheduled to." ;
    skos:definition "The time the object is scheduled to." .

:schemaVersion a owl:DatatypeProperty ;
    rdfs:label "schemaVersion" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Text,
        :URL ;
    rdfs:comment """Indicates (by URL or string) a particular version of a schema used in some CreativeWork. This property was created primarily to
    indicate the use of a specific schema.org release, e.g. ```10.0``` as a simple string, or more explicitly via URL, ```http://schema.org/docs/releases.html#v10.0```. There may be situations in which other schemas might usefully be referenced this way, e.g. ```http://dublincore.org/specifications/dublin-core/dces/1999-07-02/``` but this has not been carefully explored in the community.""" ;
    skos:definition """Indicates (by URL or string) a particular version of a schema used in some CreativeWork. This property was created primarily to
    indicate the use of a specific schema.org release, e.g. ```10.0``` as a simple string, or more explicitly via URL, ```http://schema.org/docs/releases.html#v10.0```. There may be situations in which other schemas might usefully be referenced this way, e.g. ```http://dublincore.org/specifications/dublin-core/dces/1999-07-02/``` but this has not been carefully explored in the community.""" .

:schoolClosuresInfo a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "schoolClosuresInfo" ;
    :domainIncludes :SpecialAnnouncement ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :URL,
        :WebContent ;
    :source <https://github.com/schemaorg/schemaorg/issues/2490> ;
    rdfs:comment "Information about school closures." ;
    skos:definition "Information about school closures." .

:screenCount a owl:DatatypeProperty ;
    rdfs:label "screenCount" ;
    :domainIncludes :MovieTheater ;
    :rangeIncludes :Number ;
    rdfs:comment "The number of screens in the movie theater." ;
    skos:definition "The number of screens in the movie theater." .

:screenshot a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "screenshot" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :ImageObject,
        :URL ;
    rdfs:comment "A link to a screenshot image of the app." ;
    skos:definition "A link to a screenshot image of the app." .

:sdDatePublished a owl:DatatypeProperty ;
    rdfs:label "sdDatePublished" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Date ;
    :source <https://github.com/schemaorg/schemaorg/issues/1886> ;
    rdfs:comment "Indicates the date on which the current structured data was generated / published. Typically used alongside [[sdPublisher]]." ;
    skos:definition "Indicates the date on which the current structured data was generated / published. Typically used alongside [[sdPublisher]]." .

:sdLicense a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "sdLicense" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :CreativeWork,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1886> ;
    rdfs:comment "A license document that applies to this structured data, typically indicated by URL." ;
    skos:definition "A license document that applies to this structured data, typically indicated by URL." .

:sdPublisher a owl:ObjectProperty ;
    rdfs:label "sdPublisher" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/1886> ;
    rdfs:comment """Indicates the party responsible for generating and publishing the current structured data markup, typically in cases where the structured data is derived automatically from existing published content but published on a different site. For example, student projects and open data initiatives often re-publish existing content with more explicitly structured metadata. The
[[sdPublisher]] property helps make such practices more explicit.""" ;
    skos:definition """Indicates the party responsible for generating and publishing the current structured data markup, typically in cases where the structured data is derived automatically from existing published content but published on a different site. For example, student projects and open data initiatives often re-publish existing content with more explicitly structured metadata. The
[[sdPublisher]] property helps make such practices more explicit.""" .

:seasonNumber a owl:DatatypeProperty ;
    rdfs:label "seasonNumber" ;
    :domainIncludes :CreativeWorkSeason ;
    :rangeIncludes :Integer,
        :Text ;
    rdfs:comment "Position of the season within an ordered group of seasons." ;
    rdfs:subPropertyOf :position ;
    skos:definition "Position of the season within an ordered group of seasons." .

:seasonalOverride a owl:ObjectProperty ;
    rdfs:label "seasonalOverride" ;
    :domainIncludes :ShippingConditions ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :OpeningHoursSpecification ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Limited period during which these shipping conditions apply." ;
    skos:definition "Limited period during which these shipping conditions apply." .

:seasons a owl:ObjectProperty ;
    rdfs:label "seasons" ;
    :domainIncludes :RadioSeries,
        :TVSeries,
        :VideoGameSeries ;
    :rangeIncludes :CreativeWorkSeason ;
    :supersededBy :season ;
    rdfs:comment "A season in a media series." ;
    skos:definition "A season in a media series." .

:seatNumber a owl:DatatypeProperty ;
    rdfs:label "seatNumber" ;
    :domainIncludes :Seat ;
    :rangeIncludes :Text ;
    rdfs:comment "The location of the reserved seat (e.g., 27)." ;
    skos:definition "The location of the reserved seat (e.g., 27)." .

:seatRow a owl:DatatypeProperty ;
    rdfs:label "seatRow" ;
    :domainIncludes :Seat ;
    :rangeIncludes :Text ;
    rdfs:comment "The row location of the reserved seat (e.g., B)." ;
    skos:definition "The row location of the reserved seat (e.g., B)." .

:seatSection a owl:DatatypeProperty ;
    rdfs:label "seatSection" ;
    :domainIncludes :Seat ;
    :rangeIncludes :Text ;
    rdfs:comment "The section location of the reserved seat (e.g. Orchestra)." ;
    skos:definition "The section location of the reserved seat (e.g. Orchestra)." .

:seatingCapacity a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "seatingCapacity" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :Number,
        :QuantitativeValue ;
    rdfs:comment "The number of persons that can be seated (e.g. in a vehicle), both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons." ;
    skos:definition "The number of persons that can be seated (e.g. in a vehicle), both in terms of the physical space available, and in terms of limitations set by law.\\n\\nTypical unit code(s): C62 for persons." .

:seatingType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "seatingType" ;
    :domainIncludes :Seat ;
    :rangeIncludes :QualitativeValue,
        :Text ;
    rdfs:comment "The type/class of the seat." ;
    skos:definition "The type/class of the seat." .

:secondaryPrevention a owl:ObjectProperty ;
    rdfs:label "secondaryPrevention" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Drug,
        :DrugClass,
        :LifestyleModification,
        :MedicalTherapy ;
    rdfs:comment "A preventative therapy used to prevent reoccurrence of the medical condition after an initial episode of the condition." ;
    skos:definition "A preventative therapy used to prevent reoccurrence of the medical condition after an initial episode of the condition." .

:securityClearanceRequirement a owl:DatatypeProperty ;
    rdfs:label "securityClearanceRequirement" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2384> ;
    rdfs:comment "A description of any security clearance requirements of the job." ;
    skos:definition "A description of any security clearance requirements of the job." .

:securityScreening a owl:DatatypeProperty ;
    rdfs:label "securityScreening" ;
    :domainIncludes :FlightReservation ;
    :rangeIncludes :Text ;
    rdfs:comment "The type of security screening the passenger is subject to." ;
    skos:definition "The type of security screening the passenger is subject to." .

:seeks a owl:ObjectProperty ;
    rdfs:label "seeks" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Organization,
        :Person ;
    :rangeIncludes :Demand ;
    rdfs:comment "A pointer to products or services sought by the organization or person (demand)." ;
    skos:definition "A pointer to products or services sought by the organization or person (demand)." .

:sender a owl:ObjectProperty ;
    rdfs:label "sender" ;
    :domainIncludes :Message,
        :ReceiveAction ;
    :rangeIncludes :Audience,
        :Organization,
        :Person ;
    rdfs:comment "A sub property of participant. The participant who is at the sending end of the action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The participant who is at the sending end of the action." .

:sensoryRequirement a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "sensoryRequirement" ;
    :domainIncludes :JobPosting ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2384> ;
    rdfs:comment "A description of any sensory requirements and levels necessary to function on the job, including hearing and vision. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." ;
    skos:definition "A description of any sensory requirements and levels necessary to function on the job, including hearing and vision. Defined terms such as those in O*net may be used, but note that there is no way to specify the level of ability as well as its nature when using a defined term." .

:sensoryUnit a owl:ObjectProperty ;
    rdfs:label "sensoryUnit" ;
    :domainIncludes :Nerve ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :AnatomicalStructure,
        :SuperficialAnatomy ;
    rdfs:comment "The neurological pathway extension that inputs and sends information to the brain or spinal cord." ;
    skos:definition "The neurological pathway extension that inputs and sends information to the brain or spinal cord." .

:seriousAdverseOutcome a owl:ObjectProperty ;
    rdfs:label "seriousAdverseOutcome" ;
    :domainIncludes :MedicalDevice,
        :MedicalTherapy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalEntity ;
    rdfs:comment "A possible serious complication and/or serious side effect of this therapy. Serious adverse outcomes include those that are life-threatening; result in death, disability, or permanent damage; require hospitalization or prolong existing hospitalization; cause congenital anomalies or birth defects; or jeopardize the patient and may require medical or surgical intervention to prevent one of the outcomes in this definition." ;
    skos:definition "A possible serious complication and/or serious side effect of this therapy. Serious adverse outcomes include those that are life-threatening; result in death, disability, or permanent damage; require hospitalization or prolong existing hospitalization; cause congenital anomalies or birth defects; or jeopardize the patient and may require medical or surgical intervention to prevent one of the outcomes in this definition." .

:serverStatus a owl:ObjectProperty ;
    rdfs:label "serverStatus" ;
    :domainIncludes :GameServer ;
    :rangeIncludes :GameServerStatus ;
    rdfs:comment "Status of a game server." ;
    skos:definition "Status of a game server." .

:servesCuisine a owl:DatatypeProperty ;
    rdfs:label "servesCuisine" ;
    :domainIncludes :FoodEstablishment ;
    :rangeIncludes :Text ;
    rdfs:comment "The cuisine of the restaurant." ;
    skos:definition "The cuisine of the restaurant." .

:serviceAudience a owl:ObjectProperty ;
    rdfs:label "serviceAudience" ;
    :domainIncludes :Service ;
    :rangeIncludes :Audience ;
    :supersededBy :audience ;
    rdfs:comment "The audience eligible for this service." ;
    skos:definition "The audience eligible for this service." .

:serviceLocation a owl:ObjectProperty ;
    rdfs:label "serviceLocation" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :Place ;
    rdfs:comment "The location (e.g. civic structure, local business, etc.) where a person can go to access the service." ;
    skos:definition "The location (e.g. civic structure, local business, etc.) where a person can go to access the service." .

:serviceOperator a owl:ObjectProperty ;
    rdfs:label "serviceOperator" ;
    :domainIncludes :GovernmentService ;
    :rangeIncludes :Organization ;
    rdfs:comment "The operating organization, if different from the provider.  This enables the representation of services that are provided by an organization, but operated by another organization like a subcontractor." ;
    skos:definition "The operating organization, if different from the provider.  This enables the representation of services that are provided by an organization, but operated by another organization like a subcontractor." .

:servicePhone a owl:ObjectProperty ;
    rdfs:label "servicePhone" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :ContactPoint ;
    rdfs:comment "The phone number to use to access the service." ;
    rdfs:subPropertyOf cmns-loc:hasAddress ;
    skos:definition "The phone number to use to access the service." .

:servicePostalAddress a owl:ObjectProperty ;
    rdfs:label "servicePostalAddress" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :PostalAddress ;
    rdfs:comment "The address for accessing the service by mail." ;
    rdfs:subPropertyOf cmns-loc:hasAddress ;
    skos:definition "The address for accessing the service by mail." .

:serviceSmsNumber a owl:ObjectProperty ;
    rdfs:label "serviceSmsNumber" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :ContactPoint ;
    rdfs:comment "The number to access the service by text message." ;
    rdfs:subPropertyOf cmns-loc:hasAddress ;
    skos:definition "The number to access the service by text message." .

:serviceType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "serviceType" ;
    :domainIncludes :Service ;
    :rangeIncludes :GovernmentBenefitsType,
        :Text ;
    rdfs:comment "The type of service being offered, e.g. veterans' benefits, emergency relief, etc." ;
    skos:definition "The type of service being offered, e.g. veterans' benefits, emergency relief, etc." .

:serviceUrl a owl:DatatypeProperty ;
    rdfs:label "serviceUrl" ;
    :domainIncludes :ServiceChannel ;
    :rangeIncludes :URL ;
    rdfs:comment "The website to access the service." ;
    skos:definition "The website to access the service." .

:servingSize a owl:DatatypeProperty ;
    rdfs:label "servingSize" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Text ;
    rdfs:comment "The serving size, in terms of the number of volume or mass." ;
    skos:definition "The serving size, in terms of the number of volume or mass." .

:sha256 a owl:DatatypeProperty ;
    rdfs:label "sha256" ;
    :domainIncludes :MediaObject ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2450> ;
    rdfs:comment "The [SHA-2](https://en.wikipedia.org/wiki/SHA-2) SHA256 hash of the content of the item. For example, a zero-length input has value 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'." ;
    rdfs:subPropertyOf :description ;
    skos:definition "The [SHA-2](https://en.wikipedia.org/wiki/SHA-2) SHA256 hash of the content of the item. For example, a zero-length input has value 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'." .

:sharedContent a owl:ObjectProperty ;
    rdfs:label "sharedContent" ;
    :domainIncludes :Comment,
        :SocialMediaPosting ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "A CreativeWork such as an image, video, or audio clip shared as part of this posting." ;
    skos:definition "A CreativeWork such as an image, video, or audio clip shared as part of this posting." .

:shippingConditions a owl:ObjectProperty ;
    rdfs:label "shippingConditions" ;
    :domainIncludes :ShippingService ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :ShippingConditions ;
    :source <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The conditions (constraints, price) applicable to the [[ShippingService]]." ;
    skos:definition "The conditions (constraints, price) applicable to the [[ShippingService]]." .

:shippingDestination a owl:ObjectProperty ;
    rdfs:label "shippingDestination" ;
    :domainIncludes :OfferShippingDetails,
        :ShippingConditions,
        :ShippingRateSettings ;
    :rangeIncludes :DefinedRegion ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "indicates (possibly multiple) shipping destinations. These can be defined in several ways, e.g. postalCode ranges." ;
    skos:definition "indicates (possibly multiple) shipping destinations. These can be defined in several ways, e.g. postalCode ranges." .

:shippingDetails a owl:ObjectProperty ;
    rdfs:label "shippingDetails" ;
    :domainIncludes :Offer ;
    :rangeIncludes :OfferShippingDetails ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "Indicates information about the shipping policies and options associated with an [[Offer]]." ;
    skos:definition "Indicates information about the shipping policies and options associated with an [[Offer]]." .

:shippingOrigin a owl:ObjectProperty ;
    rdfs:label "shippingOrigin" ;
    :domainIncludes :OfferShippingDetails,
        :ShippingConditions ;
    :rangeIncludes :DefinedRegion ;
    :source <https://github.com/schemaorg/schemaorg/issues/3122>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "Indicates the origin of a shipment, i.e. where it should be coming from." ;
    rdfs:subPropertyOf cmns-loc:hasLocation ;
    owl:equivalentProperty unece:DespatchLocation ;
    skos:definition "Indicates the origin of a shipment, i.e. where it should be coming from." .

:shippingRate a owl:ObjectProperty ;
    rdfs:label "shippingRate" ;
    :domainIncludes :OfferShippingDetails,
        :ShippingConditions,
        :ShippingRateSettings ;
    :rangeIncludes :MonetaryAmount,
        :ShippingRateSettings ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506>,
        <https://github.com/schemaorg/schemaorg/issues/3617> ;
    rdfs:comment "The shipping rate is the cost of shipping to the specified destination. Typically, the maxValue and currency values (of the [[MonetaryAmount]]) are most appropriate." ;
    skos:definition "The shipping rate is the cost of shipping to the specified destination. Typically, the maxValue and currency values (of the [[MonetaryAmount]]) are most appropriate." .

:siblings a owl:ObjectProperty ;
    rdfs:label "siblings" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    :supersededBy :sibling ;
    rdfs:comment "A sibling of the person." ;
    skos:definition "A sibling of the person." .

:signDetected a owl:ObjectProperty ;
    rdfs:label "signDetected" ;
    :domainIncludes :MedicalTest ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalSign ;
    rdfs:comment "A sign detected by the test." ;
    skos:definition "A sign detected by the test." .

:signOrSymptom a owl:ObjectProperty ;
    rdfs:label "signOrSymptom" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalSignOrSymptom ;
    rdfs:comment "A sign or symptom of this condition. Signs are objective or physically observable manifestations of the medical condition while symptoms are the subjective experience of the medical condition." ;
    skos:definition "A sign or symptom of this condition. Signs are objective or physically observable manifestations of the medical condition while symptoms are the subjective experience of the medical condition." .

:significance a owl:DatatypeProperty ;
    rdfs:label "significance" ;
    :domainIncludes :SuperficialAnatomy ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Text ;
    rdfs:comment "The significance associated with the superficial anatomy; as an example, how characteristics of the superficial anatomy can suggest underlying medical conditions or courses of treatment." ;
    skos:definition "The significance associated with the superficial anatomy; as an example, how characteristics of the superficial anatomy can suggest underlying medical conditions or courses of treatment." .

:significantLinks a owl:DatatypeProperty ;
    rdfs:label "significantLinks" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :URL ;
    :supersededBy :significantLink ;
    rdfs:comment "The most significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." ;
    skos:definition "The most significant URLs on the page. Typically, these are the non-navigation links that are clicked on the most." .

:size a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "size" ;
    :domainIncludes :CreativeWork,
        :Product ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :DefinedTerm,
        :QuantitativeValue,
        :SizeSpecification,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1797> ;
    rdfs:comment "A standardized size of a product or creative work, specified either through a simple textual string (for example 'XL', '32Wx34L'), a  QuantitativeValue with a unitCode, or a comprehensive and structured [[SizeSpecification]]; in other cases, the [[width]], [[height]], [[depth]] and [[weight]] properties may be more applicable. " ;
    owl:equivalentProperty unece:sizeDescription ;
    skos:definition "A standardized size of a product or creative work, specified either through a simple textual string (for example 'XL', '32Wx34L'), a  QuantitativeValue with a unitCode, or a comprehensive and structured [[SizeSpecification]]; in other cases, the [[width]], [[height]], [[depth]] and [[weight]] properties may be more applicable. " .

:sizeGroup a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "sizeGroup" ;
    :domainIncludes :SizeSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :SizeGroupEnumeration,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "The size group (also known as \"size type\") for a product's size. Size groups are common in the fashion industry to define size segments and suggested audiences for wearable products. Multiple values can be combined, for example \"men's big and tall\", \"petite maternity\" or \"regular\"." ;
    skos:definition "The size group (also known as \"size type\") for a product's size. Size groups are common in the fashion industry to define size segments and suggested audiences for wearable products. Multiple values can be combined, for example \"men's big and tall\", \"petite maternity\" or \"regular\"." .

:sizeSystem a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "sizeSystem" ;
    :domainIncludes :SizeSpecification ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :SizeSystemEnumeration,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2811> ;
    rdfs:comment "The size system used to identify a product's size. Typically either a standard (for example, \"GS1\" or \"ISO-EN13402\"), country code (for example \"US\" or \"JP\"), or a measuring system (for example \"Metric\" or \"Imperial\")." ;
    skos:definition "The size system used to identify a product's size. Typically either a standard (for example, \"GS1\" or \"ISO-EN13402\"), country code (for example \"US\" or \"JP\"), or a measuring system (for example \"Metric\" or \"Imperial\")." .

:skills a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "skills" ;
    :domainIncludes :JobPosting,
        :Occupation,
        :Organization,
        :Person ;
    :rangeIncludes :DefinedTerm,
        :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/1698>,
        <https://github.com/schemaorg/schemaorg/issues/2322> ;
    rdfs:comment "A statement of knowledge, skill, ability, task or any other assertion expressing a competency that is either claimed by a person, an organization or desired or required to fulfill a role or to work in an occupation." ;
    skos:definition "A statement of knowledge, skill, ability, task or any other assertion expressing a competency that is either claimed by a person, an organization or desired or required to fulfill a role or to work in an occupation." .

:sku a owl:DatatypeProperty ;
    rdfs:label "sku" ;
    :contributor <http://schema.org/docs/collab/GoodRelationsTerms> ;
    :domainIncludes :Demand,
        :Offer,
        :Product ;
    :rangeIncludes :Text ;
    rdfs:comment "The Stock Keeping Unit (SKU), i.e. a merchant-specific identifier for a product or service, or the product to which the offer refers." ;
    rdfs:subPropertyOf :identifier ;
    owl:equivalentProperty unece:sellerAssignedId ;
    skos:definition "The Stock Keeping Unit (SKU), i.e. a merchant-specific identifier for a product or service, or the product to which the offer refers." .

:slogan a owl:DatatypeProperty ;
    rdfs:label "slogan" ;
    :domainIncludes :Brand,
        :Organization,
        :Place,
        :Product,
        :Service ;
    :rangeIncludes :Text ;
    rdfs:comment "A slogan or motto associated with the item." ;
    owl:equivalentProperty unece:PromotionalMessage ;
    skos:definition "A slogan or motto associated with the item." .

:smiles a owl:DatatypeProperty ;
    rdfs:label "smiles" ;
    :domainIncludes :MolecularEntity ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <http://www.bioschemas.org/MolecularEntity> ;
    rdfs:comment "A specification in form of a line notation for describing the structure of chemical species using short ASCII strings.  Double bond stereochemistry \\ indicators may need to be escaped in the string in formats where the backslash is an escape character." ;
    rdfs:subPropertyOf :hasRepresentation ;
    skos:definition "A specification in form of a line notation for describing the structure of chemical species using short ASCII strings.  Double bond stereochemistry \\ indicators may need to be escaped in the string in formats where the backslash is an escape character." .

:smokingAllowed a owl:DatatypeProperty ;
    rdfs:label "smokingAllowed" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :Place ;
    :rangeIncludes :Boolean ;
    rdfs:comment "Indicates whether it is allowed to smoke in the place, e.g. in the restaurant, hotel or hotel room." ;
    skos:definition "Indicates whether it is allowed to smoke in the place, e.g. in the restaurant, hotel or hotel room." .

:sodiumContent a owl:ObjectProperty ;
    rdfs:label "sodiumContent" ;
    :domainIncludes :NutritionInformation ;
    :rangeIncludes :Mass ;
    rdfs:comment "The number of milligrams of sodium." ;
    skos:definition "The number of milligrams of sodium." .

:softwareAddOn a owl:ObjectProperty ;
    rdfs:label "softwareAddOn" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :SoftwareApplication ;
    rdfs:comment "Additional content for a software application." ;
    skos:definition "Additional content for a software application." .

:softwareHelp a owl:ObjectProperty ;
    rdfs:label "softwareHelp" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :CreativeWork ;
    rdfs:comment "Software application help." ;
    skos:definition "Software application help." .

:softwareVersion a owl:DatatypeProperty ;
    rdfs:label "softwareVersion" ;
    :domainIncludes :SoftwareApplication ;
    :rangeIncludes :Text ;
    rdfs:comment "Version of the software instance." ;
    skos:definition "Version of the software instance." .

:source a owl:ObjectProperty ;
    rdfs:label "source" ;
    :domainIncludes :InstantaneousEvent ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Thing ;
    :source <https://github.com/schemaorg/schemaorg/issues/4527> ;
    rdfs:comment "The source or cause of the event." ;
    skos:definition "The source or cause of the event." .

:sourceOrganization a owl:ObjectProperty ;
    rdfs:label "sourceOrganization" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Organization ;
    rdfs:comment "The Organization on whose behalf the creator was working." ;
    skos:definition "The Organization on whose behalf the creator was working." .

:sourcedFrom a owl:ObjectProperty ;
    rdfs:label "sourcedFrom" ;
    :domainIncludes :Nerve ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :BrainStructure ;
    rdfs:comment "The neurological pathway that originates the neurons." ;
    skos:definition "The neurological pathway that originates the neurons." .

:spatial a owl:ObjectProperty ;
    rdfs:label "spatial" ;
    :domainIncludes :CreativeWork ;
    :rangeIncludes :Place ;
    rdfs:comment """The "spatial" property can be used in cases when more specific properties
(e.g. [[locationCreated]], [[spatialCoverage]], [[contentLocation]]) are not known to be appropriate.""" ;
    owl:equivalentProperty dcterms:spatial ;
    skos:definition """The "spatial" property can be used in cases when more specific properties
(e.g. [[locationCreated]], [[spatialCoverage]], [[contentLocation]]) are not known to be appropriate.""" .

:speakable a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "speakable" ;
    :domainIncludes :Article,
        :WebPage ;
    :rangeIncludes :SpeakableSpecification,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1389> ;
    rdfs:comment """Indicates sections of a Web page that are particularly 'speakable' in the sense of being highlighted as being especially appropriate for text-to-speech conversion. Other sections of a page may also be usefully spoken in particular circumstances; the 'speakable' property serves to indicate the parts most likely to be generally useful for speech.

The *speakable* property can be repeated an arbitrary number of times, with three kinds of possible 'content-locator' values:

1.) *id-value* URL references - uses *id-value* of an element in the page being annotated. The simplest use of *speakable* has (potentially relative) URL values, referencing identified sections of the document concerned.

2.) CSS Selectors - addresses content in the annotated page, e.g. via class attribute. Use the [[cssSelector]] property.

3.)  XPaths - addresses content via XPaths (assuming an XML view of the content). Use the [[xpath]] property.


For more sophisticated markup of speakable sections beyond simple ID references, either CSS selectors or XPath expressions to pick out document section(s) as speakable. For this
we define a supporting type, [[SpeakableSpecification]]  which is defined to be a possible value of the *speakable* property.
         """ ;
    skos:definition """Indicates sections of a Web page that are particularly 'speakable' in the sense of being highlighted as being especially appropriate for text-to-speech conversion. Other sections of a page may also be usefully spoken in particular circumstances; the 'speakable' property serves to indicate the parts most likely to be generally useful for speech.

The *speakable* property can be repeated an arbitrary number of times, with three kinds of possible 'content-locator' values:

1.) *id-value* URL references - uses *id-value* of an element in the page being annotated. The simplest use of *speakable* has (potentially relative) URL values, referencing identified sections of the document concerned.

2.) CSS Selectors - addresses content in the annotated page, e.g. via class attribute. Use the [[cssSelector]] property.

3.)  XPaths - addresses content via XPaths (assuming an XML view of the content). Use the [[xpath]] property.


For more sophisticated markup of speakable sections beyond simple ID references, either CSS selectors or XPath expressions to pick out document section(s) as speakable. For this
we define a supporting type, [[SpeakableSpecification]]  which is defined to be a possible value of the *speakable* property.
         """ .

:specialCommitments a owl:DatatypeProperty ;
    rdfs:label "specialCommitments" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    rdfs:comment "Any special commitments associated with this job posting. Valid entries include VeteranCommit, MilitarySpouseCommit, etc." ;
    skos:definition "Any special commitments associated with this job posting. Valid entries include VeteranCommit, MilitarySpouseCommit, etc." .

:specialOpeningHoursSpecification a owl:ObjectProperty ;
    rdfs:label "specialOpeningHoursSpecification" ;
    :domainIncludes :Place ;
    :rangeIncludes :OpeningHoursSpecification ;
    rdfs:comment """The special opening hours of a certain place.\\n\\nUse this to explicitly override general opening hours brought in scope by [[openingHoursSpecification]] or [[openingHours]].
      """ ;
    skos:definition """The special opening hours of a certain place.\\n\\nUse this to explicitly override general opening hours brought in scope by [[openingHoursSpecification]] or [[openingHours]].
      """ .

:specialty a owl:ObjectProperty ;
    rdfs:label "specialty" ;
    :domainIncludes :WebPage ;
    :rangeIncludes :Specialty ;
    rdfs:comment "One of the domain specialities to which this web page's content applies." ;
    skos:definition "One of the domain specialities to which this web page's content applies." .

:speechToTextMarkup a owl:DatatypeProperty ;
    rdfs:label "speechToTextMarkup" ;
    :domainIncludes :PronounceableText ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2108> ;
    rdfs:comment "Form of markup used. eg. [SSML](https://www.w3.org/TR/speech-synthesis11) or [IPA](https://www.wikidata.org/wiki/Property:P898)." ;
    skos:definition "Form of markup used. eg. [SSML](https://www.w3.org/TR/speech-synthesis11) or [IPA](https://www.wikidata.org/wiki/Property:P898)." .

:speed a owl:ObjectProperty ;
    rdfs:label "speed" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    :domainIncludes :Vehicle ;
    :isPartOf <http://auto.schema.org> ;
    :rangeIncludes :QuantitativeValue ;
    rdfs:comment "The speed range of the vehicle. If the vehicle is powered by an engine, the upper limit of the speed range (indicated by [[maxValue]]) should be the maximum speed achievable under regular conditions.\\n\\nTypical unit code(s): KMH for km/h, HM for mile per hour (0.447 04 m/s), KNT for knot\\n\\n*Note 1: Use [[minValue]] and [[maxValue]] to indicate the range. Typically, the minimal value is zero.\\n* Note 2: There are many different ways of measuring the speed range. You can link to information about how the given value has been determined using the [[valueReference]] property." ;
    skos:definition "The speed range of the vehicle. If the vehicle is powered by an engine, the upper limit of the speed range (indicated by [[maxValue]]) should be the maximum speed achievable under regular conditions.\\n\\nTypical unit code(s): KMH for km/h, HM for mile per hour (0.447 04 m/s), KNT for knot\\n\\n*Note 1: Use [[minValue]] and [[maxValue]] to indicate the range. Typically, the minimal value is zero.\\n* Note 2: There are many different ways of measuring the speed range. You can link to information about how the given value has been determined using the [[valueReference]] property." .

:spokenByCharacter a owl:ObjectProperty ;
    rdfs:label "spokenByCharacter" ;
    :domainIncludes :Quotation ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Organization,
        :Person ;
    :source <https://github.com/schemaorg/schemaorg/issues/271> ;
    rdfs:comment "The (e.g. fictional) character, Person or Organization to whom the quotation is attributed within the containing CreativeWork." ;
    skos:definition "The (e.g. fictional) character, Person or Organization to whom the quotation is attributed within the containing CreativeWork." .

:sport a owl:DatatypeProperty ;
    rdfs:label "sport" ;
    :domainIncludes :SportsEvent,
        :SportsOrganization ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/1951> ;
    rdfs:comment "A type of sport (e.g. Baseball)." ;
    skos:definition "A type of sport (e.g. Baseball)." .

:sportsActivityLocation a owl:ObjectProperty ;
    rdfs:label "sportsActivityLocation" ;
    :domainIncludes :ExerciseAction ;
    :rangeIncludes :SportsActivityLocation ;
    rdfs:comment "A sub property of location. The sports activity location where this action occurred." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The sports activity location where this action occurred." .

:sportsEvent a owl:ObjectProperty ;
    rdfs:label "sportsEvent" ;
    :domainIncludes :ExerciseAction ;
    :rangeIncludes :SportsEvent ;
    rdfs:comment "A sub property of location. The sports event where this action occurred." ;
    rdfs:subPropertyOf :location ;
    skos:definition "A sub property of location. The sports event where this action occurred." .

:sportsTeam a owl:ObjectProperty ;
    rdfs:label "sportsTeam" ;
    :domainIncludes :ExerciseAction ;
    :rangeIncludes :SportsTeam ;
    rdfs:comment "A sub property of participant. The sports team that participated on this action." ;
    rdfs:subPropertyOf :participant ;
    skos:definition "A sub property of participant. The sports team that participated on this action." .

:spouse a owl:ObjectProperty ;
    rdfs:label "spouse" ;
    :domainIncludes :Person ;
    :rangeIncludes :Person ;
    rdfs:comment "The person's spouse." ;
    skos:definition "The person's spouse." .

:stage a owl:ObjectProperty ;
    rdfs:label "stage" ;
    :domainIncludes :MedicalCondition ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :MedicalConditionStage ;
    rdfs:comment "The stage of the condition, if applicable." ;
    skos:definition "The stage of the condition, if applicable." .

:stageAsNumber a owl:DatatypeProperty ;
    rdfs:label "stageAsNumber" ;
    :domainIncludes :MedicalConditionStage ;
    :isPartOf <http://health-lifesci.schema.org> ;
    :rangeIncludes :Number ;
    rdfs:comment "The stage represented as a number, e.g. 3." ;
    skos:definition "The stage represented as a number, e.g. 3." .

:starRating a owl:ObjectProperty ;
    rdfs:label "starRating" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    :domainIncludes :FoodEstablishment,
        :LodgingBusiness ;
    :rangeIncludes :Rating ;
    rdfs:comment "An official rating for a lodging business or food establishment, e.g. from national associations or standards bodies. Use the author property to indicate the rating organization, e.g. as an Organization with name such as (e.g. HOTREC, DEHOGA, WHR, or Hotelstars)." ;
    skos:definition "An official rating for a lodging business or food establishment, e.g. from national associations or standards bodies. Use the author property to indicate the rating organization, e.g. as an Organization with name such as (e.g. HOTREC, DEHOGA, WHR, or Hotelstars)." .

:startDate a owl:DatatypeProperty ;
    rdfs:label "startDate" ;
    :domainIncludes :CreativeWorkSeason,
        :CreativeWorkSeries,
        :DatedMoneySpecification,
        :EducationalOccupationalProgram,
        :Event,
        :MerchantReturnPolicySeasonalOverride,
        :Role,
        :Schedule ;
    :rangeIncludes :Date,
        :DateTime ;
    :source <https://github.com/schemaorg/schemaorg/issues/2486> ;
    rdfs:comment "The start date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." ;
    owl:equivalentProperty cmns-dt:hasStartDate ;
    skos:definition "The start date and time of the item (in [ISO 8601 date format](http://en.wikipedia.org/wiki/ISO_8601))." .

:startOffset a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "startOffset" ;
    :domainIncludes :Clip,
        :SeekToAction ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :HyperTocEntry,
        :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2021> ;
    rdfs:comment "The start time of the clip expressed as the number of seconds from the beginning of the work." ;
    skos:definition "The start time of the clip expressed as the number of seconds from the beginning of the work." .

:startTime a owl:DatatypeProperty ;
    rdfs:label "startTime" ;
    :domainIncludes :Action,
        :FoodEstablishmentReservation,
        :InteractionCounter,
        :MediaObject,
        :Schedule ;
    :rangeIncludes :DateTime,
        :Time ;
    :source <https://github.com/schemaorg/schemaorg/issues/2493> ;
    rdfs:comment "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. E.g. John wrote a book from *January* to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." ;
    skos:definition "The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. E.g. John wrote a book from *January* to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.\\n\\nNote that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions." .

:statType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "statType" ;
    :domainIncludes :StatisticalVariable ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Property,
        :Text,
        :URL ;
    :source <https://github.com/schemaorg/schemaorg/issues/2564> ;
    rdfs:comment "Indicates the kind of statistic represented by a [[StatisticalVariable]], e.g. mean, count etc. The value of statType is a property, either from within Schema.org (e.g. [[median]], [[marginOfError]], [[maxValue]], [[minValue]]) or from other compatible (e.g. RDF) systems such as DataCommons.org or Wikidata.org. " ;
    skos:definition "Indicates the kind of statistic represented by a [[StatisticalVariable]], e.g. mean, count etc. The value of statType is a property, either from within Schema.org (e.g. [[median]], [[marginOfError]], [[maxValue]], [[minValue]]) or from other compatible (e.g. RDF) systems such as DataCommons.org or Wikidata.org. " .

