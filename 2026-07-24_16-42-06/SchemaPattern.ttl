: a owl:Ontology ;
    rdfs:label "Schema.org Ontology"@en ;
    dcterms:license <https://schema.org/docs/terms.html> ;
    dcterms:modified "2026-07-24T16:07:32+00:00"^^xsd:dateTime ;
    dcterms:title "Schema.org Ontology"@en ;
    vann:preferredNamespacePrefix "schema" ;
    vann:preferredNamespaceUri "http://schema.org/"^^xsd:anyURI ;
    skos:definition "Schema.org is a collaborative, community activity with a mission to create, maintain, and promote schemas for structured data on the Internet."@en ;
    skos:note "This ontology has been converted from Schema.org RDF/XML to Turtle for documentation generation with ont2md. Class declarations use owl:Class (instead of rdfs:Class) and properties use owl:ObjectProperty and/or owl:DatatypeProperty (instead of rdf:Property) based on schema:rangeIncludes. skos:definition annotations were added from rdfs:comment where missing. rdfs:subClassOf axioms were removed from enumeration individuals (e.g. MedicalSpecialty values) that Schema.org also marks as pseudo-classes, because ont2md documents only owl:Class terms and those individuals do not get pages. No other intentional semantic changes were made."@en .

:AMRadioChannel a owl:Class ;
    rdfs:label "AMRadioChannel" ;
    :source <https://github.com/schemaorg/schemaorg/issues/1004> ;
    rdfs:comment "A radio channel that uses AM." ;
    rdfs:subClassOf :RadioChannel ;
    skos:definition "A radio channel that uses AM." .

:Abdomen a :PhysicalExam ;
    rdfs:label "Abdomen" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Abdomen clinical examination." ;
    skos:definition "Abdomen clinical examination." .

:AcceptAction a owl:Class ;
    rdfs:label "AcceptAction" ;
    rdfs:comment "The act of committing to/adopting an object.\\n\\nRelated actions:\\n\\n* [[RejectAction]]: The antonym of AcceptAction." ;
    rdfs:subClassOf :AllocateAction ;
    skos:definition "The act of committing to/adopting an object.\\n\\nRelated actions:\\n\\n* [[RejectAction]]: The antonym of AcceptAction." .

:AccountingService a owl:Class ;
    rdfs:label "AccountingService" ;
    rdfs:comment """Accountancy business.\\n\\nAs a [[LocalBusiness]] it can be described as a [[provider]] of one or more [[Service]]\\(s).
      """ ;
    rdfs:subClassOf :FinancialService ;
    skos:definition """Accountancy business.\\n\\nAs a [[LocalBusiness]] it can be described as a [[provider]] of one or more [[Service]]\\(s).
      """ .

:ActivateAction a owl:Class ;
    rdfs:label "ActivateAction" ;
    rdfs:comment "The act of starting or activating a device or application (e.g. starting a timer or turning on a flashlight)." ;
    rdfs:subClassOf :ControlAction ;
    skos:definition "The act of starting or activating a device or application (e.g. starting a timer or turning on a flashlight)." .

:ActivationFee a :PriceComponentTypeEnumeration ;
    rdfs:label "ActivationFee" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2689> ;
    rdfs:comment "Represents the activation fee part of the total price for an offered product, for example a cellphone contract." ;
    skos:definition "Represents the activation fee part of the total price for an offered product, for example a cellphone contract." .

:ActiveActionStatus a :ActionStatusType ;
    rdfs:label "ActiveActionStatus" ;
    rdfs:comment "An in-progress action (e.g., while watching the movie, or driving to a location)." ;
    skos:definition "An in-progress action (e.g., while watching the movie, or driving to a location)." .

:ActiveNotRecruiting a :MedicalStudyStatus ;
    rdfs:label "ActiveNotRecruiting" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Active, but not recruiting new participants." ;
    skos:definition "Active, but not recruiting new participants." .

:AdultEntertainment a owl:Class ;
    rdfs:label "AdultEntertainment" ;
    rdfs:comment "An adult entertainment establishment." ;
    rdfs:subClassOf :EntertainmentBusiness ;
    skos:definition "An adult entertainment establishment." .

:AdvertiserContentArticle a owl:Class ;
    rdfs:label "AdvertiserContentArticle" ;
    :contributor <http://schema.org/docs/collab/TP> ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1525> ;
    rdfs:comment "An [[Article]] that an external entity has paid to place or to produce to its specifications. Includes [advertorials](https://en.wikipedia.org/wiki/Advertorial), sponsored content, native advertising and other paid content." ;
    rdfs:subClassOf :Article ;
    skos:definition "An [[Article]] that an external entity has paid to place or to produce to its specifications. Includes [advertorials](https://en.wikipedia.org/wiki/Advertorial), sponsored content, native advertising and other paid content." .

:AerobicActivity a :PhysicalActivityCategory ;
    rdfs:label "AerobicActivity" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "Physical activity of relatively low intensity that depends primarily on the aerobic energy-generating process; during activity, the aerobic metabolism uses oxygen to adequately meet energy demands during exercise." ;
    skos:definition "Physical activity of relatively low intensity that depends primarily on the aerobic energy-generating process; during activity, the aerobic metabolism uses oxygen to adequately meet energy demands during exercise." .

:AgreeAction a owl:Class ;
    rdfs:label "AgreeAction" ;
    rdfs:comment "The act of expressing a consistency of opinion with the object. An agent agrees to/about an object (a proposition, topic or theme) with participants." ;
    rdfs:subClassOf :ReactAction ;
    skos:definition "The act of expressing a consistency of opinion with the object. An agent agrees to/about an object (a proposition, topic or theme) with participants." .

:AlbumRelease a :MusicAlbumReleaseType ;
    rdfs:label "AlbumRelease" ;
    :contributor <http://schema.org/docs/collab/MBZ> ;
    rdfs:comment "AlbumRelease." ;
    skos:definition "AlbumRelease." .

:AlcoholConsideration a :AdultOrientedEnumeration ;
    rdfs:label "AlcoholConsideration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2989> ;
    rdfs:comment "Item contains alcohol or promotes alcohol consumption." ;
    skos:definition "Item contains alcohol or promotes alcohol consumption." .

:AlgorithmicMediaDigitalSource a :IPTCDigitalSourceEnumeration ;
    rdfs:label "AlgorithmicMediaDigitalSource" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3392> ;
    rdfs:comment "Content coded as '<a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia\">algorithmic media</a>' using the IPTC <a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/\">digital source type</a> vocabulary." ;
    skos:definition "Content coded as '<a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia\">algorithmic media</a>' using the IPTC <a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/\">digital source type</a> vocabulary." ;
    skos:exactMatch <http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia> .

:AlgorithmicallyEnhancedDigitalSource a :IPTCDigitalSourceEnumeration ;
    rdfs:label "AlgorithmicallyEnhancedDigitalSource" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3392> ;
    rdfs:comment "Content coded as '<a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/algorithmicallyEnhanced\">algorithmically enhanced</a>' using the IPTC <a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/\">digital source type</a> vocabulary." ;
    skos:definition "Content coded as '<a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/algorithmicallyEnhanced\">algorithmically enhanced</a>' using the IPTC <a href=\"https://cv.iptc.org/newscodes/digitalsourcetype/\">digital source type</a> vocabulary." ;
    skos:exactMatch <http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicallyEnhanced> .

:AllWheelDriveConfiguration a :DriveWheelConfigurationValue ;
    rdfs:label "AllWheelDriveConfiguration" ;
    :contributor <http://schema.org/docs/collab/Automotive_Ontology_Working_Group> ;
    rdfs:comment "All-wheel Drive is a transmission layout where the engine drives all four wheels." ;
    skos:definition "All-wheel Drive is a transmission layout where the engine drives all four wheels." .

:AllergiesHealthAspect a :HealthAspectEnumeration ;
    rdfs:label "AllergiesHealthAspect" ;
    :isPartOf <http://pending.schema.org> ;
