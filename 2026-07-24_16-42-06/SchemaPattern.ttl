cmns-txt:hasName a owl:ObjectProperty .

:AchieveAction a owl:Class ;
    rdfs:label "AchieveAction" ;
    rdfs:comment "The act of accomplishing something via previous efforts. It is an instantaneous action rather than an ongoing process." ;
    rdfs:subClassOf :Action ;
    skos:definition "The act of accomplishing something via previous efforts. It is an instantaneous action rather than an ongoing process." .

:ArchiveComponent a owl:Class ;
    rdfs:label "ArchiveComponent"@en ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/1758> ;
    rdfs:comment "An intangible type to be applied to any archive content, carrying with it a set of properties required to describe archival items and collections."@en ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "An intangible type to be applied to any archive content, carrying with it a set of properties required to describe archival items and collections."@en .

:BedDetails a owl:Class ;
    rdfs:label "BedDetails" ;
    :contributor <http://schema.org/docs/collab/STI_Accommodation_Ontology> ;
    rdfs:comment "An entity holding detailed information about the available bed types, e.g. the quantity of twin beds for a hotel room. For the single case of just one bed of a certain type, you can use bed directly with a text. See also [[BedType]] (under development)." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "An entity holding detailed information about the available bed types, e.g. the quantity of twin beds for a hotel room. For the single case of just one bed of a certain type, you can use bed directly with a text. See also [[BedType]] (under development)." .

:Blog a owl:Class ;
    rdfs:label "Blog" ;
    rdfs:comment "A [blog](https://en.wikipedia.org/wiki/Blog), sometimes known as a \"weblog\". Note that the individual posts ([[BlogPosting]]s) in a [[Blog]] are often colloquially referred to by the same term." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "A [blog](https://en.wikipedia.org/wiki/Blog), sometimes known as a \"weblog\". Note that the individual posts ([[BlogPosting]]s) in a [[Blog]] are often colloquially referred to by the same term." .

:BoardingPolicyType a owl:Class ;
    rdfs:label "BoardingPolicyType" ;
    rdfs:comment "A type of boarding policy used by an airline." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "A type of boarding policy used by an airline." .

:BusinessAudience a owl:Class ;
    rdfs:label "BusinessAudience" ;
    rdfs:comment "A set of characteristics belonging to businesses, e.g. who compose an item's target audience." ;
    rdfs:subClassOf :Audience ;
    skos:definition "A set of characteristics belonging to businesses, e.g. who compose an item's target audience." .

:BuyAction a owl:Class ;
    rdfs:label "BuyAction" ;
    rdfs:comment "The act of giving money to a seller in exchange for goods or services rendered. An agent buys an object, product, or service from a seller for a price. Reciprocal of SellAction." ;
    rdfs:subClassOf :TradeAction ;
    skos:definition "The act of giving money to a seller in exchange for goods or services rendered. An agent buys an object, product, or service from a seller for a price. Reciprocal of SellAction." .

:CertificationStatusEnumeration a owl:Class ;
    rdfs:label "CertificationStatusEnumeration" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3230> ;
    rdfs:comment "Enumerates the different statuses of a Certification (Active and Inactive)." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerates the different statuses of a Certification (Active and Inactive)." .

:Chapter a owl:Class ;
    rdfs:label "Chapter" ;
    :isPartOf <http://bib.schema.org> ;
    rdfs:comment "One of the sections into which a book is divided. A chapter usually has a section number or a name." ;
    rdfs:subClassOf :CreativeWork ;
    skos:definition "One of the sections into which a book is divided. A chapter usually has a section number or a name." .

:ChemicalSubstance a owl:Class ;
    rdfs:label "ChemicalSubstance" ;
    :isPartOf <http://pending.schema.org> ;
    :source <http://bioschemas.org>,
        <https://www.ebi.ac.uk/chebi/searchId.do?chebiId=59999> ;
    rdfs:comment "A chemical substance is 'a portion of matter of constant composition, composed of molecular entities of the same type or of different types' (source: [ChEBI:59999](https://www.ebi.ac.uk/chebi/searchId.do?chebiId=59999))." ;
    rdfs:subClassOf :BioChemEntity ;
    skos:definition "A chemical substance is 'a portion of matter of constant composition, composed of molecular entities of the same type or of different types' (source: [ChEBI:59999](https://www.ebi.ac.uk/chebi/searchId.do?chebiId=59999))." .

:ChooseAction a owl:Class ;
    rdfs:label "ChooseAction" ;
    rdfs:comment "The act of expressing a preference from a set of options or a large or unbounded set of choices/options." ;
    rdfs:subClassOf :AssessAction ;
    skos:definition "The act of expressing a preference from a set of options or a large or unbounded set of choices/options." .

:ConstraintNode a owl:Class ;
    rdfs:label "ConstraintNode" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/2564> ;
    rdfs:comment """The ConstraintNode type is provided to support usecases in which a node in a structured data graph is described with properties which appear to describe a single entity, but are being used in a situation where they serve a more abstract purpose. A [[ConstraintNode]] can be described using [[constraintProperty]] and [[numConstraints]]. These constraint properties can serve a
    variety of purposes, and their values may sometimes be understood to indicate sets of possible values rather than single, exact and specific values.""" ;
    rdfs:subClassOf :Intangible ;
    skos:definition """The ConstraintNode type is provided to support usecases in which a node in a structured data graph is described with properties which appear to describe a single entity, but are being used in a situation where they serve a more abstract purpose. A [[ConstraintNode]] can be described using [[constraintProperty]] and [[numConstraints]]. These constraint properties can serve a
    variety of purposes, and their values may sometimes be understood to indicate sets of possible values rather than single, exact and specific values.""" .

:ContactPointOption a owl:Class ;
    rdfs:label "ContactPointOption" ;
    rdfs:comment "Enumerated options related to a ContactPoint." ;
    rdfs:subClassOf :Enumeration ;
    skos:definition "Enumerated options related to a ContactPoint." .

:CookAction a owl:Class ;
    rdfs:label "CookAction" ;
    rdfs:comment "The act of producing/preparing food." ;
    rdfs:subClassOf :CreateAction ;
    skos:definition "The act of producing/preparing food." .

:DDxElement a owl:Class ;
    rdfs:label "DDxElement" ;
    :isPartOf <http://health-lifesci.schema.org> ;
