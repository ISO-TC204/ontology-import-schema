    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Text ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "Identifier of the NHSN facility that this data record applies to. Use [[cvdFacilityCounty]] to indicate the county. To provide other details, [[healthcareReportingData]] can be used on a [[Hospital]] entry." ;
    skos:definition "Identifier of the NHSN facility that this data record applies to. Use [[cvdFacilityCounty]] to indicate the county. To provide other details, [[healthcareReportingData]] can be used on a [[Hospital]] entry." .

:cvdNumBeds a owl:DatatypeProperty ;
    rdfs:label "cvdNumBeds" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numbeds - HOSPITAL INPATIENT BEDS: Inpatient beds, including all staffed, licensed, and overflow (surge) beds used for inpatients." ;
    skos:definition "numbeds - HOSPITAL INPATIENT BEDS: Inpatient beds, including all staffed, licensed, and overflow (surge) beds used for inpatients." .

:cvdNumBedsOcc a owl:DatatypeProperty ;
    rdfs:label "cvdNumBedsOcc" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numbedsocc - HOSPITAL INPATIENT BED OCCUPANCY: Total number of staffed inpatient beds that are occupied." ;
    skos:definition "numbedsocc - HOSPITAL INPATIENT BED OCCUPANCY: Total number of staffed inpatient beds that are occupied." .

:cvdNumC19Died a owl:DatatypeProperty ;
    rdfs:label "cvdNumC19Died" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numc19died - DEATHS: Patients with suspected or confirmed COVID-19 who died in the hospital, ED, or any overflow location." ;
    skos:definition "numc19died - DEATHS: Patients with suspected or confirmed COVID-19 who died in the hospital, ED, or any overflow location." .

:cvdNumC19HOPats a owl:DatatypeProperty ;
    rdfs:label "cvdNumC19HOPats" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numc19hopats - HOSPITAL ONSET: Patients hospitalized in an NHSN inpatient care location with onset of suspected or confirmed COVID-19 14 or more days after hospitalization." ;
    skos:definition "numc19hopats - HOSPITAL ONSET: Patients hospitalized in an NHSN inpatient care location with onset of suspected or confirmed COVID-19 14 or more days after hospitalization." .

:cvdNumC19HospPats a owl:DatatypeProperty ;
    rdfs:label "cvdNumC19HospPats" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numc19hosppats - HOSPITALIZED: Patients currently hospitalized in an inpatient care location who have suspected or confirmed COVID-19." ;
    skos:definition "numc19hosppats - HOSPITALIZED: Patients currently hospitalized in an inpatient care location who have suspected or confirmed COVID-19." .

:cvdNumC19MechVentPats a owl:DatatypeProperty ;
    rdfs:label "cvdNumC19MechVentPats" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numc19mechventpats - HOSPITALIZED and VENTILATED: Patients hospitalized in an NHSN inpatient care location who have suspected or confirmed COVID-19 and are on a mechanical ventilator." ;
    skos:definition "numc19mechventpats - HOSPITALIZED and VENTILATED: Patients hospitalized in an NHSN inpatient care location who have suspected or confirmed COVID-19 and are on a mechanical ventilator." .

:cvdNumC19OFMechVentPats a owl:DatatypeProperty ;
    rdfs:label "cvdNumC19OFMechVentPats" ;
    :domainIncludes :CDCPMDRecord ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :Number ;
    :source <https://github.com/schemaorg/schemaorg/issues/2521> ;
    rdfs:comment "numc19ofmechventpats - ED/OVERFLOW and VENTILATED: Patients with suspected or confirmed COVID-19 who are in the ED or any overflow location awaiting an inpatient bed and on a mechanical ventilator." ;
    skos:definition "numc19ofmechventpats - ED/OVERFLOW and VENTILATED: Patients with suspected or confirmed COVID-19 who are in the ED or any overflow location awaiting an inpatient bed and on a mechanical ventilator." .

