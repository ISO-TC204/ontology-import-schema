    rdfs:subClassOf :MedicalBusiness,
        :MedicalOrganization ;
    skos:definition "A facility, often associated with a hospital or medical school, that is devoted to the specific diagnosis and/or healthcare. Previously limited to outpatients but with evolution it may be open to inpatients as well." .

:MedicalCode a owl:Class ;
    rdfs:label "MedicalCode" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A code for a medical entity." ;
    rdfs:subClassOf :CategoryCode,
        :MedicalIntangible ;
    skos:definition "A code for a medical entity." .

:MedicalConditionStage a owl:Class ;
    rdfs:label "MedicalConditionStage" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A stage of a medical condition, such as 'Stage IIIa'." ;
    rdfs:subClassOf :MedicalIntangible ;
    skos:definition "A stage of a medical condition, such as 'Stage IIIa'." .

:MedicalIndication a owl:Class ;
    rdfs:label "MedicalIndication" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A condition or factor that indicates use of a medical therapy, including signs, symptoms, risk factors, anatomical states, etc." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "A condition or factor that indicates use of a medical therapy, including signs, symptoms, risk factors, anatomical states, etc." .

:MedicalProcedureType a owl:Class ;
    rdfs:label "MedicalProcedureType" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "An enumeration that describes different types of medical procedures." ;
    rdfs:subClassOf :MedicalEnumeration ;
    skos:definition "An enumeration that describes different types of medical procedures." .

:MedicalRiskFactor a owl:Class ;
    rdfs:label "MedicalRiskFactor" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A risk factor is anything that increases a person's likelihood of developing or contracting a disease, medical condition, or complication." ;
    rdfs:subClassOf :MedicalEntity ;
    skos:definition "A risk factor is anything that increases a person's likelihood of developing or contracting a disease, medical condition, or complication." .

:OnlineStore a owl:Class ;
    rdfs:label "OnlineStore" ;
    :isPartOf <http://pending.schema.org> ;
    :source <https://github.com/schemaorg/schemaorg/issues/3028> ;
    rdfs:comment "An eCommerce site." ;
    rdfs:subClassOf :OnlineBusiness ;
    skos:definition "An eCommerce site." .

:Patient a owl:Class ;
    rdfs:label "Patient" ;
    :isPartOf <http://health-lifesci.schema.org> ;
    rdfs:comment "A patient is any person recipient of health care services." ;
    rdfs:subClassOf :MedicalAudience,
        :Person ;
    owl:equivalentClass snomed:116154003 ;
    skos:definition "A patient is any person recipient of health care services." .

:PostalCodeRangeSpecification a owl:Class ;
    rdfs:label "PostalCodeRangeSpecification" ;
    :source <https://github.com/schemaorg/schemaorg/issues/2506> ;
    rdfs:comment "Indicates a range of postal codes, usually defined as the set of valid codes between [[postalCodeBegin]] and [[postalCodeEnd]], inclusively." ;
    rdfs:subClassOf :StructuredValue ;
    skos:definition "Indicates a range of postal codes, usually defined as the set of valid codes between [[postalCodeBegin]] and [[postalCodeEnd]], inclusively." .

:Residence a owl:Class ;
    rdfs:label "Residence" ;
    rdfs:comment "The place where a person lives." ;
    rdfs:subClassOf :Place ;
    skos:definition "The place where a person lives." .

:RsvpAction a owl:Class ;
    rdfs:label "RsvpAction" ;
    rdfs:comment "The act of notifying an event organizer as to whether you expect to attend the event." ;
    rdfs:subClassOf :InformAction ;
    skos:definition "The act of notifying an event organizer as to whether you expect to attend the event." .

:ScreeningEvent a owl:Class ;
    rdfs:label "ScreeningEvent" ;
    rdfs:comment "A screening of a movie or other video." ;
    rdfs:subClassOf :Event ;
    skos:definition "A screening of a movie or other video." .

:SocialMediaPosting a owl:Class ;
    rdfs:label "SocialMediaPosting" ;
    rdfs:comment "A post to a social media platform, including blog posts, tweets, Facebook posts, etc." ;
    rdfs:subClassOf :Article ;
    skos:definition "A post to a social media platform, including blog posts, tweets, Facebook posts, etc." .

:SpeakableSpecification a owl:Class ;
    rdfs:label "SpeakableSpecification" ;
    :source <https://github.com/schemaorg/schemaorg/issues/1389> ;
    rdfs:comment "A SpeakableSpecification indicates (typically via [[xpath]] or [[cssSelector]]) sections of a document that are highlighted as particularly [[speakable]]. Instances of this type are expected to be used primarily as values of the [[speakable]] property." ;
    rdfs:subClassOf :Intangible ;
    skos:definition "A SpeakableSpecification indicates (typically via [[xpath]] or [[cssSelector]]) sections of a document that are highlighted as particularly [[speakable]]. Instances of this type are expected to be used primarily as values of the [[speakable]] property." .

:SteeringPositionValue a owl:Class ;
