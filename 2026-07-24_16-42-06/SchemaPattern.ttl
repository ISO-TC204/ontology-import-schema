    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :IncentiveStatus ;
    :source <https://github.com/schemaorg/schemaorg/issues/3572> ;
    rdfs:comment "The status of the incentive (active, on hold, retired, etc.)." ;
    skos:definition "The status of the incentive (active, on hold, retired, etc.)." .

:incentiveType a owl:ObjectProperty ;
    rdfs:label "incentiveType" ;
    :domainIncludes :FinancialIncentive ;
    :isPartOf <http://pending.schema.org> ;
    :rangeIncludes :IncentiveType ;
    :source <https://github.com/schemaorg/schemaorg/issues/3572> ;
    rdfs:comment "The type of incentive offered (tax credit/rebate, tax deduction, tax waiver, subsidies, etc.)." ;
    skos:definition "The type of incentive offered (tax credit/rebate, tax deduction, tax waiver, subsidies, etc.)." .

:incentives a owl:DatatypeProperty ;
    rdfs:label "incentives" ;
    :domainIncludes :JobPosting ;
    :rangeIncludes :Text ;
    :supersededBy :incentiveCompensation ;
