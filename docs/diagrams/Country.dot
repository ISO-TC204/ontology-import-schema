// Diagram for Country
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		AdministrativeArea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">AdministrativeArea</TD></TR></TABLE>> URL="../AdministrativeArea" margin=0]
		"cmns-geopol_GeopoliticalEntity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cmns-geopol:GeopoliticalEntity</TD></TR></TABLE>> URL="https://w3id.org/citydata/imported/cmns-geopol/latest/GeopoliticalEntity" margin=0]
	}
	Country [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Country</TD></TR></TABLE>> URL="../Country" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	Country -> AdministrativeArea [arrowhead=onormal style=solid]
	Country -> "cmns-geopol_GeopoliticalEntity" [arrowhead=onormal style=solid]
}
