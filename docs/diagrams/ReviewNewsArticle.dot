// Diagram for ReviewNewsArticle
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		CriticReview [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">CriticReview</TD></TR></TABLE>> URL="../CriticReview" margin=0]
		NewsArticle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">NewsArticle</TD></TR></TABLE>> URL="../NewsArticle" margin=0]
	}
	ReviewNewsArticle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">ReviewNewsArticle</TD></TR></TABLE>> URL="../ReviewNewsArticle" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	ReviewNewsArticle -> CriticReview [arrowhead=onormal style=solid]
	ReviewNewsArticle -> NewsArticle [arrowhead=onormal style=solid]
}
