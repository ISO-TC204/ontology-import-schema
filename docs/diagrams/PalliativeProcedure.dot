// Diagram for PalliativeProcedure
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		MedicalProcedure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MedicalProcedure</TD></TR></TABLE>> URL="../MedicalProcedure" margin=0]
		MedicalTherapy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MedicalTherapy</TD></TR></TABLE>> URL="../MedicalTherapy" margin=0]
	}
	PalliativeProcedure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PalliativeProcedure</TD></TR></TABLE>> URL="../PalliativeProcedure" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	PalliativeProcedure -> MedicalProcedure [arrowhead=onormal style=solid]
	PalliativeProcedure -> MedicalTherapy [arrowhead=onormal style=solid]
}
